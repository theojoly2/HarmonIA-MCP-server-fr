@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/ns/adms#> .
@prefix onto: <http://vocab.deri.ie/raul> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://purl.org/NET/raul#Button> a rdfs:Class,
        owl:Class ;
    rdfs:label "Button" ;
    rdfs:subClassOf <http://purl.org/NET/raul#Widget> .

<http://purl.org/NET/raul#CREATEOperation> a rdfs:Class,
        owl:Class ;
    rdfs:label "CREATEOperation" ;
    rdfs:subClassOf <http://purl.org/NET/raul#CRUDOperation> .

<http://purl.org/NET/raul#CRUDOperation> a rdfs:Class,
        owl:Class ;
    rdfs:label "CRUDOperation" ;
    rdfs:subClassOf owl:Class .

<http://purl.org/NET/raul#Checkbox> a rdfs:Class,
        owl:Class ;
    rdfs:label "Checkbox" ;
    rdfs:subClassOf <http://purl.org/NET/raul#Button> .

<http://purl.org/NET/raul#DELETEOperation> a rdfs:Class,
        owl:Class ;
    rdfs:label "DELETEOperation" ;
    rdfs:subClassOf <http://purl.org/NET/raul#CRUDOperation> .

<http://purl.org/NET/raul#DynamicGroup> a rdfs:Class,
        owl:Class ;
    rdfs:label "DynamicGroup" ;
    rdfs:subClassOf <http://purl.org/NET/raul#Widget> .

<http://purl.org/NET/raul#Group> a rdfs:Class,
        owl:Class ;
    rdfs:label "Group" ;
    rdfs:subClassOf <http://purl.org/NET/raul#Widget> .

<http://purl.org/NET/raul#Listbox> a rdfs:Class,
        owl:Class ;
    rdfs:label "Listbox" ;
    rdfs:subClassOf <http://purl.org/NET/raul#Widget> .

<http://purl.org/NET/raul#Listitem> a rdfs:Class,
        owl:Class ;
    rdfs:label "Listitem" ;
    rdfs:subClassOf <http://purl.org/NET/raul#Widget> .

<http://purl.org/NET/raul#Page> a rdfs:Class,
        owl:Class ;
    rdfs:label "Page" ;
    rdfs:subClassOf owl:Class .

<http://purl.org/NET/raul#READOperation> a rdfs:Class,
        owl:Class ;
    rdfs:label "READOperation" ;
    rdfs:subClassOf <http://purl.org/NET/raul#CRUDOperation> .

<http://purl.org/NET/raul#Radiobutton> a rdfs:Class,
        owl:Class ;
    rdfs:label "Radiobutton" ;
    rdfs:subClassOf <http://purl.org/NET/raul#Button> .

<http://purl.org/NET/raul#Textbox> a rdfs:Class,
        owl:Class ;
    rdfs:label "Textbox" ;
    rdfs:subClassOf <http://purl.org/NET/raul#Widget> .

<http://purl.org/NET/raul#UPDATEOperation> a rdfs:Class,
        owl:Class ;
    rdfs:label "UPDATEOperation" ;
    rdfs:subClassOf <http://purl.org/NET/raul#CRUDOperation> .

<http://purl.org/NET/raul#Widget> a rdfs:Class,
        owl:Class ;
    rdfs:label "Widget" ;
    rdfs:subClassOf <http://purl.org/NET/raul#Page> .

<http://purl.org/NET/raul#WidgetContainer> a rdfs:Class,
        owl:Class ;
    rdfs:label "WidgetContainer" ;
    rdfs:subClassOf <http://purl.org/NET/raul#Widget> .

<http://purl.org/NET/raul#action> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "action" ;
    rdfs:domain <http://purl.org/NET/raul#WidgetContainer> ;
    rdfs:range xsd:string .

<http://purl.org/NET/raul#checked> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "checked" ;
    rdfs:domain <http://purl.org/NET/raul#Button> ;
    rdfs:range xsd:boolean .

<http://purl.org/NET/raul#class> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "class" ;
    rdfs:domain <http://purl.org/NET/raul#Page> ;
    rdfs:range xsd:string .

<http://purl.org/NET/raul#command> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "command" ;
    rdfs:domain <http://purl.org/NET/raul#Button> ;
    rdfs:range xsd:string .

<http://purl.org/NET/raul#disabled> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "disabled" ;
    rdfs:domain <http://purl.org/NET/raul#Widget> ;
    rdfs:range xsd:boolean .

<http://purl.org/NET/raul#group> a rdf:Property ;
    rdfs:label "group" ;
    rdfs:domain <http://purl.org/NET/raul#Widget> ;
    rdfs:range <http://purl.org/NET/raul#Group> .

<http://purl.org/NET/raul#hidden> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "hidden" ;
    rdfs:domain <http://purl.org/NET/raul#Widget> ;
    rdfs:range xsd:boolean .

<http://purl.org/NET/raul#id> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:domain <http://purl.org/NET/raul#Page> ;
    rdfs:range xsd:string .

<http://purl.org/NET/raul#isPassword> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "isPassword" ;
    rdfs:domain <http://purl.org/NET/raul#Textbox> ;
    rdfs:range xsd:boolean .

<http://purl.org/NET/raul#label> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "label" ;
    rdfs:domain <http://purl.org/NET/raul#Widget> ;
    rdfs:range xsd:string .

<http://purl.org/NET/raul#list> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "list" ;
    rdfs:domain <http://purl.org/NET/raul#Page> ;
    rdfs:range rdfs:Literal .

<http://purl.org/NET/raul#maxlength> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "maxlength" ;
    rdfs:domain <http://purl.org/NET/raul#Textbox> ;
    rdfs:range xsd:int .

<http://purl.org/NET/raul#method> a rdf:Property ;
    rdfs:label "method" ;
    rdfs:domain <http://purl.org/NET/raul#WidgetContainer> ;
    rdfs:range <http://purl.org/NET/raul#CRUDOperation> .

<http://purl.org/NET/raul#multiple> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "multiple" ;
    rdfs:domain <http://purl.org/NET/raul#Listbox> ;
    rdfs:range xsd:boolean .

<http://purl.org/NET/raul#name> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:domain <http://purl.org/NET/raul#Widget> ;
    rdfs:range xsd:string .

<http://purl.org/NET/raul#row> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "row" ;
    rdfs:domain <http://purl.org/NET/raul#Widget> ;
    rdfs:range xsd:integer .

<http://purl.org/NET/raul#selected> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "selected" ;
    rdfs:domain <http://purl.org/NET/raul#Listitem> ;
    rdfs:range xsd:boolean .

<http://purl.org/NET/raul#size> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "size" ;
    rdfs:domain <http://purl.org/NET/raul#Textbox> ;
    rdfs:range xsd:string .

<http://purl.org/NET/raul#title> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:domain <http://purl.org/NET/raul#Page> ;
    rdfs:range xsd:string .

<http://purl.org/NET/raul#value> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:domain <http://purl.org/NET/raul#Widget> ;
    rdfs:range xsd:string .

<http://vocab.deri.ie/raul#CSIRO> a dcterms:Agent ;
    foaf:homepage onto: ;
    foaf:member <http://vocab.deri.ie/raul#ahaller> ;
    foaf:name "CSIRO" .

<http://vocab.deri.ie/raul#DERI> a dcterms:Agent ;
    foaf:homepage <http://www.deri.ie/> ;
    foaf:member <http://vocab.deri.ie/raul#juum> ;
    foaf:name "DERI" .

<http://vocab.deri.ie/raul#LiDRC> a dcterms:Agent ;
    foaf:homepage <http://linkeddata.deri.ie/> ;
    foaf:member <http://vocab.deri.ie/raul#Michael%20Hausenblas> ;
    foaf:name "LiDRC" .

<http://vocab.deri.ie/raul#rdf> a ns1:SemanticDistribution ;
    dcterms:FileFormat onto: ;
    ns1:accessURL "http://vocab.deri.ie/raul.rdf" ;
    ns1:status <http://purl.org/adms/status/Completed> .

<http://vocab.deri.ie/raul#ttl> a ns1:SemanticDistribution ;
    dcterms:FileFormat onto: ;
    ns1:accessURL "http://vocab.deri.ie/raul.ttl" ;
    ns1:status <http://purl.org/adms/status/Completed> .

<http://vocab.deri.ie/raul#Michael%20Hausenblas> a foaf:Person ;
    foaf:homepage <http://sw-app.org/about.html> ;
    foaf:mbox <mailto:michael.hausenblas@deri.org> ;
    foaf:name "Michael Hausenblas" .

<http://vocab.deri.ie/raul#ahaller> a foaf:Person ;
    foaf:homepage <http://www.armin-haller.com> ;
    foaf:mbox <mailto:armin.haller@csiro.au> ;
    foaf:name "Armin Haller" .

<http://vocab.deri.ie/raul#juum> a foaf:Person ;
    foaf:homepage <http://umbrich.net/> ;
    foaf:name "Jürgen Umbrich" .

onto: a owl:Ontology,
        ns1:SemanticAsset ;
    dc:creator <http://vocab.deri.ie/raul#Michael%20Hausenblas>,
        <http://vocab.deri.ie/raul#ahaller>,
        <http://vocab.deri.ie/raul#juum> ;
    dcterms:created "2010-06-30"^^xsd:date ;
    dcterms:description "A vocabulary to describe Web form widgets. Strongly aligned with the meta model of HTML Web forms. A RESTful service that can render HTML Web forms from RaUL models can be found at: http://w3c.org.au/raul" ;
    dcterms:modified "2012-04-30"^^xsd:date ;
    dcterms:partOf <http://vocab.deri.ie> ;
    dcterms:publisher "http://vocab.deri.ie/raul#LiDRC" ;
    dcterms:status <http://purl.org/adms/status/UnderDevelopment> ;
    dcterms:title "RAUL Vocabulary" ;
    dcterms:type <http://purl.org/adms/assettype/Ontology> ;
    vann:preferredNamespacePrefix "raul" ;
    vann:preferredNamespaceUri "http://purl.org/NET/raul#" ;
    foaf:homepage onto:.html .

