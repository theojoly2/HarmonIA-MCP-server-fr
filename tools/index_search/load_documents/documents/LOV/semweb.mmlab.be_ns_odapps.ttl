@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://creativecommons.org/ns#> .
@prefix onto: <http://semweb.mmlab.be/ns/odapps> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://semweb.mmlab.be/ns/odapps#AppConcept> a rdfs:Class ;
    rdfs:label "Application Concept"@en ;
    rdfs:comment "An App Concept describes an idea for an application (a digital work) which refers to Open Data."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://purl.org/vocab/frbr/core#Work> .

<http://semweb.mmlab.be/ns/odapps#Application> a rdfs:Class ;
    rdfs:label "Application"@en ;
    rdfs:comment "An App Concept implementation." ;
    rdfs:isDefinedBy onto: .

<http://semweb.mmlab.be/ns/odapps#Tool> a rdfs:Class ;
    rdfs:label "Tool."@en ;
    rdfs:comment "The tool or library used to build the application."@en ;
    rdfs:isDefinedBy onto: .

<http://purl.org/ontology/dvia#Application> rdfs:subClassOf <http://semweb.mmlab.be/ns/odapps#Application> .

<http://purl.org/ontology/dvia#VisualTool> rdfs:subClassOf <http://semweb.mmlab.be/ns/odapps#Tool> .

<http://purl.org/ontology/dvia#consumes> rdfs:SubClassOf <http://semweb.mmlab.be/ns/odapps#consumes> .

<http://purl.org/ontology/dvia#downloadUrl> rdfs:subClassOf <http://semweb.mmlab.be/ns/odapps#downloadUrl> .

<http://purl.org/ontology/dvia#hasLicense> rdfs:subPropertyOf <http://semweb.mmlab.be/ns/odapps#license> .

<http://purl.org/ontology/dvia#keyword> rdfs:subPropertyOf <http://semweb.mmlab.be/ns/odapps#keyword> .

<http://purl.org/ontology/dvia#url> rdfs:subClassOf <http://semweb.mmlab.be/ns/odapps#url> .

<http://purl.org/ontology/dvia#usesTool> rdfs:subClassOf <http://semweb.mmlab.be/ns/odapps#usesTool> .

<http://semweb.mmlab.be/ns/odapps#comment> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "comment"@en ;
    rdfs:comment "comment on the application and the Concept" ;
    rdfs:domain <http://semweb.mmlab.be/ns/odapps#AppConcept>,
        <http://semweb.mmlab.be/ns/odapps#Application> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://semweb.mmlab.be/ns/odapps#AppConcept>,
        <http://semweb.mmlab.be/ns/odapps#Application> .

<http://semweb.mmlab.be/ns/odapps#conceived> a rdf:Property ;
    rdfs:label "conceived by" ;
    rdfs:comment "The Agent which conceived the idea about the App Concept" ;
    rdfs:range foaf:Agent .

<http://semweb.mmlab.be/ns/odapps#datasetDescription> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "dataset description"@en ;
    rdfs:comment "Property for a given descriptive informations of the datasets used for making the application. It could be used when no more details are given on the datasets like URL, formats, etc."@en ;
    rdfs:domain <http://semweb.mmlab.be/ns/odapps#AppConcept>,
        <http://semweb.mmlab.be/ns/odapps#Application> ;
    rdfs:isDefinedBy onto: .

<http://semweb.mmlab.be/ns/odapps#demoUri> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "demo uri"@en ;
    rdfs:comment "Property for a given demo of the application and/or the Concept."@en ;
    rdfs:domain <http://semweb.mmlab.be/ns/odapps#AppConcept>,
        <http://semweb.mmlab.be/ns/odapps#Application> ;
    rdfs:isDefinedBy onto: .

<http://semweb.mmlab.be/ns/odapps#description> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Concept and/or Application description"@en ;
    rdfs:comment "Property for a given descriptive informations of the concept and/or the application."@en ;
    rdfs:domain <http://semweb.mmlab.be/ns/odapps#AppConcept>,
        <http://semweb.mmlab.be/ns/odapps#Application> ;
    rdfs:isDefinedBy onto: .

<http://semweb.mmlab.be/ns/odapps#implements> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "implements"@en ;
    rdfs:comment "The App Concept that this application implements"@en ;
    rdfs:domain <http://semweb.mmlab.be/ns/odapps#Application> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://semweb.mmlab.be/ns/odapps#AppConcept> .

<http://semweb.mmlab.be/ns/odapps#instigator> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "instigator"@en ;
    rdfs:comment "The Agent which conceived the idea about the App Concept (the instigator/initiator)."@en ;
    rdfs:domain <http://semweb.mmlab.be/ns/odapps#AppConcept> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Agent .

<http://semweb.mmlab.be/ns/odapps#revised> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "revised"@en ;
    rdfs:comment "The Agent which revised / extended the idea about the App Concept."@en ;
    rdfs:domain <http://semweb.mmlab.be/ns/odapps#AppConcept> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Agent .

<http://semweb.mmlab.be/ns/odapps#revision> a rdf:Property ;
    rdfs:label "revision of" ;
    rdfs:comment "An App concept which was revised and re-posed / extended. " ;
    rdfs:domain <http://semweb.mmlab.be/ns/odapps#AppConcept> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://semweb.mmlab.be/ns/odapps#AppConcept> .

<http://semweb.mmlab.be/ns/odapps#consumes> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "consumes"@en ;
    rdfs:comment "links to the dataset used to make the application, and could be of different types or formats" ;
    rdfs:domain <http://semweb.mmlab.be/ns/odapps#AppConcept>,
        <http://semweb.mmlab.be/ns/odapps#Application> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string,
        dcat:Dataset .

<http://semweb.mmlab.be/ns/odapps#downloadUrl> a rdf:Property ;
    rdfs:label "download url"@en ;
    rdfs:comment "This property links to the application"@en ;
    rdfs:domain <http://semweb.mmlab.be/ns/odapps#Application> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:anyURI .

<http://semweb.mmlab.be/ns/odapps#keyword> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "dataset description"@en ;
    rdfs:comment "The keywords of the Application."@en ;
    rdfs:domain <http://semweb.mmlab.be/ns/odapps#AppConcept>,
        <http://semweb.mmlab.be/ns/odapps#Application> ;
    rdfs:isDefinedBy onto: .

<http://semweb.mmlab.be/ns/odapps#license> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "has license"@en ;
    rdfs:comment "This property links to the license of the application" ;
    rdfs:domain <http://semweb.mmlab.be/ns/odapps#Application> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:anyURI .

<http://semweb.mmlab.be/ns/odapps#url> a rdf:Property ;
    rdfs:label "url"@en ;
    rdfs:comment "This property links to the application"@en ;
    rdfs:domain <http://semweb.mmlab.be/ns/odapps#Application> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:anyURI .

<http://semweb.mmlab.be/ns/odapps#usesTool> a rdf:Property ;
    rdfs:label "usesTool"@en ;
    rdfs:comment "This property links to the tools or libraries used for the application"@en ;
    rdfs:domain <http://semweb.mmlab.be/ns/odapps#Application> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://semweb.mmlab.be/ns/odapps#Tool> .

onto: a owl:Ontology ;
    ns1:license <http://creativecommons.org/licenses/by/3.0/> ;
    dcterms:contributor [ foaf:mbox "atemezin@eurecom.fr" ;
            foaf:name "Ghislain Auguste Atemezing" ],
        [ foaf:mbox "rtroncy@eurecom.fr" ;
            foaf:name "Raphael Troncy" ],
        [ foaf:mbox "rtroncy@eurecom.fr" ;
            foaf:name "Raphael Troncy" ],
        [ foaf:mbox "atemezin@eurecom.fr" ;
            foaf:name "Ghislain Auguste Atemezing" ] ;
    dcterms:creator [ foaf:mbox "Anastasia.Dimou@UGent.be" ;
            foaf:name "Anastasia Dimou" ],
        [ foaf:mbox "Pieter.Colpaert@UGent.be" ;
            foaf:name "Pieter Colpaert" ],
        [ foaf:mbox "Pieter.Colpaert@UGent.be" ;
            foaf:name "Pieter Colpaert" ],
        [ foaf:mbox "Anastasia.Dimou@UGent.be" ;
            foaf:name "Anastasia Dimou" ] ;
    dcterms:issued "2013-05-10"^^xsd:date ;
    dcterms:modified "2014-01-14"^^xsd:date ;
    dcterms:title "The vocabulary for (L)OD ideas and applications"@en ;
    vann:preferredNamespacePrefix "odapps" ;
    rdfs:comment "odapps is an RDF vocabulary defined to facilitate the description of Open-Data-based ideas and applications published on the Web."@en ;
    owl:versionInfo "1.1 - 2014-01-14" .

