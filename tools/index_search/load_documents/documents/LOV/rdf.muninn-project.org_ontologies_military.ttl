ns1:Rank_Chiliarch a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Chiliarch"@en,
        "Chiliarque"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Chiliarch> ;
    skos:definition "Chiliarch, in the Greek army of the Hellenistic period, was a commander of a 1,000 men unit, roughly equivalent to a modern battalion. The office was an adaptation by Alexander the Great of the Persian Achaemenid empire's hazarapatish. A chiliarch heldl duties both martial and civil. Alexander the Great first awarded this rank to Hephaestion Amyntoros, but after Hephaestion's death it was awarded to Perdiccas."@en ;
    foaf:name "Chiliarch" .

