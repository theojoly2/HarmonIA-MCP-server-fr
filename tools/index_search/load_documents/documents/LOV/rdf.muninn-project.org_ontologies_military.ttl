    owl:sameAs <http://dbpedia.org/resource/Marshal_of_the_air_force> ;
    skos:inScheme ns1:AirForceServiceBranch ;
    org:rankEquivalentTo ns1:Rank_Admiral_of_the_fleet_EnglishTradition,
        ns1:Rank_Field_marshal_EnglishTradition,
        ns1:Rank_Marshal_EnglishTradition ;
    org:rankSeniorToTransitive ns1:Rank_Air_marshal_EnglishTradition .

ns1:Rank_Navarch a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Navarch"@en,
        "Navarque"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Navarch> ;
    skos:definition "Navarch is a Greek word meaning \"leader of the ships\", which in some states became the title of an office equivalent to that of a modern admiral."@en ;
    foaf:name "Navarch" .

ns1:Rank_Petty_officer_EnglishTradition a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Petty officer"@en,
        "Maître (grade)"@fr ;
    ns1:rankOf ns1:EnglishTradition ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Petty_officer> ;
    skos:definition "A petty officer is a non-commissioned officer in many navies and is given the NATO rank denotion OR-6. They are equal in rank to sergeant, British Army and Royal Air Force. A Petty Officer is superior in rank to Leading Rate and subordinate to Chief Petty Officer, in the case of the British Armed Forces. The modern petty officer dates back to the Age of Sail. Petty officers rank between naval officers and most enlisted sailors."@en ;
    skos:inScheme ns1:NavyServiceBranch ;
    org:rankEquivalentTo ns1:Rank_Sergeant_EnglishTradition ;
    org:rankJuniorToTransitive ns1:Rank_Warrant_officer_EnglishTradition ;
    org:rankSeniorToTransitive ns1:Rank_Leading_seaman_EnglishTradition .

ns1:Rank_Phrourarch a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Phrourarch"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Phrourarch> ;
    skos:definition "Phrourarch or Phrourarchos is a Greek military title, meaning garrison commander. Athenians controlled their overseas empire with the episcopi and phrourarchs . The term was widely used by the Macedonian and later Hellenistic armies. Regarding the Spartans, it is not clear if phrourarch was the specific Spartan term. Phroura (garrison) is reported to be a Spartan term for 'a small mobile or expeditionary force'."@en ;
    foaf:name "Phrourarch" .

ns1:Rank_Pilot_officer_EnglishTradition a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Pilot officer"@en ;
