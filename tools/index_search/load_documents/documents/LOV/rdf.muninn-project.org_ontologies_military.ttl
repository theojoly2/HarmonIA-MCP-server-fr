ns1:Rank_Admiral_EnglishTradition a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Admiral"@en,
        "Amiral"@fr ;
    ns1:rankOf ns1:EnglishTradition ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Admiral> ;
    skos:definition "Admiral is the rank, or part of the name of the ranks, of the highest naval officers. It is usually considered a full admiral (equivalent to full general) and above vice admiral and below admiral of the fleet. It is usually abbreviated to \"Adm\" or \"ADM\". Where relevant, admiral has a NATO code of OF-9, and is a 4 star rank."@en ;
    skos:inScheme ns1:NavyServiceBranch ;
    org:rankEquivalentTo ns1:Rank_Air_marshal_EnglishTradition,
        ns1:Rank_General_officer_EnglishTradition ;
    org:rankJuniorToTransitive ns1:Rank_Admiral_of_the_fleet_EnglishTradition ;
    org:rankSeniorToTransitive ns1:Rank_Commodore_\(rank\)_EnglishTradition .

