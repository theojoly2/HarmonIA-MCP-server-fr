ns1:1AIFRankLieutenant a ns1:MilitaryRank,
        ns1:Soldier,
        skos:Concept ;
    rdfs:label "Lieutenant (1st AIF)"@en ;
    ns1:rankOf ns1:Infantry,
        <http://rdf.muninn-project.org/ww1/1stAIF> ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:subClassOf ns1:Rank_Lieutenant_EnglishTradition ;
    skos:definition "A Lieutenant was a rank in the 1st Australian Imperial Force." ;
    foaf:name "Lieutenant"@en .

ns1:AirForceCommand a owl:Class,
        skos:Concept ;
    rdfs:label "Command (Air Force)"@en,
        ""@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    skos:definition "An air force command. eg: Bomber Command."@en ;
    org:hasUnit ns1:TacticalAirForce ;
    org:unitOf ns1:AirForceServiceBranch .

ns1:ArmyCompany a owl:Class,
        skos:Concept ;
    rdfs:label "Company (Military Unit)"@en,
        "Compagnie (militaire)"@fr ;
    ns1:nominalSize "100" ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Company_(military_unit)> ;
    skos:definition "A military company"@en ;
    org:hasUnit ns1:Platoon ;
    org:unitOf ns1:ArmyServiceBranch,
        ns1:Battalion ;
    foaf:logo <http://rdf.muninn-project.org/ww1/2011/11/11/Image/86f5d79432849d7059da6460a74ba7fe> .

ns1:ArmyFront a owl:Class,
        skos:Concept ;
    rdfs:label "Front (military formation)"@en,
        "Front (unité soviétique)"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Front_(military_formation)> ;
    skos:definition "A front was a major military formation. Appearing to originate with the Russian Empire, it has been used by the Polish Army, the Red Army and Soviet Army, and by Turkey. It was roughly equivalent to an army group in the militaries of most other countries. It should not to be confused with the more general usage of military front, describing a geographic area in wartime."@en ;
    org:hasUnit ns1:FieldArmy ;
    org:unitOf ns1:ArmyServiceBranch ;
    foaf:name "Front" .

ns1:ArmyGroup a owl:Class,
