        skos:Concept ;
    rdfs:label "Tactical Air Force"@en,
        "Force Aérienne Tactique "@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Tactical Air Force."@en ;
    org:hasUnit ns1:AirForceGroup ;
    org:unitOf ns1:AirForceCommand,
        ns1:AirForceServiceBranch .

ns1:UnprivilegedCombatant a owl:Class,
        skos:Concept ;
    rdfs:label "Unprivileged Combatant"@en,
        "Combatant non-privilégié"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:subClassOf ns1:Combatant ;
    skos:definition "A person engaging in combat and/or war as an unprivileged combatants under the rules of war."@en ;
    foaf:name "Unprivileged Combatant" .

