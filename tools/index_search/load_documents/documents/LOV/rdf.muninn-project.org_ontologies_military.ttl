    org:rankSeniorToTransitive ns1:Rank_Wing_commander_\(rank\)_EnglishTradition .

ns1:Rank_Hetman a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Hetman"@en,
        "Hetman"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Hetman> ;
    skos:definition "Hetman was the title of the second-highest military commander in 15th- to 18th-century Poland and the Grand Duchy of Lithuania, which together, from 1569 to 1795, comprised the Polish-Lithuanian Commonwealth, or Rzeczpospolita. \"Hetman\" was also the highest military office, and head of state, in Ukraine's Cossack Hetmanate. The title (Ð³ÐµÑÑÐ¼Ð°Ð½) was used by Ukraine's Cossacks from the 16th century, and by the Czechs (hejtman) in Bohemia from the Hussite Wars (15th century) on."@en ;
    foaf:name "Hetman" .

ns1:Rank_Kolonel a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Kolonel"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Kolonel> ;
    skos:definition "Kolonel is a rank of the Belgium, Malaysia, Estonia and Netherlands which corresponds to the rank of Colonel in other countries."@en ;
    foaf:name "Kolonel" .

