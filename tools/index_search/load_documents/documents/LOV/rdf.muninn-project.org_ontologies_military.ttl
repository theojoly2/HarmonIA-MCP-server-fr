ns1:AirForceGroup a owl:Class,
        skos:Concept ;
    rdfs:label "Group (military aviation unit)"@en,
        "Groupe (Force Aérienne)"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Group_(military_aviation_unit)> ;
    skos:definition "A group is a military aviation unit, a component of military organization and a military formation. Usage of the terms group and wing differ from one country to another, as well as different branches of a defence force, in some cases. Groups therefore vary considerably in size. In most air services and most countries, a group is made up of two to four squadrons and is commanded by a Lieutenant Colonel, Commander or similar ranks."@en ;
    org:hasUnit ns1:AirForceSquadron ;
    org:unitOf ns1:AirForceServiceBranch,
        ns1:TacticalAirForce ;
    foaf:name "Group" .

ns1:AirForceSquadron a owl:Class,
        skos:Concept ;
    rdfs:label "Squadron (aviation)"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Squadron_(aviation)> ;
    owl:subClass ns1:Squadron ;
    skos:definition "A squadron in air force, army aviation or naval aviation is mainly a unit comprising a number of military aircraft, usually of the same type, typically with 12 to 24 aircraft, sometimes divided into three or four flights, depending on aircraft type and air force. In most air forces, two or more squadrons form a group or wing. Some air forces also use the term squadrons for non-flying ground units. An escadron is the equivalent unit in France's Armée de l'Air."@en ;
    org:hasUnit ns1:MilitaryFlightUnit ;
    org:unitOf ns1:AirForceWing ;
    foaf:name "Squadron" .

