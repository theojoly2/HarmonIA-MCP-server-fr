    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Drum_Major_General> ;
    skos:definition "[edit] Overview The Drum Major General was a royal appointment in the British Army used from the mid-17th century and into the 18th century. Under this appointment, all training and licensing of military drummers took place."@en ;
    foaf:name "Drum Major General" .

