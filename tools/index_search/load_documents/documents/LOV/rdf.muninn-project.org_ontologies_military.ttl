    owl:sameAs <http://dbpedia.org/resource/Chief_petty_officer> ;
    foaf:name "Chief petty officer" .

ns1:Rank_Chorbaji a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "ÃorbacÄ±"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/%C3%87orbac%C4%B1> ;
    skos:definition "ÃorbacÄ± (sometimes variously transliterated as chorbaji, chorbadzhi, tschorbadji) was a military rank of the corps of Janissaries in the Ottoman Empire, used for the commander of an orta, i.e. , approximately corresponding to the rank of colonel. The word is pronounced tÊoÉ¾baËdÊÉ¯ in Turkish and literally means \"soup server\", derived from Ã§orba, \"soup\". However, this word could be connected to an old Turkic word korbashi (head of the unit/campfire)."@en ;
    foaf:name "ÃorbacÄ±" .

ns1:Rank_Ferik a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Ferik (rank)"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Ferik_%28rank%29> ;
    skos:definition "Ferik was a military rank of the Ottoman Army. It is translated as Major General or Lieutenant General (Korgeneral). It was superior to a Mirliva (\"Brigadier\") and junior to a Birinci Ferik (\"First Ferik/General\"). The title of Ferik was abolished with Act No. 2590 of 26 November 1934 on the Abolition of Titles and Appellations such as Efendi, Bey or Pasha."@en ;
    foaf:name "Ferik" .

ns1:Rank_Field_marshal_EnglishTradition a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Field marshal"@en ;
    ns1:rankOf ns1:EnglishTradition ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Field_marshal> ;
    skos:inScheme ns1:ArmyServiceBranch ;
    org:rankEquivalentTo ns1:Rank_Admiral_of_the_fleet_EnglishTradition,
        ns1:Rank_Marshal_of_the_air_force_EnglishTradition ;
    org:rankSeniorToTransitive ns1:Rank_General_officer_EnglishTradition .

ns1:Rank_Fleet_Board a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Fleet Board"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Fleet_Board> ;
    skos:definition "Fleet Board is a term in the Royal Navy for the examination cadet officers take which qualifies them to become commissioned officers. After passing the examination, officers who entered as sub-lieutenants have their commissions backdated to the date when they entered the Royal Navy. Midshipmen are also considered commissioned officers at this point, but are not immediately promoted to sub-lieutenant."@en ;
    foaf:name "Fleet Board" .

ns1:Rank_Garrison_Sergeant_Major a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Garrison Sergeant Major"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Garrison_Sergeant_Major> ;
    skos:definition "A Garrison Sergeant Major (GSM) in the British Army is the senior warrant officer of a garrison and holds the rank of Warrant Officer Class 1. The GSM London District, always a guardsman, holds one of the four most senior WO1 appointments in the British Army, and has military ceremonial responsibility for important state occasions such as Trooping the Colour."@en ;
    foaf:name "Garrison Sergeant Major" .

ns1:Rank_Gefreiter a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Gefreiter"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Gefreiter> ;
    skos:definition "Gefreiter is the German, Swiss and Austrian equivalent for the military rank Private (NATO Rank Code OR-2). Gefreiter was the lowest rank to which an ordinary soldier could be promoted. As a military rank it has existed since at least the 16th century. From the 1920s on Gefreiter has expanded into several additional ranks, those being Obergefreiter, Hauptgefreiter, Stabsgefreiter and Oberstabsgefreiter (NATO Rank Code OR-3 and OR-4). Gefreiter means \"the exempted\"."@en ;
    foaf:name "Gefreiter" .

ns1:Rank_General_Admiral a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "General Admiral"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/General_Admiral> ;
    skos:definition "General Admiral was a Danish, Dutch, German, Russian, Portuguese, Spanish and Swedish naval rank. Its historic origin is a title high military or naval dignitaries of early modern Europe sometimes held, for example the (nominal) Commander-in-Chief of the Dutch Republic's navy."@en ;
    foaf:name "General Admiral" .

ns1:Rank_Kapudan_Pasha a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Kapudan Pasha"@en,
        "Capitan pacha"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Kapudan_Pasha> ;
    skos:definition "Kapudan Pasha or Kapudan-i Derya were the titles given to the chief commander of the navy in the Ottoman Empire. The title Kapudan-i Derya was first granted during the reign of Bayezid I as an official rank within the state structure. Starting with the reign of Mehmed II, holders of the rank were accorded the status of viziers and held the title of Pasha, thus they were more often called Kapudan Pasha."@en ;
    foaf:name "Kapudan Pasha" .

ns1:Rank_Kolagasi a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "KolaÄasÄ±"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Kola%C4%9Fas%C4%B1> ;
    skos:definition "KolaÄasÄ± (also written as Kol AÄsÄ±, Kol Aghasi) was a military rank of the Ottoman Army. It corresponds to a Senior Captain or an Adjutant Major. Kol AÄasÄ± is a compound word composed of Kol and AÄa. The rank was junior to the BinbaÅÄ± (Major) and superior to the YÃ¼zbaÅÄ± (Captain). The rank of Kol AÄasÄ± was changed to ÃnyÃ¼zbaÅÄ± in Republican period."@en ;
    foaf:name "KolaÄasÄ±" .

ns1:Rank_Lance-corporal_of_horse a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Lance Corporal of Horse"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Lance-corporal_of_horse> ;
    skos:inScheme ns1:HouseholdCavalry ;
    foaf:name "Lance Corporal of Horse" .

ns1:Rank_Leading_aircraftman a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Leading aircraftman"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Leading_aircraftman> ;
    foaf:name "Leading aircraftman" .

ns1:Rank_Leading_seaman_EnglishTradition a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Leading seaman"@en ;
    ns1:rankOf ns1:EnglishTradition ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Leading_seaman> ;
    skos:inScheme ns1:NavyServiceBranch ;
    org:rankEquivalentTo ns1:Rank_Corporal_EnglishTradition ;
    org:rankJuniorToTransitive ns1:Rank_Petty_officer_EnglishTradition ;
    org:rankSeniorToTransitive ns1:Rank_Seaman_EnglishTradition .

ns1:Rank_Lord_High_Admiral_of_the_Wash a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Lord High Admiral of the Wash"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Lord_High_Admiral_of_the_Wash> ;
    skos:definition "The position of Lord High Admiral of the Wash is an ancient hereditary naval office of England. In mediaeval times, the Lord High Admiral of the Wash was a nobleman with responsibility for the defence and protection of The Wash coast in north East Anglia. The post was granted to the le Strange family after the Norman Conquest. In the 16th century the post became obsolete and the Royal Navy took over the defence of the area."@en ;
    foaf:name "Lord High Admiral of the Wash" .

ns1:Rank_Midshipman_EnglishTradition a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Midshipman"@en ;
    ns1:rankOf ns1:EnglishTradition ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Midshipman> ;
    skos:definition "A midshipman is an officer cadet, or a commissioned officer of the lowest rank, in the Royal Navy, United States Navy, and many Commonwealth navies. Commonwealth countries which use the rank include Australia, New Zealand, South Africa, Pakistan, India, Singapore, Sri Lanka and Kenya. The rank was also used, prior to 1968, by the Royal Canadian Navy, but upon the creation of the Canadian Forces the rank of midshipman was replaced with the rank of naval cadet."@en ;
    skos:inScheme ns1:NavyServiceBranch ;
    org:rankEquivalentTo ns1:Rank_Officer_cadet_EnglishTradition ;
    org:rankJuniorToTransitive ns1:Rank_Ensign_\(rank\)_EnglishTradition ;
    org:rankSeniorToTransitive ns1:Rank_Warrant_officer_EnglishTradition .

ns1:Rank_Mirliva a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Mirliva"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Mirliva> ;
    skos:definition "Mirliva or Mîr-i livâ was a military rank of the Ottoman Army. It corresponds to a Brigadier General or Major General (Tümgeneral). Mirliva is a compound word composed of Mir and Liva. The rank was junior to the Ferik and superior to the Miralay (Colonel). The title of Mirliva was abolished with Act No. 2590 of 26 November 1934 on the Abolition of Titles and Appellations such as Efendi, Bey or Pasha."@en ;
    foaf:name "Mirliva" .

ns1:Rank_Musir a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "MÃ¼Åir"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/M%C3%BC%C5%9Fir> ;
    foaf:name "MÃ¼Åir" .

ns1:Rank_Ordinary_seaman_rating a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Ordinary Seaman"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Ordinary_seaman_%28rating%29> ;
    skos:inScheme ns1:NavyServiceBranch ;
    foaf:name "Ordinary Seaman" .

ns1:Rank_Poruchik a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Poruchik"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Poruchik> ;
    skos:definition "Poruchik was a military rank in several Slavic countries, such as the Russian Empire and the Republic of Poland, equivalent to Lieutenant. \"Poruchik\" means \"messenger\", \"officer for orders\". This is a Slavic (Czech) copy of the term \"Lieutenant\" (locum tenens). In Russia this rank was first introduced in Strelets New Regiments, the rank legalised by the Table of Ranks. A podporuchik is simply a Sub-Poruchik."@en ;
    foaf:name "Poruchik" .

ns1:Rank_Schout-bij-nacht a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Schout-bij-nacht"@en,
        "Schout-bij-nacht"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Schout-bij-nacht> ;
    skos:definition "Schout-bij-nacht is a Dutch Naval rank, equivalent to Rear Admiral in the US Navy and Royal Navy. It is the second most junior Admiral position of the Dutch Navy, ranking above Commandeur and below a Vice-admiraal. The rank of Schout-bij-nacht originated between the 15th and 16th century. Translated as Watch-at-night, the Schout-bij-Nacht was the officer who supervised the ship when the Captain was asleep."@en ;
    foaf:name "Schout-bij-nacht" .

ns1:Rank_Seaman_EnglishTradition a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Seaman"@en,
        "Matelot"@fr ;
    ns1:rankOf ns1:EnglishTradition ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Seaman> ;
    skos:definition "Seaman is one of the lowest ranks in a Navy. In the Commonwealth it is the lowest rank in the Navy, followed by Able Seaman and Leading Seaman, and followed by the Petty Officer ranks. In the United States, it means the lowest three enlisted rates of the U.S. Navy, followed by the higher Petty Officer ranks. The equivalent of the seaman, in French-speaking countries, is the Matelot."@en ;
    skos:inScheme ns1:NavyServiceBranch ;
    org:rankEquivalentTo ns1:Rank_Aircraftman_EnglishTradition,
        ns1:Rank_Private_EnglishTradition ;
    org:rankJuniorToTransitive ns1:Rank_Leading_seaman_EnglishTradition .

ns1:Rank_Second_Corporal a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Second Corporal"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Second_Corporal> ;
    skos:definition "Second Corporal was a rank in the Royal Engineers and Army Ordnance Corps of the British Army. Second Corporals wore one rank chevron, but unlike Lance-Corporals they held full non-commissioned officer rank. They were thus equivalent to Bombardiers in the Royal Artillery. The rank was abolished in 1920."@en ;
    foaf:name "Second Corporal" .

ns1:Rank_Sergeant_Major_Instructor a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Sergeant Major Instructor"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Sergeant_Major_Instructor> ;
    skos:definition "Sergeant Major Instructor (SMI) is a British Army appointment held by Warrant Officers Class 1 in the Small Arms School Corps and the Army Physical Training Corps and by some WO1s in the Royal Engineers."@en ;
    foaf:name "Sergeant Major Instructor" .

ns1:Rank_Sergeant_major_EnglishTradition a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Sergeant major"@en ;
    ns1:rankOf ns1:EnglishTradition ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Sergeant_major> ;
    skos:inScheme ns1:ArmyServiceBranch ;
    org:rankEquivalentTo ns1:Rank_Warrant_officer_EnglishTradition ;
    org:rankJuniorToTransitive ns1:Rank_Officer_cadet_EnglishTradition ;
    org:rankSeniorToTransitive ns1:Rank_Sergeant_EnglishTradition .

ns1:Rank_Sotnik a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Sotnik"@en,
        "Sotnik"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Sotnik> ;
    skos:definition "Sotnik or Sotnyk was a military rank among the Cossack starshyna (officers), Strelets Troops (17th century) in Muscovy and Imperial Cossack cavalry (since 1826), the Ukrainian Insurgent Army, the Ukrainian Galician Army, and the Ukrainian People's Army."@en ;
    foaf:name "Sotnik" .

ns1:Rank_Stabskapitan a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Stabskapitän"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Stabskapit%C3%A4n> ;
    skos:definition "Stabskapitän (staff captain) is a historic military rank, used in the Prussian and Russian armies. It ranked between the Premierleutnant and Hauptmann/Rittmeister in the Prussian army, and between lieutenant and captain in the Russian army."@en ;
    foaf:name "Stabskapitän" .

ns1:Rank_Staff_Corporal a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Staff Corporal"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Staff_Corporal> ;
    skos:definition "Staff Corporal (SCpl or S/Cpl) is the equivalent rank to Staff Sergeant in the Household Cavalry, ranking between Corporal of Horse and Warrant Officer Class 2. He may hold an appointment such as Squadron Quartermaster Corporal. A Staff Corporal wears four point-up rank chevrons on his cuff, surmounted by a crown."@en ;
    foaf:name "Staff Corporal" .

ns1:Rank_Staff_Sergeant_Major a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Staff Sergeant Major"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Staff_Sergeant_Major> ;
    foaf:name "Staff Sergeant Major" .

ns1:Rank_Starshina a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Starshina"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Starshina> ;
    skos:definition "Starshina, or Starshyna, initially was a Cossacks officership, but in Soviet times was used as the top non-commissioned officer. Among Cossacks and in Ukraine, starshina was a collective noun for categories of officership or a military elite: junior starshina (ÐÐ¾Ð»Ð¾Ð´ÑÐ° ÑÑÐ°ÑÑÐ¸Ð½Ð°), general starshina (ÐÐµÐ½ÐµÑÐ°Ð»ÑÐ½Ð° ÑÑÐ°ÑÑÐ¸Ð½Ð°), military starshina (ÐÑÐ¹ÑÑÐºÐ¾Ð²Ð° ÑÑÐ°ÑÑÐ¸Ð½Ð°), substarshina (ÐÑÐ´ÑÑÐ°ÑÑÐ¸Ð½Ð°)."@en ;
    foaf:name "Starshina" .

ns1:Rank_Stratarches a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Stratarches"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Stratarches> ;
    skos:definition "Stratarches, means \"master/ruler of the army\" in Greek, and is a title associated with successful generals. In modern Greek usage, it corresponds to the rank of Field Marshal."@en ;
    foaf:name "Stratarches" .

ns1:Rank_Subaltern a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Subaltern"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Subaltern> ;
    skos:definition "A subaltern is a chiefly British military term for a junior officer. Literally meaning \"subordinate,\" subaltern is used to describe commissioned officers below the rank of captain and generally comprises the various grades of lieutenant. In the British Army the senior subaltern rank was captain-lieutenant, obsolete since the 18th century."@en ;
    foaf:name "Subaltern" .

ns1:Rank_Vice-Admiral_of_the_Coast a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Vice-Admiral of the Coast"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Vice-Admiral_of_the_Coast> ;
    skos:definition "The holder of the post Vice-Admiral of the Coast was responsible for the defence of one of the twenty maritime counties of England, the North and South of Wales, or the four provinces of Ireland. As a Vice-Admiral, the post holder was the chief of naval administration for his district. His responsibilities included pressing men for naval service, deciding the lawfulness of prizes (captured by pirate ships), dealing with salvage claims for wrecks and acting as a judge."@en ;
    foaf:name "Vice-Admiral of the Coast" .

ns1:Rank_Vice-Admiral_of_the_West a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Vice-Admiral of the West"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Vice-Admiral_of_the_West> ;
    skos:definition "The historical title Vice-Admiral of the West is sometimes applied to holders of the crown appointment Vice-Admiral of the Coast of counties in the South West of England. The duties of a Vice-Admiral of the coast were to control the shipping (especially piracy) around a maritime county's coast and organise defense on land and at sea. He also acted as a local judge to deal with maritime matters."@en ;
    foaf:name "Vice-Admiral of the West" .

ns1:Rank_Wachtmeister a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Wachtmeister"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Wachtmeister> ;
    skos:definition "Wachtmeister (German for master-sentinel; watch-master) was a German, Austrian and Swiss military rank of non-commissioned officers. It was also adopted into Russian Army vakhmistr and was used as Sergeant-grade rank in cavalry (until 1826), then Special Corps of Gendarmes and Cossack cavalry and Cossack Leib Guard units. Also, the Polish army used the rank Wachmistrz as a cavalry-specific title for Sergeant. This was similar to calling cavalry Captains Rittmeister."@en ;
    foaf:name "Wachtmeister" .

