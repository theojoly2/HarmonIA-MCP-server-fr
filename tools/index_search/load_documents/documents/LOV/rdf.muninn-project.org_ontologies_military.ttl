ns1:Rank_Brigadier_EnglishTradition a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Brigadier"@en,
        "Brigadier"@fr ;
    ns1:rankOf ns1:EnglishTradition ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Brigadier> ;
    skos:definition "Brigadier is a senior military rank, the meaning of which is somewhat different in different military services. The brigadier rank is generally superior to the rank of colonel, and subordinate to major general. A brigadier typically commands a brigade consisting of three battalions (approximately 3,000 troops). Many countries use the rank Brigadier General rather than Brigadier, and prior to the 1920s, so did members of the Commonwealth."@en ;
    skos:inScheme ns1:ArmyServiceBranch ;
    org:rankEquivalentTo ns1:Rank_Air_commodore_EnglishTradition,
        ns1:Rank_Commodore_\(rank\)_EnglishTradition ;
    org:rankJuniorToTransitive ns1:Rank_General_officer_EnglishTradition ;
    org:rankSeniorToTransitive ns1:Rank_Colonel_EnglishTradition .

