    rdfs:label "Warrant officer"@en ;
    ns1:rankOf ns1:EnglishTradition ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Warrant_officer> ;
    skos:inScheme ns1:AirForceServiceBranch,
        ns1:NavyServiceBranch ;
    org:rankEquivalentTo ns1:Rank_Sergeant_major_EnglishTradition,
        ns1:Rank_Warrant_officer_EnglishTradition ;
    org:rankJuniorToTransitive ns1:Rank_Midshipman_EnglishTradition,
        ns1:Rank_Officer_cadet_EnglishTradition ;
    org:rankSeniorToTransitive ns1:Rank_Petty_officer_EnglishTradition,
        ns1:Rank_Sergeant_EnglishTradition .

