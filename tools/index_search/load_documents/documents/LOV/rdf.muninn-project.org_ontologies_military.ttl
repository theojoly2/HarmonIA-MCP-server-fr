ns1:Rank_Lochagos a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Lochagos"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Lochagos> ;
    skos:definition "Lochagos is used in the Greek language to mean \"Captain\". More precisely, it means \"leader of a lochos\"."@en ;
    foaf:name "Lochagos" .

ns1:Rank_Major_EnglishTradition a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Major"@en,
        "Major"@fr ;
    ns1:rankOf ns1:EnglishTradition ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Major> ;
    skos:definition "Major is a rank of commissioned officer, with corresponding ranks existing in almost every military in the world. When used unhyphenated, in conjunction with no other indicator of rank, the term refers to the rank just senior to that of an Army captain and just below the rank of lieutenant colonel. It is considered the most junior of the field ranks. In some militaries, notably France, the rank is referred to as commandant, while in others it is known as \"captain-major\"."@en ;
    skos:inScheme ns1:ArmyServiceBranch ;
    org:rankEquivalentTo ns1:Rank_Lieutenant_commander_EnglishTradition,
        ns1:Rank_Squadron_leader_EnglishTradition ;
    org:rankJuniorToTransitive ns1:Rank_Lieutenant_colonel_EnglishTradition .

ns1:Rank_Marshal_of_the_air_force_EnglishTradition a ns1:MilitaryRank,
