ns1:Rank_Marshal_of_the_Soviet_Union a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Marshal of the Soviet Union"@en,
        "Maréchal de l'Union soviétique"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Marshal_of_the_Soviet_Union> ;
    skos:definition "Marshal of the Soviet Union was the de facto highest military rank of the Soviet Union. (The highest rank de jure, Generalissimus of the Soviet Union, was created for Joseph Stalin and held by him alone). The rank of Marshal of the Soviet Union was created in 1935 and abolished in 1991. Forty-one people held the rank of Marshal of the Soviet Union. The equivalent naval rank was Admiral of the Fleet of the Soviet Union."@en ;
    foaf:name "Marshal of the Soviet Union" .

