ns1:AirForceWing a owl:Class,
        skos:Concept ;
    rdfs:label "Wing (military aviation unit)"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Wing_(military_aviation_unit)> ;
    skos:definition "Wing is a term used by different military aviation forces for a unit of command. The terms wing, group or Staffel are used for different-sized units from one country or service to another. In some military aviation services, a wing is a relatively large formation of two or more groups, which in turn control two or more squadrons. In other contexts a wing is a smaller unit, comprising two to four squadrons, with several wings forming a group."@en ;
    org:hasUnit ns1:AirForceSquadron ;
    org:unitOf ns1:AirForceGroup ;
    foaf:name "Wing" .

ns1:CarrierBattleGroup a owl:Class,
        skos:Concept ;
    rdfs:label "Carrier battle group"@en,
        "Groupe aéronaval"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Carrier_battle_group> ;
    skos:definition "A carrier battle group (CVBG) consists of an aircraft carrier (designated CV) and its escorts, together comprising the group. The first naval task forces built around carriers appeared just prior to and during World War II. The Imperial Japanese Navy was the first to assemble a large number of carriers into a single task force, known as Kido Butai. This task force was used with devastating effect during the Pearl Harbor Attack."@en ;
    skos:inScheme ns1:NavyServiceBranch ;
    org:hasUnit ns1:Flotilla ;
    org:unitOf ns1:NavalTaskForce ;
    foaf:name "Carrier battle group" .

ns1:Corps a owl:Class,
        skos:Concept ;
    rdfs:label "Corps"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:oneOf ns1:Corps_list ;
    owl:sameAs <http://dbpedia.org/resource/Corps>,
        <http://ldf.fi/ww1lod/schema#ArmyCorps> ;
    skos:definition "A disambiguation term for a military Corps."@en ;
    skos:narrower ns1:CorpsFormation,
        ns1:CorpsUnit .

ns1:FightsPrimarilyInAir a ns1:BattleSpace,
        skos:Concept ;
    rdfs:label "Air (Battleground)"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Fights primarily in Air."@en .

ns1:Flotilla a owl:Class,
        skos:Concept ;
    rdfs:label "Flotilla"@en,
        "Flottille"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Flotilla> ;
    skos:definition "A flotilla (from Spanish, meaning a small flota of ships, and this from French flotte), or naval flotilla, is a formation of small warships that may be part of a larger fleet. A flotilla is usually composed of a homogeneous group of the same class of warship, such as frigates, destroyers, torpedo boats, submarines, gunboats, or minesweepers."@en ;
    skos:inScheme ns1:NavyServiceBranch ;
    org:hasUnit ns1:NavalSquadron ;
    org:unitOf ns1:CarrierBattleGroup ;
    foaf:name "Flotilla" .

ns1:MilitaryFlightUnit a owl:Class,
        skos:Concept ;
    rdfs:label "Flight (military unit)"@en,
        "Escadrille"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Flight_(military_unit)> ;
    skos:definition "A flight is a military unit in an air force, naval air service, or army air corps. It usually comprises three to six aircraft, with their aircrews and ground staff; or, in the case of a non-flying ground flight, no aircraft and a roughly equivalent number of support personnel. In most usages, multiple flights make up a squadron. The \"flight\" is also a basic unit for intercontinental ballistic missiles."@en ;
    org:unitOf ns1:AirForceSquadron ;
    foaf:name "Flight (military unit)" .

ns1:NavalFleet a owl:Class,
        skos:Concept ;
    rdfs:label "Naval fleet"@en,
        "Flotte"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Naval_fleet> ;
    skos:definition "A fleet, or naval fleet, is a large formation of warships, and the largest formation in any navy. A fleet at sea is the direct equivalent of an army on land. Fleets are usually, but not necessarily, permanent formations and are generally assigned to a particular ocean or sea. Most fleets are named after that ocean or sea, but the convention in the United States Navy is to use numbers."@en ;
    skos:inScheme ns1:NavyServiceBranch ;
    org:hasUnit ns1:NavalTaskForce ;
    org:unitOf ns1:NavyBigFleet ;
    foaf:name "Naval fleet" .

ns1:NavalSquadron a owl:Class,
        skos:Concept ;
    rdfs:label "Squadron (naval)"@en,
        "Escadre"@fr ;
    ns1:nominalSize "4" ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Squadron_(naval)> ;
    owl:subClass ns1:Navy,
        ns1:Squadron ;
    skos:definition "A squadron, or naval squadron, is a unit of 3-4 major warships, transport ships, submarines, or sometimes small craft that may be part of a larger task force or a fleet. A squadron is usually composed of a homogeneous group of the same classification of ships, such as battleships, battlecruisers, cruisers, destroyers or frigates, or of various types tasked with a specific mission such as coastal patrol, blockade, or minesweeping. Smaller warships are usually grouped in flotillas."@en ;
    skos:inScheme ns1:NavyServiceBranch ;
    org:hasUnit ns1:DivisionNavalEstablishment ;
    org:unitOf ns1:Flotilla ;
    foaf:name "Squadron" .

ns1:NavalTaskForce a owl:Class,
        skos:Concept ;
    rdfs:label "Task Force (Naval)"@en,
        "Force opérationnelle (Marine)"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:differentFrom <http://dbpedia.org/resource/Task_force> ;
    skos:inScheme ns1:NavyServiceBranch ;
    org:hasUnit ns1:CarrierBattleGroup ;
    org:unitOf ns1:NavalFleet .

ns1:PrivilegedCombatant a owl:Class,
        skos:Concept ;
    rdfs:label "Privileged Combatant"@en,
        "Combatant privilégié"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:disjointWith ns1:UnprivilegedCombatant ;
    owl:subClassOf ns1:Combatant ;
    skos:definition "A person engaging in combat and/or war as a privileged combatants under the rules of war, circa Great War."@en ;
    foaf:name "Privileged Combatant" .

ns1:RankCaptainNaval a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Captain (naval)"@en,
        "Capitaine de vaisseau"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Captain_%28naval%29> ;
    skos:definition "Captain is the name most often given in English-speaking navies to the rank corresponding to command of the largest ships. The NATO rank code is OF-5, equivalent to an army full colonel. The equivalent rank in some navies translates as \"ship captain\" (e.g. French - capitaine de vaisseau), \"captain of sea and war\" (Portuguese capitÃ£o de mar e guerra), \"captain at sea\" (e.g. German KapitÃ¤n zur See) or \"captain of the first rank\" (Russian - ÐºÐ°Ð¿Ð¸ÑÐ°Ð½ 1-Ð³Ð¾ ÑÐ°Ð½Ð³Ð°)."@en ;
    foaf:name "Captain" .

ns1:RankCombatMilitaryRank a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Combat (military rank)"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Combat_%28military_rank%29> ;
    skos:definition "Combat or Kombat, abbreviated from ÐÐ¾Ð¼Ð°Ð½Ð´Ð¸Ñ Ð±Ð°ÑÐ°Ð»ÑÐ¾Ð½Ð° (\"Commander of a battalion\") was a military rank in the Red Army until the end of the 1930s. At that time it was roughly equivalent to the rank of Captain."@en ;
    foaf:name "Combat" .

ns1:RankCommandant a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Commandant (rank)"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Commandant_%28rank%29> ;
    skos:definition "Commandant is a military or police rank. In the French, Spanish and Irish armed forces it is a rank equivalent to major. In South Africa for most of the second half of the 20th century, commandant was a rank equivalent to lieutenant-colonel in other countries."@en ;
    foaf:name "Commandant" .

ns1:Rank_Admiral_of_the_Fleet_Russia a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Admiral of the Fleet (Russia)"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Admiral_of_the_Fleet_%28Russia%29> ;
    skos:definition "Admiral of the Fleet or Fleet Admiral (ÐÐ´Ð¼Ð¸ÑÐ°Ð» ÑÐ»oÑÐ°, Admiral flota) is the highest naval (deck) rank of the Russian Federation. It is the equivalent of the Soviet naval rank of Admiral of the Fleet and the present Russian rank of General of the Army. The rank is roughly equivalent to 4-stars Admiral ranks of other nations. There is only one rank higher than that of Admiral of the Fleet in the Russian armed forces, namely Marshal of the Russian Federation."@en ;
    foaf:name "Admiral of the Fleet" .

ns1:Rank_Anthypolochagos a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Anthypolochagos"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Anthypolochagos> ;
    skos:definition "Anthypolochagos is used in the Greek language to mean \"Second Lieutenant\". In the modern Hellenic Army the rank is the lowest commissioned officer rank and is inferior to an Ypolochagos. The insignia consists of a single silver star (or a star and a bar for reserve officers). Officers holding this rank should be addressed as \"Kyrie Anthypolochage\" (ÎÏÏÎ¹Îµ ÎÎ½Î¸ÏÏÎ¿Î»Î¿ÏÎ±Î³Î­) by their subordinates, or \"Anthypolochage + family name\" by their superior officers."@en ;
    foaf:name "Anthypolochagos" .

ns1:Rank_Antisyntagmatarchis a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Antisyntagmatarchis"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Antisyntagmatarchis> ;
    skos:definition "Antisyntagmatarchis is used in the Greek language to mean \"Lieutenant Colonel\". The typical responsibility of an Antisyntagmatarchis is to exercise command of a battalion. Officers holding this rank should be addressed as \"Kyrie Diikita\" (ÎÏÏÎ¹Îµ Î´Î¹Î¿Î¹ÎºÎ·ÏÎ¬) (stressed on the last syllable), by their subordinates when they exercise battalion command or \"Kyrie Antisyntagmatarcha\" (ÎÏÏÎ¹Îµ ÎÎ½ÏÎ¹ÏÏÎ½ÏÎ±Î³Î¼Î±ÏÎ¬ÏÏÎ±) (stressed on the syllable before last) in other cases."@en ;
    foaf:name "Antisyntagmatarchis" .

ns1:Rank_Army_General_Russia a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Army General (Russia)"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Army_General_%28Russia%29> ;
    skos:definition "Please see \"Army General\" for other nations which use this rank Army General is the second highest military rank in the Russian Federation, inferior only to a Marshal and superior to a Colonel General. It is a direct counterpart of the Soviet rank, General of the Army (USSR)."@en ;
    foaf:name "Army General" .

ns1:Rank_Aspirant a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Aspirant"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Aspirant> ;
    skos:definition "Aspirant is a military rank in the Canadian Navy, French military, Brazilian military, Romanian Navy and Polish Police."@en ;
    foaf:name "Aspirant" .

ns1:Rank_Bombardier a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Bombardier (rank)"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Bombardier_%28rank%29> ;
    skos:definition "Bombardier is a rank used in artillery units in the armies of Commonwealth countries instead of corporal. Lance-bombardier is used instead of lance-corporal. Bombardier (Bdr) and lance-bombardier (LBdr or L/Bdr) are used by the British Army in the Royal Artillery and Royal Horse Artillery. The same applies to the Royal Australian Artillery, the Royal New Zealand Artillery, the South African Army Artillery and the Armed Forces of Malta (AFM)."@en ;
    foaf:name "Bombardier" .

ns1:Rank_Brigade_General a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Brigade General"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Brigade_General> ;
    foaf:name "Brigade General" .

ns1:Rank_Buffer_Navy a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Buffer (navy)"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Buffer_%28navy%29> ;
    skos:definition "Buffer is the colloquial title for the senior seaman sailor in a Commonwealth of Nations Navy ship. The formal title is Chief Boatswain's Mate. This person is typically a Chief Petty Officer in frigates or destroyers, and in larger ships may be a Warrant Officer. In smaller ships, such as a patrol boat, the Buffer may be a Petty Officer."@en ;
    foaf:name "Buffer" .

ns1:Rank_Chief_Marshal a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Chief Marshal"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Chief_Marshal> ;
    skos:definition "The ranks of Marshal of a branch and Chief Marshal of a branch were senior military ranks of the Soviet Armed Forces. Immediately above the rank \"Marshal of a branch\" is the rank \"Chief Marshal of a branch\". Both ranks are immediately above the rank \"Colonel General\" and equal to Soviet General of the Army. The ranks were created as an analog to Air Marshal and Air Chief Marshal, though they weren't used just in the Soviet Air Force but also in the several Soviet Army's branch commands."@en ;
    foaf:name "Chief Marshal" .

ns1:Rank_Comandarm a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Comandarm"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Comandarm> ;
    skos:definition "Comandarm (also Komandarm, Commandarm, Russian \"ÐºÐ¾Ð¼Ð°Ð½Ð´Ð°ÑÐ¼\" - abbreviated \"ÐºÐ¾Ð¼Ð°Ð½Ð´ÑÑÑÐ¸Ð¹ Ð°ÑÐ¼Ð¸ÐµÐ¹\", Commander of the Army) was a military rank in the Red Army until the end of the 1930s. Comandarm 2nd rank, with the insignia of four rombs, is graded at 4 ranks above colonel. Comandarm 1st rank, with the insignia of four rombs and a star, is at 5 ranks above colonel."@en ;
    foaf:name "Comandarm" .

ns1:Rank_Combrig a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Combrig"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Combrig> ;
    skos:definition "Combrig was a military rank used in the Red Army for commanders of brigades between 1935 and 1940 (with some individuals still holding the rank in 1941). Kombrigs were senior to polkovniks (colonels) and junior to comdivs (commander of the division). When general ranks were reintroduced in July 1940 most kombrigs were transferred to the junior rank of polkovnik, while some received the rank of major general."@en ;
    foaf:name "Combrig" .

ns1:Rank_Comcor a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Comcor"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Comcor> ;
    skos:definition "Comcor (or Comkor, Komkor, abbreviated from Commander of the Corps) was a military rank in the Red Army until the end of the 1930"@en ;
    foaf:name "Comcor" .

ns1:Rank_Comdiv a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Comdiv"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Comdiv> ;
    skos:definition "Comdiv or Komdiv, abbreviated from (\"Commander of the division\") was a military rank in the Red Army until the end of the 1930s."@en ;
    foaf:name "Comdiv" .

ns1:Rank_Commandeur a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Commandeur"@en,
        "Commandeur"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Commandeur> ;
    skos:definition "Commandeur is a title in French and Dutch (also, now a purism, Kommandeur), usually rendered in English as Commander, with different uses. The literal meaning is he who commands, parallel to Commandant. In most senses the German equivalent is Kommandeur."@en ;
    foaf:name "Commandeur" .

ns1:Rank_Daejang a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Daejang"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Daejang> ;
    skos:definition "Daejang is a senior military rank of the Korean Peninsula, used by both North and South Korea. It is considered the combined equivalent of a General and Admiral in other nations. The rank of Daejang is sometimes spelled as Taejang, depending on the transliteration system used (Taejang in McCune-Reischauer, Daejang in official ROK transliteration system)."@en ;
    foaf:name "Daejang" .

ns1:Rank_Divisional_Admiral a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Divisional Admiral"@en,
        "Amiral de division"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Divisional_Admiral> ;
    skos:definition "Divisional Admiral or Division Admiral is a commissioned officer rank in several navies. It is a two-star flag rank, equivalent to the rank of Rear Admiral in the Royal Navy and the rank of Rear Admiral (Upper Half) in the United States Navy."@en ;
    foaf:name "Divisional Admiral" .

ns1:Rank_Divisional_General a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Divisional General"@en,
        "Général de division"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Divisional_General> ;
    skos:definition "Divisional General is a rank used in many armies to denote a rank of general, corresponding to command of a division. For convenience Divisional General is almost always translated into English as Major-General, the equivalent rank used by the UK, USA, etc. , although this translation is, strictly speaking, incorrect. The rank is particularly common in western Europe and Latin America."@en ;
    foaf:name "Divisional General" .

ns1:Rank_Epihipparch a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Epihipparch"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Epihipparch> ;
    skos:definition "Epihipparch is an Ancient Greek military title for a cavalry commander of 1,000 horse. This unit was divided into two hipparchiai of 500. Each of these was commanded by a hipparchos."@en ;
    foaf:name "Epihipparch" .

ns1:Rank_General-in-Chief a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "General-in-Chief"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/General-in-Chief> ;
    skos:definition "General-in-Chief has been a military rank or title in various armed forces around the world."@en ;
    foaf:name "General-in-Chief" .

ns1:Rank_Hasa a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Hasa (Korean military)"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Hasa_%28Korean_military%29> ;
    skos:definition "Hasa is a Korean military rank which is used in both the armed forces of North and South Korea. In both countries, the rank is considered the first non-commissioned officer grade and is generally considered the equivalent of a Corporal or Sergeant in western militaries."@en ;
    foaf:name "Hasa" .

ns1:Rank_Hipparchus_Cavalry a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Hipparchus (cavalry officer)"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Hipparchus_%28cavalry_officer%29> ;
    skos:definition "A Hipparchus or Hipparch was the title of an ancient Greek cavalry officer, commanding a hipparchia (unit of about 500 horsemen); two such units were commanded by an Epihipparchos."@en ;
    foaf:name "Hipparchus" .

ns1:Rank_Jungsa a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Jungsa"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Jungsa> ;
    skos:definition "Jungsa is a Korean military rank used by the armed forces of South and North Koreas. A Jungsa is the equivalent to a Sergeant First Class. The rank of Jungsa is junior to a Sangsa in North and South Korea."@en ;
    foaf:name "Jungsa" .

ns1:Rank_Jungwi a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Jungwi"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Jungwi> ;
    skos:definition "Chungwi (ì¤ì) is the second most junior Korean officer rank in both the militaries of North and South Korea. It is considered the equivalent of a First Lieutenant in most other militaries."@en ;
    foaf:name "Jungwi" .

ns1:Rank_Junior_sergeant a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Junior Sergeant"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Junior_sergeant> ;
    foaf:name "Junior Sergeant" .

ns1:Rank_Junjang a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Junjang"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Junjang> ;
    foaf:name "Junjang" .

ns1:Rank_Kindral a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Kindral"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Kindral> ;
    skos:definition "Kindral is the Estonian word for General which is also the highest military position in the Republic of Estonia. Both Ground Force and Air Force superior officers ranks share the same names which have been combined with the military rank of general and other senior officer ranks. There are four types of generals in the Estonia Defence Forces."@en ;
    foaf:name "Kindral" .

ns1:Rank_Major_general a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Major general"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Major_general> ;
    foaf:name "Major general" .

ns1:Rank_Marshal_EnglishTradition a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Marshal"@en,
        "Marshal"@fr,
        "Maréchal (armée)"@fr ;
    ns1:rankOf ns1:EnglishTradition ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Marshal> ;
    skos:definition "Marshal (also spelled marshall, more commonly in British English than American English), is a word used in several official titles of various branches of society. The word is an ancient loan word from Old (Norman) French, cf. modern French maréchal, which in turn is a borrowing from Old Frankish *marhskalk \"stable boy, keeper, servant\", still continued by Middle Dutch maerscalc, marscal \"id. \", modern Dutch maarschalk \"military commander\" (the meaning is under French influence)."@en ;
    skos:inScheme ns1:ArmyServiceBranch ;
    org:rankEquivalentTo ns1:Rank_Admiral_of_the_fleet_EnglishTradition,
        ns1:Rank_Marshal_of_the_air_force_EnglishTradition .

ns1:Rank_Master_warrant_officer a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Master Warrant Officer"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Master_warrant_officer> ;
    foaf:name "Master Warrant Officer" .

ns1:Rank_Obergefreiter a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Obergefreiter"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Obergefreiter> ;
    skos:definition "Obergefreiter is a rank of the German and Swiss militaries which dates from the 19th century. \\t \\t\\t \\t\\t\\t021-Obergefreiter. png \\t\\t\\t German Army rank insignia (shoulder tab) \\t\\t\\t \\t\\t \\t\\t \\t\\t\\t3 - ogefr. GIF \\t\\t\\t German Navy rank insignia (sleeve) \\t\\t\\t \\t\\t \\t The rank was only used in the German army's heavy artillery branch (Fußartillerie) before 1919 and commonly established with the founding of the Reichswehr."@en ;
    foaf:name "Obergefreiter" .

ns1:Rank_Podpraporshchik a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Podpraporshchik"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Podpraporshchik> ;
    skos:definition "Podpraporshchik (Sub-Praporshchik) was one of the non-commissioned ranks, originally below the Sergeant and Feldwebel but since 1826 it became the highest non-commissioned rank of the infantry, cavalry and Leib Guard. In 1884, the podpraporshchik rank was renamed Zauryad-praporshchik (Ordinary Praporshchik)."@en ;
    foaf:name "Podpraporshchik" .

ns1:Rank_Polemarch a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Polemarch"@en,
        "Polémarque"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Polemarch> ;
    skos:definition "A polemarch was a senior military title in various ancient Greek city states (poleis). The title is composed out of the polemos (war) and archon (ruler/leader) and translates as \"warleader\" or \"warlord\", one of the nine archontes (á¼ÏÏÎ¿Î½ÏÎµÏ) appointed annually in Athens. The name indicates that the polemarchos original function was to command the army; presumably the office was created to take over this function from the king."@en ;
    foaf:name "Polemarch" .

ns1:Rank_Praporshchik a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Praporshchik"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Praporshchik> ;
    skos:definition "Praporshchik is a rank in the Russian military."@en ;
    foaf:name "Praporshchik" .

ns1:Rank_Rear_admiral a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Rear admiral"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Rear_admiral> ;
    skos:definition "Rear admiral is a naval commissioned officer rank above that of a commodore and captain, and below that of a vice admiral. It is generally regarded as the lowest of the \"admiral\" ranks, which are also sometimes referred to as \"flag officers\" or \"flag ranks\". In many navies it is referred to as a two-star rank. It originated from the days of naval sailing squadrons and can trace its origins to the Royal Navy."@en ;
    foaf:name "Rear admiral" .

ns1:Rank_Sangsa a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Sangsa"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Sangsa> ;
    skos:definition "Sangsa is a Korean military rank used by both the armed forces of North and South Korea. A Sangsa is the equivalent to a First Sergeant in most other militaries. The rank of Sangsa is junior to a Wonsa in South Korea and to a Warrant Officer like rank in the North known as Teukmu Sangsa."@en ;
    foaf:name "Sangsa" .

ns1:Rank_Skeuophoros a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Skeuophoros"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Skeuophoros> ;
    skos:definition "A skeuophoros was a slave or servant who carried baggage in Ancient Greece. Herodotus records that every hoplite was followed on campaign by a servant as a skeuophoros. In Aristophanes' play The Frogs, Xanthias, the slave of Dionysus, acts as his skeuophoros: ÎÎ¹ÏÎ½ÏÏÎ¿Ï á¼´Î¸Î¹ Î½ÏÎ½ á¼ÏÎµÎ¹Î´á½´ Î»Î·Î¼Î±ÏÎ¯Î±Ï Îºá¼Î½Î´ÏÎµá¿Î¿Ï Îµá¼¶,Ïá½º Î¼á½²Î½ Î³ÎµÎ½Î¿á¿¦ 'Î³á½¼ Ïá½¸ á¿¥ÏÏÎ±Î»Î¿Î½ ÏÎ¿ÏÏá½¶ Î»Î±Î²á½¼Î½ÎºÎ±á½¶ Ïá½´Î½ Î»ÎµÎ¿Î½Ïá¿Î½, Îµá¼´ÏÎµÏ á¼ÏÎ¿Î²ÏÏÏÎ»Î±Î³ÏÎ½Î¿Ï Îµá¼¶:á¼Î³á½¼ Î´á¾½ á¼ÏÎ¿Î¼Î±Î¯ ÏÎ¿Î¹ ÏÎºÎµÏÎ¿ÏÏÏÎ¿Ï á¼Î½ Ïá¿· Î¼Î­ÏÎµÎ¹."@en ;
    foaf:name "Skeuophoros" .

ns1:Rank_Somatophylakes a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Somatophylakes"@en,
        "Sômatophylaques"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Somatophylakes> ;
    skos:definition "Somatophylakes, in its literal English translation from Greek, means \"bodyguards\". The most famous body of somatophylakes were those of Philip of Macedon and Alexander the Great. They consisted of seven men, drawn from the Macedonian nobility, who also acted as high-ranking military officers, holding command positions such as general or chiliarch. Alexander the Great appointed Peucestas as eighth somatophylax after the siege of Malli."@en ;
    foaf:name "Somatophylakes" .

ns1:Rank_Sowi a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Sowi"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Sowi> ;
    skos:definition "Sowi (ìì) is the junior most Korean officer rank in both the militaries of North and South Korea. It is considered the equivalent of a Second Lieutenant in most other militaries."@en ;
    foaf:name "Sowi" .

ns1:Rank_Staabikapten a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Staabikapten"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Staabikapten> ;
    skos:definition "A Staff-Captain (staabikapten in Estonian language), was an Estonian military rank in the Naval forces of Estonia, which existed between 1918 in 1922."@en ;
    foaf:name "Staabikapten" .

ns1:Rank_Tetrarch a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Tetrarch"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Tetrarch> ;
    foaf:name "Tetrarch" .

ns1:Rank_Trierarch a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Trierarch"@en,
        "Triérarchie"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Trierarch> ;
    skos:definition "Trierarch was the title of officers who commanded a trireme (triÄres) in the classical Greek world. In Athens and a few other states this officer was also required to pay for the outfitting and maintenance of the ship. Trierarchs thus had to be men of considerable means, since the expenses incurred could run as high as a talent in the course of a year."@en ;
    foaf:name "Trierarch" .

ns1:Rank_Tysyatsky a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Tysyatsky"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Tysyatsky> ;
    skos:definition "Tysyatsky was a military leader in Ancient Rus, who commanded a people's volunteer army called ÑÑÑÑÑÐ° (tysyacha, or a thousand). In the Novgorod Republic, the tysyatsky evolved into a judicial or commercial official and was elected from boyars at a veche for a period of one year posadnik."@en ;
    foaf:name "Tysyatsky" .

ns1:Rank_Vaapeli a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Vääpeli"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/V%C3%A4%C3%A4peli> ;
    foaf:name "Vääpeli" .

ns1:Rank_Veebel a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Veebel"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Veebel> ;
    skos:definition "Veebel is an Estonian military rank which has existed since the 20th century. The word veebel is usually, but incorrectly, translated in English as Sergeant. The correct equivalent is Warrant Officer."@en ;
    foaf:name "Veebel" .

ns1:Rank_Vice_admiral a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Vice admiral"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Vice_admiral> ;
    foaf:name "Vice admiral" .

ns1:Rank_Wojski a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Wojski"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Wojski> ;
    skos:definition "The Wojski was an officer in medieval Poland, responsible for the security of voivodships or districts at times when voivods and castellans had accompanied the szlachta (nobility) to war. With time, the wojski's responsibilities were take over by starostas, and \"wojski\" became an honorary district office in the Polish-Lithuanian Commonwealth."@en ;
    foaf:name "Wojski" .

ns1:Rank_Wonsu a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Wonsu"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Wonsu> ;
    skos:definition "Wonsu is a very high military rank of the armed forces of the Republic of Korea and of North Korea."@en ;
    foaf:name "Wonsu" .

ns1:Rank_Ypolochagos a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Ypolochagos"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Ypolochagos> ;
    skos:definition "Ypolochagos is used in the modern Greek language to mean \"First Lieutenant\". In the modern Hellenic Army the rank is superior to that of Anthypolochagos and inferior to that of an Lochagos. The insignia consists of two silver stars. Officers holding this rank should be addressed as \"Kyrie Ypolochage\" (ÎÏÏÎ¹Îµ Î¥ÏÎ¿Î»Î¿ÏÎ±Î³Î­) by their subordinates, or \"Ypolochage + family name\" by their superior officers."@en ;
    foaf:name "Ypolochagos" .

