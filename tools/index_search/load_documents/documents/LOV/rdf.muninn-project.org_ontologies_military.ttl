    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Under_Officer> ;
    skos:definition "\"Underofficer\" redirects here, although it can also mean non-commissioned officer when translated from certain other languages. Under Officer is an appointment held by senior cadets at some Commonwealth officer training establishments and in University Officers' Training Corps in the United Kingdom, and also a rank used in some Commonwealth cadet forces."@en ;
    foaf:name "Under Officer" .

<http://dbpedia.org/resource/Republic_of_Ireland> ns2:wikipedia_version "498350287" .

<http://dbpedia.org/resource/Singapore> ns2:wikipedia_version "498300526" .

