ns1:RankDriver a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Driver (rank)"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Driver_%28rank%29> ;
    skos:definition "Driver (Dvr) was a military rank used in the British Army and the armies of other Commonwealth countries. It was equivalent to the rank of Private. The rank was initially used in the Royal Artillery for the men who drove the teams of horses which pulled the guns. It was phased out after the First World War (when all Royal Artillerymen of the lowest rank were redesignated as Gunners). It was also used in the Royal Australian Artillery and Royal Canadian Artillery."@en ;
    foaf:name "Driver" .

ns1:Rank_Agha a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Agha (Ottoman Empire)"@en,
        "Agha"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Agha_%28Ottoman_Empire%29> ;
    skos:definition "For other uses of the term 'Aga', see Aga. For other uses of the term 'Agha', see Agha. Agha, also Aga, as a title for a civil or military officer, or often part of such title, was placed after the name of certain military functionaries in the Ottoman Empire. At the same time some court functionaries were entitled to the agha title."@en ;
    foaf:name "Agha" .

ns1:Rank_Air_chief_marshal a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Air chief marshal"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Air_chief_marshal> ;
    foaf:name "Air chief marshal" .

ns1:Rank_Air_vice-marshal a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Air vice-marshal"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Air_vice-marshal> ;
    foaf:name "Air vice-marshal" .

ns1:Rank_Aircraftman_EnglishTradition a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Aircraftman"@en ;
    ns1:rankOf ns1:EnglishTradition ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Aircraftman> ;
    skos:definition "Aircraftman (AC), or Aircraftwoman (ACW), is the lowest rank in the Royal Air Force and the air forces of several other Commonwealth countries. Aircraftman ranks below Leading Aircraftman and has a NATO rank code of OR-1. It is presently a training rank only and no airmen in productive service hold this rank. Aircraftman do not wear any rank insignia."@en ;
    skos:inScheme ns1:AirForceServiceBranch ;
    org:rankEquivalentTo ns1:Rank_Private_EnglishTradition,
        ns1:Rank_Seaman_EnglishTradition ;
    org:rankJuniorToTransitive ns1:Rank_Corporal_EnglishTradition .

ns1:Rank_Ataman a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Ataman"@en,
        "Ataman / Otaman"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Ataman> ;
    skos:definition "Ataman was a commander title of the Ukrainian People's Army, Cossack, and haidamak leaders, who were in essence the Cossacks. In the Russia Empire, the term was the official title of the supreme military commanders of the Cossack armies. It had a derogatory suggestion and was also used for the leader of a fisherman artel, a band of robbers or thieves, or leaders of the opposition forces."@en ;
    foaf:name "Ataman" .

ns1:Rank_Birinci_Ferik a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Birinci Ferik"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Birinci_Ferik> ;
    skos:definition "Birinci Ferik or Ferik-i evvel was a military rank of the Ottoman Army. It is translated as Lieutenant General or General (Orgeneral). The title means \"first Ferik\" and was superior to a Ferik and junior only to the MÃ¼Åir. The title of Birinci Ferik was abolished with Act No. 2590 of 26 November 1934 on the Abolition of Titles and Appellations such as Efendi, Bey or Pasha."@en ;
    foaf:name "Birinci Ferik" .

ns1:Rank_Bootsmann a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Bootsmann"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Bootsmann> ;
    skos:definition "Bootsmann was a highest-ranking Petty Officer position in German naval forces. A lower-ranking Bootsmann was called Bootsmannsmaat. These names were adopted for the Russian Navy as Ð±Ð¾ÑÐ¼Ð°Ð½ and Ð±Ð¾ÑÐ¼Ð°Ð½Ð¼Ð°Ñ by Peter the Great, among many other Prussian and Holland military ranks; they were initially treated as positions rather than ranks. The army and air force equivalent is a Feldwebel. In the modern German Navy, Bootsmann is a senior NCO rank."@en ;
    foaf:name "Bootsmann" .

ns1:Rank_Brigadier_general a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Brigadier general"@en ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Brigadier_general> ;
    foaf:name "Brigadier general" .

ns1:Rank_Captain_Lieutenant a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Captain Lieutenant"@en,
        "Capitaine-lieutenant"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Captain_Lieutenant> ;
    skos:definition "Captain Lieutenant or Captain-Lieutenant is a military rank, used in a number of different navies worldwide. It is generally equivalent to the Commonwealth or US rank of Lieutenant, and has the NATO rank code of OF-2, though this can vary."@en ;
    foaf:name "Captain Lieutenant" .

ns1:Rank_Captain_lieutenant a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Captain lieutenant"@en ;
    void:inDataset ns1:datasetdefinition ;
