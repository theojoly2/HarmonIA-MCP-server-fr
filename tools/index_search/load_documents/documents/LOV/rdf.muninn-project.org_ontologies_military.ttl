    rdfs:label "Army Group"@en,
        "Groupe d'Armée"@fr ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A field army containing Corps, Brigades, Divisions, etc..."@en ;
    org:hasUnit ns1:FieldArmy ;
    org:unitOf ns1:ArmyServiceBranch .

