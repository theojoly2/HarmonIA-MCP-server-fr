ns1:Rank_Colonel_EnglishTradition a ns1:MilitaryRank,
        skos:Concept ;
    rdfs:label "Colonel"@en,
        "Colonel"@fr ;
    ns1:rankOf ns1:EnglishTradition ;
    void:inDataset ns1:datasetdefinition ;
    rdfs:isDefinedBy onto: ;
    owl:sameAs <http://dbpedia.org/resource/Colonel> ;
    skos:definition "Colonel, abbreviated as Col or COL, is a military rank of a senior commissioned officer. It or a corresponding rank exists in most armies and in many air forces; the naval equivalent rank is generally \"Captain\". It is also used in some police forces and other paramilitary rank structures. A colonel is typically in charge of a regiment in an army. \"Colonel\" is usually the highest or second-highest field rank, and is below the general ranks."@en ;
    skos:inScheme ns1:ArmyServiceBranch ;
    org:rankEquivalentTo ns1:Rank_Captain_\(naval\)_EnglishTradition,
        ns1:Rank_Group_captain_EnglishTradition ;
    org:rankJuniorToTransitive ns1:Rank_Brigadier_EnglishTradition ;
    org:rankSeniorToTransitive ns1:Rank_Lieutenant_colonel_EnglishTradition .

