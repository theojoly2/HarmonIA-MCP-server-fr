@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix onto: <https://yogaontology.org/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a owl:Ontology ;
    dc:creator "Stan & Tanja" ;
    dc:description "Yoga Ontology is the list of vocabularies that define the yogic practice. Where Yoga is the union of the mind and body."@en ;
    dc:issued "2020-07-16"^^xsd:date ;
    dc:rights "Copyright © 2020 Tanya Ronzhina and Stan Ronzhin" ;
    dc:title "Yoga Ontology"@en ;
    vann:preferredNamespacePrefix "yoga" ;
    rdfs:comment "First publication v0.1"@en ;
    owl:versionInfo 0.1 .

onto:Block a owl:Class ;
    rdfs:label "Block"@en ;
    rdfs:isDefinedBy <http://yogaontology.org/ontology/> ;
    rdfs:subClassOf onto:Props .

onto:LeftArm a owl:Class ;
    rdfs:label "LeftArm"@en ;
    rdfs:isDefinedBy <http://yogaontology.org/ontology/> ;
    rdfs:subClassOf onto:Arm .

onto:Pubis a owl:Class ;
    rdfs:label "Pubis"@en ;
    rdfs:isDefinedBy <http://yogaontology.org/ontology/> ;
    rdfs:subClassOf onto:BodyPart .

onto:Sitting a owl:Class ;
    rdfs:label "Sitting"@en ;
    rdfs:subClassOf onto:Position .

onto:Standing a owl:Class ;
    rdfs:label "Standing"@en ;
    rdfs:isDefinedBy <http://yogaontology.org/ontology/> ;
    rdfs:subClassOf onto:Position .

onto:Viloma a owl:Class ;
    rdfs:label "Viloma"@en ;
    rdfs:isDefinedBy <http://yogaontology.org/ontology/> ;
    rdfs:subClassOf onto:Pranayama .

onto:consistsOf a owl:ObjectProperty ;
    rdfs:label "consists of"@en ;
    rdfs:domain onto:Sequence ;
    rdfs:isDefinedBy <http://yogaontology.org/ontology/> ;
    rdfs:range onto:Asana .

onto:hasEffectOn a owl:ObjectProperty ;
    rdfs:label "has effect on"@en ;
    rdfs:domain onto:Asana,
        onto:Pranayama ;
    rdfs:isDefinedBy <http://yogaontology.org/ontology/> ;
    rdfs:range onto:BodyPart,
        onto:Condition,
        onto:Mind .

onto:hasPosition a owl:ObjectProperty ;
    rdfs:label "has position"@en ;
    rdfs:domain onto:Body ;
    rdfs:range onto:Position .

onto:performedInPosition a owl:ObjectProperty ;
    rdfs:label "performed in position"@en ;
    rdfs:domain onto:Asana ;
    rdfs:isDefinedBy <http://yogaontology.org/ontology/> ;
    rdfs:range onto:Position .

onto:preparesFor a owl:ObjectProperty ;
    rdfs:label "prepares for"@en ;
    rdfs:domain onto:Asana ;
    rdfs:isDefinedBy <http://yogaontology.org/ontology/> ;
    rdfs:range onto:Pranayama .

onto:uses a owl:ObjectProperty ;
    rdfs:label "uses"@en ;
    rdfs:domain onto:Asana ;
    rdfs:isDefinedBy <http://yogaontology.org/ontology/> ;
    rdfs:range onto:Props .

onto:Acidity a owl:Class ;
    rdfs:label "Acidity"@en ;
    rdfs:isDefinedBy <http://yogaontology.org/ontology/> .

onto:Arm a owl:Class ;
    rdfs:label "Arm"@en ;
    rdfs:isDefinedBy <http://yogaontology.org/ontology/> ;
    rdfs:subClassOf onto:BodyPart .

onto:Condition a owl:Class ;
    rdfs:label "Condition"@en ;
    rdfs:comment "Health complaints"@en ;
    rdfs:isDefinedBy <http://yogaontology.org/ontology/> ;
    rdfs:subClassOf onto:Acidity .

onto:Mind a owl:Class ;
    rdfs:label "Mind"@en ;
    rdfs:comment "Mind is the totality of conscious and unconscious mental processes and activities"@en ;
    rdfs:isDefinedBy <http://yogaontology.org/ontology/> .

onto:Body a owl:Class ;
    rdfs:label "Body"@en ;
    rdfs:isDefinedBy <http://yogaontology.org/ontology/> .

onto:Props a owl:Class ;
    rdfs:label "Props"@en ;
    rdfs:comment "Different equipment that could be used for yoga practice."@en ;
    rdfs:isDefinedBy <http://yogaontology.org/ontology/> .

onto:Sequence a owl:Class ;
    rdfs:label "Sequence"@en ;
    rdfs:isDefinedBy <http://yogaontology.org/ontology/> .

onto:BodyPart a owl:Class ;
    rdfs:label "Body part"@en ;
    rdfs:comment "Body part is any part of an organism, such as a limb or an organ."@en ;
    rdfs:isDefinedBy <http://yogaontology.org/ontology/> ;
    rdfs:subClassOf onto:Body .

onto:Pranayama a owl:Class ;
    rdfs:label "Pranayama"@en ;
    rdfs:comment "Prana means the breath, life, vitality, respiration; Ayama could be translated as stretch, extension, restrain or control. Thus pranayama is the control of breath (inhalation and exhalation) in a steady pose."@en ;
    rdfs:isDefinedBy <http://yogaontology.org/ontology/> .

onto:Position a owl:Class ;
    rdfs:label "Position"@en ;
    rdfs:comment "Position is the way the body is placed in the space"@en ;
    rdfs:isDefinedBy <http://yogaontology.org/ontology/> .

onto:Asana a owl:Class ;
    rdfs:label "Asana"@en ;
    rdfs:comment "Asana is a comfortable and stable body posture in yoga."@en ;
    rdfs:isDefinedBy <http://yogaontology.org/ontology/> ;
    owl:disjointWith onto:Sequence .

