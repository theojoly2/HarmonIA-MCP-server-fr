@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://semanticscience.org/resource/> .
@prefix ns2: <http://protege.stanford.edu/plugins/owl/protege#> .
@prefix ns3: <http://creativecommons.org/ns#> .
@prefix onto: <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#AggregateMonthly> a owl:Class ;
    rdfs:label "aggregate monthly"^^xsd:string ;
    ns1:comment "The process of aggregate values in a PRISM dataset over a month."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#PRISMDatasetProcessing> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#AggregateOverThirtyYears> a owl:Class ;
    rdfs:label "aggregate over thirty years"^^xsd:string ;
    ns1:comment "The process of aggregate values in a PRISM dataset over a thirty years."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#PRISMDatasetProcessing> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#AggregateYearly> a owl:Class ;
    rdfs:label "aggregate yearly"^^xsd:string ;
    ns1:comment "The process of aggregate values in a PRISM dataset over a year."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#PRISMDatasetProcessing> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Air> a owl:Class ;
    rdfs:label "air"^^xsd:string ;
    ns1:comment "Invisible gaseous substance surrounding the earth."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#AtmosphericFeature> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#ConvertASCIIToTIFF> a owl:Class ;
    rdfs:label "convert ASCII to TIFF"^^xsd:string ;
    ns1:comment "A process that involves converting an ASCII file to a TIFF file."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#DatasetProcessing> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#ConvertedDataset> a owl:Class ;
    rdfs:label "converted dataset"^^xsd:string ;
    ns1:comment "A raster dataset that was output by a conversion processing."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#RGISPrepublishedRasterDataset> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#DewPointTemperature> a owl:Class ;
    rdfs:label "dew point temperature"^^xsd:string ;
    ns1:comment "Temperature at which the water vapor in the air becomes saturated and water droplets begin to form as defined in the Collings English Dictionary."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Temperature> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Download> a owl:Class ;
    rdfs:label "download"^^xsd:string ;
    ns1:comment "Retrieving a dataset from a specific location in the web."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#DatasetProcessing> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#DownloadedMODISDataset> a owl:Class ;
    rdfs:label "downloaded modis dataset"^^xsd:string ;
    rdfs:comment "A MODIS dataset that has been obtained from a URL."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#MODISDataset> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#DownloadedPRISMDataset> a owl:Class ;
    rdfs:label "downloaded prism dataset"^^xsd:string ;
    ns1:comment "A PRISM dataset that has been downloaded from a specific URL."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#PRISMDataset> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#ExtractedDataset> a owl:Class ;
    rdfs:label "extracted dataset"^^xsd:string ;
    rdfs:comment "A raster dataset that was output by an extraction processing, such as a payload extraction."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#RGISPrepublishedRasterDataset> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Index> a owl:Class ;
    rdfs:label "index"^^xsd:string ;
    ns1:comment "A measurement of a specific characteristic that is commonly used as an indicator."^^xsd:string ;
    ns1:example "UV index"^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Amount> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Mosaic> a owl:Class ;
    rdfs:label "mosaic"^^xsd:string ;
    ns1:comment "A dataset processing involving the creation of a mosaic of raster datasets."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#DatasetProcessing> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#MosaicDataset> a owl:Class ;
    rdfs:label "mosaic dataset"^^xsd:string ;
    ns1:comment "A raster dataset that is part of a mosaic dataset."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#RGISPrepublishedRasterDataset> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Precipitation> a owl:Class ;
    rdfs:label "precipitation"^^xsd:string ;
    ns1:comment "rain, snow or hail that falls to the ground."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#TerrestrialFeature> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#PublishedMODISDataset> a owl:Class ;
    rdfs:label "published modis dataset"^^xsd:string ;
    ns1:comment "A MODIS dataset that is available for retrieval through a RGIS WCS service."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#RGISWCSDataset> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#PublishedPRISMDataset> a owl:Class ;
    rdfs:label "published prism dataset"^^xsd:string ;
    ns1:comment "A PRISM dataset that is available for retrieval through a RGIS WCS service."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#RGISWCSDataset> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Reproject> a owl:Class ;
    rdfs:label "reproject"^^xsd:string ;
    ns1:comment "The process of reprojecting over a dataset."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#DatasetProcessing> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#ReprojectedDataset> a owl:Class ;
    rdfs:label "reprojected dataset"^^xsd:string ;
    ns1:comment "A dataset that has been obtained from a reprojection processing."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#RGISPrepublishedRasterDataset> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#SurfaceLayer> a owl:Class ;
    rdfs:label "surface layer"^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#TerrestrialFeature> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Vegetation> a owl:Class ;
    rdfs:label "vegetation"^^xsd:string ;
    ns1:comment "Group of plants observed collectively in a particulare area or habitat."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#EcologicalCommunity> .

ns1:comment a owl:AnnotationProperty .

ns1:example a owl:AnnotationProperty .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#Band> a owl:Class .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#BandIdentification> a owl:Class .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#DataBand> a owl:Class .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#RasterDataset> a owl:Class .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#WCSDataset> a owl:Class .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#WCSManifestation> a owl:Class .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#hasDataBand> a owl:ObjectProperty ;
    rdfs:label "has data band" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#hasManifestation> a owl:ObjectProperty ;
    rdfs:label "has manifestation" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Amount> a owl:Class ;
    rdfs:label "amount"^^xsd:string ;
    rdfs:comment "A characteristic that can be measured as a quantity."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#Characteristic> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#AtmosphericFeature> a owl:Class ;
    rdfs:label "atmospheric feature"^^xsd:string ;
    ns1:comment "An entity in the atmosphere that can be observed."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#Entity> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#DatasetManipulationSoftware> a owl:Class ;
    rdfs:label "dataset manipulation software"^^xsd:string ;
    ns1:comment " A piece of code used to manipulate a dataset."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Processor> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#EcologicalCommunity> a owl:Class ;
    rdfs:label "ecological community"^^xsd:string ;
    ns1:comment "A set of individual entities that can be observed as one entity."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#Entity> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#ExtractAndReproject> a owl:Class ;
    rdfs:label "extract and reproject"^^xsd:string ;
    ns1:comment "A dataset process involving extracting a data band and reprojecting a dataset."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#DatasetProcessing> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#hadInputBandID> ;
            owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#Band> ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#MODIS> a <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Sensor>,
        owl:NamedIndividual .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#MODISDataset> a owl:Class ;
    rdfs:label "modis dataset"^^xsd:string ;
    ns1:comment "A dataset that contains measurements of a MODIS instrument."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#RGISPrepublishedRasterDataset> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#MODISMeasurement> a owl:Class ;
    rdfs:label "modis measurement"^^xsd:string ;
    ns1:comment "A measurement associated with a MODIS sensor."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Measurement> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#MODIS> ;
            owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#wasAssociatedWith> ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#ModellingAgent> a owl:Class ;
    rdfs:label "modelling agent"^^xsd:string ;
    ns1:comment "An agent that can generate a model."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Processor> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#PRISM> a owl:NamedIndividual .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#PRISMDataset> a owl:Class ;
    rdfs:label "prism dataset"^^xsd:string ;
    ns1:comment "A dataset that provides estimates of three basic climate elements: precipitation, temperature (min and max) and dew point."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#RGISPrepublishedRasterDataset> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#PRISMModelling> a owl:Class ;
    rdfs:label "prism modelling"^^xsd:string ;
    ns1:comment "The process of creating a PRISM model."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Modelling> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#PRISM> ;
            owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#wasAssociatedWith> ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Temperature> a owl:Class ;
    rdfs:label "temperature"^^xsd:string ;
    ns1:comment "A measurement of hot or cold."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#Characteristic> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#hadInput> a owl:ObjectProperty ;
    rdfs:label "had input" ;
    rdfs:domain <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#DatasetProcessing> ;
    rdfs:range <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#RGISPrepublishedRasterDataset> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#hadInputBandID> a owl:ObjectProperty ;
    rdfs:label "had input band id" ;
    rdfs:domain <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#ExtractAndReproject> ;
    rdfs:range <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#BandIdentification> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#hasJSONCapabilitiesDigestURL> a owl:DatatypeProperty ;
    rdfs:label "has json capabilities digest url" ;
    rdfs:domain <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#RGISWCSManifestation> ;
    rdfs:range rdfs:Literal .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#hasProcessorName> a owl:DatatypeProperty ;
    rdfs:label "has processor name" ;
    rdfs:domain <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Processor> ;
    rdfs:range rdfs:Literal .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#wasMeasuredBy> a owl:ObjectProperty ;
    rdfs:label "was measured by" ;
    rdfs:domain <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#RGISDataBand> ;
    rdfs:range <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#MODISMeasurement> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#wasModelledBy> a owl:ObjectProperty ;
    rdfs:label "was modelled by" ;
    rdfs:domain <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#RGISDataBand> ;
    rdfs:range <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#PRISMModelling> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#wasOutputBy> a owl:ObjectProperty ;
    rdfs:label "was output by" ;
    rdfs:domain <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#RGISPrepublishedRasterDataset> ;
    rdfs:range <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#DatasetProcessing> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#wasPublishedBy> a owl:ObjectProperty ;
    rdfs:label "was published by" ;
    rdfs:domain <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#RGISWCSDataset> ;
    rdfs:range <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Publish> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#Characteristic> a owl:Class .

onto: a owl:Ontology ;
    ns3:license "http://creativecommons.org/licenses/by/3.0/"^^xsd:anyURI ;
    ns2:defaultLanguage "en" ;
    dc:contributor "Contributors are those that engage in discussions during the development of this ontology (in alphabetical order):\\nkarl benedict\\nluis garnica\\ncj grady\\nbill hudspeth\\ndeana pennington\\nsoren scott\\naimee stewart"^^xsd:string ;
    dc:creator "http://cybershare.utep.edu"^^xsd:anyURI,
        "ELSEWeb team"@en,
        "Natalia Villanueva-Rosales"@en,
        "Nicholas del Rio"@en ;
    dc:description "The ELSEWeb EDAC ontology describes datasets publised by EDAC. This project provides foundational support for the ELSEWeb project(http://elseweb.cybershare.utep.edu/).\\nwebsite: http://elseweb.cybershare.utep.edu/ontologies\\nemail: nvillanuevarosales@utep.edu\\n"@en ;
    dc:issued "2014-05-01"^^xsd:date ;
    dc:rights "free to use,share,modify. modify with attribution [http://creativecommons.org/licenses/by/3.0/]."^^xsd:string ;
    dc:title "ELSEWeb EDAC Ontology"@en ;
    dcterms:identifier "elseweb-edac.owl" ;
    dcterms:modified "2015-09-24"^^xsd:date ;
    vann:preferredNamespacePrefix "elseweb-edac"@en ;
    vann:preferredNamespaceUri "http://ontology.cybershare.utep.edu/ELSEWeb/"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    owl:imports <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl> ;
    owl:versionIRI onto: ;
    owl:versionInfo "1.2"^^xsd:string .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#DataBandProcessing> a owl:Class ;
    rdfs:label "databand processing"^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Processing> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Measurement> a owl:Class ;
    rdfs:label "measurement"^^xsd:string ;
    ns1:comment "A characteristic measurement associated with a sensor."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#DataBandProcessing> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#wasAssociatedWith> ;
            owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Sensor> ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Modelling> a owl:Class ;
    rdfs:label "modelling"^^xsd:string ;
    ns1:comment "Creation of a model using measurements of characteristics."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#DataBandProcessing> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#wasAssociatedWith> ;
            owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#ModellingAgent> ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Publish> a owl:Class ;
    rdfs:label "publish"^^xsd:string ;
    ns1:comment "The process of publishing a dataset over a Web service."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#DatasetProcessing> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#RGISWCSManifestation> a owl:Class ;
    rdfs:label "rgis wcs manifestation" ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#WCSManifestation> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#hasJSONCapabilitiesDigestURL> ;
            owl:someValuesFrom rdfs:Literal ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Sensor> a owl:Class ;
    rdfs:label "sensor"^^xsd:string ;
    ns1:comment "An agent that can capture a measurement of a characteristic of an entity."^^xsd:string ;
    ns1:example "MODIS"^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Processor> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#TerrestrialFeature> a owl:Class ;
    rdfs:label "terrestrial feature"^^xsd:string ;
    ns1:comment "An entity that is situated the earth."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#Entity> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#Entity> a owl:Class .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#PRISMDatasetProcessing> a owl:Class ;
    rdfs:label "prism dataset processing"^^xsd:string ;
    ns1:comment "The process of manipulating a PRISM dataset."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#DatasetProcessing> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Processing> a owl:Class ;
    rdfs:label "processing"^^xsd:string ;
    ns1:comment "A set of steps to process a dataset."^^xsd:string .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#RGISDataBand> a owl:Class ;
    rdfs:label "rgis data band"^^xsd:string ;
    ns1:comment "A databand that is contained in an RGIS dataset."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#DataBand> ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onClass <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Measurement> ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#wasMeasuredBy> ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onClass <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Modelling> ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#wasModelledBy> ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#RGISWCSDataset> a owl:Class ;
    rdfs:label "rgis wcs dataset"^^xsd:string ;
    ns1:comment "A dataset that has been output from a RGIS WCS service manifestation."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#WCSDataset> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#hasManifestation> ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#RGISWCSManifestation> ] [ a owl:Restriction ;
                        owl:onClass <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Publish> ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#wasPublishedBy> ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Processor> a owl:Class ;
    rdfs:label "processor"^^xsd:string ;
    ns1:comment "An agent that will execute some process over a dataset."^^xsd:string ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#hasProcessorName> ;
            owl:someValuesFrom rdfs:Literal ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#wasAssociatedWith> a owl:ObjectProperty ;
    rdfs:label "was associated with" ;
    rdfs:domain <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Processing> ;
    rdfs:range <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Processor> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#RGISPrepublishedRasterDataset> a owl:Class ;
    rdfs:label "rgis prepublished raster dataset"^^xsd:string ;
    ns1:comment "A raster dataset that cotians an RGIS databand obtained by some dataset processing."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#RasterDataset> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#hasDataBand> ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#RGISDataBand> ] [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#wasOutputBy> ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#DatasetProcessing> ] ) ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#DatasetProcessing> a owl:Class ;
    rdfs:label "dataset processing"^^xsd:string ;
    ns1:comment "A process that involves the manipulation of a dataset."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Processing> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#hadInput> ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#RGISPrepublishedRasterDataset> ] [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#wasAssociatedWith> ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#DatasetManipulationSoftware> ] ) ] .

