@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix onto: <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#Milestone> a rdfs:Class,
        owl:Class ;
    rdfs:label "The Milestone entity" ;
    rdfs:comment "Clase que representa los hitos del desarrollo o\\n   versiones del software durante el transcurso de los proyectos.\\n  " ;
    rdfs:isDefinedBy onto: .

<http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#Project> a rdfs:Class,
        owl:Class ;
    rdfs:label "The Project entity" ;
    rdfs:comment "Clase contenedora de todos las tareas y milestones\\n   establecidos para la planificación y monitorización de un proyecto\\n   software." ;
    rdfs:isDefinedBy onto: .

<http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#Role> a rdfs:Class,
        owl:Class ;
    rdfs:label "The Role entity" ;
    rdfs:comment "Clase que representa el papel que juega un determinado\\n   miembro de un proyecto de desarrollo o mantenimiento de software.\\n  " ;
    rdfs:isDefinedBy onto: .

<http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#Task> a rdfs:Class,
        owl:Class ;
    rdfs:label "The Task entity" ;
    rdfs:comment "Clase que define la acción de realizar una labor\\n   necesaria para conseguir los objetivos del proyecto." ;
    rdfs:isDefinedBy onto: .

<http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#TaskCategory> a rdfs:Class,
        owl:Class ;
    rdfs:label "The TaskCategory entity" ;
    rdfs:comment "Clase que permite categorizar una tarea según su ámbito\\n   de aplicación." ;
    rdfs:isDefinedBy onto: .

<http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#TaskDependency> a rdfs:Class,
        owl:Class ;
    rdfs:label "The TaskDependency entity" ;
    rdfs:comment "Clase de asociación que permite representar la\\n   dependencia entre dos tareas concretas." ;
    rdfs:isDefinedBy onto: .

<http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#category> a rdf:Property ;
    rdfs:label "The category reference" ;
    rdfs:comment "Categoría de una tarea dada" ;
    rdfs:domain <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#Task> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#TaskCategory> .

<http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#dependencies> a rdf:Property ;
    rdfs:label "The dependencies reference" ;
    rdfs:comment "Dependencias de una tarea" ;
    rdfs:domain <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#Task> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#TaskDependency> .

<http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#dependentTask> a rdf:Property ;
    rdfs:label "The dependentTask reference" ;
    rdfs:comment "Tarea dependiente de una tarea dada" ;
    rdfs:domain <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#TaskDependency> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#Task> .

<http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#description> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "The description attribute" ;
    rdfs:comment "Descripción de un proyecto, un hito o una tarea" ;
    rdfs:domain <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#Milestone>,
        <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#Project>,
        <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#Task> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#members> a rdf:Property ;
    rdfs:label "The members reference" ;
    rdfs:comment "Roles asignados a un proyecto" ;
    rdfs:domain <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#Project> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#Role> .

<http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#milestones> a rdf:Property ;
    rdfs:label "The milestones reference" ;
    rdfs:comment "Conjunto de milestones o hitos de un proyecto" ;
    rdfs:domain <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#Project> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#Milestone> .

<http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#name> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "The name attribute" ;
    rdfs:comment "Tareas asociadas a un determinado hito del proyecto" ;
    rdfs:domain <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#Milestone>,
        <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#Project>,
        <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#Role>,
        <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#Task>,
        <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#TaskCategory> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#responsible> a rdf:Property ;
    rdfs:label "The responsible reference" ;
    rdfs:comment "Rol responsable de realizar una determinada tarea" ;
    rdfs:domain <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#Task> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#Role> .

<http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#skills> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "The skills attribute" ;
    rdfs:comment "Habilidades específicas de un determinado rol." ;
    rdfs:domain <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#Role> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#taskCategories> a rdf:Property ;
    rdfs:label "The taskCategories reference" ;
    rdfs:comment "Categorías definidas para las tareas de un proyecto" ;
    rdfs:domain <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#Project> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#TaskCategory> .

<http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#tasks> a rdf:Property ;
    rdfs:label "The tasks reference" ;
    rdfs:comment "Tareas asociadas a un determinado hito del proyecto" ;
    rdfs:domain <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#Milestone> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#Task> .

<http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#type> a rdf:Property ;
    rdfs:label "The type attribute" ;
    rdfs:comment "Tipo de dependencia entre tareas" ;
    rdfs:domain <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#TaskDependency> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept .

<http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#Project> rdfs:subClassOf doap:Project .

<http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#description> rdfs:subPropertyOf dc:description .

<http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#name> rdfs:subPropertyOf dc:title .

<http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#type> rdfs:subPropertyOf dc:subject .

<http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#ruizrube> a foaf:Person ;
    foaf:name "Iván Ruiz Rube" .

onto: a owl:Ontology ;
    dc:creator <http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#ruizrube> ;
    dc:description "<p>La planificación y monitorización de la ejecución de proyectos software puede llevarse a cabo con diferentes herramientas, desde sistemas basados en gestión de tareas, hasta herramientas especializadas en diagramas de Gantt o incluso mediante simples hojas de cálculo.  Este vocabulario contempla los elementos típicos a la hora de controlar los proyectos de desarrollo o mantenimiento de software. </p>" ;
    dc:modified "2014-01-08"^^xsd:date ;
    dc:title "Software Process Control Model" ;
    vann:preferredNamespacePrefix "spcm" ;
    vann:preferredNamespaceUri "http://spi-fm.uca.es/spdef/models/deployment/spcm/1.0#" ;
    foaf:page onto:.html .

