@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <https://creativecommons.org/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://cookingbigdata.com/linkeddata/ccsla#Claim> a rdfs:Class,
        owl:Class ;
    rdfs:label "Claims of the agreement"@en ;
    rdfs:comment "Claims of the agreement license"@en ;
    rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccsla#Claim> ;
    rdfs:subClassOf <http://cookingbigdata.com/linkeddata/ccsla#Term> .

<http://cookingbigdata.com/linkeddata/ccsla#Condition> a rdfs:Class,
        owl:Class ;
    rdfs:label "Conditions of compensation"@en ;
    rdfs:comment "Conditions and levels of the agreement and compensation"@en ;
    rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccsla#Condition> .

<http://cookingbigdata.com/linkeddata/ccsla#Definition> a rdfs:Class,
        owl:Class ;
    rdfs:label "Definitions of the agreement"@en ;
    rdfs:comment "Definitions of the agreement license used in terms"@en ;
    rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccsla#Definition> .

<http://cookingbigdata.com/linkeddata/ccsla#Limitation> a rdfs:Class,
        owl:Class ;
    rdfs:label "Limitations of the agreement"@en ;
    rdfs:comment "Limitations and Exclusions of the agreement license considering Compensations"@en ;
    rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccsla#Limitation> ;
    rdfs:subClassOf <http://cookingbigdata.com/linkeddata/ccsla#Term> .

<http://cookingbigdata.com/linkeddata/ccsla#SLA> a rdfs:Class,
        owl:Class ;
    rdfs:label "SLA Class"@en ;
    rdfs:comment "SLA Main Class"@en ;
    rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccsla#SLA> .

<http://cookingbigdata.com/linkeddata/ccsla#ServiceCredit> a rdfs:Class,
        owl:Class ;
    rdfs:label "ServiceCredits of the agreement"@en ;
    rdfs:comment "ServiceCredits of the agreement license considering Compensations terms"@en ;
    rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccsla#ServiceCredit> ;
    rdfs:subClassOf <http://cookingbigdata.com/linkeddata/ccsla#Term> .

<http://cookingbigdata.com/linkeddata/ccsla#Term> a rdfs:Class,
        owl:Class ;
    rdfs:label "Term of the agreement"@en ;
    rdfs:comment "Term of the SLA"@en ;
    rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccsla#Term> .

<http://cookingbigdata.com/linkeddata/ccsla#> a owl:Ontology ;
    rdfs:label "Service Level Agreement for Cloud Computing"@en ;
    dcterms:created "2018-03-06"^^xsd:date ;
    dcterms:creator <http://cookingbigdata.com/linkeddata/ccsla#manuelparra> ;
    dcterms:description "Service Level Agreement for Cloud Computing Services. This ontology allows to define model of SLA/SLO used in large cloud computing providers such as Amazon, Azure, etc., including terms, claims, credit, compensations, etc"@en ;
    dcterms:issued "2018-05-20"^^xsd:date ;
    dcterms:modified "2018-04-03"^^xsd:date ;
    dcterms:publisher <http://cookingbigdata.com/linkeddata/ccsla#cookingbigdata> ;
    dcterms:rights "Copyright © 2018 Manuel Parra-Royón" ;
    dcterms:title "SLA and SLO for Cloud Computing Services"@en ;
    owl:versionInfo 1.0 ;
    ns1:licence <https://creativecommons.org/licenses/by/3.0/> .

<http://cookingbigdata.com/linkeddata/ccsla#hasDefinitionValue> a owl:ObjectProperty ;
    rdfs:label "Definition values"@en ;
    rdfs:comment "Definition values of an agreement term."@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccsla#Definition> ;
    rdfs:range <http://schema.org/structuredValue> .

<http://cookingbigdata.com/linkeddata/ccsla#hasTermValue> a owl:ObjectProperty ;
    rdfs:label "Terms values"@en ;
    rdfs:comment "Definition values of an agreement term."@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccsla#Definition> ;
    rdfs:range <http://schema.org/structuredValue> .

<http://cookingbigdata.com/linkeddata/ccsla#hasValidity> a owl:ObjectProperty ;
    rdfs:label "Validity interval"@en ;
    rdfs:comment "Validity interval of an agreement term."@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccsla#SLA> ;
    rdfs:range time:Interval .

<http://cookingbigdata.com/linkeddata/ccsla#containsTerm> a rdf:Property ;
    rdfs:label "SLA Contains"@en ;
    rdfs:comment "SLA contains Terms of the agreement"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccsla#SLA> ;
    rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccsla#containsTerm> ;
    rdfs:range <http://cookingbigdata.com/linkeddata/ccsla#Term> .

<http://cookingbigdata.com/linkeddata/ccsla#cookingbigdata> a foaf:Organization ;
    rdfs:seeAlso <http://cookingbigdata.com/about> ;
    foaf:homepage <http://cookingbigdata.com> ;
    foaf:name "CookingBigData"^^xsd:string .

<http://cookingbigdata.com/linkeddata/ccsla#hasCompensation> a rdf:Property ;
    rdfs:label "Term Compensation"@en ;
    rdfs:comment "Term Compensation of the agreement"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccsla#Term> ;
    rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccsla#hasCompensation> ;
    rdfs:range <http://cookingbigdata.com/linkeddata/ccsla#Condition> .

<http://cookingbigdata.com/linkeddata/ccsla#includeDefs> a rdf:Property ;
    rdfs:label "Include Defs"@en ;
    rdfs:comment "Include definitions"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccsla#Term> ;
    rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccsla#includeDefs> ;
    rdfs:range <http://cookingbigdata.com/linkeddata/ccsla#Definition> .

<http://cookingbigdata.com/linkeddata/ccsla#includeValue> a owl:ObjectProperty ;
    rdfs:label "With values"@en ;
    rdfs:comment "Values of the condition"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccsla#Condition> ;
    rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccsla#includeValue> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/goodrelations/v1#QuantitativeValue> <http://purl.org/goodrelations/v1#QualitativeValue> ) ] .

<http://cookingbigdata.com/linkeddata/ccsla#manuelparra> a foaf:Person ;
    rdfs:seeAlso <https://twitter.com/manugrapevine> ;
    foaf:homepage <https://twitter.com/manugrapevine> ;
    foaf:mbox "manuparra@gmail.com"^^xsd:string ;
    foaf:name "Manuel Parra-Royon"^^xsd:string .

