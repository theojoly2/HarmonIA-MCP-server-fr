    dcterms:publisher "EMMC ASBL" ;
    dcterms:source "" ;
    dcterms:title "CHAracterisation MEthodology Ontology"@en ;
    ns2:doi "" ;
    ns2:status "" ;
    vann:preferredNamespacePrefix "chameo"@en ;
    vann:preferredNamespaceUri "https://w3id.org/emmo/domain/characterisation-methodology/chameo" ;
    rdfs:comment "Contacts:\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\tGerhard Goldbeck\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\tGoldbeck Consulting Ltd (UK)\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\temail: gerhard@goldbeck-consulting.com"@en ;
    owl:backwardCompatibleWith "" ;
    owl:imports <https://w3id.org/emmo/1.0.0-beta7/disciplines/computerscience>,
        <https://w3id.org/emmo/1.0.0-beta7/disciplines/isq>,
