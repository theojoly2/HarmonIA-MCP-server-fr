        <https://orcid.org/0000-0002-5174-8508>,
        <https://orcid.org/0000-0002-9668-6961> ;
    dcterms:description "Characterisation Methodology Ontology"@en ;
    dcterms:hasFormat <https://www.w3.org/TR/turtle/> ;
    dcterms:identifier "https://w3id.org/emmo/domain/characterisation-methodology/chameo" ;
    dcterms:issued "2024-04-12" ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/legalcode" ;
