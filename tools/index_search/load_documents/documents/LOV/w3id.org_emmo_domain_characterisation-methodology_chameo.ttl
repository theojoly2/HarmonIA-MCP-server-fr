onto: a owl:Ontology ;
    dcterms:abstract "CHAMEO is a domain ontology designed to model the common aspects across the different characterisation techniques and methodologies."@en ;
    dcterms:alternative "CHAMEO" ;
    dcterms:bibliographicCitation "Del Nostro, P., Goldbeck, G., Toti, D., 2022. CHAMEO: An ontology for the harmonisation of materials characterisation methodologies. Applied Ontology 17, 401–421. doi:10.3233/AO-220271." ;
    dcterms:contributor <https://orcid.org/0000-0002-4181-2852>,
        <https://orcid.org/0000-0002-5174-8508>,
        <https://orcid.org/0000-0002-9668-6961> ;
