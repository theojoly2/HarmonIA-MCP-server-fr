@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://gbol.life/ontology/bibo#> .
@prefix ns2: <http://www.w3.org/2003/11/swrl#> .
@prefix ns3: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix ns4: <http://creativecommons.org/ns#> .
@prefix onto: <https://w3id.org/isCharacterisedBy> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns4:license a owl:AnnotationProperty .

ns1:status a owl:AnnotationProperty .

dcterms:bibliographicCitation a owl:AnnotationProperty .

dcterms:contributor a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:publisher a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

owl:qualifiedCardinality a owl:AnnotationProperty .

ns3:term_status a owl:AnnotationProperty .

onto: a owl:Ontology ;
    ns4:license <https://creativecommons.org/licenses/by-nc/4.0/> ;
    ns1:status "published" ;
    dcterms:bibliographicCitation "Work in progress" ;
    dcterms:contributor "Izaskun Fernandez (Tekniker) \\nIban Quintana (Tekniker) \\nXana Fernandez (Tekniker)"@en ;
    dcterms:created "2023-05-30" ;
    dcterms:creator "Patricia Casla (Tekniker)"@en ;
    dcterms:description "The goal of this ontology design pattern is to characterise a subject or group of subjects of interest by assigning qualifiable or quantifiable attributes or characteristics."@en ;
    dcterms:issued "2023-05-30" ;
    dcterms:publisher "Tekniker" ;
    dcterms:title "isCharacterisedBy ontology design pattern " ;
    vann:preferredNamespacePrefix "icb" ;
    vann:preferredNamespaceUri "https://w3id.org/isCharacterisedBy" ;
    owl:versionInfo 1.0 .

<https://w3id.org/isCharacterisedBy#belongsTo> a owl:ObjectProperty ;
    rdfs:label "belongsTo" ;
    rdfs:comment "Relationship between a member and the group it belongs to." ;
    rdfs:isDefinedBy "https://w3id.org/isCharacterisedBy" ;
    owl:inverseOf <https://w3id.org/isCharacterisedBy#isGroupingOf> ;
    ns3:term_status "Testing" .

<https://w3id.org/isCharacterisedBy#characterises> a owl:ObjectProperty ;
    rdfs:label "characterises" ;
    rdfs:comment "Relationship between a Property and the SubjectOfInterest it characterises." ;
    rdfs:isDefinedBy "https://w3id.org/isCharacterisedBy" ;
    rdfs:range <https://w3id.org/isCharacterisedBy#SubjectOfInterest> ;
    owl:inverseOf <https://w3id.org/isCharacterisedBy#isCharacterisedBy> ;
    ns3:term_status "Testing" .

<https://w3id.org/isCharacterisedBy#isUnitFor> a owl:ObjectProperty ;
    rdfs:label "isUnitFor" ;
    rdfs:comment "Relationship between an unit and the property of which it is a unit of measurement." ;
    rdfs:domain <https://w3id.org/isCharacterisedBy#Unit> ;
    rdfs:isDefinedBy "https://w3id.org/isCharacterisedBy" ;
    ns3:term_status "Testing" .

<https://w3id.org/isCharacterisedBy#maxValue> a owl:DatatypeProperty ;
    rdfs:label "maxValue" ;
    rdfs:comment "Maximum permissible value." ;
    rdfs:isDefinedBy "https://w3id.org/isCharacterisedBy" ;
    ns3:term_status "Testing" .

<https://w3id.org/isCharacterisedBy#minValue> a owl:DatatypeProperty ;
    rdfs:label "minValue" ;
    rdfs:comment "Minimun permissible value." ;
    rdfs:isDefinedBy "https://w3id.org/isCharacterisedBy" ;
    ns3:term_status "Testing" .

<https://w3id.org/isCharacterisedBy#value> a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:comment "Specific value." ;
    rdfs:isDefinedBy "https://w3id.org/isCharacterisedBy" ;
    ns3:term_status "Testing" .

dcterms:identifier a owl:DatatypeProperty ;
    rdfs:label "identifier" ;
    rdfs:comment "An unambiguous reference to the resource within a given context." ;
    rdfs:isDefinedBy "http://purl.org/dc/terms" .

dcterms:title a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:comment "A name given to the resource." ;
    rdfs:isDefinedBy "http://purl.org/dc/terms" ;
    ns3:term_status "" .

<https://w3id.org/isCharacterisedBy#hasUnit> a owl:ObjectProperty ;
    rdfs:label "hasUnit" ;
    rdfs:comment "Relationship between a quantifiable property and a unit of measurement" ;
    rdfs:isDefinedBy "https://w3id.org/isCharacterisedBy" ;
    rdfs:range <https://w3id.org/isCharacterisedBy#Unit> ;
    owl:inverseOf <https://w3id.org/isCharacterisedBy#isUnitFor> ;
    ns3:term_status "Testing" .

<https://w3id.org/isCharacterisedBy#isGroupingOf> a owl:ObjectProperty ;
    rdfs:label "isGroupingOf" ;
    rdfs:comment "Relationship between a group and the members of such group. All the members of a group have the same charabterists or attributes." ;
    rdfs:isDefinedBy "https://w3id.org/isCharacterisedBy" ;
    ns3:term_status "Testing" .

<https://w3id.org/isCharacterisedBy#Property> a owl:Class ;
    rdfs:label "Property" ;
    rdfs:comment "Property is a qualifiable or quantifiable attribute, or characteristic of something. or somebody" ;
    rdfs:isDefinedBy "https://w3id.org/isCharacterisedBy" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <https://w3id.org/isCharacterisedBy#SubjectOfInterest> ;
            owl:onProperty <https://w3id.org/isCharacterisedBy#characterises> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dcterms:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:double ;
            owl:onProperty <https://w3id.org/isCharacterisedBy#value> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:double ;
            owl:onProperty <https://w3id.org/isCharacterisedBy#maxValue> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:double ;
            owl:onProperty <https://w3id.org/isCharacterisedBy#minValue> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <https://w3id.org/isCharacterisedBy#Unit> ;
            owl:onProperty <https://w3id.org/isCharacterisedBy#hasUnit> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/isCharacterisedBy#Unit> ;
            owl:onProperty <https://w3id.org/isCharacterisedBy#hasUnit> ] ;
    ns3:term_status "Testing" .

<urn:swrl:var#p> a ns2:Variable .

<urn:swrl:var#soc> a ns2:Variable .

<urn:swrl:var#soi> a ns2:Variable .

<https://w3id.org/isCharacterisedBy#isCharacterisedBy> a owl:ObjectProperty ;
    rdfs:label "isCharacterisedBy" ;
    rdfs:comment "Relationship between a SubjectOfInterest and the Property that characterises it." ;
    rdfs:domain <https://w3id.org/isCharacterisedBy#SubjectOfInterest> ;
    rdfs:isDefinedBy "https://w3id.org/isCharacterisedBy" ;
    ns3:term_status "Testing" .

<https://w3id.org/isCharacterisedBy#Unit> a owl:Class ;
    rdfs:label "Unit" ;
    rdfs:comment "A reference to the unit of measure of a quantifiable aspect (attribute or characteristic)." ;
    rdfs:isDefinedBy "https://w3id.org/isCharacterisedBy" ;
    ns3:term_status "Testing" .

<https://w3id.org/isCharacterisedBy#SubjectOfInterest> a owl:Class ;
    rdfs:label "SubjectOfInterest" ;
    rdfs:comment "A subject of interest is an abstraction of a real world phenomena (thing, person, event, etc)." ;
    rdfs:isDefinedBy "https://w3id.org/isCharacterisedBy" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dcterms:title ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/isCharacterisedBy#Property> ;
            owl:onProperty <https://w3id.org/isCharacterisedBy#isCharacterisedBy> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/isCharacterisedBy#SubjectOfInterest> ;
            owl:onProperty <https://w3id.org/isCharacterisedBy#isGroupingOf> ] ;
    ns3:term_status "Testing" .

[] a ns2:Imp ;
    ns2:body [ a ns2:AtomList ;
            rdf:first [ a ns2:ClassAtom ;
                    ns2:argument1 <urn:swrl:var#p> ;
                    ns2:classPredicate <https://w3id.org/isCharacterisedBy#Property> ] ;
            rdf:rest [ a ns2:AtomList ;
                    rdf:first [ a ns2:ClassAtom ;
                            ns2:argument1 <urn:swrl:var#soi> ;
                            ns2:classPredicate <https://w3id.org/isCharacterisedBy#SubjectOfInterest> ] ;
                    rdf:rest [ a ns2:AtomList ;
                            rdf:first [ a ns2:IndividualPropertyAtom ;
                                    ns2:argument1 <urn:swrl:var#soc> ;
                                    ns2:argument2 <urn:swrl:var#p> ;
                                    ns2:propertyPredicate <https://w3id.org/isCharacterisedBy#isCharacterisedBy> ] ;
                            rdf:rest [ a ns2:AtomList ;
                                    rdf:first [ a ns2:ClassAtom ;
                                            ns2:argument1 <urn:swrl:var#soc> ;
                                            ns2:classPredicate <https://w3id.org/isCharacterisedBy#SubjectOfInterest> ] ;
                                    rdf:rest [ a ns2:AtomList ;
                                            rdf:first [ a ns2:IndividualPropertyAtom ;
                                                    ns2:argument1 <urn:swrl:var#soi> ;
                                                    ns2:argument2 <urn:swrl:var#soc> ;
                                                    ns2:propertyPredicate <https://w3id.org/isCharacterisedBy#belongsTo> ] ;
                                            rdf:rest () ] ] ] ] ] ;
    ns2:head [ a ns2:AtomList ;
            rdf:first [ a ns2:IndividualPropertyAtom ;
                    ns2:argument1 <urn:swrl:var#soi> ;
                    ns2:argument2 <urn:swrl:var#p> ;
                    ns2:propertyPredicate <https://w3id.org/isCharacterisedBy#isCharacterisedBy> ] ;
            rdf:rest () ] .

[] a owl:AllDisjointClasses ;
    owl:members ( <https://w3id.org/isCharacterisedBy#Property> <https://w3id.org/isCharacterisedBy#SubjectOfInterest> <https://w3id.org/isCharacterisedBy#Unit> ) .

