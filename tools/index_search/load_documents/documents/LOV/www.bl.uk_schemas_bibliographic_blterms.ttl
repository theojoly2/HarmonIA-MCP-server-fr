@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://creativecommons.org/ns#> .
@prefix onto: <http://www.bl.uk/schemas/bibliographic/blterms> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.bl.uk/schemas/bibliographic/blterms#Family> a rdfs:Class,
        owl:Class ;
    rdfs:label "Family"@en ;
    rdfs:comment "A family"@en ;
    rdfs:isDefinedBy <http://www.bl.uk/schemas/bibliographic/blterms#> ;
    rdfs:subClassOf foaf:Group .

<http://www.bl.uk/schemas/bibliographic/blterms#FamilyConcept> a rdfs:Class,
        owl:Class ;
    rdfs:label "Family Concept"@en ;
    rdfs:comment "A family expressed as a concept."@en ;
    rdfs:isDefinedBy <http://www.bl.uk/schemas/bibliographic/blterms#> ;
    rdfs:subClassOf skos:Concept .

<http://www.bl.uk/schemas/bibliographic/blterms#OrganizationConcept> a rdfs:Class,
        owl:Class ;
    rdfs:label "Organization Concept"@en ;
    rdfs:comment "An organization expressed as a concept."@en ;
    rdfs:isDefinedBy <http://www.bl.uk/schemas/bibliographic/blterms#> ;
    rdfs:subClassOf skos:Concept .

<http://www.bl.uk/schemas/bibliographic/blterms#PersonConcept> a rdfs:Class,
        owl:Class ;
    rdfs:label "Person Concept"@en ;
    rdfs:comment "A person expressed as a concept."@en ;
    rdfs:isDefinedBy <http://www.bl.uk/schemas/bibliographic/blterms#> ;
    rdfs:subClassOf skos:Concept .

<http://www.bl.uk/schemas/bibliographic/blterms#PlaceConcept> a rdfs:Class,
        owl:Class ;
    rdfs:label "Place Concept"@en ;
    rdfs:comment "A place expressed as a concept."@en ;
    rdfs:isDefinedBy <http://www.bl.uk/schemas/bibliographic/blterms#> ;
    rdfs:subClassOf skos:Concept .

<http://www.bl.uk/schemas/bibliographic/blterms#PublicationEndEvent> a rdfs:Class,
        owl:Class ;
    rdfs:label "Publication event end"@en ;
    rdfs:comment "An event which is the end of the publication of a resource."@en ;
    rdfs:isDefinedBy <http://www.bl.uk/schemas/bibliographic/blterms#> ;
    rdfs:subClassOf <http://purl.org/NET/c4dm/event.owl#Event>,
        <http://www.bl.uk/schemas/bibliographic/blterms#PublicationEvent> .

<http://www.bl.uk/schemas/bibliographic/blterms#PublicationEvent> a rdfs:Class,
        owl:Class ;
    rdfs:label "Publication event"@en ;
    rdfs:comment "An event which is the publication of a resource."@en ;
    rdfs:isDefinedBy <http://www.bl.uk/schemas/bibliographic/blterms#> ;
    rdfs:subClassOf <http://purl.org/NET/c4dm/event.owl#Event> .

<http://www.bl.uk/schemas/bibliographic/blterms#PublicationStartEvent> a rdfs:Class,
        owl:Class ;
    rdfs:label "Publication event start"@en ;
    rdfs:comment "An event which is the start of the publication of a resource."@en ;
    rdfs:isDefinedBy <http://www.bl.uk/schemas/bibliographic/blterms#> ;
    rdfs:subClassOf <http://purl.org/NET/c4dm/event.owl#Event>,
        <http://www.bl.uk/schemas/bibliographic/blterms#PublicationEvent> .

<http://www.bl.uk/schemas/bibliographic/blterms#TopicDDC> a rdfs:Class,
        owl:Class ;
    rdfs:label "Dewey Decimal Classification (DDC) number"@en ;
    rdfs:comment "A Dewey Decimal Classification number (as found in British Library cataloguing data)"@en ;
    rdfs:isDefinedBy <http://www.bl.uk/schemas/bibliographic/blterms#> ;
    rdfs:subClassOf skos:Concept .

<http://www.bl.uk/schemas/bibliographic/blterms#TopicLCSH> a rdfs:Class,
        owl:Class ;
    rdfs:label "Library of Congress Subject Heading (LCSH)"@en ;
    rdfs:comment "A Library of Congress Subject Heading (LCSH) (as found in British Library cataloguing data)"@en ;
    rdfs:isDefinedBy <http://www.bl.uk/schemas/bibliographic/blterms#> ;
    rdfs:subClassOf skos:Concept .

onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:Ontology ;
    rdfs:label "British Library Terms RDF schema"@en ;
    ns1:license <http://creativecommons.org/publicdomain/mark/1.0/> ;
            foaf:name "Jan Ashton" ],
            foaf:name "Alan Danskin" ],
            foaf:name "Heather Rosie" ],
            foaf:name "Corine Deliot" ],
        [ foaf:mbox "mailto:Tim.Hodson@talis.com" ;
            foaf:name "Tim Hodson" ] ;
    dcterms:created "2011-06-28"^^xsd:date ;
    dcterms:description "This schema describes properties and classes defined to facilitate the description of bibliographic resources and their relationships to other entities. The properties and classes defined by this schema supplement properties and classes from other ontologies. A diagram of the full model as used by the British Library is available at: http://www.bl.uk/bibliographic/datafree.html"@en ;
    dcterms:modified "2013-10-03"^^xsd:date ;
            foaf:name "British Library, Metadata Services" ] ;
    dcterms:rights "public domain" ;
    dcterms:title "British Library Terms RDF schema"@en ;
    vann:preferredNamespacePrefix "blt" ;
    vann:preferredNamespaceUri "http://www.bl.uk/schemas/bibliographic/blterms#" ;
    rdfs:comment "Some useful terms for describing bibliographic resources that other models did not include. Version 1.4: brings the description for this schema in line with \"Metadata recommendations for Linked Open Vocabulairies\", version 1.1.; dct:license replaced by cc:license and the value changed from http://www.opendatacommons.org/licenses/pddl/1.0/ to http://creativecommons.org/publicdomain/mark/1.0/; various typos corrected. Version 1.4.1: added links to previous schema versions"@en ;
    owl:priorVersion onto:-v1-2.rdf,
        onto:-v1-3.rdf,
        onto:-v1-4.rdf ;
    owl:versionInfo 1.41 .

<http://www.bl.uk/schemas/bibliographic/blterms#bnb> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "BNB number"@en ;
    rdfs:comment "The BNB number associated with this resource"@en ;
    rdfs:isDefinedBy <http://www.bl.uk/schemas/bibliographic/blterms#> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:identifier .

<http://www.bl.uk/schemas/bibliographic/blterms#hasContributedTo> a rdf:Property ;
    rdfs:label "has contributed to"@en ;
    rdfs:comment "the inverse property of dct:contributor"@en ;
    rdfs:isDefinedBy <http://www.bl.uk/schemas/bibliographic/blterms#> ;
    owl:inverseOf dcterms:contributor .

<http://www.bl.uk/schemas/bibliographic/blterms#hasCreated> a rdf:Property ;
    rdfs:label "has created"@en ;
    rdfs:comment "the inverse property of dct:creator"@en ;
    rdfs:isDefinedBy <http://www.bl.uk/schemas/bibliographic/blterms#> ;
    owl:inverseOf dcterms:creator .

<http://www.bl.uk/schemas/bibliographic/blterms#publicationEnd> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Publication end"@en ;
    rdfs:comment "The end of the publication event of a resource."@en ;
    rdfs:isDefinedBy <http://www.bl.uk/schemas/bibliographic/blterms#> ;
    rdfs:range <http://www.bl.uk/schemas/bibliographic/blterms#PublicationEndEvent> ;
    rdfs:subPropertyOf <http://www.bl.uk/schemas/bibliographic/blterms#publication> .

<http://www.bl.uk/schemas/bibliographic/blterms#publicationStart> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Publication start"@en ;
    rdfs:comment "The start of the publication event of a resource."@en ;
    rdfs:isDefinedBy <http://www.bl.uk/schemas/bibliographic/blterms#> ;
    rdfs:range <http://www.bl.uk/schemas/bibliographic/blterms#PublicationStartEvent> ;
    rdfs:subPropertyOf <http://www.bl.uk/schemas/bibliographic/blterms#publication> .

<http://www.bl.uk/schemas/bibliographic/blterms#publication> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Publication"@en ;
    rdfs:comment "The publication event of a resource."@en ;
    rdfs:isDefinedBy <http://www.bl.uk/schemas/bibliographic/blterms#> ;
    rdfs:range <http://www.bl.uk/schemas/bibliographic/blterms#PublicationEvent> .

