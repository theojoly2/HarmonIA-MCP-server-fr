@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcam: <http://purl.org/dc/dcam/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix onto: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto:Agent a onto:AgentClass,
        rdfs:Class ;
    rdfs:label "Agent"@en ;
    onto:description "Examples of Agent include person, organization, and software agent."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#Agent-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A resource that acts or has the power to act."@en ;
    rdfs:isDefinedBy onto: .

onto:AgentClass a rdfs:Class ;
    rdfs:label "Agent Class"@en ;
    onto:description "Examples of Agent Class include groups seen as classes, such as students, women, charities, lecturers."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#AgentClass-003> ;
    onto:issued "2008-01-14"^^xsd:date ;
    onto:modified "2012-06-14"^^xsd:date ;
    rdfs:comment "A group of agents."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf rdfs:Class .

onto:BibliographicResource a rdfs:Class ;
    rdfs:label "Bibliographic Resource"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#BibliographicResource-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A book, article, or other documentary resource."@en ;
    rdfs:isDefinedBy onto: .

onto:FileFormat a rdfs:Class ;
    rdfs:label "File Format"@en ;
    onto:description "Examples include the formats defined by the list of Internet Media Types."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#FileFormat-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A digital resource format."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:MediaType .

onto:Frequency a rdfs:Class ;
    rdfs:label "Frequency"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#Frequency-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A rate at which something recurs."@en ;
    rdfs:isDefinedBy onto: .

onto:Jurisdiction a rdfs:Class ;
    rdfs:label "Jurisdiction"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#Jurisdiction-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "The extent or range of judicial, law enforcement, or other authority."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:LocationPeriodOrJurisdiction .

onto:LicenseDocument a rdfs:Class ;
    rdfs:label "License Document"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#LicenseDocument-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A legal document giving official permission to do something with a Resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:RightsStatement .

onto:LinguisticSystem a rdfs:Class ;
    rdfs:label "Linguistic System"@en ;
    onto:description "Examples include written, spoken, sign, and computer languages."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#LinguisticSystem-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A system of signs, symbols, sounds, gestures, or rules used in communication."@en ;
    rdfs:isDefinedBy onto: .

onto:Location a rdfs:Class ;
    rdfs:label "Location"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#Location-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A spatial region or named place."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:LocationPeriodOrJurisdiction .

onto:LocationPeriodOrJurisdiction a rdfs:Class ;
    rdfs:label "Location, Period, or Jurisdiction"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#LocationPeriodOrJurisdiction-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A location, period of time, or jurisdiction."@en ;
    rdfs:isDefinedBy onto: .

onto:MediaType a rdfs:Class ;
    rdfs:label "Media Type"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#MediaType-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A file format or physical medium."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:MediaTypeOrExtent .

onto:MediaTypeOrExtent a rdfs:Class ;
    rdfs:label "Media Type or Extent"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#MediaTypeOrExtent-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A media type or extent."@en ;
    rdfs:isDefinedBy onto: .

onto:MethodOfAccrual a rdfs:Class ;
    rdfs:label "Method of Accrual"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#MethodOfAccrual-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A method by which resources are added to a collection."@en ;
    rdfs:isDefinedBy onto: .

onto:MethodOfInstruction a rdfs:Class ;
    rdfs:label "Method of Instruction"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#MethodOfInstruction-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A process that is used to engender knowledge, attitudes, and skills."@en ;
    rdfs:isDefinedBy onto: .

onto:PeriodOfTime a rdfs:Class ;
    rdfs:label "Period of Time"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#PeriodOfTime-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "An interval of time that is named or defined by its start and end dates."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:LocationPeriodOrJurisdiction .

onto:PhysicalMedium a rdfs:Class ;
    rdfs:label "Physical Medium"@en ;
    onto:description "Examples include paper, canvas, or DVD."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#PhysicalMedium-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A physical material or carrier."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:MediaType .

onto:PhysicalResource a rdfs:Class ;
    rdfs:label "Physical Resource"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#PhysicalResource-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A material thing."@en ;
    rdfs:isDefinedBy onto: .

onto:Policy a rdfs:Class ;
    rdfs:label "Policy"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#Policy-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A plan or course of action by an authority, intended to influence and determine decisions, actions, and other matters."@en ;
    rdfs:isDefinedBy onto: .

onto:ProvenanceStatement a rdfs:Class ;
    rdfs:label "Provenance Statement"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#ProvenanceStatement-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A statement of any changes in ownership and custody of a resource since its creation that are significant for its authenticity, integrity, and interpretation."@en ;
    rdfs:isDefinedBy onto: .

onto:RightsStatement a rdfs:Class ;
    rdfs:label "Rights Statement"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#RightsStatement-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A statement about the intellectual property rights (IPR) held in or over a Resource, a legal document giving official permission to do something with a resource, or a statement about access rights."@en ;
    rdfs:isDefinedBy onto: .

onto:SizeOrDuration a rdfs:Class ;
    rdfs:label "Size or Duration"@en ;
    onto:description "Examples include a number of pages, a specification of length, width, and breadth, or a period in hours, minutes, and seconds."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#SizeOrDuration-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A dimension or extent, or a time taken to play or execute."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:MediaTypeOrExtent .

onto:Standard a rdfs:Class ;
    rdfs:label "Standard"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#Standard-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A basis for comparison; a reference point against which other things can be evaluated."@en ;
    rdfs:isDefinedBy onto: .

onto:Box a rdfs:Datatype ;
    rdfs:label "DCMI Box"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#Box-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The set of regions in space defined by their geographic coordinates according to the DCMI Box Encoding Scheme."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://dublincore.org/documents/dcmi-box/> .

onto:DCMIType a dcam:VocabularyEncodingScheme ;
    rdfs:label "DCMI Type Vocabulary"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#DCMIType-005> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2012-06-14"^^xsd:date ;
    rdfs:comment "The set of classes specified by the DCMI Type Vocabulary, used to categorize the nature or genre of the resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso dcmitype: .

onto:DDC a dcam:VocabularyEncodingScheme ;
    rdfs:label "DDC"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#DDC-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The set of conceptual resources specified by the Dewey Decimal Classification."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://www.oclc.org/dewey/> .

onto:IMT a dcam:VocabularyEncodingScheme ;
    rdfs:label "IMT"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#IMT-004> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The set of media types specified by the Internet Assigned Numbers Authority."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://www.iana.org/assignments/media-types/> .

onto:ISO3166 a rdfs:Datatype ;
    rdfs:label "ISO 3166"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#ISO3166-004> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The set of codes listed in ISO 3166-1 for the representation of names of countries."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://www.iso.org/iso/en/prods-services/iso3166ma/02iso-3166-code-lists/list-en1.html> .

onto:ISO639-2 a rdfs:Datatype ;
    rdfs:label "ISO 639-2"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#ISO639-2-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The three-letter alphabetic codes listed in ISO639-2 for the representation of names of languages."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://lcweb.loc.gov/standards/iso639-2/langhome.html> .

onto:ISO639-3 a rdfs:Datatype ;
    rdfs:label "ISO 639-3"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#ISO639-3-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "The set of three-letter codes listed in ISO 639-3 for the representation of names of languages."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://www.sil.org/iso639-3/> .

onto:LCC a dcam:VocabularyEncodingScheme ;
    rdfs:label "LCC"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#LCC-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The set of conceptual resources specified by the Library of Congress Classification."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://lcweb.loc.gov/catdir/cpso/lcco/lcco.html> .

onto:LCSH a dcam:VocabularyEncodingScheme ;
    rdfs:label "LCSH"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#LCSH-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The set of labeled concepts specified by the Library of Congress Subject Headings."@en ;
    rdfs:isDefinedBy onto: .

onto:MESH a dcam:VocabularyEncodingScheme ;
    rdfs:label "MeSH"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#MESH-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The set of labeled concepts specified by the Medical Subject Headings."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://www.nlm.nih.gov/mesh/meshhome.html> .

onto:NLM a dcam:VocabularyEncodingScheme ;
    rdfs:label "NLM"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#NLM-002> ;
    onto:issued "2005-06-13"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The set of conceptual resources specified by the National Library of Medicine Classification."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://wwwcf.nlm.nih.gov/class/> .

onto:Period a rdfs:Datatype ;
    rdfs:label "DCMI Period"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#Period-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The set of time intervals defined by their limits according to the DCMI Period Encoding Scheme."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://dublincore.org/documents/dcmi-period/> .

onto:Point a rdfs:Datatype ;
    rdfs:label "DCMI Point"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#Point-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The set of points in space defined by their geographic coordinates according to the DCMI Point Encoding Scheme."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://dublincore.org/documents/dcmi-point/> .

onto:RFC1766 a rdfs:Datatype ;
    rdfs:label "RFC 1766"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#RFC1766-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The set of tags, constructed according to RFC 1766, for the identification of languages."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://www.ietf.org/rfc/rfc1766.txt> .

onto:RFC3066 a rdfs:Datatype ;
    rdfs:label "RFC 3066"@en ;
    onto:description "RFC 3066 has been obsoleted by RFC 4646."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#RFC3066-002> ;
    onto:issued "2002-07-13"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The set of tags constructed according to RFC 3066 for the identification of languages."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://www.ietf.org/rfc/rfc3066.txt> .

onto:RFC4646 a rdfs:Datatype ;
    rdfs:label "RFC 4646"@en ;
    onto:description "RFC 4646 obsoletes RFC 3066."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#RFC4646-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "The set of tags constructed according to RFC 4646 for the identification of languages."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://www.ietf.org/rfc/rfc4646.txt> .

onto:RFC5646 a rdfs:Datatype ;
    rdfs:label "RFC 5646"@en ;
    onto:description "RFC 5646 obsoletes RFC 4646."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#RFC5646-001> ;
    onto:issued "2010-10-11"^^xsd:date ;
    rdfs:comment "The set of tags constructed according to RFC 5646 for the identification of languages."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://www.ietf.org/rfc/rfc5646.txt> .

onto:TGN a dcam:VocabularyEncodingScheme ;
    rdfs:label "TGN"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#TGN-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The set of places specified by the Getty Thesaurus of Geographic Names."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://www.getty.edu/research/tools/vocabulary/tgn/index.html> .

onto:UDC a dcam:VocabularyEncodingScheme ;
    rdfs:label "UDC"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#UDC-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The set of conceptual resources specified by the Universal Decimal Classification."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://www.udcc.org/> .

onto:URI a rdfs:Datatype ;
    rdfs:label "URI"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#URI-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The set of identifiers constructed according to the generic syntax for Uniform Resource Identifiers as specified by the Internet Engineering Task Force."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://www.ietf.org/rfc/rfc3986.txt> .

onto:W3CDTF a rdfs:Datatype ;
    rdfs:label "W3C-DTF"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#W3CDTF-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The set of dates and times constructed according to the W3C Date and Time Formats Specification."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://www.w3.org/TR/NOTE-datetime> .

onto:abstract a rdf:Property ;
    rdfs:label "Abstract"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#abstract-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A summary of the resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:description,
        onto:description .

onto:accessRights a rdf:Property ;
    rdfs:label "Access Rights"@en ;
    onto:description "Access Rights may include information regarding access or restrictions based on privacy, security, or other policies."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#accessRights-002> ;
    onto:issued "2003-02-15"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "Information about who can access the resource or an indication of its security status."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:RightsStatement ;
    rdfs:subPropertyOf dc:rights,
        onto:rights .

onto:accrualMethod a rdf:Property ;
    rdfs:label "Accrual Method"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#accrualMethod-003> ;
    onto:issued "2005-06-13"^^xsd:date ;
    onto:modified "2010-10-11"^^xsd:date ;
    rdfs:comment "The method by which items are added to a collection."@en ;
    rdfs:domain dcmitype:Collection ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:MethodOfAccrual .

onto:accrualPeriodicity a rdf:Property ;
    rdfs:label "Accrual Periodicity"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#accrualPeriodicity-003> ;
    onto:issued "2005-06-13"^^xsd:date ;
    onto:modified "2010-10-11"^^xsd:date ;
    rdfs:comment "The frequency with which items are added to a collection."@en ;
    rdfs:domain dcmitype:Collection ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Frequency .

onto:accrualPolicy a rdf:Property ;
    rdfs:label "Accrual Policy"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#accrualPolicy-003> ;
    onto:issued "2005-06-13"^^xsd:date ;
    onto:modified "2010-10-11"^^xsd:date ;
    rdfs:comment "The policy governing the addition of items to a collection."@en ;
    rdfs:domain dcmitype:Collection ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Policy .

onto:alternative a rdf:Property ;
    rdfs:label "Alternative Title"@en ;
    onto:description "The distinction between titles and alternative titles is application-specific."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#alternative-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2010-10-11"^^xsd:date ;
    rdfs:comment "An alternative name for the resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:title,
        onto:title .

onto:available a rdf:Property ;
    rdfs:label "Date Available"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#available-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "Date (often a range) that the resource became or will become available."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:date,
        onto:date .

onto:bibliographicCitation a rdf:Property ;
    rdfs:label "Bibliographic Citation"@en ;
    onto:description "Recommended practice is to include sufficient bibliographic detail to identify the resource as unambiguously as possible."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#bibliographicCitation-002> ;
    onto:issued "2003-02-15"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A bibliographic reference for the resource."@en ;
    rdfs:domain onto:BibliographicResource ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:identifier,
        onto:identifier .

onto:conformsTo a rdf:Property ;
    rdfs:label "Conforms To"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#conformsTo-003> ;
    onto:issued "2001-05-21"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "An established standard to which the described resource conforms."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Standard ;
    rdfs:subPropertyOf dc:relation,
        onto:relation .

onto:created a rdf:Property ;
    rdfs:label "Date Created"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#created-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "Date of creation of the resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:date,
        onto:date .

onto:creator a rdf:Property ;
    rdfs:label "Creator"@en ;
    onto:description "Examples of a Creator include a person, an organization, or a service."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#creatorT-002> ;
    onto:issued "2008-01-14"^^xsd:date ;
    onto:modified "2010-10-11"^^xsd:date ;
    rdfs:comment "An entity primarily responsible for making the resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Agent ;
    rdfs:subPropertyOf dc:creator,
        onto:contributor ;
    owl:equivalentProperty foaf:maker .

onto:dateAccepted a rdf:Property ;
    rdfs:label "Date Accepted"@en ;
    onto:description "Examples of resources to which a Date Accepted may be relevant are a thesis (accepted by a university department) or an article (accepted by a journal)."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#dateAccepted-002> ;
    onto:issued "2002-07-13"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "Date of acceptance of the resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:date,
        onto:date .

onto:dateCopyrighted a rdf:Property ;
    rdfs:label "Date Copyrighted"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#dateCopyrighted-002> ;
    onto:issued "2002-07-13"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "Date of copyright."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:date,
        onto:date .

onto:dateSubmitted a rdf:Property ;
    rdfs:label "Date Submitted"@en ;
    onto:description "Examples of resources to which a Date Submitted may be relevant are a thesis (submitted to a university department) or an article (submitted to a journal)."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#dateSubmitted-002> ;
    onto:issued "2002-07-13"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "Date of submission of the resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:date,
        onto:date .

onto:educationLevel a rdf:Property ;
    rdfs:label "Audience Education Level"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#educationLevel-002> ;
    onto:issued "2002-07-13"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A class of entity, defined in terms of progression through an educational or training context, for which the described resource is intended."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:AgentClass ;
    rdfs:subPropertyOf onto:audience .

onto:extent a rdf:Property ;
    rdfs:label "Extent"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#extent-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The size or duration of the resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:SizeOrDuration ;
    rdfs:subPropertyOf dc:format,
        onto:format .

onto:hasFormat a rdf:Property ;
    rdfs:label "Has Format"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#hasFormat-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A related resource that is substantially the same as the pre-existing described resource, but in another format."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:relation,
        onto:relation ;
    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/).  As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en .

onto:hasPart a rdf:Property ;
    rdfs:label "Has Part"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#hasPart-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A related resource that is included either physically or logically in the described resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:relation,
        onto:relation ;
    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/).  As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en .

onto:hasVersion a rdf:Property ;
    rdfs:label "Has Version"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#hasVersion-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A related resource that is a version, edition, or adaptation of the described resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:relation,
        onto:relation ;
    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/).  As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en .

onto:instructionalMethod a rdf:Property ;
    rdfs:label "Instructional Method"@en ;
    onto:description "Instructional Method will typically include ways of presenting instructional materials or conducting instructional activities, patterns of learner-to-learner and learner-to-instructor interactions, and mechanisms by which group and individual levels of learning are measured.  Instructional methods include all aspects of the instruction and learning processes from planning and implementation through evaluation and feedback."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#instructionalMethod-002> ;
    onto:issued "2005-06-13"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A process, used to engender knowledge, attitudes and skills, that the described resource is designed to support."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:MethodOfInstruction .

onto:isFormatOf a rdf:Property ;
    rdfs:label "Is Format Of"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#isFormatOf-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A related resource that is substantially the same as the described resource, but in another format."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:relation,
        onto:relation ;
    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/).  As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en .

onto:isPartOf a rdf:Property ;
    rdfs:label "Is Part Of"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#isPartOf-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A related resource in which the described resource is physically or logically included."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:relation,
        onto:relation ;
    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/).  As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en .

onto:isReferencedBy a rdf:Property ;
    rdfs:label "Is Referenced By"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#isReferencedBy-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A related resource that references, cites, or otherwise points to the described resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:relation,
        onto:relation ;
    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/).  As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en .

onto:isReplacedBy a rdf:Property ;
    rdfs:label "Is Replaced By"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#isReplacedBy-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A related resource that supplants, displaces, or supersedes the described resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:relation,
        onto:relation ;
    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/).  As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en .

onto:isRequiredBy a rdf:Property ;
    rdfs:label "Is Required By"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#isRequiredBy-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A related resource that requires the described resource to support its function, delivery, or coherence."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:relation,
        onto:relation ;
    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/).  As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en .

onto:isVersionOf a rdf:Property ;
    rdfs:label "Is Version Of"@en ;
    onto:description "Changes in version imply substantive changes in content rather than differences in format."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#isVersionOf-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A related resource of which the described resource is a version, edition, or adaptation."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:relation,
        onto:relation ;
    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/).  As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en .

onto:issued a rdf:Property ;
    rdfs:label "Date Issued"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#issued-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "Date of formal issuance (e.g., publication) of the resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:date,
        onto:date .

onto:language a rdf:Property ;
    rdfs:label "Language"@en ;
    onto:description "Recommended best practice is to use a controlled vocabulary such as RFC 4646 [RFC4646]."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#languageT-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A language of the resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:LinguisticSystem ;
    rdfs:subPropertyOf dc:language .

onto:license a rdf:Property ;
    rdfs:label "License"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#license-002> ;
    onto:issued "2004-06-14"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A legal document giving official permission to do something with the resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:LicenseDocument ;
    rdfs:subPropertyOf dc:rights,
        onto:rights .

onto:mediator a rdf:Property ;
    rdfs:label "Mediator"@en ;
    onto:description "In an educational context, a mediator might be a parent, teacher, teaching assistant, or care-giver."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#mediator-003> ;
    onto:issued "2001-05-21"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "An entity that mediates access to the resource and for whom the resource is intended or useful."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:AgentClass ;
    rdfs:subPropertyOf onto:audience .

onto:medium a rdf:Property ;
    rdfs:label "Medium"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#medium-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The material or physical carrier of the resource."@en ;
    rdfs:domain onto:PhysicalResource ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:PhysicalMedium ;
    rdfs:subPropertyOf dc:format,
        onto:format .

onto:modified a rdf:Property ;
    rdfs:label "Date Modified"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#modified-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "Date on which the resource was changed."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:date,
        onto:date .

onto:provenance a rdf:Property ;
    rdfs:label "Provenance"@en ;
    onto:description "The statement may include a description of any changes successive custodians made to the resource."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#provenance-002> ;
    onto:issued "2004-09-20"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A statement of any changes in ownership and custody of the resource since its creation that are significant for its authenticity, integrity, and interpretation."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:ProvenanceStatement .

onto:publisher a rdf:Property ;
    rdfs:label "Publisher"@en ;
    onto:description "Examples of a Publisher include a person, an organization, or a service."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#publisherT-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    onto:modified "2010-10-11"^^xsd:date ;
    rdfs:comment "An entity responsible for making the resource available."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Agent ;
    rdfs:subPropertyOf dc:publisher .

onto:references a rdf:Property ;
    rdfs:label "References"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#references-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A related resource that is referenced, cited, or otherwise pointed to by the described resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:relation,
        onto:relation ;
    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/).  As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en .

onto:replaces a rdf:Property ;
    rdfs:label "Replaces"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#replaces-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A related resource that is supplanted, displaced, or superseded by the described resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:relation,
        onto:relation ;
    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/).  As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en .

onto:requires a rdf:Property ;
    rdfs:label "Requires"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#requires-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A related resource that is required by the described resource to support its function, delivery, or coherence."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:relation,
        onto:relation ;
    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/).  As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en .

onto:rightsHolder a rdf:Property ;
    rdfs:label "Rights Holder"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#rightsHolder-002> ;
    onto:issued "2004-06-14"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A person or organization owning or managing rights over the resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Agent .

onto:source a rdf:Property ;
    rdfs:label "Source"@en ;
    onto:description "The described resource may be derived from the related resource in whole or in part. Recommended best practice is to identify the related resource by means of a string conforming to a formal identification system."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#sourceT-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A related resource from which the described resource is derived."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:source,
        onto:relation ;
    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/).  As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en .

onto:spatial a rdf:Property ;
    rdfs:label "Spatial Coverage"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#spatial-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "Spatial characteristics of the resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Location ;
    rdfs:subPropertyOf dc:coverage,
        onto:coverage .

onto:subject a rdf:Property ;
    rdfs:label "Subject"@en ;
    onto:description "Typically, the subject will be represented using keywords, key phrases, or classification codes. Recommended best practice is to use a controlled vocabulary."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#subjectT-002> ;
    onto:issued "2008-01-14"^^xsd:date ;
    onto:modified "2012-06-14"^^xsd:date ;
    rdfs:comment "The topic of the resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:subject ;
    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/).  As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en .

onto:tableOfContents a rdf:Property ;
    rdfs:label "Table Of Contents"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#tableOfContents-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A list of subunits of the resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:description,
        onto:description .

onto:temporal a rdf:Property ;
    rdfs:label "Temporal Coverage"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#temporal-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "Temporal characteristics of the resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:PeriodOfTime ;
    rdfs:subPropertyOf dc:coverage,
        onto:coverage .

onto:type a rdf:Property ;
    rdfs:label "Type"@en ;
    onto:description "Recommended best practice is to use a controlled vocabulary such as the DCMI Type Vocabulary [DCMITYPE]. To describe the file format, physical medium, or dimensions of the resource, use the Format element."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#typeT-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The nature or genre of the resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Class ;
    rdfs:subPropertyOf dc:type .

onto:valid a rdf:Property ;
    rdfs:label "Date Valid"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#valid-003> ;
    onto:issued "2000-07-11"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "Date (often a range) of validity of a resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:date,
        onto:date .

onto:contributor a rdf:Property ;
    rdfs:label "Contributor"@en ;
    onto:description "Examples of a Contributor include a person, an organization, or a service."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#contributorT-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    onto:modified "2010-10-11"^^xsd:date ;
    rdfs:comment "An entity responsible for making contributions to the resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Agent ;
    rdfs:subPropertyOf dc:contributor .

onto:identifier a rdf:Property ;
    rdfs:label "Identifier"@en ;
    onto:description "Recommended best practice is to identify the resource by means of a string conforming to a formal identification system. "@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#identifierT-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "An unambiguous reference to the resource within a given context."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:identifier .

onto:title a rdf:Property ;
    rdfs:label "Title"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#titleT-002> ;
    onto:issued "2008-01-14"^^xsd:date ;
    onto:modified "2010-10-11"^^xsd:date ;
    rdfs:comment "A name given to the resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:title .

onto:audience a rdf:Property ;
    rdfs:label "Audience"@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#audience-003> ;
    onto:issued "2001-05-21"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A class of entity for whom the resource is intended or useful."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:AgentClass .

onto:coverage a rdf:Property ;
    rdfs:label "Coverage"@en ;
    onto:description "Spatial topic and spatial applicability may be a named place or a location specified by its geographic coordinates. Temporal topic may be a named period, date, or date range. A jurisdiction may be a named administrative entity or a geographic place to which the resource applies. Recommended best practice is to use a controlled vocabulary such as the Thesaurus of Geographic Names [TGN]. Where appropriate, named places or time periods can be used in preference to numeric identifiers such as sets of coordinates or date ranges."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#coverageT-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The spatial or temporal topic of the resource, the spatial applicability of the resource, or the jurisdiction under which the resource is relevant."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:LocationPeriodOrJurisdiction ;
    rdfs:subPropertyOf dc:coverage .

onto:description a rdf:Property ;
    rdfs:label "Description"@en ;
    onto:description "Description may include but is not limited to: an abstract, a table of contents, a graphical representation, or a free-text account of the resource."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#descriptionT-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "An account of the resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:description .

onto:format a rdf:Property ;
    rdfs:label "Format"@en ;
    onto:description "Examples of dimensions include size and duration. Recommended best practice is to use a controlled vocabulary such as the list of Internet Media Types [MIME]."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#formatT-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The file format, physical medium, or dimensions of the resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:MediaTypeOrExtent ;
    rdfs:subPropertyOf dc:format .

onto:rights a rdf:Property ;
    rdfs:label "Rights"@en ;
    onto:description "Typically, rights information includes a statement about various property rights associated with the resource, including intellectual property rights."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#rightsT-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "Information about rights held in and over the resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:RightsStatement ;
    rdfs:subPropertyOf dc:rights .

onto:date a rdf:Property ;
    rdfs:label "Date"@en ;
    onto:description "Date may be used to express temporal information at any level of granularity.  Recommended best practice is to use an encoding scheme, such as the W3CDTF profile of ISO 8601 [W3CDTF]."@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#dateT-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A point or period of time associated with an event in the lifecycle of the resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:date .

onto:relation a rdf:Property ;
    rdfs:label "Relation"@en ;
    onto:description "Recommended best practice is to identify the related resource by means of a string conforming to a formal identification system. "@en ;
    onto:hasVersion <http://dublincore.org/usage/terms/history/#relationT-001> ;
    onto:issued "2008-01-14"^^xsd:date ;
    onto:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A related resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:relation ;
    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/).  As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en .

onto: onto:modified "2012-06-14"^^xsd:date ;
    onto:publisher <http://purl.org/dc/aboutdcmi#DCMI> ;
    onto:title "DCMI Metadata Terms - other"@en .

