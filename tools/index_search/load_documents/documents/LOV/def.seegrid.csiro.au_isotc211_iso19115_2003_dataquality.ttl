<http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#QuantitativeResult> a owl:Class ;
    rdfs:label "Quantitative result"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#valueType> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#valueUnit> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#value> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#errorStatistic> ],
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#Result> ;
    skos:notation "DQ_QuantitativeResult"^^ns1:ISOClassName .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#Result> a owl:Class ;
    rdfs:label "Result"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    skos:notation "DQ_Result"^^ns1:ISOClassName .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#Scope> a owl:Class ;
    rdfs:label "Scope"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19115/2003/metadata#ScopeCode> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#level> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#level> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19115/2003/metadata#ScopeDescription> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#levelDescription> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#Extent> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#extent> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#extent> ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#levelDescription> ] ;
    skos:notation "DQ_Scope"^^ns1:ISOClassName .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#Element> a owl:Class ;
    rdfs:label "Element"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#result> ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#nameOfMeasure> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19115/2003/citation#Citation> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#evaluationProcedure> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#measureDescription> ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#dateTime> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#evaluationMethodDescription> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#EvaluationMethodTypeCode> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#evaluationMethodType> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#measureIdentification> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#evaluationMethodType> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#Result> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#result> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#evaluationProcedure> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#result> ] ;
    skos:notation "DQ_Element"^^ns1:ISOClassName .

