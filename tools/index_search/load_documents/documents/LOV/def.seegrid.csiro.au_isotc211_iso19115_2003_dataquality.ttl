    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#Element> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#Result> .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#LogicalConsistency> a owl:Class ;
    rdfs:label "Logical consistency"^^xsd:string ;
    ns1:isAbstract true ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#Element> ;
