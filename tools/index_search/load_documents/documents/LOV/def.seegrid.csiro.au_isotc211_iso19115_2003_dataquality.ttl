    skos:notation "DQ_EvaluationMethodTypeCode"^^ns1:ISOClassName .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#evaluationMethodType> a owl:ObjectProperty ;
    rdfs:label "evaluation method type"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#Element> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#EvaluationMethodTypeCode> .

