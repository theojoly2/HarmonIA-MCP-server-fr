<http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#EvaluationMethodTypeCode> a owl:Class ;
    rdfs:label "Evaluation method code"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
