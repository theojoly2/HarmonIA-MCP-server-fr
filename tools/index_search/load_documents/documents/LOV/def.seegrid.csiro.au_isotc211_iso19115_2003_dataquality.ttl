<http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#ConformanceResult> a owl:Class ;
    rdfs:label "Conformance result"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#explanation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19115/2003/citation#Citation> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#specification> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#pass> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#specification> ],
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#Result> ;
    skos:notation "DQ_ConformanceResult"^^ns1:ISOClassName .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#DataQuality> a owl:Class ;
    rdfs:label "Data quality"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#Element> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#report> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#lineage> ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#report> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#Scope> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#scope> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#scope> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19115/2003/lineage#Lineage> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#lineage> ] ;
    skos:notation "DQ_DataQuality"^^ns1:ISOClassName .

