    rdfs:range skos:Concept .

<http://purl.org/oslo/ns/localgov#locatorDesignator> a rdf:Property ;
    rdfs:label "locator designator"@en ;
    dcterms:identifier "oslo:locatorDesignator" ;
    rdfs:comment "A number or a sequence of characters that uniquely identifies the locator within the relevant scope(s). The full identification of the locator could include one or more locator designators. The domain of oslo:locatorDesignator is oslo:Address."@en ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#ExtendedAddress> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <http://www.w3.org/ns/locn#locatorDesignator> .

<http://purl.org/oslo/ns/localgov#locatorName> a rdf:Property ;
    rdfs:label "locator name"@en ;
    dcterms:identifier "oslo:locatorName" ;
    rdfs:comment "Proper noun(s) applied to the real world entity identified by the locator. The locator name could be the name of the property or complex, of the building or part of the building, or it could be the name of a room inside a building. The domain of oslo:locatorName is oslo:ExtendedAddress."@en ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#ExtendedAddress> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <http://www.w3.org/ns/locn#locn;locatorName> .

<http://purl.org/oslo/ns/localgov#locatorNumber> a rdf:Property ;
    rdfs:label "locator number"@en ;
    dcterms:identifier "oslo:locatorNumber" ;
    rdfs:comment "A number or a sequence of characters that uniquely identifies the locator within the relevant scope(s). This is typically an identification for the locator in the thoroughfare (most of the times a street or square)."@en ;
    rdfs:domain <http://www.w3.org/ns/locn#Address> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <http://www.w3.org/ns/locn#locatorDesignator> .

<http://purl.org/oslo/ns/localgov#mailingLocation> a rdf:Property ;
    rdfs:label "mailing location"@en ;
    dcterms:identifier "oslo:mailingLocation" ;
    ns3:domainIncludes <http://purl.org/oslo/ns/localgov#Membership>,
        <http://purl.org/oslo/ns/localgov#Organization> ;
    rdfs:comment "Points to a mailing location"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.org/oslo/ns/localgov#ResidenceObject> .

<http://purl.org/oslo/ns/localgov#membershipFunction> a rdf:Property ;
    rdfs:label "membership function"@en ;
    dcterms:identifier "oslo:membershipFunction" ;
    rdfs:comment "Function label of a membership"@en ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#Membership> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

<http://purl.org/oslo/ns/localgov#membershipType> a rdf:Property ;
    rdfs:label "type of membership"@en ;
    dcterms:identifier "oslo:membershipType" ;
    rdfs:comment "Type of a membership"@en ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#Membership> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf dc:type .

<http://purl.org/oslo/ns/localgov#nobelityTitle> a rdf:Property ;
    rdfs:label "nobelity title"@en ;
    dcterms:identifier "oslo:nobelityTitle" ;
    rdfs:comment "Nobelity title of a person"@en ;
    rdfs:domain <http://www.w3.org/ns/person#Person> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

<http://purl.org/oslo/ns/localgov#orgStatus> a rdf:Property ;
    rdfs:label "KBO Organisation status"@en ;
    dcterms:identifier "oslo:orgStatus" ;
    rdfs:comment "A KBO Organisation status"@en ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#Organization> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept .

<http://purl.org/oslo/ns/localgov#parcel> a rdf:Property ;
    rdfs:label "parcel "@en ;
    dcterms:identifier "oslo:parcel" ;
    ns3:domainIncludes <http://purl.org/oslo/ns/localgov#Building>,
        <http://purl.org/oslo/ns/localgov#ResidenceObject> ;
    rdfs:comment "Parcel linked to a building or a residence object."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.org/oslo/ns/localgov#Parcel> .

<http://purl.org/oslo/ns/localgov#parcelId> a rdf:Property ;
    rdfs:label "parcel ID"@en ;
    dcterms:identifier "oslo:parcelId" ;
    rdfs:comment "The concept of adding a globally unique identifier for each instance of a parcel is a crucial part of the OSLO data spec. The domain of oslo:parcelId is oslo:Parcel."@en ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#Parcel> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.w3.org/ns/adms#Identifier> .

<http://purl.org/oslo/ns/localgov#poBox> a rdf:Property ;
    rdfs:label "po box"@en ;
    dcterms:identifier "oslo:poBox" ;
    rdfs:comment "The Post Office Box number. The domain of oslo:poBox is oslo:ExtendedAddress."@en ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#ExtendedAddress> ;
    rdfs:isDefinedBy <http://www.w3.org/ns/locn#> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <http://www.w3.org/ns/locn#poBox> .

<http://purl.org/oslo/ns/localgov#productType> a rdf:Property ;
    rdfs:label "type of product"@en ;
    dcterms:identifier "oslo:productType" ;
    rdfs:comment "Type of a product"@en ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#Product> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf dc:type .

<http://purl.org/oslo/ns/localgov#providesRole> a rdf:Property ;
    rdfs:label "provides role"@en ;
    rdfs:comment "This very general property links an Public Service to a Role."@en ;
    rdfs:domain <http://purl.org/vocab/cpsv#PublicService> ;
    rdfs:range <http://purl.org/oslo/ns/localgov#Role> .

<http://purl.org/oslo/ns/localgov#province> a rdf:Property ;
    rdfs:label "province"@en ;
    dcterms:identifier "oslo:province" ;
    rdfs:comment "The province of the address. The domain of \\n    oslo:province is oslo:ExtendedAddress and the range is a literal, conceptually \\n  defined by the <a xmlns=\"http://purl.org/oslo/ns/localgov#\" =\"https://inspire-twg.jrc.ec.europa.eu/inspire-fc.html#_C2612\">INSPIRE Geographical Name data type</a>." ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#ExtendedAddress> ;
    rdfs:isDefinedBy <http://www.w3.org/ns/locn#> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <http://www.w3.org/ns/locn#adminUnitL2> .

<http://purl.org/oslo/ns/localgov#reasonShutDown> a rdf:Property ;
    rdfs:label "reason shutdown"@en ;
    dcterms:identifier "oslo:reasonShutDown" ;
    rdfs:comment "Reason for shutdown of an organization"@en ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#Organization> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

<http://purl.org/oslo/ns/localgov#residence> a rdf:Property ;
    rdfs:label "residence"@en ;
    dcterms:identifier "oslo:residence" ;
    rdfs:comment "The range of residence is ResidenceObject."@en ;
    rdfs:domain <http://www.w3.org/ns/person#Person> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.org/oslo/ns/localgov#ResidenceObject> .

<http://purl.org/oslo/ns/localgov#result> a rdf:Property ;
    rdfs:label "Public Service Result"@en ;
    dcterms:identifier "oslo:result" ;
    rdfs:comment "Result of the public service process."@en ;
    rdfs:domain <http://purl.org/vocab/cpsv#PublicService> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept .

<http://purl.org/oslo/ns/localgov#shutDownDate> a rdf:Property ;
    rdfs:label "date of shutdown"@en ;
    dcterms:identifier "oslo:shutDownDate" ;
    rdfs:comment "Date of shutdown of an organization"@en ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#Organization> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

<http://purl.org/oslo/ns/localgov#status> a rdf:Property ;
    rdfs:label "Public Service Status"@en ;
    dcterms:identifier "oslo:result" ;
    rdfs:comment "Status of the public service process."@en ;
    rdfs:domain <http://purl.org/vocab/cpsv#PublicService> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.org/oslo/ns/localgov#Status> .

<http://purl.org/oslo/ns/localgov#statusCode> a rdf:Property ;
    rdfs:label "Statuscode"@en ;
    dcterms:identifier "oslo:statusCode" ;
    rdfs:comment "Statuscode"@en ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#Status> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf dc:type .

<http://purl.org/oslo/ns/localgov#statusType> a rdf:Property ;
    rdfs:label "type of status"@en ;
    dcterms:identifier "oslo:statusType" ;
    rdfs:comment "Type of a status"@en ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#Status> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf dc:type .

<http://purl.org/oslo/ns/localgov#targetDate> a rdf:Property ;
    rdfs:label "Target date"@en ;
    dcterms:identifier "oslo:targetDate" ;
    rdfs:comment "Targetdate for a public service to process its input and produce output"@en ;
    rdfs:domain <http://purl.org/vocab/cpsv#PublicService> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

<http://purl.org/oslo/ns/localgov#toOrganization> a rdf:Property ;
    rdfs:label "to"@en ;
    rdfs:comment "to relation"@en ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#OrganizationRelation> ;
    rdfs:range <http://purl.org/oslo/ns/localgov#Organization> .

<http://purl.org/oslo/ns/localgov#toPerson> a rdf:Property ;
    rdfs:label "to"@en ;
    rdfs:comment "to relation"@en ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#PersonRelation> ;
    rdfs:range <http://purl.org/oslo/ns/localgov#Person> .

<http://purl.org/oslo/ns/localgov#validityPeriod> a rdf:Property ;
    rdfs:label "validity period"@en ;
    dcterms:identifier "oslo:validityPeriod" ;
    rdfs:comment "Points to a time interval"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range time: .

<http://purl.org/vocab/cpsv#follows> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "follows"@en ;
    rdfs:comment "The follows property links a service to the Rule(s) under which it operates."@en ;
    rdfs:range <http://purl.org/vocab/cpsv#Rule> .

<http://purl.org/vocab/cpsv#hasInput> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has input"@en ;
    rdfs:comment "The hasInput property links a Public Service to one or more instances of the Input class (see below). A specific service may require the presence of certain inputs or combinations of inputs in order to operate. These should be described in an application profile for a given service."@en ;
    rdfs:range <http://purl.org/vocab/cpsv#Input> .

<http://purl.org/vocab/cpsv#produces> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "produces"@en ;
    rdfs:comment "The produces property links a Public Service to one or more instances of the Output class which is its range."@en ;
    rdfs:range <http://purl.org/vocab/cpsv#Output> .

ns1:birthDate a rdf:Property ;
    rdfs:label "date of birth"@en ;
    dcterms:identifier "schema:birthDate" ;
    vann:usageNote "A date that specifies the birth date of a person. The date \\n    should be provided as a literal and data typed if applicable."@en ;
    rdfs:comment "The schema:birthDate property fully represents the Person Core Vocabulary term of date of birth"@en ;
    rdfs:isDefinedBy <http://schema.org/docs/schemaorg.owl> .

ns1:deathDate a rdf:Property ;
    rdfs:label "date of death"@en ;
    dcterms:identifier "schema:deathDate" ;
    vann:usageNote "A date that specifies the death date of a person. The date should be \\n    provided as a literal and data typed if applicable."@en ;
    rdfs:comment "The schema:deathDate property fully represents the Person Core Vocabulary term of date of death."@en ;
    rdfs:isDefinedBy <http://schema.org/docs/schemaorg.owl> .

ns1:gender a rdf:Property ;
    rdfs:label "gender"@en ;
    dcterms:identifier "schema:gender" ;
    vann:usageNote "The gender of an individual should be recorded using a controlled vocabulary \\n    that is appropriate for the specific context. In some cases the chromosomal or physical state of an \\n    individual will be more important than the gender that they express, in others the reverse will be true. \\n    What is always important is that the controlled vocabulary used to describe an individual's gender \\n    is stated explicitly. To do this use a skos:Concept as described in the <a xmlns=\"http://purl.org/oslo/ns/localgov#\" =\"#skos:Concept\">Code</a> class.\\n    The <a =\"https://joinup.ec.europa.eu/system/files/project/Core_Vocabularies-Business_Location_Person-Specification-v0.3_0.zip\">Person Core Vocabulary</a> includes an example of such a SKOS concept scheme." ;
    rdfs:comment "The schema:gender property fully represents the Person Core Vocabulary term of the same name."@en ;
    rdfs:isDefinedBy <http://schema.org/docs/schemaorg.owl> .

rdfs:seeAlso a rdf:Property ;
    rdfs:label "geographic identifier"@en ;
    dcterms:identifier "rdfs:seeAlso" ;
    vann:usageNote "Used in the Location Core vocabulary to provide a URI that identifies the location. \\n    This should be expressed using the rdfs:seeAlso property unless the identifier is already the subject of the description. \\n    Examples include URIs from <a xmlns=\"http://purl.org/oslo/ns/localgov#\" =\"http://www.geonames.org/\">GeoNames.org</a> and <a =\"http://dbpedia.org/\">DBpedia</a> \\n    such as http://dbpedia.org/resource/ISO_3166-2:XX where XX is the ISO 3166 two character code for a country." ;
    rdfs:comment "rdfs:seeAlso fully represents the Location Core Vocabulary concept of a geographic identifier."@en ;
    rdfs:isDefinedBy onto: .

<http://www.w3.org/ns/adms#identifies> a rdf:Property ;
    rdfs:label "identifies"@en ;
    dcterms:identifier "adms:identifies" ;
    vann:usageNote "The identifies relation is used to link an adms:Identifier class to whatever resource it identifies (such as a business or a person)."@en ;
    rdfs:comment "adms:identifies fully represents the Core Vocabulary property of the same name"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/adms#> .

<http://www.w3.org/ns/locn#address> a rdf:Property ;
    rdfs:label "address"@en ;
    dcterms:identifier "locn:address" ;
    rdfs:comment "The locn:address property relationship associates any resource with the <a xmlns=\"http://purl.org/oslo/ns/localgov#\" =\"#locn:Address\">Address</a> Class" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/locn#> ;
    rdfs:range <http://www.w3.org/ns/locn#Address> .

<http://www.w3.org/ns/locn#geographicName> a rdf:Property ;
    rdfs:label "geographic name"@en ;
    dcterms:identifier "locn:geographicName" ;
    rdfs:comment "<p xmlns=\"http://purl.org/oslo/ns/localgov#\">A geographic name is a proper noun applied to a spatial object. Taking the example used in the <a =\"http://inspire.jrc.ec.europa.eu/documents/Data_Specifications/INSPIRE_DataSpecification_GN_v3.0.1.pdf\">INSPIRE document</a> (page 18), the following are all valid geographic names for the Greek capital:</p>\\n    <ul><li>A?n?a (the Greek endonym written in the Greek script)</li><li>Athina (the standard Romanisation of the endonym)</li><li>Athens (the English language exonym)</li></ul>\\n    <p>For INSPIRE-conformant data, provide the metadata for the geographic name using a skos:Concept as a datatype.</p>" ;
    rdfs:domain dcterms:Location ;
    rdfs:isDefinedBy <http://www.w3.org/ns/locn#> ;
    rdfs:range rdf:Literal ;
    ns2:describedby <https://joinup.ec.europa.eu/system/files/project/Core_Vocabularies-Business_Location_Person-Specification-v0.3_0.zip> .

<http://www.w3.org/ns/locn#geometry> a rdf:Property ;
    rdfs:label "geometry"@en ;
    dcterms:identifier "locn:geometry" ;
    vann:usageNote "\\n      <p xmlns=\"http://purl.org/oslo/ns/localgov#\">Depending on how a geometry is encoded (see usage note of the <a =\"#locn:Geometry\">locn:Geometry</a> class), the range of this property may be either a literal (e.g., WKT - string literal -, GML, KML - XML literal) or a geometry class, as those defined in the OGC's <a =\"http://www.w3.org/2011/02/GeoSPARQL.pdf\">GeoSPARQL specification</a>, in the W3C's <a =\"http://www.w3.org/2003/01/geo/wgs84_pos#\">Basic Geo (WGS84 lat/long) vocabulary</a>, and at <a =\"http://schema.org/\">schema.org</a>, or even the <a =\"http://geohash.org/\">GeoHash</a> URI references.</p>\\n      <p>The following are examples of equivalent statements using different geometry encodings:</p>\\n      <ul>\\n        <li><p>WKT (GeoSPARQL)</p>\\n          <pre>&lt;ex:a&gt; locn:geometry\\n  \"&lt;http://www.opengis.net/def/crs/OGC/1.3/CRS84&gt; Point(-0.001475 51.477811)\"^^ogc:WKTLiteral .</pre>\\n        </li>\\n        <li><p>GML</p>\\n          <pre>&lt;ex:a&gt; locn:geometry\\n  \"&lt;gml:Point srsName='http://www.opengis.net/def/crs/OGC/1.3/CRS84'&gt;\\n  &lt;gml:coordinates&gt;-0.001475, 51.477811&lt;/gml:coordinates&gt;&lt;/gml:Point&gt;\"^^ogc:GMLLiteral .</pre>\\n        </li>\\n        <li><p>RDF+WKT (GeoSPARQL)</p>\\n          <pre>&lt;ex:a&gt; locn:geometry\\n  [ a ogc:Point; ogc:asWKT \"&lt;http://www.opengis.net/def/crs/OGC/1.3/CRS84&gt; Point(-0.001475 51.477811)\"^^ogc:WKTLiteral ] .</pre>\\n        </li>\\n        <li><p>RDF+GML (GeoSPARQL)</p>\\n          <pre>&lt;ex:a&gt; locn:geometry\\n  [ a ogc:Point; ogc:asGML\\n     \"&lt;gml:Point srsName='http://www.opengis.net/def/crs/OGC/1.3/CRS84'&gt;\\n      &lt;gml:coordinates&gt;-0.001475, 51.477811&lt;/gml:coordinates&gt;&lt;/gml:Point&gt;\"^^ogc:GMLLiteral ] .</pre>\\n        </li>\\n        <li><p>RDF (WGS84 lat/long)</p>\\n          <pre>&lt;ex:a&gt; locn:geometry [ a geo:Point; geo:lat \"51.477811\"; geo:long \"-0.001475\" ] .</pre>\\n        </li>\\n        <li><p>RDF (schema.org)</p>\\n          <pre>&lt;ex:a&gt; locn:geometry [ a schema:GeoCoordinates; schema:latitude \"51.477811\"; schema:longitude \"-0.001475\" ] .</pre>\\n        </li>\\n        <li><p>URI reference (GeoHash)</p>\\n          <pre>&lt;ex:a&gt; locn:geometry &lt;<a =\"http://geohash.org/gcpuzgnzvxkp\">http://geohash.org/gcpuzgnzvxkp</a>&gt; .</pre>\\n        </li>\\n      </ul>\\n" ;
    rdfs:comment "Associates any <a xmlns=\"http://purl.org/oslo/ns/localgov#\" =\"#dcterms:Location\">Location</a> with the locn:Geometry class." ;
    rdfs:domain dcterms:Location,
        <http://purl.org/oslo/ns/localgov#Building>,
        <http://purl.org/oslo/ns/localgov#Parcel> ;
    rdfs:isDefinedBy <http://www.w3.org/ns/locn#> ;
    rdfs:range <http://www.w3.org/ns/locn#Geometry> ;
    ns2:describedby <https://joinup.ec.europa.eu/system/files/project/Core_Vocabularies-Business_Location_Person-Specification-v0.3_0.zip> .

<http://www.w3.org/ns/locn#postCode> a rdf:Property ;
    rdfs:label "post code"@en ;
    dcterms:identifier "locn:postCode" ;
    rdfs:comment "The post code (a.k.a postal code, zip code etc.). Post codes are common elements in many countries' postal address systems. The domain of locn:postCode is locn:Address."@en ;
    rdfs:domain <http://www.w3.org/ns/locn#Address> ;
    rdfs:isDefinedBy <http://www.w3.org/ns/locn#> ;
    rdfs:range rdfs:Literal .

<http://www.w3.org/ns/locn#postName> a rdf:Property ;
    rdfs:label "post name"@en ;
    dcterms:identifier "locn:postName" ;
    rdfs:comment "The key postal division of the address, usually the city. (INSPIRE's definition is \"One or more names created and maintained for postal purposes to identify a subdivision of addresses and postal delivery points.\") The domain of locn:postName is locn:Address."@en ;
    rdfs:domain <http://www.w3.org/ns/locn#Address> ;
    rdfs:isDefinedBy <http://www.w3.org/ns/locn#> ;
    rdfs:range rdfs:Literal .

<http://www.w3.org/ns/locn#thoroughfare> a rdf:Property ;
    rdfs:label "thoroughfare"@en ;
    dcterms:identifier "locn:thoroughfare" ;
    rdfs:comment "An address component that represents the name of a passage or way through from one location to another. A thoroughfare is not necessarily a road, it might be a waterway or some other feature. The domain of locn:thoroughfare is locn:Address."@en ;
    rdfs:domain <http://www.w3.org/ns/locn#Address> ;
    rdfs:isDefinedBy <http://www.w3.org/ns/locn#> ;
    rdfs:range rdfs:Literal .

org:hasSite a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has site"@en ;
    rdfs:comment "Indicates a site at which the Organization has some presence even if only indirect (e.g. virtual office or a professional service which is acting as the registered address for a company). Inverse of `org:siteOf`."@en ;
    rdfs:domain org:Organization ;
    rdfs:isDefinedBy <http://www.w3.org/ns/org> ;
    owl:inverseOf org:siteOf .

org:member a rdf:Property,
        owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "member"@en,
        "membre"@fr ;
    rdfs:comment "Indicates the Person (or other Agent including Organization) involved in the Membership relationship. Inverse of `org:hasMembership`"@en,
        "Indique une personne (ou tout autre Agent, y compris une Organisation) impliquÃ© dans la relation d'Engagement. Inverse de `org:hasMembership`"@fr ;
    rdfs:domain org:Membership ;
    rdfs:isDefinedBy <http://www.w3.org/ns/org> ;
    rdfs:range foaf:Agent ;
    owl:inverseOf org:hasMembership .

org:organization a rdf:Property,
        owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "organization"@en,
        "organisation"@fr ;
    rdfs:comment "Indicates Organization in which the Agent is a member."@en,
        "Indique l'Organization dont l'agent est membre."@fr ;
    rdfs:domain org:Membership ;
    rdfs:isDefinedBy <http://www.w3.org/ns/org> ;
    rdfs:range org:Organization .

<http://www.w3.org/ns/person#birthName> a rdf:Property ;
    rdfs:label "birth name"@en ;
    dcterms:identifier "person:birthName" ;
    rdfs:comment "All data associated with an individual are subject to change. Names can change for \\n    a variety of reasons, either formally or informally, and new information may come to light that means that \\n    a correction or clarification can be made to an existing record. Birth names tend to be persistent \\n    however and for this reason they are recorded by some public sector information systems. There is \\n    no granularity for birth name - the full name should be recorded in a single field."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/person#> .

<http://www.w3.org/ns/person#citizenship> a rdf:Property ;
    rdfs:label "citizenship"@en ;
    dcterms:identifier "person:citizenship" ;
    rdfs:comment "The range of citizenship is dcterms:Jurisdiction."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/person#> ;
    rdfs:range dcterms:Jurisdiction .

<http://www.w3.org/ns/person#countryOfBirth> a rdf:Property ;
    rdfs:label "country of birth"@en ;
    dcterms:identifier "person:countryOfBirth" ;
    rdfs:comment "The range of country of birth is dcterms:Location and schema:Place."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/person#> ;
    rdfs:range dcterms:Location,
        ns1:Place,
        <http://www.w3.org/ns/locn#Location> .

<http://www.w3.org/ns/person#countryOfDeath> a rdf:Property ;
    rdfs:label "country of death"@en ;
    dcterms:identifier "person:countryOfDeath" ;
    rdfs:comment "The range of country of death is dcterms:Location and schema:Place."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/person#> ;
    rdfs:range dcterms:Location,
        ns1:Place ;
    ns2:describedby <https://joinup.ec.europa.eu/system/files/project/Core_Vocabularies-Business_Location_Person-Specification-v0.3_0.zip> .

<http://www.w3.org/ns/person#patronymicName> a rdf:Property ;
    rdfs:label "patronymic name"@en ;
    dcterms:identifier "person:patronymicName" ;
    rdfs:comment "Patronymic names are important in some countries. Iceland \\n    does not have a concept of family name in the way that many other European countries \\n    do, for example. In Bulgaria and Russia, patronymic names are in every day usage, \\n    for example, the \"Sergeyevich\" (?????????) in \"Mikhail Sergeyevich Gorbachev\" \\n    (?????? ????????? ????????)."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/person#> .

<http://www.w3.org/ns/person#placeOfBirth> a rdf:Property ;
    rdfs:label "place of birth"@en ;
    dcterms:identifier "person:placeOfBirth" ;
    rdfs:comment "The range of place of birth is dcterms:Location and schema:Place."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/person#> ;
    rdfs:range dcterms:Location,
        ns1:Place .

<http://www.w3.org/ns/person#placeOfDeath> a rdf:Property ;
    rdfs:label "place of death"@en ;
    dcterms:identifier "person:placeOfDeath" ;
    rdfs:comment "The range of place of death is dcterms:Location and schema:Place."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/person#> ;
    rdfs:range dcterms:Location,
        ns1:Place .

<http://www.w3.org/ns/regorg#legalName> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "legal name"@en ;
    dcterms:identifier "rov:legalName" ;
    rdfs:comment "The legal name of the business. A business might have more than one \\n      legal name, particularly in countries with more than one official language. In such cases the \\n      language of the string should be identified."@en,
        "The legal name of the business. A business might have more than one \\n    legal name, particularly in countries with more than one official language. In such cases the \\n    language of the string should be identified."@en ;
    rdfs:isDefinedBy <http://www.w3.org/TR/vocab-regorg/>,
        <http://www.w3.org/ns/regorg#> ;
    rdfs:range rdfs:Literal .

<http://www.w3.org/ns/regorg#orgActivity> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "org activity"@en ;
    dcterms:identifier "legal:orgActivity",
        "rov:orgActivity" ;
    rdfs:comment "The activity of an organisation should be recorded using a controlled vocabulary expressed\\n    as a SKOS concept scheme (see <a xmlns=\"http://purl.org/oslo/ns/localgov#\" =\"#skos:Concept\">Code</a>. Several such \\n    vocabularies exist, many of which map to the UN's ISIC codes. Where a particular controlled vocabulary is in use \\n    within a given context, such as SIC codes in the UK, it is acceptable to use these, however, the preferred \\n    choice for European interoperability is NACE.",
        "The activity of a company should be \\n      recorded using a controlled vocabulary expressed as a SKOS concept scheme. Several such \\n      vocabularies exist, many of which map to the UN's ISIC codes. Where a particular controlled vocabulary is in use \\n      within a given context, such as SIC codes in the UK, it is acceptable to use these, however, the preferred \\n      choice for European interoperability is NACE. rov:companyActivity is a sub class of org:classification which has a range of skos:Concept."@en ;
    rdfs:isDefinedBy <http://www.w3.org/TR/vocab-regorg/>,
        <http://www.w3.org/ns/regorg#> ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf org:classification .

<http://www.w3.org/ns/regorg#orgStatus> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "org status"@en ;
    dcterms:identifier "legal:orgStatus",
        "rov:orgStatus" ;
    rdfs:comment "Terms like insolvent, bankrupt and in receivership are likely to have \\n    different legal implications in different jurisdictions. Best Practice for recording various \\n    other status levels is to use the relevant jurisdiction's terms and to do so in a \\n    consistent manner using a skos:Concept as described in the <skos:a xmlns:skos=\"http://www.w3.org/2004/02/skos/core#\" =\"http://www.w3.org/2004/02/skos/core#Concept\">Concept</skos:a> Class. \\n    The term \"Normal Activity\" appears to have cross-border usefulness \\n    and this should be used in preference to terms like trading or operating.",
        "Terms like insolvent, bankrupt and in receivership are likely to have \\n      different legal implications in different jurisdictions. Best Practice for recording various \\n      other status levels is to use the relevant jurisdiction's terms and to do so in a \\n      consistent manner using a SKOS Concept Scheme. rov:orgStatcompanyus is a sub class of org:classification\\n      which has a range of skos:Concept."@en ;
    rdfs:isDefinedBy <http://www.w3.org/TR/vocab-regorg/>,
        <http://www.w3.org/ns/regorg#> ;
    rdfs:range <http://purl.org/oslo/ns/Code> ;
    rdfs:subPropertyOf org:classification .

<http://www.w3.org/ns/regorg#registration> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "registration"@en ;
    dcterms:identifier "rov:registration" ;
    rdfs:comment "The legal status of a registered organization is conferred on it by an authority within a given \\n      jurisdiction. The registration is therefore a fundamental relationship between a the organization and the authority with \\n      which it is registered. The details of the registration are provided as properties of the Identifier class which is \\n      defined by ADMS. The vocabulary sets no restriction on the type of legal identifier. In many countries, the business register's \\n      identifier is the relevant data point. The tax number often fulfils this function in Spain and elsewhere.\\n      Although there is no formal cardinality constraint on any property in the Registered Organization Vocabulary, it is \\n      questionable whether a description of a registered organization without this property and an associated Identifier class will \\n      be of any value."@en ;
    rdfs:domain <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    rdfs:isDefinedBy <http://www.w3.org/ns/regorg#> ;
    rdfs:subPropertyOf <http://www.w3.org/ns/adms#identifier> .

foaf:familyName a rdf:Property ;
    rdfs:label "family name"@en ;
    dcterms:identifier "foaf:familyName" ;
    vann:usageNote "A family name is usually shared by members of a family. This attribute also carries prefixes or suffixes which are part of the Family Name, e.g. \"de Boer\", \"van de Putte\", \"von und zu Orlow\". Multiple family names, such as are commonly found in Hispanic countries, are recorded in the single Family Name field so that, for example, Miguel de Cervantes Saavedra's Family Name would be recorded as \"Cervantes Saavedra.\""@en ;
    rdfs:comment "The foaf:familyName property fully represents the Person Core Vocabulary term of family name"@en ;
    rdfs:isDefinedBy <http://xmlns.com/foaf/spec/> .

foaf:givenName a rdf:Property ;
    rdfs:label "given name"@en ;
    dcterms:identifier "foaf:givenName" ;
    vann:usageNote "A given name, or multiple given names, are the denominator(s) that identify an individual \\n    within a family. These are given to a person by his or her parents at birth or may be legally recognised \\n    for example, the given name for Johan Sebastian Bach is 'Johan Sebastian.'"@en ;
    rdfs:comment "The foaf:givenName property fully represents the Person Core Vocabulary term of given name"@en ;
    rdfs:isDefinedBy <http://xmlns.com/foaf/spec/> .

foaf:name a rdf:Property ;
    rdfs:label "name"@en ;
    dcterms:identifier "foaf:name" ;
    vann:usageNote "The full name contains the complete name of a person \\n    as one string. In addition to the content of given name, family name and, in some \\n    systems, patronymic name, this can carry additional parts of a person's name \\n    such as titles, middle names or suffixes like \"the third\" or names which are neither \\n    a given nor a family name."@en ;
    rdfs:comment "The foaf:name property fully represents the Person Core Vocabulary term of full name"@en ;
    rdfs:isDefinedBy <http://xmlns.com/foaf/spec/> .

<http://purl.org/oslo> rdfs:label "OSLO Vocabulary" .

org:hasMembership a owl:ObjectProperty .

org:siteOf a rdf:Property .

<http://www.w3.org/ns/regorg#orgType> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "organization type"@en ;
    dcterms:identifier "legal:orgType",
        "rov:orgType" ;
    rdfs:comment "This property records the type of company. Familiar types are SA, PLC, LLC, GmbH etc. Each \\n    jurisdiction will have a limited set of recognised company types and these should be used in a consistent manner\\n    using a skos:Concept as described in the <skos:a xmlns:skos=\"http://www.w3.org/2004/02/skos/core#\" =\"http://www.w3.org/2004/02/skos/core#Concept\">Code</skos:a> Class.",
        "This property records the type of company. Familiar types are SA, PLC, LLC, GmbH etc. Each \\n      jurisdiction will have a limited set of recognized company types and these should be used in a consistent manner\\n      using a SKOS Concept Scheme. rov:orgType is a sub class of org:classification which has a range of skos:Concept."@en ;
    rdfs:isDefinedBy <http://www.w3.org/TR/vocab-regorg/>,
        <http://www.w3.org/ns/regorg#> ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf org:classification .

<https://joinup.ec.europa.eu/category/licence/isa-open-metadata-licence-v11> ns5:attributionName "European Commission" ;
    ns5:attributionURL <http://ec.europa.eu/> ;
    dcterms:title "ISA Open Metadata Licence v1.1" .

<https://joinup.ec.europa.eu/elibrary/document/isa-deliverable-process-and-methodology-developing-core-vocabularies> dcterms:title "Process and Methodology for Developing Core Vocabularies" .

<http://www.w3.org/ns/locn#location> a rdf:Property ;
    rdfs:label "location"@en ;
    dcterms:identifier "locn:location" ;
    rdfs:comment "The location property links any resource to the Location Class. \\n    Asserting the location relationship implies only that the domain has some connection to a \\n    Location in time or space. It does not imply that the resource is necessarily at that location \\n    at the time when the assertion is made."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/locn#> ;
    rdfs:range dcterms:Location .

<https://joinup.ec.europa.eu/system/files/project/Core_Vocabularies-Business_Location_Person-Specification-v0.3_0.zip> dcterms:title "Person Core Vocabulary" .

onto: a ns6:Vocabulary,
        owl:Ontology ;
    rdfs:label "OSLO Exchange Standard"^^xsd:string ;
    ns5:attributionName "V-ICT-OR"^^xsd:string ;
    ns5:attributionURL <http://purl.org/oslo>,
        <http://www.v-ict-or.be> ;
    dcterms:abstract "This version of the OSLO Exchange Standard provides a minimum set of classes and properties for describing a natural person, i.e. the individual as opposed to any role they may play in society or the relationships they have to other people, organisations and property; all of which contribute significantly to the broader concept of identity. The vocabulary is closely integrated with the Person, Organisation and Location Vocabularies published by the W3C in the Gov Linked Data Project."^^xsd:string ;
    dcterms:conformsTo <https://joinup.ec.europa.eu/elibrary/document/isa-deliverable-process-and-methodology-developing-core-vocabularies> ;
    dcterms:creator [ ns1:affiliation [ foaf:name "V-ICT-OR/OSLO" ] ;
            foaf:homepage <http://be.linkedin.com/pub/raf-buyle/3/86/959/> ;
            foaf:name "Raf Buyle" ],
        [ ns1:affiliation [ foaf:name "Ghent University - iMinds - Multimedia Lab" ] ;
            foaf:homepage <http://be.linkedin.com/pub/laurensdv/> ;
            foaf:name "Laurens De Vocht" ] ;
    dcterms:description "This is the RDF encoding of the OSLO Vocabulary developed under the OSLO (Open Standards for Local Administrations) Programme."^^xsd:string ;
    dcterms:license <https://joinup.ec.europa.eu/category/licence/isa-open-metadata-licence-v11> ;
    dcterms:modified "2014-05-30"^^xsd:date ;
    dcterms:rights "Copyright (c) 2013-2014 V-ICT-OR.",
        "Copyright Â© 2013-2014 V-ICT-OR"^^xsd:string ;
    vann:preferredNamespacePrefix "oslo",
        "oslo"@en ;
    vann:preferredNamespaceUri "http://purl.org/oslo/ns/localgov#" ;
    ns6:reliesOn dcterms:,
        <http://www.opengis.net/rdf#> ;
    ns7:imports <http://topbraid.org/spin/owlrl-all>,
        <http://topbraid.org/spin/rdfsplus> ;
    ns4:last onto: ;
    rdfs:comment "This file specifies the set of RDF classes and properties used in the OSLO exchange standard for local administrations in Flanders."^^xsd:string ;
    owl:versionInfo "Version 1.1.0 30 May 2014"^^xsd:string ;
    ns2:describedby <https://joinup.ec.europa.eu/system/files/project/Core_Vocabularies-Business_Location_Person-Specification-v0.3_0.zip> ;
    foaf:depiction <http://purl.org/oslo/model> ;
    foaf:maker [ foaf:name "Open Standards for Linking Governments Working Group (V-ICT-OR, OSLO)" ;
            foaf:page <http://www.v-ict-or.be/kenniscentrum/OSLO> ] .

