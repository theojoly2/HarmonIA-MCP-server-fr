    rdfs:domain <http://purl.org/oslo/ns/localgov#Role> ;
    rdfs:range <http://purl.org/oslo/ns/localgov#Permission> .

<http://purl.org/oslo/ns/localgov#invoiceLocation> a rdf:Property ;
