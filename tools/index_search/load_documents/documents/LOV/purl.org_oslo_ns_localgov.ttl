@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://schema.org/> .
@prefix ns2: <http://www.w3.org/2007/05/powder-s#> .
@prefix ns3: <http://www.lingvoj.org/olca#> .
@prefix ns4: <http://www.w3.org/1999/xhtml/vocab#> .
@prefix ns5: <http://creativecommons.org/ns#> .
@prefix ns6: <http://purl.org/vocommons/voaf#> .
@prefix ns7: <http://spinrdf.org/spin#> .
@prefix onto: <http://purl.org/oslo/ns/localgov> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:Location a rdfs:Class ;
    rdfs:label "Location"@en ;
    dcterms:identifier "dcterms:Location" ;
    vann:usageNote "This is the key class for the Location Core Vocabulary and represents any location, irrespective of size or other restriction."@en ;
    rdfs:comment "dcterms:Location class fully represents the Location Core Vocabulary class of Location."@en ;
    rdfs:isDefinedBy dcterms: .

<http://purl.org/oslo/ns/localgov#BasicAddress> a rdfs:Class ;
    rdfs:label "BasicAddress"@en ;
    dcterms:identifier "oslo:BasicAddress" ;
    rdfs:comment "An \"address representation\" as defined in the <a xmlns=\"http://purl.org/oslo/ns/localgov#\" =\"https://inspire-twg.jrc.ec.europa.eu/inspire-fc.html#_C2538\">data specifications</a> of the EU INSPIRE Directive. The <a =\"#locn:addressId\">locn:addressId</a> property may be used to link this Address to other representations. This address extends the address with additional information" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.w3.org/ns/locn#Address> ;
    ns2:describedby <https://joinup.ec.europa.eu/system/files/project/Core_Vocabularies-Business_Location_Person-Specification-v0.3_0.zip> .

<http://purl.org/oslo/ns/localgov#Building> a rdfs:Class ;
    rdfs:label "Building"@en ;
    dcterms:identifier "oslo:Building" ;
    vann:usageNote "Use this class to represent information about a building."@en ;
    rdfs:comment "Information related to a Building"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf owl:Thing .

<http://purl.org/oslo/ns/localgov#ExtendedAddress> a rdfs:Class ;
    rdfs:label "ExtendedAddress"@en ;
    dcterms:identifier "oslo:ExtendedAddress" ;
    rdfs:comment "An \"address representation\" as defined in the <a xmlns=\"http://purl.org/oslo/ns/localgov#\" =\"https://inspire-twg.jrc.ec.europa.eu/inspire-fc.html#_C2538\">data specifications</a> of the EU INSPIRE Directive. The <a =\"#locn:addressId\">locn:addressId</a> property may be used to link this Address to other representations. This address extends the address with additional information" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.w3.org/ns/locn#Address> ;
    ns2:describedby <https://joinup.ec.europa.eu/system/files/project/Core_Vocabularies-Business_Location_Person-Specification-v0.3_0.zip> .

<http://purl.org/oslo/ns/localgov#Membership> a rdfs:Class ;
    rdfs:label "Membership"@en ;
    dcterms:identifier "oslo:Membership" ;
    rdfs:comment "This is the key class for the Business Core Vocabulary and represents a \\n    business that is legally registered. In many countries there is a single registry although in others, \\n    such as Spain and Germany, multiple registries exist. A Legal Entity is able to trade, is \\n    legally liable for its actions, accounts, tax affairs etc. It is a sub class of org:FormalOrganization\\n    which covers a wider range of entities, such as charities."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf org:Membership .

<http://purl.org/oslo/ns/localgov#Organization> a rdfs:Class ;
    rdfs:label "Organization"@en ;
    dcterms:identifier "oslo:Organization" ;
    rdfs:comment "This is the key class for the Business Core Vocabulary and represents a \\n    business that is legally registered. In many countries there is a single registry although in others, \\n    such as Spain and Germany, multiple registries exist. A Legal Entity is able to trade, is \\n    legally liable for its actions, accounts, tax affairs etc. It is a sub class of org:FormalOrganization\\n    which covers a wider range of entities, such as charities."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.w3.org/ns/regorg#RegisteredOrganization> .

<http://purl.org/oslo/ns/localgov#OrganizationRelation> a rdfs:Class,
        owl:Class ;
    rdfs:label "OrganizationnRelation"@en ;
    dcterms:identifier "oslo:OrganizationRelation" ;
    rdfs:comment "A relation between two organizations"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://purl.org/oslo/ns/localgov#Relation> .

<http://purl.org/oslo/ns/localgov#Parcel> a rdfs:Class ;
    rdfs:label "Parcel"@en ;
    dcterms:identifier "oslo:Parcel" ;
    vann:usageNote "Use this class to contain the parcels in."@en ;
    rdfs:comment "Information related to a Parcel Address or Label"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Parcel> .

<http://purl.org/oslo/ns/localgov#Permission> a rdfs:Class,
        owl:Class ;
    rdfs:label "Permission"@en ;
    dcterms:identifier "oslo:Permission" ;
    rdfs:comment "Denotes a the permission of a role. Should be linked with a formal rule."@en ;
    rdfs:isDefinedBy onto: .

<http://purl.org/oslo/ns/localgov#PersonRelation> a rdfs:Class,
        owl:Class ;
    rdfs:label "PersonRelation"@en ;
    dcterms:identifier "oslo:PersonRelation" ;
    rdfs:comment "A relation between two persons"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://purl.org/oslo/ns/localgov#Relation> .

<http://purl.org/oslo/ns/localgov#Relation> a rdfs:Class,
        owl:Class ;
    rdfs:label "Relation"@en ;
    dcterms:identifier "oslo:Relation" ;
    rdfs:comment "A relation between two agents"@en ;
    rdfs:isDefinedBy onto: .

<http://purl.org/oslo/ns/localgov#ResidenceObject> a rdfs:Class ;
    rdfs:label "Residence Object"@en ;
    dcterms:identifier "oslo:ResidenceObject" ;
    vann:usageNote "This is the key class for the Location Core Vocabulary and represents any location that has an address, a building and a parcel."@en ;
    rdfs:comment "This is the key class for the OSLO Location Vocabulary and represents a \\n      location that is linked with an address and/or a building with parcel(s)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf dcterms:Location .

<http://purl.org/oslo/ns/localgov#Role> a rdfs:Class,
        owl:Class ;
    rdfs:label "Role"@en ;
    dcterms:identifier "oslo:Role" ;
    rdfs:comment "Denotes a role that a Person or other Agent can take in an public service. Instances of this class describe the abstract role; to denote a specific instance of a person playing that role in a specific public service use an instance of `Permission` that is linked with the formal rules `Rule`."@en ;
    rdfs:isDefinedBy onto: .

<http://purl.org/oslo/ns/localgov#Status> a rdfs:Class,
        owl:Class ;
    rdfs:label "Status"@en ;
    dcterms:identifier "oslo:Status" ;
    rdfs:comment "Status of Public Service"@en ;
    rdfs:isDefinedBy onto: .

<http://purl.org/vocab/cpsv#Input> a rdfs:Class,
        owl:Class ;
    rdfs:label "Input"@en ;
    rdfs:comment "Inputs can by any resource - document, artefact - anything. In a specific context it is likely to be useful to either define a sub class or declare the particular resource to also be of another type as well. A general case might be a foaf:Document but where possible, it is better to refer to a controlled vocabulary of types. dcterms:type should be used to use to provide this information linking to a SKOS Concept."@en .

<http://purl.org/vocab/cpsv#Output> a rdfs:Class,
        owl:Class ;
    rdfs:label "Output"@en ;
    rdfs:comment "Outputs can by any resource - document, artefact - anything. In a specific context it is likely to be useful to either define a sub class or declare the particular resource to also be of another type as well. A general case might be a foaf:Document but where possible, it is better to refer to a controlled vocabulary of types. dcterms:type should be used to use to provide this information linking to a SKOS Concept."@en .

<http://purl.org/vocab/cpsv#PublicService> a rdfs:Class,
        owl:Class ;
    rdfs:label "Public Service"@en ;
    rdfs:comment "This class represents the service itself. As noted in the scope (section 1.4), a public service is the capacity to carry out a procedure and exists whether it is used or not. It is a set of deeds and acts performed by or on behalf of a public agency for the benefit of a citizen, a business or another public agency."@en .

<http://purl.org/vocab/cpsv#Rule> a rdfs:Class,
        owl:Class ;
    rdfs:label "Rule"@en ;
    rdfs:comment "The Rule class represents the specific rules, guidelines or procedures that the Public Service follows. Instances of the Rule class are FRBR Expressions, that is, a concrete expression, such as a document, of the more abstract concept of the rules themselves."@en ;
    rdfs:subClassOf <http://purl.org/vocab/frbr/core#Expression> .

skos:Concept a rdfs:Class ;
    rdfs:label "Concept"@en ;
    dcterms:identifier "skos:Concept" ;
    rdfs:comment "<p xmlns=\"http://purl.org/oslo/ns/localgov#\">The Conceptual Model includes a 'Code' datatype that \\n      is used for the types of relation and membership properties. This is expressed using the <a =\"http://www.w3.org/TR/skos-primer/\">SKOS vocabulary</a> with\\n      a particular 'code' usually being a skos:Concept that is part of a scheme. \\n      The intention is that the skos:Concepts class be used as follows;</p><skos:ul xmlns:skos=\"http://www.w3.org/2004/02/skos/core#\">\\n        <skos:li>for the content property, use skos:notation</skos:li>\\n        <skos:li>the 'list' property will be taken care of by means of the skos:inScheme property;</skos:li>\\n        <skos:li>the list agency property is likely to be applied to the scheme as a whole for which dcterms:creator is appropriate;</skos:li>\\n        <skos:li>the list version property can be fulfilled using schema:version (see <skos:a =\"http://schema.org/CreativeWork\">http://schema.org/CreativeWork</skos:a>)</skos:li></skos:ul>\\n" ;
    rdfs:isDefinedBy <http://www.w3.org/TR/skos-primer/> .

<http://www.w3.org/ns/adms#Identifier> a rdfs:Class ;
    rdfs:label "Identifier"@en ;
    dcterms:identifier "adms:Identifier" ;
    vann:usageNote "<p xmlns=\"http://purl.org/oslo/ns/localgov#\">The Identifier class represents any identifier issued by any authority, whether a \\n      government agency or not. It captures the identifier itself and details of the issuing authority, \\n      the date on which the identifier was issued and so on.</p>\\n      <p>This class is based on the UN/CEFACT Identifier complex type defined in See Section 5.8 of \\n        <a =\"http://www.unece.org/fileadmin/DAM/cefact/codesfortrade/CCTS/CCTS-DTCatalogueVersion3p1.pdf\">Core Components Data Type Catalogue Version 3.1</a></p>\\n      <p>The various conceptual properties can be fulfilled as follows:</p><ul>\\n        <li>use <a =\"http://www.w3.org/2004/02/skos/core##notation\">skos:notation</a> to provide the actual identifier (the \\n          Identifier class is effectively meaningless without this property and conceptually it is mandatory);</li>\\n        <li>use <a =\"http://purl.org/dc/terms/type\">dcterms:type</a> to provide an identifier for the type of identifier issued;</li>\\n        <li>use <a =\"http://purl.org/dc/terms/created\">dcterms:created</a> to provide the date on which the identifier was issued.</li>\\n        <li>use <a =\"#schemeagency\">adms:schemeAgency</a> to provide the name of the agency that created the identifier (as an rdfs:Literal).</li>\\n        <li>use <a =\"http://purl.org/dc/terms/creator\">dcterms:creator</a> to link to a URI of an Agent class describing the issuing Agency;</li></ul>" ;
    rdfs:comment "The ADMS class of Identifier fully represents the Business Core Vocabulary term of the same name"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/adms#> .

<http://www.w3.org/ns/locn#Address> a rdfs:Class ;
    rdfs:label "Address"@en ;
    dcterms:identifier "locn:Address" ;
    rdfs:comment "An \"address representation\" as defined in the <a xmlns=\"http://purl.org/oslo/ns/localgov#\" =\"https://inspire-twg.jrc.ec.europa.eu/inspire-fc.html#_C2538\">data specifications</a> of the EU INSPIRE Directive. The <a =\"#locn:addressId\">locn:addressId</a> property may be used to link this Address to other representations." ;
    rdfs:isDefinedBy <http://www.w3.org/ns/locn#> ;
    ns2:describedby <https://joinup.ec.europa.eu/system/files/project/Core_Vocabularies-Business_Location_Person-Specification-v0.3_0.zip> .

<http://www.w3.org/ns/locn#Geometry> a rdfs:Class ;
    rdfs:label "Geometry"@en ;
    dcterms:identifier "locn:Geometry" ;
    vann:usageNote "This class defines the notion of \"geometry\" at the conceptual level, and it shall be encoded by using different formats. For interoperability reasons, it is recommended using one of the following:\\n      <ul xmlns=\"http://purl.org/oslo/ns/localgov#\">\\n        <li><p>Any geometry:</p>\\n          <ul>\\n            <li>WKT, GML, and RDF+WKT/GML, as per the <a =\"http://www.w3.org/2011/02/GeoSPARQL.pdf\">GeoSPARQL specification</a>.</li>\\n            <li><a =\"http://www.opengeospatial.org/standards/kml\">KML (Keyhole Markup Language)</a> - note that KML supports the following geometries only: point, line string, linear ring, and polygon.</li>\\n            <li>RDF as per the <a =\"http://schema.org/\">schema.org</a> vocabulary (see classes <a =\"http://schema.org/GeoCoordinates\">schema:GeoCoordinates</a> and <a =\"http://schema.org/GeoShape\">schema:GeoShape</a>).</li>\\n          </ul>\\n        </li>\\n        <li><p>Points: one of the above, or:</p>\\n          <ul>\\n            <li>RDF as per the <a =\"http://www.w3.org/2003/01/geo/wgs84_pos#\">W3C Basic Geo (WGS84 lat/long) vocabulary</a>.</li>\\n            <li><a =\"http://geohash.org/\">GeoHash</a> URI references.</li>\\n          </ul>\\n        </li>\\n      </ul>\\n" ;
    rdfs:comment "The Geometry Class provides the means to identify a Location as a point, line, polygon, etc. expressed using coordinates in some coordinate reference system."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/locn#> .

org:Organization a rdfs:Class ;
    rdfs:label "Organization"@en ;
    dcterms:identifier "org:Organization" ;
    rdfs:comment "Represents a collection of people organized together into a community or other social, commercial or political structure. The group has some common purpose or reason for existence which goes beyond the set of people belonging to it and can act as an Agent. Organizations are often decomposable into hierarchical structures.  It is recommended that SKOS lexical labels should be used to label the Organization. In particular `skos:prefLabel` for the primary (possibly legally recognized name), `skos:altLabel` for alternative names (trading names, colloquial names) and `skos:notation` to denote a code from a code list. Alternative names: _Collective_ _Body_ _Org_ _Group_"@en ;
    rdfs:isDefinedBy org: ;
    owl:equivalentClass foaf:Organization .

org:Site a rdfs:Class ;
    rdfs:label "Site"@en ;
    dcterms:identifier "org:Site" ;
    rdfs:comment "An office or other premise at which the organization is located. Many organizations are spread across multiple sites and many sites will host multiple locations. In most cases a Site will be a physical location. However, we don't exclude the possibility of non-physical sites such as a virtual office with an associated post box and phone reception service. Extensions may provide subclasses to denote particular types of site."@en ;
    rdfs:isDefinedBy org: .

<http://www.w3.org/ns/person#Person> a rdfs:Class ;
    rdfs:label "Person"@en ;
    dcterms:identifier "person:Person" ;
    rdfs:comment "An individual person who may be dead or alive, \\n    but not imaginary. It is that restriction that makes person:Person a\\n    sub class of both foaf:Person and schema:Person which both cover imaginary\\n    characters as well as real people."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/person#> ;
    rdfs:subClassOf ns1:Person,
        foaf:Person .

dcterms:alternative a rdf:Property ;
    rdfs:label "alternative name"@en ;
    dcterms:identifier "dcterms:alternative" ;
    vann:usage "Any name by which an individual is known. Many individuals use a short form of their name, a \"middle\" name as a \"first\" name or a professional name. For example, the British politician and former UN High Representative for Bosnia and Herzegovina, Jeremy John Durham Ashdown, Baron Ashdown of Norton-sub-Hamdon, is usually referred to simply as Paddy Ashdown or Lord Ashdown. "@en ;
    vann:usageNote "It is not the role of the alternative name field to record nick names, \\n    pet names or other 'familiar names' that will be of no consequence in public sector data exchange (foaf:nick would be appropriate for that)."@en,
        "Some jurisdictions recognise concepts such as a trading name or alternative forms of a legal entity's name. The Alternative Name property can be used to record such names but should not be used to record translations of the primary legal name. Where more than one legal name exists and where they have equal standing but are expressed in different languages, identify the language used in each of the multiple legal names."@en ;
    rdfs:comment "The dcterms:alternative property fully represents the Business Core Vocabulary property of alternative name."@en,
        "The dcterms:alternative property fully represents the Person Core Vocabulary property of alternative name."@en,
        "The dcterms:alternative property fully represents the \\n      Registered Organization vocabulary property of alternative name. Some jurisdictions recognize concepts such as \\n      a trading name or alternative forms of a legal entity's name. The alternative name property can be \\n      used to record such names but should not be used to record translations of the primary legal name. \\n      Where more than one legal name exists and where they have equal standing but are expressed in \\n      different languages, identify the language used in each of the multiple legal names."@en ;
    rdfs:isDefinedBy <http://dublincore.org/documents/dcmi-terms/>,
        <http://purl.org/oslo/ns/dublincore.org/documents/dcmi-terms/>,
        <http://www.w3.org/ns/person#> ;
    ns2:describedby <https://joinup.ec.europa.eu/system/files/project/Core_Vocabularies-Business_Location_Person-Specification-v0.3_0.zip> .

dcterms:identifier a rdf:Property ;
    rdfs:label "identifer"@en ;
    dcterms:identifier "dcterms:identifier" ;
    vann:usageNote "The identifier relation is used to link a person to any formally issued identifier for that person."@en,
        "The identifier relation links a resource to any formally issued identifier for that resource other than one that confers legal status upon it. The range is adms:Identifier."@en ;
    rdfs:comment "dcterms:identifier fully represents the Core Vocabulary property of the same name"@en ;
    rdfs:isDefinedBy <http://dublincore.org/documents/dcmi-terms/> .

<http://purl.org/oslo/ns/localgov#address> a rdf:Property ;
    rdfs:label "addres "@en ;
    dcterms:identifier "oslo:address" ;
    rdfs:comment "Parcel linked to a building or a residence object."@en ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#ResidenceObject> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.org/oslo/ns/localgov#BasicAddress> .

<http://purl.org/oslo/ns/localgov#addressArea> a rdf:Property ;
    rdfs:label "address area"@en ;
    dcterms:identifier "oslo:addressArea" ;
    rdfs:comment "The name or names of a geographic area or locality that groups a number of addressable objects for addressing purposes, without being an administrative unit. This would typically be part of a city, a neighbourhood or village. The domain of oslo:addressArea is oslo:Address."@en ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#ExtendedAddress> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <http://www.w3.org/ns/locn#addressArea> .

<http://purl.org/oslo/ns/localgov#addressId> a rdf:Property ;
    rdfs:label "address ID"@en ;
    dcterms:identifier "oslo:addressId" ;
    rdfs:comment "The concept of adding a globally unique identifier for each instance of an address is a crucial part of the INSPIRE data spec. The domain of oslo:addressId is locn:Address."@en ;
    rdfs:domain <http://www.w3.org/ns/locn#Address> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.w3.org/ns/adms#Identifier> .

<http://purl.org/oslo/ns/localgov#adminUnit> a rdf:Property ;
    rdfs:label "Administrative Unit"@en ;
    dcterms:identifier "oslo:adminUnit" ;
    rdfs:comment "Admin Unit linked to an address"@en ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#BasicAddress> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept .

<http://purl.org/oslo/ns/localgov#authenticLocation> a rdf:Property ;
    rdfs:label "authentic location"@en ;
    dcterms:identifier "oslo:invoiceLocation" ;
    rdfs:comment "Points to a authentic location"@en ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#Organization> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.org/oslo/ns/localgov#ResidenceObject> ;
    rdfs:subPropertyOf <http://www.w3.org/ns/locn#location> .

<http://purl.org/oslo/ns/localgov#availableAt> a rdf:Property ;
    rdfs:label "availableAt"@en ;
    dcterms:identifier "oslo:availableAt" ;
    rdfs:comment "Points to a residence"@en ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#Membership> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.org/oslo/ns/localgov#ResidenceObject> ;
    rdfs:subPropertyOf <http://www.w3.org/ns/locn#location> .

<http://purl.org/oslo/ns/localgov#building> a rdf:Property ;
    rdfs:label "building "@en ;
    dcterms:identifier "oslo:building" ;
    rdfs:comment "Building linked to a residence object."@en ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#ResidenceObject> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.org/oslo/ns/localgov#Building> .

<http://purl.org/oslo/ns/localgov#buildingId> a rdf:Property ;
    rdfs:label "building ID"@en ;
    dcterms:identifier "oslo:buldingId" ;
    rdfs:comment "The concept of adding a globally unique identifier for each instance of a building is a crucial part of the OSLO data spec. The domain of oslo:buildingId is oslo:Building."@en ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#Building> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.w3.org/ns/adms#Identifier> .

<http://purl.org/oslo/ns/localgov#civilClass> a rdf:Property ;
    rdfs:label "civil classs"@en ;
    dcterms:identifier "oslo:civilClass" ;
    rdfs:comment "The range of place of death is a code."@en ;
    rdfs:domain <http://www.w3.org/ns/person#Person> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept .

<http://purl.org/oslo/ns/localgov#contact> a rdf:Property ;
    rdfs:label "contact information"@en ;
    dcterms:identifier "oslo:contact" ;
    ns3:domainIncludes <http://purl.org/oslo/ns/localgov#Membership>,
        <http://purl.org/oslo/ns/localgov#Organization>,
        <http://www.w3.org/ns/person#Person> ;
    rdfs:comment "Depicts the contact information for a person, organizaton or membership"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.w3.org/2006/vcard/ns#VCard> .

<http://purl.org/oslo/ns/localgov#country> a rdf:Property ;
    rdfs:label "country"@en ;
    dcterms:identifier "oslo:country",
        "urn:x-inspire:specification:gmlas:BaseTypes:3.2:adminUnit" ;
    vann:usageNote "Best practice is to use the ISO 3166-1 code but if this is inappropriate for the context, country names should be provided in a consistent manner to reduce ambiguity. For example, either write 'United Kingdom' or 'UK' consistently throughout the data set and avoid mixing the two.    "@en ;
    rdfs:comment "The uppermost administrative unit for the address, almost always a country. The domain of locn:adminUnitL1 is locn:Address and the range is a literal, conceptually defined by the <a xmlns=\"http://purl.org/oslo/ns/localgov#\" =\"https://inspire-twg.jrc.ec.europa.eu/inspire-fc.html#_C2612\">INSPIRE Geographical Name data type</a>." ;
    rdfs:domain <http://www.w3.org/ns/locn#Address> ;
    rdfs:isDefinedBy <http://www.w3.org/ns/locn#> ;
    rdfs:subPropertyOf <http://www.w3.org/ns/locn#adminUnitL1> .

<http://purl.org/oslo/ns/localgov#deliveryLocation> a rdf:Property ;
    rdfs:label "delivery location"@en ;
    dcterms:identifier "oslo:deliveryLocation" ;
    rdfs:comment "Points to a delivery location"@en ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#Organization> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.org/oslo/ns/localgov#ResidenceObject> ;
    rdfs:subPropertyOf <http://www.w3.org/ns/locn#location> .

<http://purl.org/oslo/ns/localgov#domicile> a rdf:Property ;
    rdfs:label "domicile"@en ;
    dcterms:identifier "oslo:domicile" ;
    rdfs:comment "The range of domicile is ResidenceObject."@en ;
    rdfs:domain <http://www.w3.org/ns/person#Person> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.org/oslo/ns/localgov#ResidenceObject> .

<http://purl.org/oslo/ns/localgov#establishmentDate> a rdf:Property ;
    rdfs:label "date of establishment"@en ;
    dcterms:identifier "oslo:establishmentDate" ;
    rdfs:comment "Date of establishment of an organization"@en ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#Organization> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

<http://purl.org/oslo/ns/localgov#extended_address> a rdf:Property ;
    rdfs:label "extended address"@en ;
    dcterms:identifier "locn:address" ;
    rdfs:comment "The oslo:extended_address property relationship associates an <a xmlns=\"http://purl.org/oslo/ns/localgov#\" =\"#oslo:ExtendedAddress\">Extended Address</a> with a <a =\"#locn:Address\">Address</a> Class" ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#BasicAddress> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.org/oslo/ns/localgov#ExtendedAddress> .

<http://purl.org/oslo/ns/localgov#extended_addressId> a rdf:Property ;
    rdfs:label "extended address ID"@en ;
    dcterms:identifier "oslo:extended_addressId" ;
    rdfs:comment "The concept of adding a globally unique identifier for each instance of an address is a crucial part of the INSPIRE data spec. The domain of oslo:extended_addressId is oslo:ExtendedAddress."@en ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#ExtendedAddress> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.w3.org/ns/adms#Identifier> .

<http://purl.org/oslo/ns/localgov#fromOrganization> a rdf:Property ;
    rdfs:label "from"@en ;
    rdfs:comment "from relation"@en ;
    rdfs:domain <http://purl.org/oslo/ns/localgov#OrganizationRelation> ;
