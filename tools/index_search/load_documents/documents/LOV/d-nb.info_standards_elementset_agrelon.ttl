    ns1:term_status "stable" ;
    ns2:correspondsToInverse ns2:HasIsMuse .

ns2:isPatronOf a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "is patron of"@en ;
    rdfs:comment "A person or corporation (subject) sponsors/favours a person or corporation (object; e.g. an artist or group of artists)."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subPropertyOf ns2:hasProfessionalContact ;
    ns1:term_status "stable" ;
    ns2:correspondsTo ns2:IsHasPatron .

ns2:hasAncestor a rdf:Property,
        owl:TransitiveProperty ;
    rdfs:label "has ancestor"@en ;
    rdfs:comment "A person (subject) has an ancestor (object), where the chain of parent-relations might include adoptive, foster, illegitimate, step relations."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subPropertyOf ns2:hasRelative ;
    owl:inverseOf ns2:hasOffspring ;
    ns1:term_status "stable" ;
    ns2:correspondsToInverse ns2:HasOffspringAncestor .

ns2:hasSpiritualContact a rdf:Property,
        owl:SymmetricProperty ;
    rdfs:label "has spiritual contact"@en ;
    rdfs:comment "A person or spiritual entity (subject) has some kind of spiritual relation with a person or spiritual entity (object). The relationship may e.g. be channelling, guru-devotee, or a psychoanalyst-patient."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subPropertyOf ns2:relatedAgent ;
    ns1:term_status "stable" ;
    ns2:correspondsTo ns2:HasSpiritualContact .

ns2:hasAcquaintance a rdf:Property,
        owl:SymmetricProperty ;
    rdfs:label "has acquaintance"@en ;
    rdfs:comment "A person (subject) privately knows a person (object)."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subPropertyOf ns2:relatedAgent ;
    owl:equivalentProperty <https://d-nb.info/standards/elementset/gnd#acquaintanceshipOrFriendship> ;
    ns1:term_status "stable" ;
    ns2:correspondsTo ns2:HasAcquaintance ;
    ns2:hasGndCode "beza" .

ns2:hasOffspring a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has offspring"@en ;
    rdfs:comment "A person (subject) has an offspring (object), where the chain of child-relations might include adoptive, foster, illegitimate, step relations."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subPropertyOf ns2:hasRelative ;
    ns1:term_status "stable" ;
    ns2:correspondsTo ns2:HasOffspringAncestor .

ns2:hasVitalLethalContact a rdf:Property,
        owl:SymmetricProperty ;
    rdfs:label "has vital or lethal contact"@en ;
    rdfs:comment "A person or corporate body (subject) has som kind of vital or lethal relation with a person or corporate body (object). The relationship may e.g. include healing, mutilating, life saving, killing."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subPropertyOf ns2:relatedAgent ;
    ns1:term_status "stable" ;
    ns2:correspondsTo ns2:HasVitalLethalContact .

ns2:hasChild a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has child"@en ;
    rdfs:comment "A person has as some kind of child a person (object)."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subPropertyOf ns2:hasOffspring ;
    ns1:term_status "stable" ;
    ns2:correspondsTo ns2:HasChildParent .

ns2:hasInlaw a rdf:Property,
        owl:SymmetricProperty ;
    rdfs:label "has in-law"@en ;
    rdfs:comment "A person (subject) is related with a person (object) by a marriage between themselves or between relatives."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subPropertyOf ns2:hasRelative ;
    ns1:term_status "stable" ;
    ns2:correspondsTo ns2:HasInlaw .

ns2:hasAssociate a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has group affiliation"@en ;
    rdfs:comment "A person (subject) is associated with a group (object), or a group (subject) is associated with a person (object)."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subPropertyOf ns2:relatedAgent ;
    owl:equivalentProperty <https://d-nb.info/standards/elementset/gnd#affiliation> ;
    ns1:term_status "stable" ;
    ns2:correspondsTo ns2:HasAssociate ;
    ns2:hasGndCode "affi" .

ns2:hasParent a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has parent"@en ;
    rdfs:comment "A person has as some kind of parent a person (object)."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subPropertyOf ns2:hasAncestor ;
    owl:inverseOf ns2:hasChild ;
    ns1:term_status "stable" ;
    ns2:correspondsToInverse ns2:HasChildParent .

ns2:hasSibling a rdf:Property,
        owl:SymmetricProperty ;
    rdfs:label "has sibling"@en ;
    rdfs:comment "A person has as some kind of sibling a person (object)."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subPropertyOf ns2:hasRelative ;
    ns1:term_status "stable" ;
    ns2:correspondsTo ns2:HasSibling .

ns2:relatedAgent a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "related Agent"@en ;
    rdfs:comment "A person or corporation (subject) has some kind of relation with a person or corporation (object)."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subPropertyOf <https://d-nb.info/standards/elementset/gnd#relatedTerm> ;
    ns1:term_status "stable" ;
    ns2:correspondsTo ns2:RelatedAgent .

ns2:hasRelative a rdf:Property,
        owl:SymmetricProperty ;
    rdfs:label "has relative"@en ;
    rdfs:comment "A person (subject) is kin to a person (object). This denotes not only biological kinship, but also inlaw, adoptive, step, foster relationships."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subPropertyOf ns2:relatedAgent ;
    owl:equivalentProperty <https://d-nb.info/standards/elementset/gnd#familialRelationship> ;
    ns1:term_status "stable" ;
    ns2:correspondsTo ns2:HasRelative ;
    ns2:hasGndCode "bezf" .

ns2:hasProfessionalContact a rdf:Property,
        owl:SymmetricProperty ;
    rdfs:label "has professional contact"@en ;
    rdfs:comment "A person or corporation (subject) has some business/profession/occupation related relation with a person or corporation (object)."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subPropertyOf ns2:relatedAgent ;
    owl:equivalentProperty <https://d-nb.info/standards/elementset/gnd#professionalRelationship> ;
    ns1:term_status "stable" ;
    ns2:correspondsTo ns2:HasProfessionalContact ;
    ns2:hasGndCode "bezb" .

ns2: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:Ontology ;
    ns3:license <http://creativecommons.org/publicdomain/zero/1.0/> ;
    dc:description "\\nThe ontology of agent relationships (AgRelOn) defines relations of persons to other persons\\nand to organisations, since agents (persons, organisations) and their interconnections are important \\nin the cultural heritage domain. AgRelOn is developed to foster uniform cataloging as well as \\nsemantic searchability of and via relations between agents. Therefore, a general set of nearly \\n70 relationhip types is provided. AgRelOn discerns private acquaintanceship, group affiliation, \\ncorrespondence, occupational contact, kinship, spiritual contact, and vital/lethal contact. \\nFor these kinds of relations more specific sub-relations are formulated.\\nMeta statements are supported to obtain transparency of reliability and provenance as well as validity \\nperiod of facts.\\nThe modelled relations are determined on the one hand by exemplary knowledge base searches, on the other \\nhand by available data sources. Hence, the model consciously is incomplete and pertinent to a cultural \\narea and period."@en,
        "\\nThe ontology of agent relationships, AgRelOn, defines relations of persons to other persons and to organisations, since agents (persons, organisations) and their interconnections are important in the cultural heritage domain. AgRelOn is developed to foster uniform cataloging as well as semantic searchability of and via relations between agents. Therefore, a general set of nearly 70 relationhip types is provided. AgRelOn discerns private acquaintanceship, group affiliation, correspondence, occupational contact,  kinship, spiritual contact, and vital/lethal contact. For these kinds of relations more specific sub-relations are formulated.\\nMeta statements are supported to obtain transparency of reliability and provenance as well as validity period of facts.\\nThe modelled relations are determined on the one hand by exemplary knowledge base searches, on the other hand by available data sources. Hence, the model consciously is incomplete and pertinent to a cultural area and period."@en ;
    dc:title "AgRelOn, an Agent Relationship Ontology"@en ;
    dcterms:available "2019-10-15"^^xsd:date ;
    dcterms:contributor ns2:berenikeLitz,
        ns2:larsGSvensson ;
    dcterms:creator ns2:aenneLoehden ;
    dcterms:issued "2011-06-30"^^xsd:date ;
    dcterms:license <http://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:modified "2019-06-13T10:24:00+02:00"^^xsd:dateTime ;
    dcterms:publisher <http://ld.zdb-services.de/resource/organisations/DE-101> ;
    dcterms:rights "Copyright 2013-2019 Deutsche Nationalbibliothek" ;
    vann:preferredNamespacePrefix "agrelon" ;
    vann:preferredNamespaceUri "https://d-nb.info/standards/elementset/agrelon#" ;
    rdfs:comment "\\n\\t\\t\\tChanges from 2019-06-18 to 2019-10-15\\n\\t\\t\\tAll d-nb.info-URIs changed from http to https\\n\\t\\t\\t\\n\\t\\t\\tChanges from 2018-10-16\\n\\t\\t\\tUpdated labels in agrelon:hasGrandParent, agrelon:hasStepParent,\\n\\t\\t\\t\\tagrelon:HasAdoptiveChildParent, agrelon:HasChildParentInlaw, \\n\\t\\t\\t\\tagrelon:hasFosterParent, agrelon:HasStepChildParent,\\n\\t\\t\\t\\tagrelon:HasFosterChildParent, agrelon:hasAdoptiveParent,\\n\\t\\t\\t\\tagrelon:HasGrandChildParent, agrelon:HasFosterParent,\\n\\t\\t\\t\\tagrelon:HasBiologicalChildParent, agrelon:hasIllegitimateParent,\\n\\t\\t\\t\\tagrelon:hasBiologicalParent, agrelon:HasIllegitimateChildParent\\n\\t\\t\\t\\n\\t\\t\\tChanges from 2018-05-15\\n\\t\\t\\tMinor terminology changes in labels\\n\\t\\t\\tAdded alignments to GNDO:\\n\\t\\t\\tagrelon:relatedAgent rdfs:subPropertyOf gndo:relatedTerm\\n\\t\\t\\tagrelon:hasAcquaintance owl:equivalentProperty gndo:acquaintanceshipOrFriendship (beza)\\n\\t\\t\\tagrelon:hasAssociate owl:equivalentProperty gndo:affiliation (affi)\\n\\t\\t\\tagrelon:hasCorrespondent owl:equivalentProperty gndo:correspondent (gndo:correspondent == corr -- in AgRelOn zu ergänzen)\\n\\t\\t\\tagrelon:hasProfessionalContact owl:equivalentProperty gndo:professionalRelationship (bezb)\\n\\t\\t\\tagrelon:hasPatron rdfs:subPropertyOf gndo:sponsorOrPatron\\n\\t\\t\\tagrelon:hasRelative owl:equivalentProperty gndo:familialRelationship (bezf)\\n\\t\\t\\tagrelon:hasBeginDate rdfs:subPropertyOf gndo:associatedDate\\n\\t\\t\\tagrelon:hasEndDate rdfs:subPropertyOf gndo:associatedDate\\n\\t\\t\\t\\n            Changes from 2017-01-17\\n            agrelon:hasGodChild and agrelon:hasGodParent are now subproperties of agrelon:hasRelative and not of agrelon:hasNieceOrNephew resp. agrelon:hasAuntOrUncle  \\n\\t\\t\\t\\n            Changes from 2013-06-30\\n\\t\\t\\t\\n\\t\\t\\tagrelon:hasGndCode is now an annotation property\\n\\t\\t\\tminor bugfix to ensure that the correct datatype is used for dates.\\n\\t\\t"@en,
        "∼∼∼ Modelling Guidelines ∼∼∼ \\nVocabulary elements (properties and concepts) are conceived gender neutral.\\nThe identifiers of properties are preferably hasProperty and invers isPropertyOf or hasInverseProperty. \\nDomains and ranges of properties are mostly not fixed.\\nInstance relations (object properties) are mostly specified bidirectionally.\\nImplicit, deducable instance relations are explicitly formulated.\\nProperties partly allow imperfect information (e.g. fragmentary dates, names instead of object URIs).\\nCorrelations between instance relations, like inversity, transitivity, symmetry, hierarchie, are marked.\\nMeta statements are exhibited by modelling person relations as n-ary concepts as well as as properties, corresponding n-ary concepts and properties are correlated.\\n"@en ;
    owl:priorVersion onto:2018-10-16 ;
    owl:versionIRI <https://d-nb.info/standards/elementset/agrelon_20190618> ;
    owl:versionInfo "1.5" .

