@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix onto: <https://w3id.org/mdo/calculation/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:contributor a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

onto: a owl:Ontology ;
    dcterms:contributor "Patrick Lambrix"^^xsd:string,
        "Rickard Armiento"^^xsd:string ;
    dcterms:created "2019-11-07" ;
    dcterms:creator "Huanyu Li"^^xsd:string ;
    dcterms:license "https://github.com/huanyu-li/Materials-Design-Ontology/blob/master/LICENSE" ;
    dcterms:title "Materials Design Ontology - Calculation Module"@en ;
    vann:preferredNamespacePrefix "calculation" ;
    vann:preferredNamespaceUri "https://w3id.org/mdo/calculation/1.0/" ;
    rdfs:comment "This is the calculation module of Materials Design Ontology."@en ;
    rdfs:seeAlso "https://github.com/huanyu-li/Materials-Design-Ontology" ;
    owl:imports <https://w3id.org/mdo/core/1.0/> ;
    owl:versionIRI <https://w3id.org/mdo/calculation/1.0/> ;
    owl:versionInfo "1.0"^^xsd:string .

onto:GeneralizedGradientApproximation a owl:Class ;
    rdfs:label "Generalized Gradient Approximation"@en ;
    rdfs:comment "A GeneralizedGradientApproximation is a classification of exchange correlation energy functionals that only use the local value of the electronic density and its gradient."@en ;
    rdfs:subClassOf onto:ExchangeCorrelationEnergyFunctional .

onto:HartreeFockMethod a owl:Class ;
    rdfs:label "Hartree Fock Method"@en ;
    rdfs:comment "A Hartree Fock method is a computational quantum mechanical modelling method used to investigate the electronic structure based on variational search over wave functions."@en ;
    rdfs:subClassOf onto:ComputationalMethod .

onto:HybridGeneralizedGradientApproximation a owl:Class ;
    rdfs:label "Hybrid Generalized Gradient Approximation"@en ;
    rdfs:comment "A hybrid generalized gradient approximation is a classification of exchange correlation energy functionals that combine exact exchange from Hartree–Fock theory with generalized gradient approximation."@en ;
    rdfs:subClassOf onto:HybridFunctional .

onto:HybridmetaGeneralizedGradientApproximation a owl:Class ;
    rdfs:label "Hybrid meta Generalized Gradient Approximation"@en ;
    rdfs:comment "A hybrid meta generalized gradient approximation is a classification of exchange correlation energy functionals that combine exact exchange from Hartree–Fock theory with meta generalized gradient approximation."@en ;
    rdfs:subClassOf onto:HybridFunctional .

onto:LocalDensityApproximation a owl:Class ;
    rdfs:label "Local Density Approximation"@en ;
    rdfs:comment "An LDA is a classification of exchange correlation energy functionals that only use the local value of the electronic density."@en ;
    rdfs:subClassOf onto:ExchangeCorrelationEnergyFunctional .

onto:ParameterName a owl:DatatypeProperty ;
    rdfs:label "parameter name"@en ;
    rdfs:comment "ParameterName represents that a computational method parameter has the name in a string."@en ;
    rdfs:domain onto:ComputationalMethodParameter ;
    rdfs:range xsd:string .

onto:ParameterValue a owl:DatatypeProperty ;
    rdfs:label "parameter value"@en ;
    rdfs:comment "ParameterValue represents that a computational method parameter has the value in a string."@en ;
    rdfs:domain onto:ComputationalMethodParameter ;
    rdfs:range xsd:string .

onto:metaGeneralizedGradientApproximation a owl:Class ;
    rdfs:label "meta Generalized Gradient Approximation"@en ;
    rdfs:comment "A metaGeneralizedGradientApproximation is a classification of exchange correlation energy functionals that only use the local value of the electronic density and its gradient and the Kohn–Sham orbital kinetic energy density."@en ;
    rdfs:subClassOf onto:ExchangeCorrelationEnergyFunctional .

onto:DensityFunctionalTheoryMethod a owl:Class ;
    rdfs:label "Density Functional Theory Method"@en ;
    rdfs:comment "A DFT method is a computational quantum mechanical modelling method used to investigate the electronic structure based on optimization of the energy over electronic densities."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty onto:hasXCFunctional ;
                        owl:someValuesFrom onto:ExchangeCorrelationEnergyFunctional ] [ a owl:Restriction ;
                        owl:allValuesFrom onto:ExchangeCorrelationEnergyFunctional ;
                        owl:onProperty onto:hasXCFunctional ] ) ],
        onto:ComputationalMethod .

onto:hasComputationalMethod a owl:ObjectProperty ;
    rdfs:label "has computational method"@en ;
    rdfs:comment "hasComputationalMethod represents the relationship between a calculation and a computational method it uses."@en ;
    rdfs:domain <https://w3id.org/mdo/core/Calculation> ;
    rdfs:range onto:ComputationalMethod .

<https://w3id.org/mdo/core/Calculation> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass onto:ComputationalMethod ;
            owl:onProperty onto:hasComputationalMethod ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

onto:HybridFunctional a owl:Class ;
    rdfs:label "Hybrid Functional"@en ;
    rdfs:comment "A hybrid functional is a classification of exchange correlation energy functionals that combine exact exchange from HartreeFock theory with another exchange correlation energy approximation."@en ;
    rdfs:subClassOf onto:ExchangeCorrelationEnergyFunctional .

onto:hasParameter a owl:ObjectProperty ;
    rdfs:label "has parameter"@en ;
    rdfs:comment "hasParameter represents the relationship between a calculation and the parameters it has."@en ;
    rdfs:domain onto:ComputationalMethod ;
    rdfs:range onto:ComputationalMethodParameter .

onto:hasXCFunctional a owl:ObjectProperty ;
    rdfs:label "has XC functional"@en ;
    rdfs:comment "hasXCFunctional represents the relationship between a density functional theory method and the exchange-correlation energy functionals it takes."@en ;
    rdfs:domain onto:DensityFunctionalTheoryMethod ;
    rdfs:range onto:ExchangeCorrelationEnergyFunctional .

onto:ComputationalMethod a owl:Class ;
    rdfs:label "Computational Method"@en ;
    rdfs:comment "A computational method is a way to process structures and/or properties into output structures and/or calculated properties."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty onto:hasParameter ;
                        owl:someValuesFrom onto:ComputationalMethodParameter ] [ a owl:Restriction ;
                        owl:allValuesFrom onto:ComputationalMethodParameter ;
                        owl:onProperty onto:hasParameter ] ) ] .

onto:ComputationalMethodParameter a owl:Class ;
    rdfs:label "Computational Method Parameter"@en ;
    rdfs:comment "A computational method parameter is a parameter used in a computational method."@en .

onto:ExchangeCorrelationEnergyFunctional a owl:Class ;
    rdfs:label "Exchange Correlation Energy Functional"@en ;
    rdfs:comment "An ExchangeCorrelationEnergyFunctional is a functional to compute the exchange correlation energy."@en .

