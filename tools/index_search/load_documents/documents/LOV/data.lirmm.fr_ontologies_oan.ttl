        <http://data.lirmm.fr/ontologies/oan/Mandat>,
        <http://data.lirmm.fr/ontologies/oan/Organisme>,
        <http://data.lirmm.fr/ontologies/oan/PositionArticle>,
        <http://data.lirmm.fr/ontologies/oan/Presence>,
        <http://data.lirmm.fr/ontologies/oan/PreuvePresence>,
        <http://data.lirmm.fr/ontologies/oan/QuestionEcrite>,
        <http://data.lirmm.fr/ontologies/oan/Rapport>,
        <http://data.lirmm.fr/ontologies/oan/Reponse>,
        <http://data.lirmm.fr/ontologies/oan/Section>,
        <http://data.lirmm.fr/ontologies/oan/SousSection>,
        <http://data.lirmm.fr/ontologies/oan/TexteLoi> .

<http://data.lirmm.fr/ontologies/oan/Section> a rdfs:Class,
        owl:Class ;
    rdfs:label "Section" ;
    rdfs:comment "La classe \"Section\" représente les différentes sections contenus dans un texte de loi." ;
