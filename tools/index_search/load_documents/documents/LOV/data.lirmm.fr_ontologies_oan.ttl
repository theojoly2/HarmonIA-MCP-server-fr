<http://data.lirmm.fr/ontologies/oan/Chapitre> a rdfs:Class,
        owl:Class ;
    rdfs:label "Chapitre" ;
    rdfs:comment "La classe \"Chapitre\" représente les différents chapitres contenus dans un texte de loi." ;
