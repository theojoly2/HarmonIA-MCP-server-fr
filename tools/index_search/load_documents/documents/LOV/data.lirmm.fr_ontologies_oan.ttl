<http://data.lirmm.fr/ontologies/oan/Organisme> a rdfs:Class,
        owl:Class ;
    rdfs:label "Organisme" ;
    rdfs:comment "La classe \"Organisme\" représente les différents organismes possibles auxquels un député peut appartenir." ;
