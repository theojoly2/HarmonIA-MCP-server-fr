<http://data.lirmm.fr/ontologies/oan/Alinea> a rdfs:Class,
        owl:Class ;
    rdfs:label "Alinea" ;
    rdfs:comment "La classe \"Alinea\" représente les différents alinéas qui sont contenus dans un article." ;
    owl:disjointWith <http://data.lirmm.fr/ontologies/oan/Amendement>,
