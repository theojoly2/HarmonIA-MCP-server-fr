<http://data.lirmm.fr/ontologies/oan/Presence> a rdfs:Class,
        owl:Class ;
    rdfs:label "Présence" ;
    rdfs:comment "La classe \"Presence\" représente la présence d'un député lors d'une commission ou d'une session de l'assemblée nationale." ;
