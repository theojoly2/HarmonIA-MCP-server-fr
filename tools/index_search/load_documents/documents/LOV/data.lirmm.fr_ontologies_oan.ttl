        <http://data.lirmm.fr/ontologies/oan/Seance>,
        <http://data.lirmm.fr/ontologies/oan/SousSection>,
        <http://data.lirmm.fr/ontologies/oan/TexteLoi> .

<http://data.lirmm.fr/ontologies/oan/SousSection> a rdfs:Class,
        owl:Class ;
    rdfs:label "Sous Section" ;
    rdfs:comment "La classe \"SousSection\" représente les sous sections contenus dans un texte de loi." ;
    owl:disjointWith <http://data.lirmm.fr/ontologies/oan/Alinea>,
        <http://data.lirmm.fr/ontologies/oan/Amendement>,
