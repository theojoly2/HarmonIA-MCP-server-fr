        <http://data.lirmm.fr/ontologies/oan/TexteLoi> .

<http://data.lirmm.fr/ontologies/oan/TexteLoi> a rdfs:Class,
        owl:Class ;
    rdfs:label "Texte de Loi" ;
    rdfs:comment "La classe \"TexteLoi\" représente le texte contenu dans une loi. Pour plus de détails voir la classe \"Loi\"." ;
    owl:disjointWith <http://data.lirmm.fr/ontologies/oan/Alinea>,
        <http://data.lirmm.fr/ontologies/oan/Amendement>,
