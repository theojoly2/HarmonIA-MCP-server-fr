<http://data.lirmm.fr/ontologies/oan/Article> a rdfs:Class,
        owl:Class ;
    rdfs:label "Article" ;
    rdfs:comment "La classe \"Article\" représente les différents articles qui peuvent être contenus dans un texte de loi." ;
