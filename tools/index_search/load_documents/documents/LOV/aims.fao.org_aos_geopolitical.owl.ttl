ns1:GDP a owl:DatatypeProperty ;
    ns1:sourceCreator "World Bank"^^xsd:string ;
    ns1:sourceIdentifier "http://data.worldbank.org/indicator/NY.GDP.MKTP.CD"^^xsd:string,
        "http://data.worldbank.org/indicator/NY.GDP.MKTP.CD"@en,
        "http://donnees.banquemondiale.org/indicateur/NY.GDP.MKTP.CD"@fr ;
    ns1:sourceModified "2010-12-16"^^xsd:string ;
    dcterms:description "GDP at purchaser's prices is the sum of gross value added by all resident producers in the economy plus any product taxes and minus any subsidies not included in the value of the products. It is calculated without making deductions for depreciation of fabricated assets or for depletion and degradation of natural resources. Data are in current U.S. dollars. Dollar figures for GDP are converted from domestic currencies using single year official exchange rates. For a few countries where the official exchange rate does not reflect the rate effectively applied to actual foreign exchange transactions, an alternative conversion factor is used. Source: World Bank national accounts data, and OECD National Accounts data files. http://data.worldbank.org/indicator/NY.GDP.MKTP.CD"^^xsd:string ;
    dcterms:source "World Bank http://data.worldbank.org/indicator/NY.GDP.MKTP.CD"^^xsd:string ;
    rdfs:subPropertyOf ns1:hasStatistics .

ns1:HDI a owl:DatatypeProperty ;
    ns1:sourceCreator "UNDP - HDRO"^^xsd:string ;
    ns1:sourceIdentifier "http://hdr.undp.org/en/statistics/hdi/ "^^xsd:string,
        "http://hdr.undp.org/en/statistics/hdi/ "@en,
        "http://hdr.undp.org/fr/statistiques/idh/"@fr ;
    ns1:sourceModified "2010-11-04"^^xsd:string ;
    dcterms:description " composite index measuring average achievement in three basic dimensions of human development—a long and healthy life, knowledge and a decent standard of living. Source: Calculated based on data from UNDESA (2009d), Barro and Lee (2010), UNESCO Institute for Statistics (2010b), World Bank (2010b) and IMF(2010a) . http://hdrstats.undp.org/en/indicators/49806.html"^^xsd:string ;
    dcterms:source "UNDP - HDRO http://hdrstats.undp.org/en/indicators/49806.html"^^xsd:string ;
    rdfs:subPropertyOf ns1:hasStatistics .

