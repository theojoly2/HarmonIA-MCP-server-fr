@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

<http://schema.org#value> a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://w3id.org/dstv#MeasuredValues> <http://w3id.org/dstv#PlannedValues> <http://w3id.org/dstv#ToleranceValues> ) ] ;
    rdfs:range rdfs:Literal .

<http://w3id.org/dstv#BottomReference> a owl:Class ;
    rdfs:isDefinedBy <http://w3id.org/dstv#> ;
    rdfs:subClassOf <http://w3id.org/dstv#DimensionalReference> .

<http://w3id.org/dstv#BottomView> a owl:Class ;
    rdfs:comment "b" ;
    rdfs:subClassOf <http://w3id.org/dstv#ReferenceView> .

<http://w3id.org/dstv#DepthDeviation> a owl:Class ;
    rdfs:isDefinedBy <http://w3id.org/dstv#> ;
    rdfs:subClassOf <http://w3id.org/dstv#DeviationValues> .

<http://w3id.org/dstv#DepthTolerance> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#ToleranceValues> .

<http://w3id.org/dstv#DistanceSUM> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#Distance> .

<http://w3id.org/dstv#DistanceSUMDeviation> a owl:Class ;
    rdfs:isDefinedBy <http://w3id.org/dstv#> ;
    rdfs:subClassOf <http://w3id.org/dstv#DeviationValues> .

<http://w3id.org/dstv#DistanceSUMTolerance> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#ToleranceValues> .

<http://w3id.org/dstv#DistanceX> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#Distance> .

<http://w3id.org/dstv#DistanceXDeviation> a owl:Class ;
    rdfs:isDefinedBy <http://w3id.org/dstv#> ;
    rdfs:subClassOf <http://w3id.org/dstv#DeviationValues> .

<http://w3id.org/dstv#DistanceXTolerance> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#ToleranceValues> .

<http://w3id.org/dstv#DistanceY> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#Distance> .

<http://w3id.org/dstv#DistanceYDeviation> a owl:Class ;
    rdfs:isDefinedBy <http://w3id.org/dstv#> ;
    rdfs:subClassOf <http://w3id.org/dstv#DeviationValues> .

<http://w3id.org/dstv#DistanceYTolerance> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#ToleranceValues> .

<http://w3id.org/dstv#FrontView> a owl:Class ;
    rdfs:comment "f" ;
    rdfs:subClassOf <http://w3id.org/dstv#ReferenceView> .

<http://w3id.org/dstv#MeasuredDepth> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#MeasuredValues> .

<http://w3id.org/dstv#MeasuredDistanceSUM> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#MeasuredValues> .

<http://w3id.org/dstv#MeasuredDistanceX> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#MeasuredValues> .

<http://w3id.org/dstv#MeasuredDistanceY> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#MeasuredValues> .

<http://w3id.org/dstv#PlannedDepth> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#PlannedValues> .

<http://w3id.org/dstv#PlannedDistanceSUM> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#PlannedValues> .

<http://w3id.org/dstv#PlannedDistanceX> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#PlannedValues> .

<http://w3id.org/dstv#PlannedDistanceY> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#PlannedValues> .

<http://w3id.org/dstv#RearView> a owl:Class ;
    rdfs:comment "r" ;
    rdfs:subClassOf <http://w3id.org/dstv#ReferenceView> .

<http://w3id.org/dstv#SymmetricalReference> a owl:Class ;
    rdfs:isDefinedBy <http://w3id.org/dstv#> ;
    rdfs:subClassOf <http://w3id.org/dstv#DimensionalReference> .

<http://w3id.org/dstv#TopReference> a owl:Class ;
    rdfs:isDefinedBy <http://w3id.org/dstv#> ;
    rdfs:subClassOf <http://w3id.org/dstv#DimensionalReference> .

<http://w3id.org/dstv#TopView> a owl:Class ;
    rdfs:comment "t" ;
    rdfs:subClassOf <http://w3id.org/dstv#ReferenceView> .

<http://w3id.org/dstv#describedInIfcFeature> a owl:ObjectProperty ;
    rdfs:domain <http://w3id.org/dstv#TroughHole> ;
    rdfs:range <https://standards.buildingsmart.org/IFC/DEV/IFC4/ADD2_TC1/OWL#IfcVoidingFeature> .

<http://w3id.org/dstv#hasDiameterDeviation> a owl:ObjectProperty ;
    rdfs:domain <http://w3id.org/dstv#Diameter> ;
    rdfs:range <http://w3id.org/dstv#DiameterDeviation> ;
    rdfs:subPropertyOf <http://w3id.org/dstv#hasDeviationValues> .

<http://w3id.org/dstv#hasDiameterTolerance> a owl:ObjectProperty ;
    rdfs:domain <http://w3id.org/dstv#Diameter> ;
    rdfs:range <http://w3id.org/dstv#DiameterTolerance> ;
    rdfs:subPropertyOf <http://w3id.org/dstv#hasTolerances> .

<http://w3id.org/dstv#hasDimensionalReference> a owl:ObjectProperty ;
    rdfs:domain <http://w3id.org/dstv#Drill> ;
    rdfs:range <http://w3id.org/dstv#DimensionalReference> .

<http://w3id.org/dstv#hasMaxBound> a owl:DatatypeProperty ;
    rdfs:domain <http://w3id.org/dstv#ToleranceValues> ;
    rdfs:range rdfs:Literal .

<http://w3id.org/dstv#hasMeasuredDiameter> a owl:ObjectProperty ;
    rdfs:domain <http://w3id.org/dstv#Diameter> ;
    rdfs:range <http://w3id.org/dstv#MeasuredDiameter> ;
    rdfs:subPropertyOf <http://w3id.org/dstv#hasMeasuredValue> .

<http://w3id.org/dstv#hasMinBound> a owl:DatatypeProperty ;
    rdfs:domain <http://w3id.org/dstv#ToleranceValues> ;
    rdfs:range rdfs:Literal .

<http://w3id.org/dstv#hasPlannedDiameter> a owl:ObjectProperty ;
    rdfs:domain <http://w3id.org/dstv#Diameter> ;
    rdfs:range <http://w3id.org/dstv#PlannedDiameter> ;
    rdfs:subPropertyOf <http://w3id.org/dstv#hasPlannedValue> .

<http://w3id.org/dstv#hasReferenceView> a owl:ObjectProperty ;
    rdfs:comment "dstvNC Level" ;
    rdfs:domain <http://w3id.org/dstv#Drill> ;
    rdfs:range <http://w3id.org/dstv#ReferenceView> .

<http://w3id.org/dstv#hasVertex> a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://w3id.org/dstv#Drill> <http://w3id.org/dstv#DrillMeasurement> ) ] ;
    rdfs:range <http://w3id.org/dstv#Vertex> ;
    rdfs:subPropertyOf <http://w3id.org/dstv#hasFeature> .

<http://w3id.org/dstv#hasVertexX> a owl:ObjectProperty ;
    rdfs:domain <http://w3id.org/dstv#Vertex> ;
    rdfs:range <http://w3id.org/dstv#VertexX> .

<http://w3id.org/dstv#hasVertexY> a owl:ObjectProperty ;
    rdfs:domain <http://w3id.org/dstv#Vertex> ;
    rdfs:range <http://w3id.org/dstv#VertexY> .

<http://w3id.org/dstv#inTolerance> a owl:ObjectProperty ;
    rdfs:domain <http://w3id.org/dstv#FeatureValues> ;
    rdfs:range <http://w3id.org/dstv#ToleranceBool> .

<http://w3id.org/ioc#hasFeatureValue> a owl:ObjectProperty ;
    rdfs:domain <http://w3id.org/dstv#Feature> ;
    rdfs:range <http://w3id.org/dstv#FeatureValues> .

<http://w3id.org/ioc#hasOutputElement> a owl:ObjectProperty ;
    rdfs:domain <http://w3id.org/dstv#ThroughHoleDrill> ;
    rdfs:range <http://w3id.org/dstv#TroughHole> .

<http://w3id.org/dstv#Depth> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#FeatureValues> .

<http://w3id.org/dstv#DiameterDeviation> a owl:Class ;
    rdfs:isDefinedBy <http://w3id.org/dstv#> ;
    rdfs:subClassOf <http://w3id.org/dstv#DeviationValues> .

<http://w3id.org/dstv#DiameterTolerance> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#ToleranceValues> .

<http://w3id.org/dstv#MeasuredDiameter> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#MeasuredValues> .

<http://w3id.org/dstv#PlannedDiameter> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#PlannedValues> .

<http://w3id.org/dstv#ThroughHoleDrillMeasurement> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#DrillMeasurement> .

<http://w3id.org/dstv#ToleranceBool> a owl:Class .

<http://w3id.org/dstv#hasDeviationValues> a owl:ObjectProperty ;
    rdfs:domain <http://w3id.org/dstv#FeatureValues> ;
    rdfs:range <http://w3id.org/dstv#DeviationValues> .

<http://w3id.org/dstv#hasDiameter> a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://w3id.org/dstv#AdjustmentProcess> <http://w3id.org/dstv#ThroughHoleDrill> <http://w3id.org/dstv#ValidationProcess> ) ] ;
    rdfs:range <http://w3id.org/dstv#Diameter> ;
    rdfs:subPropertyOf <http://w3id.org/dstv#hasFeature> .

<http://w3id.org/dstv#hasMeasuredValue> a owl:ObjectProperty ;
    rdfs:domain <http://w3id.org/dstv#FeatureValues> ;
    rdfs:range <http://w3id.org/dstv#MeasuredValues> .

<http://w3id.org/dstv#hasMeasurement> a owl:ObjectProperty ;
    rdfs:domain <http://w3id.org/dstv#Drill> ;
    rdfs:range <http://w3id.org/dstv#MeasurementProcess> .

<http://w3id.org/dstv#hasPlannedValue> a owl:ObjectProperty ;
    rdfs:domain <http://w3id.org/dstv#FeatureValues> ;
    rdfs:range <http://w3id.org/dstv#PlannedValues> .

<http://w3id.org/dstv#hasTolerances> a owl:ObjectProperty ;
    rdfs:domain <http://w3id.org/dstv#PlannedValues> ;
    rdfs:range <http://w3id.org/dstv#ToleranceValues> .

<https://standards.buildingsmart.org/IFC/DEV/IFC4/ADD2_TC1/OWL#IfcVoidingFeature> a owl:Class .

<http://w3id.org/dstv#AdjustmentProcess> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/ioc#Process> .

<http://w3id.org/dstv#DrillMeasurement> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#MeasurementProcess> .

<http://w3id.org/dstv#Feature> a owl:Class ;
    rdfs:isDefinedBy <http://w3id.org/dstv#> .

<http://w3id.org/dstv#ProductionProcess> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/ioc#Process> .

<http://w3id.org/dstv#ThroughHoleDrill> a owl:Class ;
    rdfs:comment "The element hljob is an optional element of hl. It is created for each through hole of the corresponding reference plane.",
        "hljob" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/dstv#ThroughHoleDrillMeasurement> ;
            owl:onProperty <http://w3id.org/dstv#hasMeasurement> ],
        [ a owl:Restriction ;
            owl:onClass <http://w3id.org/dstv#Diameter> ;
            owl:onProperty <http://w3id.org/dstv#hasDiameter> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://w3id.org/dstv#Drill> .

<http://w3id.org/dstv#TroughHole> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#Feature> .

<http://w3id.org/dstv#ValidationProcess> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/ioc#Process> .

<http://w3id.org/dstv#VertexX> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#FeatureValues> .

<http://w3id.org/dstv#VertexY> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#FeatureValues> .

<http://w3id.org/dstv#hasFeature> a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://w3id.org/dstv#AdjustmentProcess> <http://w3id.org/dstv#MeasurementProcess> <http://w3id.org/dstv#ProductionProcess> <http://w3id.org/dstv#ValidationProcess> <http://w3id.org/ioc#Process> ) ] ;
    rdfs:range <http://w3id.org/dstv#FeatureValues> .

<http://w3id.org/dstv#MeasurementProcess> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/ioc#Process> .

<http://w3id.org/dstv#DimensionalReference> a owl:Class ;
    rdfs:isDefinedBy <http://w3id.org/dstv#> .

<http://w3id.org/dstv#Distance> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#FeatureValues> .

<http://w3id.org/dstv#Vertex> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#FeatureValues> .

<http://w3id.org/dstv#Drill> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#ProductionProcess> .

<http://w3id.org/dstv#ReferenceView> a owl:Class .

<http://w3id.org/ioc#Process> a owl:Class .

<http://w3id.org/dstv#DeviationValues> a owl:Class ;
    rdfs:isDefinedBy <http://w3id.org/dstv#> .

<http://w3id.org/dstv#Diameter> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dstv#FeatureValues> .

<http://w3id.org/dstv#MeasuredValues> a owl:Class .

<http://w3id.org/dstv#PlannedValues> a owl:Class .

<http://w3id.org/dstv#ToleranceValues> a owl:Class .

<http://w3id.org/dstv#> a owl:Ontology ;
    dcterms:creator "Jyrki Oraskari, Individualized Production RWTH Aachen"@en,
        "Lukas Kirner, Individualized Production RWTH Aachen"@en,
        "Timur Kurzu, Individualized Production RWTH Aachen"@en,
        "Victoria Jung, Individualized Production RWTH Aachen"@en ;
    dcterms:description "dstv"@en ;
    dcterms:issued "2023-02-28"@en ;
    dcterms:title "DSTV:Steel Construction Ontology"@en ;
    vann:preferredNamespacePrefix "dstv" ;
    vann:preferredNamespaceUri "http://w3id.org/dstv#" ;
    owl:versionInfo "0.0.2" .

<http://w3id.org/dstv#FeatureValues> a owl:Class .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://w3id.org/dstv#Depth> <http://w3id.org/dstv#Diameter> <http://w3id.org/dstv#Distance> <http://w3id.org/dstv#Vertex> <http://w3id.org/dstv#VertexX> <http://w3id.org/dstv#VertexY> ) .

