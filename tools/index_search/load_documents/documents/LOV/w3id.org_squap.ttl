onto:SoftwareQualityResult a owl:Class ;
    rdfs:label "Software quality result" ;
    rdfs:subClassOf onto:MeasurementResult .

onto:affectsMeasurementOf a owl:ObjectProperty ;
    rdfs:label "affects measurement of" ;
    rdfs:domain onto:MeasurementResult ;
    rdfs:range onto:FactorOccurrence ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf onto:isAffectedBy .

onto:hasParameter a owl:ObjectProperty ;
    rdfs:label "has parameter" ;
    rdfs:comment "The relation between a metric and a parameter." ;
    rdfs:domain onto:Metric ;
    rdfs:range onto:Parameter ;
    owl:inverseOf onto:isParameterOf .

onto:isFactorSatisfiedBy a owl:ObjectProperty ;
    rdfs:label "is factor satisfied by" ;
    rdfs:domain onto:SoftwareQualityFactor ;
    rdfs:range onto:FactorOccurrence ;
    rdfs:subPropertyOf onto:isSatisfiedBy ;
    owl:inverseOf onto:satisfiesFactor .

onto:isParametrizedBy a owl:ObjectProperty ;
    rdfs:label "is parametrized by" ;
    ns1:isNativeTo <http://ontologydesignpatterns.org/cp/owl/parameterregion.owl> ;
    rdfs:domain onto:Region ;
    rdfs:range onto:Parameter ;
    rdfs:subPropertyOf onto:isClassifiedBy .

onto:isQualityCharacteristicUsedIn a owl:ObjectProperty ;
    rdfs:label "is quality characteristic used in" ;
    rdfs:domain onto:SoftwareQualityCharacteristic ;
    rdfs:range onto:SoftwareQualityFactor ;
    rdfs:subPropertyOf onto:isConceptUsedIn ;
    owl:inverseOf onto:usesQualityCharacteristic .

onto:isSpecializedBy a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "is specialized by" ;
    ns1:isNativeTo <http://ontologydesignpatterns.org/cp/owl/descriptionandsituation.owl> ;
    rdfs:domain onto:Concept ;
    rdfs:range onto:Concept ;
    owl:inverseOf onto:specializes .

onto:parametrizes a owl:ObjectProperty ;
    rdfs:label "parametrizes" ;
    ns1:isNativeTo <http://ontologydesignpatterns.org/cp/owl/parameterregion.owl> ;
    rdfs:domain onto:Parameter ;
    rdfs:range onto:Region ;
    rdfs:subPropertyOf onto:classifies .

