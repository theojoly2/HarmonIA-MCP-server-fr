onto:FactorOccurrence a owl:Class ;
    rdfs:label "Factor occurrence" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onto:isAffectedBy ;
            owl:someValuesFrom onto:MeasurementResult ],
        [ a owl:Restriction ;
            owl:onProperty onto:satisfiesFactor ;
            owl:someValuesFrom onto:SoftwareQualityFactor ],
        onto:Situation .

onto:Parameter a owl:Class ;
    rdfs:label "Parameter" ;
    ns1:isNativeTo <http://ontologydesignpatterns.org/cp/owl/parameterregion.owl> ;
    rdfs:comment "A Concept that classifies something having a certain value, e.g. 'High' can be said of people taller than 185 cm.\\nHowever, in order to formally represent this constraint, we need to add an anonymous type to a parameter instance, using a property that convey the semantics of the parameter, e.g.:\\nHigh rdf:type Person and (some hasHeight (Height and (oneOf isTallerThan 185) and (oneOf hasUnitOfMeasure centimeter)))" ;
    rdfs:subClassOf onto:Concept .

onto:Value a owl:Class ;
    rdfs:label "Value" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1" ;
            owl:onProperty onto:value ],
        onto:Region .

onto:Metric a owl:Class ;
    rdfs:label "Metric" ;
    rdfs:comment "A metric, e.g. precision." .

<https://w3id.org/squap/ProcessMaturity/Acquisition> a owl:Class,
