@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://ontologydesignpatterns.org/opla/> .
@prefix onto: <https://w3id.org/squap/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ns1:isNativeTo a owl:AnnotationProperty .

ns1:reusesPatternAsTemplate a owl:AnnotationProperty .

dc:creator a owl:AnnotationProperty .

dc:description a owl:AnnotationProperty .

dc:rights a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

onto: a owl:Ontology ;
    rdfs:label "SQuAP Ontology" ;
    ns1:reusesPatternAsTemplate <http://ontologydesignpatterns.org/cp/owl/descriptionandsituation.owl>,
        <http://ontologydesignpatterns.org/cp/owl/parameterregion.owl> ;
    dc:creator "Andrea Giovanni Nuzzolese (STLab, ISTC-CNR)",
        "Daniel Russo (DISI, University of Bologna)",
        "Paolo Ciancarini (DISI, University of Bologna)",
        "Valentina Presutti (STLab, ISTC-CNR)" ;
    dc:description <https://i.creativecommons.org/l/by/4.0/88x31.png>,
        <https://raw.githubusercontent.com/anuzzolese/squap/master/ont/images/squap-ont.png>,
        "Quality, architecture, and process are considered the keystones of software engineering. ISO defines them in three separate standards. However, their interaction has been poorly studied, so far. The SQuAP model (Software Quality, Architecture, Process) describes twenty-eight main factors that impact on software quality in banking systems, and each factor is described as a relation among some characteristics from the three ISO standards. Hence, SQuAP makes such relations emerge rigorously, although informally. SQaAP-Ont is an OWL ontology that formalises those relations in order to represent and reason via Linked Data about software engineering in a three-dimensional model consisting of quality, architecture, and process characteristics." ;
    dcterms:issued "2018-05-15" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2019-07-12" ;
    rdfs:comment "Quality, architecture, and process are considered the keystones of software engineering. ISO defines them in three separate standards. However, their interaction has been poorly studied, so far. The SQuAP model (Software Quality, Architecture, Process) describes twenty-eight main factors that impact on software quality in banking systems, and each factor is described as a relation among some characteristics from the three ISO standards. Hence, SQuAP makes such relations emerge rigorously, although informally. SQaAP-Ont is an OWL ontology that formalises those relations in order to represent and reason via Linked Data about software engineering in a three-dimensional model consisting of quality, architecture, and process characteristics." ;
    owl:backwardCompatibleWith onto:0.1 ;
    owl:priorVersion onto:0.1 ;
    owl:versionIRI onto:0.2 .

<https://w3id.org/squap/ArchitecturalAlignment/ModelKind> a owl:Class,
        owl:NamedIndividual,
        onto:ArchitecturalAlignment ;
    rdfs:label "Model kind" ;
    rdfs:subClassOf <https://w3id.org/squap/ArchitecturalAlignment/ObjectiveCharacteristic> ;
    onto:specializes <https://w3id.org/squap/ArchitecturalAlignment/ObjectiveCharacteristic> .

onto:ArchitecturalAlignmentResult a owl:Class ;
    rdfs:label "Architectural alignment result" ;
    rdfs:subClassOf onto:MeasurementResult .

<https://w3id.org/squap/Factor/ApplicationAndMaintenanceContractsVsDocumentation> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "Application and maintenance contracts vs documentation" ;
    rdfs:comment "Application & Maintenance (AM) contracts are set to outsource the development and maintenance, to decrease internal costs.Typically, they do not provide an adequate documentation." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/Concern>,
        <https://w3id.org/squap/ArchitecturalAlignment/Stakeholder>,
        <https://w3id.org/squap/ArchitecturalAlignment/System-of-Interest>,
        <https://w3id.org/squap/ProcessMaturity/Documentation>,
        <https://w3id.org/squap/ProcessMaturity/Improvement>,
        <https://w3id.org/squap/ProcessMaturity/Maintenance>,
        <https://w3id.org/squap/ProcessMaturity/Management>,
        <https://w3id.org/squap/ProcessMaturity/QualityAssurance>,
        <https://w3id.org/squap/SoftwareQuality/Analysability>,
        <https://w3id.org/squap/SoftwareQuality/FunctionalCompleteness>,
        <https://w3id.org/squap/SoftwareQuality/FunctionalCorrectness>,
        <https://w3id.org/squap/SoftwareQuality/Modifiability>,
        <https://w3id.org/squap/SoftwareQuality/Replaceability> .

<https://w3id.org/squap/Factor/ContractingAndSkills> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "Contracting and skills" ;
    rdfs:comment "Outsourcing is the main cause of poor software quality." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/Concern>,
        <https://w3id.org/squap/ProcessMaturity/Acquisition>,
        <https://w3id.org/squap/ProcessMaturity/Improvement>,
        <https://w3id.org/squap/ProcessMaturity/Infrastructure>,
        <https://w3id.org/squap/ProcessMaturity/Supply>,
        <https://w3id.org/squap/ProcessMaturity/Training> .

<https://w3id.org/squap/Factor/CustomSoftwareQuality> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "Custom software quality" ;
    rdfs:comment "The perceived quality of custom software applications is decreasing." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/Concern>,
        <https://w3id.org/squap/ProcessMaturity/Acquisition>,
        <https://w3id.org/squap/ProcessMaturity/Verification>,
        <https://w3id.org/squap/SoftwareQuality/FunctionalAppropriateness>,
        <https://w3id.org/squap/SoftwareQuality/Operability> .

<https://w3id.org/squap/Factor/DataAnalysisVsFunctionalAnalysis> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "Data analysis vs functional analysis" ;
    rdfs:comment "Poor data analysis influences functional analysis and so, system integrity." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/ArchitectureFramework>,
        <https://w3id.org/squap/ArchitecturalAlignment/ArchitectureModel>,
        <https://w3id.org/squap/ArchitecturalAlignment/ArchitectureView>,
        <https://w3id.org/squap/ProcessMaturity/Development>,
        <https://w3id.org/squap/SoftwareQuality/FunctionalCorrectness> .

<https://w3id.org/squap/Factor/DeveloperProfessionalismVsRates> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "Developer professionalism vs rates" ;
    rdfs:comment "Decreasing developer's professionalism and the decrease of professional rates appears to be quite connected." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/Concern>,
        <https://w3id.org/squap/ArchitecturalAlignment/Environment>,
        <https://w3id.org/squap/ProcessMaturity/Management>,
        <https://w3id.org/squap/ProcessMaturity/Supply>,
        <https://w3id.org/squap/SoftwareQuality/Maturity> .

<https://w3id.org/squap/Factor/DeveloperProfessionalismVsSkills> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "Developer professionalism vs skills" ;
    rdfs:comment "No adequate resources to invest in education and to train developers, especially those with no formal education in IT." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/Concern>,
        <https://w3id.org/squap/ProcessMaturity/Management>,
        <https://w3id.org/squap/ProcessMaturity/Supply>,
        <https://w3id.org/squap/ProcessMaturity/Training>,
        <https://w3id.org/squap/SoftwareQuality/Maturity> .

<https://w3id.org/squap/Factor/DocumentationStandardsAndTools> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "Documentation standards and tools" ;
    rdfs:comment "Poor documentation hinders software maintainability and increases evolution costs." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/ArchitectureDescription>,
        <https://w3id.org/squap/ArchitecturalAlignment/Concern>,
        <https://w3id.org/squap/ArchitecturalAlignment/CorrespondenceRules>,
        <https://w3id.org/squap/ProcessMaturity/Documentation>,
        <https://w3id.org/squap/SoftwareQuality/Adaptability>,
        <https://w3id.org/squap/SoftwareQuality/Reusability> .

<https://w3id.org/squap/Factor/DocumentationVsTimeAndBudget> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "Documentation vs time and budget" ;
    rdfs:comment "Time and budget constraints have a direct impact on software documentation. Due to low budget for new developments and urgency for new applications, documentation is the first element which is skipped." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/ArchitectureDescription>,
        <https://w3id.org/squap/ArchitecturalAlignment/ArchitectureRational>,
        <https://w3id.org/squap/ProcessMaturity/Documentation>,
        <https://w3id.org/squap/ProcessMaturity/Management>,
        <https://w3id.org/squap/SoftwareQuality/Adaptability>,
        <https://w3id.org/squap/SoftwareQuality/Analysability>,
        <https://w3id.org/squap/SoftwareQuality/Learnability>,
        <https://w3id.org/squap/SoftwareQuality/Maturity>,
        <https://w3id.org/squap/SoftwareQuality/Modifiability>,
        <https://w3id.org/squap/SoftwareQuality/Replaceability>,
        <https://w3id.org/squap/SoftwareQuality/Reusability>,
        <https://w3id.org/squap/SoftwareQuality/Testability> .

<https://w3id.org/squap/Factor/EstablishmentOfInternalAndExternalDevelopmentProcesses> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "Establishment of internal and external development processes" ;
    rdfs:comment "Merging internal and external development processes is extremely difficult." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/Concern>,
        <https://w3id.org/squap/ProcessMaturity/Acquisition>,
        <https://w3id.org/squap/ProcessMaturity/QualityAssurance>,
        <https://w3id.org/squap/ProcessMaturity/Supply>,
        <https://w3id.org/squap/SoftwareQuality/Maturity> .

<https://w3id.org/squap/Factor/FunctionalAnalysisVsDataModeling> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "Functional analysis vs data modeling" ;
    rdfs:comment "Difficulties in functional analysis lies in bad data modeling and identification of data sources." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/ArchitectureFramework>,
        <https://w3id.org/squap/ArchitecturalAlignment/ArchitectureView>,
        <https://w3id.org/squap/ProcessMaturity/Development> .

<https://w3id.org/squap/Factor/IncreaseOfMaintenanceCosts> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "Increase of maintenance costs" ;
    rdfs:comment "Some factors have a direct impact on maintenance costs. The overall architectural complexity, the decreasing software quality and incomplete documentation are the most important drivers of high maintenance costs and time." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/Correspondence>,
        <https://w3id.org/squap/ArchitecturalAlignment/CorrespondenceRules>,
        <https://w3id.org/squap/ProcessMaturity/Documentation>,
        <https://w3id.org/squap/SoftwareQuality/Adaptability>,
        <https://w3id.org/squap/SoftwareQuality/Analysability>,
        <https://w3id.org/squap/SoftwareQuality/Replaceability>,
        <https://w3id.org/squap/SoftwareQuality/Reusability>,
        <https://w3id.org/squap/SoftwareQuality/Testability> .

<https://w3id.org/squap/Factor/InterfacesArchitecturalComplexity> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "Interfaces architectural complexity" ;
    rdfs:comment "This factor is a direct consequence of the first one. Module interfaces complexity led to a typical anti-pattern." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/ArchitectureModel>,
        <https://w3id.org/squap/ProcessMaturity/Development>,
        <https://w3id.org/squap/SoftwareQuality/Accountability>,
        <https://w3id.org/squap/SoftwareQuality/Integrity>,
        <https://w3id.org/squap/SoftwareQuality/Modifiability> .

<https://w3id.org/squap/Factor/ItalianApplicationsVsQualityAndMaintainability> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "Italian applications vs quality and maintainability" ;
    rdfs:comment "Regarding Italian applications, they appear to have more functionalities but incur in higher maintenance costs." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/Concern>,
        <https://w3id.org/squap/ArchitecturalAlignment/Correspondence>,
        <https://w3id.org/squap/ProcessMaturity/Acquisition>,
        <https://w3id.org/squap/ProcessMaturity/Maintenance>,
        <https://w3id.org/squap/ProcessMaturity/QualityAssurance>,
        <https://w3id.org/squap/ProcessMaturity/Supply>,
