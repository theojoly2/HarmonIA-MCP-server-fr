        <https://w3id.org/squap/SoftwareQuality/Installability>,
        <https://w3id.org/squap/SoftwareQuality/Replaceability>,
        <https://w3id.org/squap/SoftwareQuality/Reusability> .

<https://w3id.org/squap/Factor/LackingToolsAndMethodologies> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "Lacking tools and methodologies" ;
    rdfs:comment "Finding and implementing the right tools & methodologies is quite a hard task." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/ArchitectureDescription>,
        <https://w3id.org/squap/ArchitecturalAlignment/ArchitectureModel>,
        <https://w3id.org/squap/ArchitecturalAlignment/ArchitectureView>,
        <https://w3id.org/squap/ArchitecturalAlignment/Concern>,
        <https://w3id.org/squap/ProcessMaturity/Development>,
        <https://w3id.org/squap/ProcessMaturity/QualityAssurance>,
        <https://w3id.org/squap/SoftwareQuality/Analysability>,
        <https://w3id.org/squap/SoftwareQuality/Maturity>,
        <https://w3id.org/squap/SoftwareQuality/Modifiability>,
        <https://w3id.org/squap/SoftwareQuality/Modularity>,
        <https://w3id.org/squap/SoftwareQuality/Reusability>,
        <https://w3id.org/squap/SoftwareQuality/Testability> .

<https://w3id.org/squap/Factor/LowerDevelopersExpertiseAndProfessionalism> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "Lower developers expertise and professionalism" ;
    rdfs:comment "Short time to market expectations and shrinking IT budget is generally considered the main reason for low software quality." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/Concern>,
        <https://w3id.org/squap/ArchitecturalAlignment/Stakeholder>,
        <https://w3id.org/squap/ProcessMaturity/Supply>,
        <https://w3id.org/squap/ProcessMaturity/Training> .

<https://w3id.org/squap/Factor/MeasurementOfSoftwareQuality> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "Measurement of software quality" ;
    rdfs:comment "Losing control over the system quality is a concern." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/ArchitectureView>,
        <https://w3id.org/squap/ArchitecturalAlignment/Concern>,
        <https://w3id.org/squap/ArchitecturalAlignment/Stakeholder>,
        <https://w3id.org/squap/ProcessMaturity/Audit>,
        <https://w3id.org/squap/ProcessMaturity/QualityAssurance>,
        <https://w3id.org/squap/ProcessMaturity/Validation>,
        <https://w3id.org/squap/ProcessMaturity/Verification>,
        <https://w3id.org/squap/SoftwareQuality/Accountability>,
        <https://w3id.org/squap/SoftwareQuality/FunctionalCorrectness>,
        <https://w3id.org/squap/SoftwareQuality/Integrity>,
        <https://w3id.org/squap/SoftwareQuality/Maturity>,
        <https://w3id.org/squap/SoftwareQuality/Non-repudiation> .

<https://w3id.org/squap/Factor/ModuleInterfacesComplexity> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "Module interfaces complexity" ;
    rdfs:comment "A banking information system is characterized by a high number of modules;if these are strongly coupled this increases the number of interfaces and their complexity." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/ArchitectureDescription>,
        <https://w3id.org/squap/ArchitecturalAlignment/ArchitectureModel>,
        <https://w3id.org/squap/ArchitecturalAlignment/ArchitectureRational>,
        <https://w3id.org/squap/ArchitecturalAlignment/ArchitectureView>,
        <https://w3id.org/squap/ArchitecturalAlignment/Stakeholder>,
        <https://w3id.org/squap/ArchitecturalAlignment/System-of-Interest>,
        <https://w3id.org/squap/ProcessMaturity/Maintenance>,
        <https://w3id.org/squap/ProcessMaturity/QualityAssurance>,
        <https://w3id.org/squap/SoftwareQuality/Modularity> .

<https://w3id.org/squap/Factor/NewPackagesFunctionalitiesVsComplexity> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "New packages functionalities vs complexity" ;
    rdfs:comment "The demand for more functionalities rose in the last years, along with their complexity." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/ArchitectureFramework>,
        <https://w3id.org/squap/ArchitecturalAlignment/CorrespondenceRules>,
        <https://w3id.org/squap/ProcessMaturity/ConfigurationManagement>,
        <https://w3id.org/squap/ProcessMaturity/Maintenance>,
        <https://w3id.org/squap/ProcessMaturity/ProblemResolution>,
        <https://w3id.org/squap/ProcessMaturity/Verification>,
        <https://w3id.org/squap/SoftwareQuality/Adaptability>,
        <https://w3id.org/squap/SoftwareQuality/Analysability>,
        <https://w3id.org/squap/SoftwareQuality/Operability>,
        <https://w3id.org/squap/SoftwareQuality/Replaceability>,
        <https://w3id.org/squap/SoftwareQuality/Reusability> .

<https://w3id.org/squap/Factor/Non-ItalianApplicationsVsQualityAndMaintainability> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "Non-Italian applications vs quality and maintainability" ;
    rdfs:comment "Non-Italian applications are more maintainable but have less functionalities." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/ArchitectureFramework>,
        <https://w3id.org/squap/ArchitecturalAlignment/CorrespondenceRules>,
        <https://w3id.org/squap/ProcessMaturity/Acquisition>,
        <https://w3id.org/squap/ProcessMaturity/Maintenance>,
        <https://w3id.org/squap/ProcessMaturity/QualityAssurance>,
        <https://w3id.org/squap/ProcessMaturity/Supply>,
        <https://w3id.org/squap/SoftwareQuality/Adaptability>,
        <https://w3id.org/squap/SoftwareQuality/Installability>,
        <https://w3id.org/squap/SoftwareQuality/Replaceability>,
        <https://w3id.org/squap/SoftwareQuality/Reusability> .

<https://w3id.org/squap/Factor/PackagesDocumentationVsSystemAnalysis> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "Packages documentation vs system analysis" ;
    rdfs:comment "The lack of documentation in packages impacts directly on the logical data model and quality controls." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/Environment>,
        <https://w3id.org/squap/ArchitecturalAlignment/System-of-Interest>,
        <https://w3id.org/squap/ProcessMaturity/Documentation>,
        <https://w3id.org/squap/SoftwareQuality/Analysability>,
        <https://w3id.org/squap/SoftwareQuality/Modifiability>,
        <https://w3id.org/squap/SoftwareQuality/Replaceability> .

<https://w3id.org/squap/Factor/PackagesVsDocumentation> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "Packages vs documentation" ;
    rdfs:comment "The lack of documentation for software packages is perceived as a commercial strategy of suppliers to lock-in customers." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/ArchitectureDescription>,
        <https://w3id.org/squap/ArchitecturalAlignment/ArchitectureViewpoint>,
        <https://w3id.org/squap/ProcessMaturity/Documentation>,
        <https://w3id.org/squap/ProcessMaturity/Maintenance>,
        <https://w3id.org/squap/SoftwareQuality/Adaptability>,
        <https://w3id.org/squap/SoftwareQuality/Analysability>,
        <https://w3id.org/squap/SoftwareQuality/Installability>,
        <https://w3id.org/squap/SoftwareQuality/Modifiability>,
        <https://w3id.org/squap/SoftwareQuality/Modularity>,
        <https://w3id.org/squap/SoftwareQuality/Replaceability>,
        <https://w3id.org/squap/SoftwareQuality/Reusability>,
        <https://w3id.org/squap/SoftwareQuality/Testability> .

<https://w3id.org/squap/Factor/QualityVsRequirements> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "Quality vs requirements" ;
    rdfs:comment "Poorly defined requirements lead to misunderstandings with software developers, which will deliver lower quality software. The functional quality will be low if the requirements' clarity is low." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/ArchitectureView>,
        <https://w3id.org/squap/ArchitecturalAlignment/ArchitectureViewpoint>,
        <https://w3id.org/squap/ArchitecturalAlignment/Concern>,
        <https://w3id.org/squap/ProcessMaturity/Development>,
        <https://w3id.org/squap/SoftwareQuality/FunctionalCompleteness> .

<https://w3id.org/squap/Factor/QualityVsSystemAnalysis> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "Quality vs system analysis" ;
    rdfs:comment "Even though the design phase is perceived as the most important up-front activity, it is poorly implemented." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/ArchitectureView>,
        <https://w3id.org/squap/ArchitecturalAlignment/Stakeholder>,
        <https://w3id.org/squap/ProcessMaturity/QualityAssurance>,
        <https://w3id.org/squap/SoftwareQuality/Analysability>,
        <https://w3id.org/squap/SoftwareQuality/FunctionalAppropriateness>,
        <https://w3id.org/squap/SoftwareQuality/FunctionalCompleteness>,
        <https://w3id.org/squap/SoftwareQuality/FunctionalCorrectness>,
        <https://w3id.org/squap/SoftwareQuality/Replaceability> .

<https://w3id.org/squap/Factor/QualityVsTimeAndBudget> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "Quality vs time and budget" ;
    rdfs:comment "The whole panel agreed unanimously that there is a direct relationship among quality and time and budget." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/Concern>,
        <https://w3id.org/squap/ProcessMaturity/Development>,
        <https://w3id.org/squap/ProcessMaturity/Maintenance>,
        <https://w3id.org/squap/ProcessMaturity/Management>,
        <https://w3id.org/squap/SoftwareQuality/Analysability>,
        <https://w3id.org/squap/SoftwareQuality/Co-existence>,
        <https://w3id.org/squap/SoftwareQuality/Interoperability>,
        <https://w3id.org/squap/SoftwareQuality/Modifiability>,
        <https://w3id.org/squap/SoftwareQuality/ResourceUtilization>,
        <https://w3id.org/squap/SoftwareQuality/Testability>,
        <https://w3id.org/squap/SoftwareQuality/TimeBehaviour> .

<https://w3id.org/squap/Factor/RequirementsVsMethodologies> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "Requirements vs methodologies" ;
    rdfs:comment "Poor methodologies to elicit business goals and needs lead to the definition of unclear software requirements." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/CorrespondenceRules>,
        <https://w3id.org/squap/ArchitecturalAlignment/Stakeholder>,
        <https://w3id.org/squap/ProcessMaturity/Development>,
        <https://w3id.org/squap/SoftwareQuality/FunctionalCompleteness>,
        <https://w3id.org/squap/SoftwareQuality/FunctionalCorrectness> .

<https://w3id.org/squap/Factor/RequirementsVsTechnicalJargon> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "Requirements vs technical jargon" ;
    rdfs:comment "The (mis-)use of technical jargon of different departments for requirement elicitation leads to low software quality." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/Stakeholder>,
        <https://w3id.org/squap/ProcessMaturity/Development>,
        <https://w3id.org/squap/ProcessMaturity/Management>,
        <https://w3id.org/squap/SoftwareQuality/FunctionalCorrectness> .

<https://w3id.org/squap/Factor/SystemAnalysisVsDocumentation> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "System analysis vs documentation" ;
    rdfs:comment "Inadequate documentation impacts on the system analysis and so on software quality." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/ArchitectureDescription>,
        <https://w3id.org/squap/ProcessMaturity/Documentation>,
        <https://w3id.org/squap/SoftwareQuality/Accountability>,
        <https://w3id.org/squap/SoftwareQuality/FaultTolerance>,
        <https://w3id.org/squap/SoftwareQuality/FunctionalAppropriateness>,
        <https://w3id.org/squap/SoftwareQuality/FunctionalCompleteness>,
        <https://w3id.org/squap/SoftwareQuality/FunctionalCorrectness>,
        <https://w3id.org/squap/SoftwareQuality/Integrity> .

<https://w3id.org/squap/Factor/WebTechnologiesVsMethodologies> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQualityFactor ;
    rdfs:label "Web technologies vs methodologies" ;
    rdfs:comment "There is the idea that the adoption of such technologies lead to less rigorous approach to software engineering. In this regard, Agile is considered a scapegoat of such sloppiness." ;
    rdfs:subClassOf onto:SoftwareQualityFactor ;
    onto:usesConcept <https://w3id.org/squap/ArchitecturalAlignment/Correspondence>,
        <https://w3id.org/squap/ArchitecturalAlignment/CorrespondenceRules>,
        <https://w3id.org/squap/ArchitecturalAlignment/Environment>,
        <https://w3id.org/squap/ProcessMaturity/Development>,
        <https://w3id.org/squap/SoftwareQuality/Maturity> .

