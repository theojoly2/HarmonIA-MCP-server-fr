onto:classifies a owl:ObjectProperty ;
    rdfs:label "classifies" ;
    ns1:isNativeTo <http://ontologydesignpatterns.org/cp/owl/descriptionandsituation.owl> ;
    rdfs:domain onto:Concept ;
    rdfs:range owl:Thing .

onto:isAffectedBy a owl:ObjectProperty ;
    rdfs:label "is affected by" ;
    rdfs:domain onto:FactorOccurrence ;
    rdfs:range onto:MeasurementResult ;
    rdfs:subPropertyOf owl:topObjectProperty .

onto:isClassifiedBy a owl:ObjectProperty ;
    rdfs:label "is classified by" ;
    ns1:isNativeTo <http://ontologydesignpatterns.org/cp/owl/descriptionandsituation.owl> ;
    rdfs:domain owl:Thing ;
    rdfs:range onto:Concept .

onto:satisfies a owl:ObjectProperty ;
    rdfs:label "satisfies" ;
    ns1:isNativeTo <http://ontologydesignpatterns.org/cp/owl/descriptionandsituation.owl> ;
    rdfs:domain onto:Situation ;
    rdfs:range onto:Description .

onto:satisfiesFactor a owl:ObjectProperty ;
    rdfs:label "satisfies factor" ;
    rdfs:domain onto:FactorOccurrence ;
    rdfs:range onto:SoftwareQualityFactor ;
    rdfs:subPropertyOf onto:satisfies .

onto:specializes a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "specializes" ;
    ns1:isNativeTo <http://ontologydesignpatterns.org/cp/owl/descriptionandsituation.owl> ;
    rdfs:domain onto:Concept ;
    rdfs:range onto:Concept .

