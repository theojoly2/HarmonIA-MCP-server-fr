onto:usesConcept a owl:ObjectProperty ;
    rdfs:label "uses concept" ;
    ns1:isNativeTo <http://ontologydesignpatterns.org/cp/owl/descriptionandsituation.owl> ;
    rdfs:domain onto:Description ;
    rdfs:range onto:Concept ;
    owl:propertyChainAxiom ( onto:usesConcept onto:specializes ) .

onto:usesQualityCharacteristic a owl:ObjectProperty ;
    rdfs:label "uses quality characteristic" ;
    rdfs:domain onto:SoftwareQualityFactor ;
    rdfs:range onto:SoftwareQualityCharacteristic ;
    rdfs:subPropertyOf onto:usesConcept .

<https://w3id.org/squap/ArchitecturalAlignment/ArchitectureFramework> a owl:Class,
