        onto:ArchitecturalAlignment ;
    rdfs:label "Subjective characteristic" ;
    rdfs:subClassOf onto:ArchitecturalAlignment .

onto:Concept a owl:Class ;
    rdfs:label "Concept" ;
    ns1:isNativeTo <http://ontologydesignpatterns.org/cp/owl/descriptionandsituation.owl> ;
    rdfs:comment "A concept. \\nOnce defined, a Concept can be used in other descriptions." ;
    owl:disjointWith onto:Description,
        onto:Situation .

<https://w3id.org/squap/ProcessMaturity/Primary> a owl:Class,
        owl:NamedIndividual,
        onto:ProcessMaturity ;
    rdfs:label "Primary" ;
    rdfs:subClassOf onto:ProcessMaturity .

<https://w3id.org/squap/SoftwareQuality/FlexibilityInUse> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQuality ;
    rdfs:label "Flexibility in use" ;
    rdfs:subClassOf onto:SoftwareQuality,
        <https://w3id.org/squap/SoftwareQuality/FlexibilityInUse>,
        <https://w3id.org/squap/SoftwareQuality/QualityInUse> ;
    onto:specializes <https://w3id.org/squap/SoftwareQuality/FlexibilityInUse>,
        <https://w3id.org/squap/SoftwareQuality/QualityInUse> .

<https://w3id.org/squap/SoftwareQuality/FunctionalSuitability> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQuality ;
    rdfs:label "Functional suitability" ;
    rdfs:subClassOf onto:SoftwareQuality,
        <https://w3id.org/squap/SoftwareQuality/SoftwareProductQuality> ;
    onto:specializes <https://w3id.org/squap/SoftwareQuality/SoftwareProductQuality> .

<https://w3id.org/squap/SoftwareQuality/Reliability> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQuality ;
    rdfs:label "Reliability" ;
    rdfs:subClassOf onto:SoftwareQuality,
        <https://w3id.org/squap/SoftwareQuality/SoftwareProductQuality> ;
    onto:specializes <https://w3id.org/squap/SoftwareQuality/SoftwareProductQuality> .

<https://w3id.org/squap/SoftwareQuality/Safety> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQuality ;
    rdfs:label "Safety" ;
    rdfs:subClassOf onto:SoftwareQuality,
        <https://w3id.org/squap/SoftwareQuality/QualityInUse> ;
    onto:specializes <https://w3id.org/squap/SoftwareQuality/QualityInUse> .

onto:SoftwareQualityCharacteristic a owl:Class ;
    rdfs:label "Software quality characteristic" ;
    rdfs:comment "The concept of the sotftware quality characteristic" ;
    rdfs:subClassOf onto:Concept ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( onto:ArchitecturalAlignment onto:ProcessMaturity onto:SoftwareQuality ) ] .

onto:MeasurementResult a owl:Class ;
    rdfs:label "Measurement result" ;
    rdfs:comment "A measurement result." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onto:assesses ;
            owl:someValuesFrom onto:SoftwareQualityCharacteristic ],
        [ a owl:Restriction ;
            owl:onClass onto:Value ;
            owl:onProperty onto:hasValue ;
            owl:qualifiedCardinality "1" ],
        [ a owl:Restriction ;
            owl:onClass onto:Metric ;
            owl:onProperty onto:hasMetric ;
            owl:qualifiedCardinality "1" ] .

<https://w3id.org/squap/SoftwareQuality/Security> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQuality ;
    rdfs:label "Security" ;
    rdfs:subClassOf onto:SoftwareQuality,
        <https://w3id.org/squap/SoftwareQuality/SoftwareProductQuality> ;
    onto:specializes <https://w3id.org/squap/SoftwareQuality/SoftwareProductQuality> .

<https://w3id.org/squap/ArchitecturalAlignment/Concern> a owl:Class,
        owl:NamedIndividual,
        onto:ArchitecturalAlignment ;
    rdfs:label "Concern" ;
    rdfs:subClassOf <https://w3id.org/squap/ArchitecturalAlignment/SubjectiveCharacteristic> ;
    onto:specializes <https://w3id.org/squap/ArchitecturalAlignment/SubjectiveCharacteristic> .

<https://w3id.org/squap/SoftwareQuality/SoftwareProductQuality> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQuality ;
    rdfs:label "Software product quality" ;
    rdfs:subClassOf onto:SoftwareQuality .

<https://w3id.org/squap/ArchitecturalAlignment/ObjectiveCharacteristic> a owl:Class,
        owl:NamedIndividual,
        onto:ArchitecturalAlignment ;
    rdfs:label "Objective characteristic" ;
    rdfs:subClassOf onto:ArchitecturalAlignment .

<https://w3id.org/squap/ProcessMaturity/Supporting> a owl:Class,
        owl:NamedIndividual,
        onto:ProcessMaturity ;
    rdfs:label "Supporting" ;
    rdfs:subClassOf onto:ProcessMaturity .

<https://w3id.org/squap/SoftwareQuality/Operability> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQuality ;
    rdfs:label "Operability" ;
    rdfs:subClassOf onto:SoftwareQuality,
        <https://w3id.org/squap/SoftwareQuality/SoftwareProductQuality> ;
    onto:specializes <https://w3id.org/squap/SoftwareQuality/SoftwareProductQuality> .

onto:ArchitecturalAlignment a owl:Class ;
    rdfs:label "Architectural alignment" ;
    rdfs:comment "The software quality characteristic meant as architectural alignment." ;
    rdfs:subClassOf onto:SoftwareQualityCharacteristic ;
    owl:disjointWith onto:ProcessMaturity,
        onto:SoftwareQuality .

<https://w3id.org/squap/SoftwareQuality/Compatibility> a owl:Class,
        owl:NamedIndividual,
        onto:SoftwareQuality ;
    rdfs:label "Compatibility" ;
    rdfs:subClassOf onto:SoftwareQuality,
        <https://w3id.org/squap/SoftwareQuality/SoftwareProductQuality> ;
    onto:specializes <https://w3id.org/squap/SoftwareQuality/SoftwareProductQuality> .

onto:ProcessMaturity a owl:Class ;
    rdfs:label "Process maturity" ;
    rdfs:comment "The software quality characteristic meant as process maturity." ;
    rdfs:subClassOf onto:SoftwareQualityCharacteristic ;
    owl:disjointWith onto:SoftwareQuality .

onto:SoftwareQualityFactor a owl:Class ;
    rdfs:label "Software quality factor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onto:usesQualityCharacteristic ;
            owl:someValuesFrom onto:SoftwareQualityCharacteristic ],
        [ a owl:Restriction ;
            owl:allValuesFrom onto:SoftwareQualityCharacteristic ;
            owl:onProperty onto:usesQualityCharacteristic ],
        onto:Description .

onto:SoftwareQuality a owl:Class ;
