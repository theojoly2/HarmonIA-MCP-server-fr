@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix onto: <http://purl.org/net/cartCoord#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dc:creator a owl:AnnotationProperty .

dc:description a owl:AnnotationProperty .

dc:language a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

onto: a owl:Ontology ;
    dc:creator "Diarmuid Ryan" ;
    dc:description "Ontology for representation of cartesian co-ordinates" ;
    dc:language "en" ;
    dc:title "cartCoordOnt" ;
    rdfs:comment "Date Created: 3/7/15. Last Modified: 3/7/15.",
        "This work is licensed under a Creative Commons Attribution-ShareAlike 4.0 International License.\\n        \\t\\t\\t\\thttp://creativecommons.org/licenses/by-sa/4.0/" .

onto:hasPlacement a owl:ObjectProperty ;
    rdfs:label "has Point" ;
    rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .

onto:hasPoint a owl:ObjectProperty ;
    rdfs:label "has Point" ;
    rdfs:domain onto:Point_List ;
    rdfs:range onto:Point .

onto:xcoord a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "X Coordinate" ;
    rdfs:domain onto:Point ;
    rdfs:range xsd:double .

onto:ycoord a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Y Coordinate" ;
    rdfs:domain onto:Point ;
    rdfs:range xsd:double .

onto:zcoord a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Z Coordinate" ;
    rdfs:domain onto:Point ;
    rdfs:range xsd:double .

onto:Point_List a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .

onto:Point a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .

