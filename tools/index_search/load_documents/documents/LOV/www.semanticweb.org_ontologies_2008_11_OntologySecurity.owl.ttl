    rdfs:subClassOf ns1:TrustedThirdParty .

ns1:Reliability a owl:Class ;
    rdfs:subClassOf ns1:Availability .

ns1:RemoteDeviceLock a owl:Class ;
    rdfs:comment "Sending a Short message to lock the device"@en ;
