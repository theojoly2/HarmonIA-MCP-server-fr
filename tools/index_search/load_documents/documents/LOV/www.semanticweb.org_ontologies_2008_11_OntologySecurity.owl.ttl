@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix ns1: <http://www.semanticweb.org/ontologies/2008/11/OntologySecurity.owl#> .
@prefix onto: <http://www.semanticweb.org/ontologies/2008/11/OntologySecurity.owl> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dc:format a owl:AnnotationProperty .

dc:relation a owl:AnnotationProperty .

onto: a owl:Ontology ;
    dc:relation "This ontology covers the domain of security in the field of mobile applications."^^xsd:string .

    rdfs:subClassOf ns1:BlockCipherAlgorithm .

ns1:3GPP a ns1:OrganizationsAndStandards .

ns1:ActiveThreat a ns1:ThreatType .

ns1:AdditionalTools a owl:Class ;
    rdfs:comment "New tools that should be used for the projection or the application."^^xsd:string ;
    rdfs:subClassOf ns1:Cost .

ns1:AdministrativeProcedure a owl:Class ;
    rdfs:comment "Tasks to be performed and which are out of the scope of the technical field."^^xsd:string ;
    rdfs:subClassOf ns1:Cost .

ns1:AnalysisPhase a owl:Class ;
    rdfs:subClassOf ns1:ApplicationLifeCyclePhase .

ns1:Android a ns1:Platform .

ns1:Application a owl:Class ;
    rdfs:subClassOf ns1:Software .

ns1:ApplicationServerSide a owl:Class ;
    rdfs:comment "The application server side may be a web server or a data base back end that the device connects to."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:Backup ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:Journaling ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:Backup ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:Journaling ],
        ns1:Actor .

ns1:AssociatedOriented a ns1:NonRepudiationType .

ns1:AutoInvocationFunctionGroup a ns1:FunctionGroups ;
    rdfs:comment "Permissions related to automatically starting a MIDlet, for example by Push Registration." .

ns1:BatteryMonitor a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Integrity ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Integrity ],
        ns1:ResourceMonitoring .

ns1:BiometricIdentifier a owl:Class ;
    rdfs:comment "Biometric identifier is one of the most secure and more reliable ways to authenticate a person’s identity is to verify that person’s innate biological characteristics, which are referred to as biometrics. Each person’s fingerprints, DNA, iris and retinal cell patterns, facial geometry, and heat signature are near unique to that person. These biometric measures, if properly recorded, validated, and embedded in identity credentials that are logically bound to a single person’s identity, can provide the highest degree of identity authentication (From NIST information security Report)"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:Use ;
            owl:someValuesFrom ns1:Resource ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Hurt ;
            owl:someValuesFrom ns1:Portability ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Use ;
            owl:someValuesFrom ns1:Resource ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Hurt ;
            owl:someValuesFrom ns1:Portability ],
        ns1:AuthenticationToken .

ns1:Blowfish a owl:Class ;
    rdfs:subClassOf ns1:BlockCipherAlgorithm .

ns1:Bluetooth a owl:Class ;
    rdfs:comment "Bluetooth is a Personal Area Network (PAN) standard that enables wireless connections between electronic devices in the 2.4 GHz range over short distances, as an alternative to cables. Designed to be power efficient, Bluetooth has become a common feature in cell phones. Since wireless communications are inherently insecure, a number of basic security provisions have been defined for this standard to mitigate the risks involved. NIST"^^xsd:string ;
    rdfs:subClassOf ns1:PANetwork .

ns1:Break a owl:ObjectProperty ;
    rdfs:subPropertyOf ns1:QualitySatisfaction .

ns1:ByPassingTrialCounter a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#ByPassingAuthentication> .

ns1:CBC a owl:Class ;
    rdfs:subClassOf ns1:ChainingMode .

ns1:CBC-MAC a owl:Class ;
    rdfs:comment "The simplest way to make a key-dependent one-way hash function is to encrypt a message with a block algorithm in CBC or CFB modes . The hash is the last encrypted block, encrypted once more in CBC or CFB modes."^^xsd:string ;
    rdfs:subClassOf ns1:MACAlgorithm .

ns1:CFB a owl:Class ;
    rdfs:subClassOf ns1:ChainingMode .

ns1:COMSET a owl:Class ;
    rdfs:subClassOf ns1:KeyExchangeProtocol .

ns1:ChallengeReplyPassword a owl:Class ;
    rdfs:subClassOf ns1:AuthenticationProtocolType .

ns1:CodeSeparation a owl:Class ;
    rdfs:comment "Locate and isolate critical code from from general code." ;
    rdfs:subClassOf ns1:BestPractises .

ns1:CombinedDelivery-DRM a owl:Class ;
    rdfs:subClassOf ns1:DigitalRightsManagement .

ns1:CompactFlash a ns1:CardMemory .

ns1:ContentProvider a owl:Class ;
    rdfs:comment "The entity who is responsable of providing content like ringing tones or multimedia files or any other software."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:Provide ;
            owl:someValuesFrom ns1:Software ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:DigitalRightsManagement ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:DigitalRightsManagement ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Provide ;
            owl:someValuesFrom ns1:Software ],
        ns1:Actor .

ns1:Correction a ns1:MechanismType .

ns1:Critical a ns1:ConfidentialityLevel .

ns1:DDos a owl:Class ;
    rdfs:comment "Distributed denial of service."^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat> .

ns1:DIFFIE-HELLMAN a owl:Class ;
    rdfs:subClassOf ns1:KeyExchangeProtocol .

ns1:DSA a owl:Class ;
    rdfs:comment "Digital Signature Algorithm specified by FIPS 186-2"^^xsd:string ;
    rdfs:subClassOf ns1:DigitalSignatureAlgorithm .

ns1:DeploymentPhase a owl:Class ;
    rdfs:subClassOf ns1:ApplicationLifeCyclePhase .

ns1:DesignPhase a owl:Class ;
    rdfs:subClassOf ns1:ApplicationLifeCyclePhase .

ns1:Detection a ns1:MechanismType .

ns1:DevelopmentTime a owl:Class ;
    rdfs:comment "Addiotional development time required for the application or the project."^^xsd:string ;
    rdfs:subClassOf ns1:Cost .

ns1:DeviceCloning a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#HardwareCloning> .

ns1:DeviceDriverUpgrade a owl:Class ;
    rdfs:comment "One problem in this area is that drivers are typically written by third parties and drivers are upgraded at different times to the main OS. This causes problems when implementing any validation scheme, or even isolated checking of specific software updates"^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInUse> .

ns1:DotNet a ns1:Platform .

ns1:ECB a owl:Class ;
    rdfs:comment "Electronic code book"^^xsd:string ;
    rdfs:subClassOf ns1:ChainingMode .

ns1:ECDSA a owl:Class ;
    rdfs:comment "Elliptic Curve Digital Signature Algorithm (ECDSA) (ANSI X9-62)"^^xsd:string ;
    rdfs:subClassOf ns1:DigitalSignatureAlgorithm .

ns1:EDGE a owl:Class ;
    rdfs:comment "Enhanced Data rates for GSM Evolution" ;
    rdfs:subClassOf ns1:2.5G .

ns1:EMS a owl:Class ;
    rdfs:comment "Enhanced Messaging Service - An improved message system for GSM mobile phones allowing picture, sound, animation and text elements to be conveyed through one or more concatenated SMS messages. NIST"^^xsd:string ;
    rdfs:subClassOf ns1:Messaging .

ns1:ElGammelAlgorithm a owl:Class ;
    rdfs:subClassOf ns1:AsymmetricAlgorithm .

ns1:Email a owl:Class ;
    rdfs:subClassOf ns1:Internet .

ns1:EncryptionKeys a owl:Class ;
    rdfs:comment "The encryption keys are digital bitstrings that are stored in non-volatile memory, and verification of the identity proceeds by a challenge-response protocol." ;
    rdfs:subClassOf ns1:AuthenticationToken ;
    owl:equivalentClass ns1:Keys .

ns1:EndToEnd a ns1:NonRepudiationType .

ns1:Excellent a ns1:RNGEfficiency .

ns1:FTP a owl:Class ;
    rdfs:subClassOf ns1:Internet .

ns1:ForwardLock-DRM a owl:Class ;
    rdfs:subClassOf ns1:DigitalRightsManagement .

ns1:FullIntegrity a ns1:IntegrityType .

ns1:GPRS a owl:Class ;
    rdfs:comment "General Packet Radio Service" ;
    rdfs:subClassOf ns1:2G .

ns1:GPSNetwork a owl:Class ;
    rdfs:comment "A system for determining position by comparing radio signals from several satellites. NIST"^^xsd:string ;
    rdfs:subClassOf ns1:Network .

ns1:GPSvalues a owl:Class ;
    rdfs:comment "Global positioning system coordinates used by some applications."^^xsd:string ;
    rdfs:subClassOf ns1:LocalisationData .

ns1:GSM a owl:Class ;
    rdfs:comment "Global System for Mobile communications" ;
    rdfs:subClassOf ns1:2G .

ns1:GSMA a ns1:OrganizationsAndStandards .

ns1:GSMWorld a ns1:OrganizationsAndStandards .

ns1:GuessingAttack a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#ByPassingAuthentication> .

ns1:HMAC a owl:Class ;
    rdfs:subClassOf ns1:MACAlgorithm .

ns1:HTTP a owl:Class ;
    rdfs:subClassOf ns1:Internet .

ns1:HTTPS a owl:Class ;
    rdfs:subClassOf ns1:SecureNetworkCommunication .

ns1:Hardware a owl:Class ;
    rdfs:comment "Mainly the physical device with the embedded memory and processing units."^^xsd:string ;
    rdfs:subClassOf ns1:Asset ;
    owl:equivalentClass ns1:Resource .

ns1:HardwareLocking a ns1:AccessControlMethods .

ns1:HasIterationNumber a owl:DatatypeProperty .

ns1:HashBasedOTP a owl:Class ;
    rdfs:comment "A server side list of hashed tokens is stored and each consumed token is removed from the list."^^xsd:string ;
    rdfs:subClassOf ns1:O.T.P .

ns1:IEEE a ns1:OrganizationsAndStandards .

ns1:IETF a ns1:OrganizationsAndStandards .

ns1:IM a owl:Class ;
    rdfs:subClassOf ns1:Messaging .

ns1:ITU a ns1:OrganizationsAndStandards .

ns1:Images a owl:Class ;
    rdfs:comment "All supported image files for mobile devices."^^xsd:string ;
    rdfs:subClassOf ns1:LocalFiles .

ns1:ImplementAPI a owl:ObjectProperty ;
    rdfs:subPropertyOf ns1:Relationship .

ns1:ImplementationPhase a owl:Class ;
    rdfs:subClassOf ns1:ApplicationLifeCyclePhase .

ns1:IntensifyCriticalCodeReview a owl:Class ;
    rdfs:subClassOf ns1:BestPractises .

ns1:InteractionModes a owl:Class ;
    rdfs:comment "User interaction to confirm the execution of some senstive actions like sending a sms or opening a network connection/"^^xsd:string ;
    rdfs:subClassOf ns1:AccessControlMethods .

ns1:IrDA a owl:Class ;
    rdfs:comment "A standard for line-of-sight infrared communication between devices over short distances. NIST"^^xsd:string ;
    rdfs:subClassOf ns1:PANetwork .

ns1:J2ME owl:sameAs ns1:JME .

ns1:JMEPermissionDomains a ns1:AccessControlList .

ns1:JavaCard a ns1:CardType,
        ns1:SIM ;
    ns1:ImplementAPI ns1:AES_FIPS197,
        ns1:DES_FIPS46-1-2 .

ns1:JavaVerifiedSigningProcess a ns1:SourceCodeVerification .

ns1:Kerberos a owl:Class ;
    rdfs:comment "Kerberos is an authentication process that proceeds as follows: A client sends a request to the authentication server (AS) requesting \"credentials\" for a given server.  The AS responds with these credentials,  encrypted in the client's key.  The credentials consist of 1) a \"ticket\" for the server and 2) a temporary encryption key ( a \"session key\").  The client transmits the ticket (which contains the client's identity and a copy of the session key, all encrypted in the server's key) to the server.  The session key (now shared by the client and server) is used to authenticate the client, and may optionally be used to authenticate the server.  It may also be used to encrypt further communication between the two parties or to exchange a separate sub-session key to be used to encrypt further communication. RFC 1510"^^xsd:string ;
    rdfs:subClassOf ns1:AuthenticationProtocol .

ns1:KeyExchange a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:Use ;
            owl:someValuesFrom ns1:CommChannel ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Use ;
            owl:someValuesFrom ns1:KeyExchangeProtocol ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Use ;
            owl:someValuesFrom ns1:KeyExchangeProtocol ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Use ;
            owl:someValuesFrom ns1:CommChannel ],
        ns1:KeyManagement .

ns1:Learnability a owl:Class ;
    rdfs:comment "Easy to learn how to use the application."^^xsd:string ;
    rdfs:subClassOf ns1:Usability .

ns1:LocalDeviceLock a owl:Class ;
    rdfs:subClassOf ns1:DeviceLock .

ns1:MD2 a owl:Class ;
    rdfs:subClassOf ns1:CryptographicHashFunction .

ns1:MD4 a owl:Class ;
    rdfs:subClassOf ns1:CryptographicHashFunction .

ns1:MD5 a owl:Class ;
    rdfs:subClassOf ns1:CryptographicHashFunction .

ns1:MMC a ns1:CardMemory .

ns1:MMS a ns1:CommChannel,
        owl:Class ;
    rdfs:subClassOf ns1:Messaging .

ns1:MULTOS a ns1:CardType .

ns1:Mail a owl:Class ;
    rdfs:subClassOf ns1:Manual .

ns1:MaintenancePhase a owl:Class ;
    rdfs:subClassOf ns1:ApplicationLifeCyclePhase .

ns1:Make a owl:ObjectProperty ;
    rdfs:subPropertyOf ns1:QualitySatisfaction .

ns1:Manufacturer a owl:Class ;
    rdfs:comment "Mobile device manufacturer which may implement some security features in the device"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:Issue ;
            owl:someValuesFrom ns1:ManufacturerCertificate ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Provide ;
            owl:someValuesFrom ns1:Device ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Provide ;
            owl:someValuesFrom ns1:SourceCodeVerification ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Provide ;
            owl:someValuesFrom ns1:SourceCodeVerification ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:ManufacturerCertificate ;
            owl:onProperty ns1:Issue ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Issue ;
            owl:someValuesFrom ns1:ManufacturerCertificate ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:ManufacturerCertificate ;
            owl:onProperty ns1:Issue ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Provide ;
            owl:someValuesFrom ns1:Device ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasTrustIn ;
            owl:someValuesFrom ns1:TrustedThirdParty ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasTrustIn ;
            owl:someValuesFrom ns1:TrustedThirdParty ],
        ns1:Actor .

ns1:Memorability a owl:Class ;
    rdfs:comment "A limited period of time during which the use of the application will be memorised."^^xsd:string ;
    rdfs:subClassOf ns1:Usability .

ns1:MemoryCardLock a owl:Class ;
    rdfs:comment "Memory card can be protected with a password each time someone tries to access the card"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:AccessControl ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:AccessControl ],
        ns1:LockingMechanism .

ns1:MessagingFunctionsGroup a ns1:FunctionGroups ;
    rdfs:comment "Set of permissions related to sending or receiving messages like SMS" .

ns1:MisUseAttack a owl:Class ;
    rdfs:subClassOf ns1:UnTrustedAPIAttack .

ns1:MobeyForum a ns1:OrganizationsAndStandards .

ns1:Mobile2Market a ns1:CertificationAuthority .

ns1:MobileNetworkProvidervalues a owl:Class ;
    rdfs:comment "Mobile network Cell ID to which the device is attached."^^xsd:string ;
    rdfs:subClassOf ns1:LocalisationData .

ns1:MotorollaMobileVPN a ns1:MobileVPN .

ns1:Mutual a ns1:AuthenticationWay .

ns1:MutualReliableChannel a ns1:AuthenticationLevel .

ns1:NFC a owl:Class ;
    rdfs:comment "A short-range point-to-point wireless communication technology. The technology is a simple extension of the ISO/IEC 14443 proximity-card standard (contactless card, RFID) that combines the interface of a smartcard and a reader into a single device. An NFC device can communicate with both existing ISO/IEC 14443 smartcards and readers, as well as with other NFC devices, and is thereby compatible with existing contactless infrastructure already in use for public transportation and payment."^^xsd:string ;
    rdfs:subClassOf ns1:PANetwork .

ns1:NFCEnabled a owl:Class ;
    rdfs:comment "The device may be or not equiped with Near Field Communication Ship (NFC)."^^xsd:string ;
    rdfs:subClassOf ns1:DeviceCapabilities .

ns1:NIST a ns1:OrganizationsAndStandards .

ns1:NeedhamShroeder a owl:Class ;
    rdfs:subClassOf ns1:AuthenticationProtocol .

ns1:NetworkLayer a owl:Class ;
    rdfs:subClassOf ns1:SecurityLayer .

ns1:NoAuthentication a ns1:AuthenticationLevel .

ns1:NoSensitiveInfoOnExternalMemory a owl:Class ;
    rdfs:subClassOf ns1:BestPractises .

ns1:Nokia_Mobile_VPN a ns1:VPN .

ns1:NonVolatile a owl:Class ;
    rdfs:subClassOf ns1:FixedMemory .

ns1:OneSideVerification a ns1:AuthenticationLevel,
        ns1:AuthenticationWay .

ns1:Operator a owl:Class ;
    rdfs:comment "Telecom Network Operator knowing as MNO" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:Issue ;
            owl:someValuesFrom ns1:OperatorCertificate ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Provide ;
            owl:someValuesFrom ns1:SourceCodeVerification ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:OperatorCertificate ;
            owl:onProperty ns1:Issue ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Provide ;
            owl:someValuesFrom ns1:BestPractises ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Provide ;
            owl:someValuesFrom ns1:SourceCodeVerification ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasTrustIn ;
            owl:someValuesFrom ns1:TrustedThirdParty ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Provide ;
            owl:someValuesFrom ns1:BestPractises ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasTrustIn ;
            owl:someValuesFrom ns1:TrustedThirdParty ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:OperatorCertificate ;
            owl:onProperty ns1:Issue ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Issue ;
            owl:someValuesFrom ns1:OperatorCertificate ],
        ns1:Actor .

ns1:PGPCertificate a owl:Class ;
    rdfs:subClassOf ns1:CertificateFormat .

ns1:PIN a ns1:SmartCardLock ;
    rdfs:comment "Personal Identification Number" .

ns1:PRNG a owl:Class ;
    rdfs:comment "Pseudo Random Number Generation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:Use ;
            owl:someValuesFrom ns1:PRNGAlgorithm ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Use ;
            owl:someValuesFrom ns1:PRNGAlgorithm ],
        ns1:KeyGeneration .

ns1:PUK a ns1:SmartCardLock ;
    rdfs:comment "Personal Unblocking Keys" .

ns1:PassiveThreat a ns1:ThreatType .

