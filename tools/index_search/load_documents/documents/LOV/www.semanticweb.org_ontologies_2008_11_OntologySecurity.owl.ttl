ns1:STRANDOM a owl:Class ;
    rdfs:subClassOf ns1:PRNGAlgorithm .

ns1:Secret a ns1:ConfidentialityLevel .

ns1:SemanticIntegrity a ns1:IntegrityType .

ns1:SeparateDelivery-DRM a owl:Class ;
    rdfs:subClassOf ns1:DigitalRightsManagement .

ns1:Session a owl:Class ;
    rdfs:subClassOf ns1:Duration .

ns1:Skills a owl:Class ;
    rdfs:comment "Additional skills that should be acquired to achieve some tasks or goals."^^xsd:string ;
    rdfs:subClassOf ns1:Cost .

ns1:SmartCardCloning a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#HardwareCloning> .

ns1:Socket a owl:Class ;
    rdfs:subClassOf ns1:Internet .

ns1:SoftwareLayer a owl:Class ;
    rdfs:subClassOf ns1:SecurityLayer .

ns1:Speaker a owl:Class ;
    rdfs:subClassOf ns1:Output .

ns1:Static_password a owl:Class ;
    rdfs:comment "The standard couple of login and password authentication"^^xsd:string ;
    rdfs:subClassOf ns1:Password .

ns1:Steganography a owl:Class ;
    rdfs:comment "Steganography is the art and science of writing hidden messages in such a way that no-one, apart from the sender and intended recipient, suspects the existence of the message, a form of security through obscurity. Wikipedia"^^xsd:string ;
    rdfs:subClassOf ns1:Encryption .

ns1:SteganographyAlgorithm a owl:Class ;
    rdfs:subClassOf ns1:Algorithm .

ns1:StoredData a owl:Class ;
    rdfs:comment "Data stored either in the device or on the memory card."^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:unionOf ( ns1:ApplicationData ns1:ConfigurationData ) ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasDataStructure ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( ns1:LocalDataBase ns1:LocalFiles ) ] ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:unionOf ( ns1:ApplicationData ns1:ConfigurationData ) ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasDataStructure ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( ns1:LocalDataBase ns1:LocalFiles ) ] ] ) ],
        ns1:Data .

ns1:SymbianSigned a ns1:CertificationAuthority .

ns1:SymmetricKeyPoP a owl:Class ;
    rdfs:subClassOf ns1:AuthenticationProtocolType .

ns1:TRNG a owl:Class ;
    rdfs:comment "True Random Number Generation : extract randomness from physical phenomena and introduce it into computing device."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:Use ;
            owl:someValuesFrom ns1:Input ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Use ;
            owl:someValuesFrom ns1:Input ],
        ns1:KeyGeneration .

ns1:Technical a owl:Class ;
    rdfs:comment "All limitations related to technologies like the network bandwidth or processor capabilities."^^xsd:string ;
    rdfs:subClassOf ns1:Constraints .

ns1:TestOnRealDevices a owl:Class ;
    rdfs:subClassOf ns1:BestPractises .

ns1:TestPhase a owl:Class ;
    rdfs:subClassOf ns1:ApplicationLifeCyclePhase .

ns1:Time a owl:Class ;
    rdfs:subClassOf ns1:Duration .

ns1:TimeAnalysis a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#SideChannelAttack> .

ns1:TimeBasedOTP a owl:Class ;
    rdfs:comment "A client and server time synchronization is required for the authentication token verification."^^xsd:string ;
    rdfs:subClassOf ns1:O.T.P .

ns1:TimeStampToken a owl:Class ;
    rdfs:comment "A digital signature that makes possible the verification of the sending time of a message."^^xsd:string ;
    rdfs:subClassOf ns1:AuthenticationToken .

ns1:Timeliness a owl:Class ;
    rdfs:subClassOf ns1:Usability .

ns1:TopSecret a ns1:ConfidentialityLevel .

ns1:TouchScreen a owl:Class ;
    rdfs:subClassOf ns1:Input ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:DisplayScreen ns1:KeyPad ) ],
        [ a owl:Class ;
            owl:intersectionOf ( ns1:DisplayScreen ns1:KeyPad ) ] .

ns1:Training a owl:Class ;
    rdfs:comment "Requirement for additional training to use some tools or to do some technalical or management tasks."^^xsd:string ;
    rdfs:subClassOf ns1:Cost .

ns1:Transaction a owl:Class ;
    rdfs:subClassOf ns1:Duration .

ns1:TransmittedData a owl:Class ;
    rdfs:comment "Messaging data or data transferred through Internet connection"^^xsd:string ;
    rdfs:subClassOf ns1:Data .

ns1:TrustedThirdPartyCertificate a owl:Class ;
    dc:format "A certificate which is issued by a trusted third party."^^xsd:string ;
    rdfs:subClassOf ns1:Certificate .

ns1:TunneledPassword a owl:Class ;
    rdfs:subClassOf ns1:AuthenticationProtocolType .

ns1:TypeSafe-Unsafe a ns1:CodingStandards ;
    rdfs:comment "Don't mix type safe and type-unsafe API" .

ns1:TypeSafeAPIUse a owl:Class ;
    rdfs:subClassOf ns1:BestPractises .

ns1:UICC a owl:Class ;
    rdfs:comment "The UICC is a generic platform for smart card applications. It has been standardised by ETSI EP SCP (ETSI Project Smart Card Platform) with the aim of defining a physical and logical platform for all smart card applications and to develop advanced security methods for financial transactions, to take an example. Mobey forum" ;
    rdfs:subClassOf ns1:SmartCard .

ns1:UMTS a owl:Class ;
    rdfs:subClassOf ns1:3G .

ns1:USIM a owl:Class ;
    rdfs:comment "A (U)SIM is a special type of smart card that typically contains a processor and between 16 to 128 KB of persistent Electronically Erasable, Programmable ROM (EEPROM). It also includes RAM for program execution and ROM for the operating system, user authentication and data encryption algorithms, and other applications." ;
    rdfs:subClassOf ns1:SmartCard .

ns1:UnifiedTestingInitiativeRootCertificate a owl:Class ;
    rdfs:subClassOf ns1:DeviceCapabilities .

ns1:UnsafeDataTypeAttack a owl:Class ;
    rdfs:subClassOf ns1:TrustedAPIAttack .

ns1:UsePhase a owl:Class ;
    rdfs:subClassOf ns1:ApplicationLifeCyclePhase .

ns1:VeriSignTesting-BasedACSRootSymbian a ns1:X509Certificate .

ns1:Verisign a ns1:CertificationAuthority .

ns1:VibrationKit a owl:Class ;
    rdfs:subClassOf ns1:Output .

ns1:VideoInput a owl:Class ;
    rdfs:subClassOf ns1:Input .

ns1:Videos a owl:Class ;
    rdfs:subClassOf ns1:StandardFiles .

ns1:Voice a owl:Class ;
    rdfs:subClassOf ns1:Manual .

ns1:WPKI a owl:Class ;
    rdfs:comment "Wireless Public Key Infrastructure." ;
    rdfs:subClassOf ns1:PKI ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:PKI [ a owl:Restriction ;
                        owl:onProperty ns1:Use ;
                        owl:someValuesFrom ns1:CommChannel ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( ns1:PKI [ a owl:Restriction ;
                        owl:onProperty ns1:Use ;
                        owl:someValuesFrom ns1:CommChannel ] ) ] .

ns1:WiFi a owl:Class ;
    rdfs:subClassOf ns1:LANetwork .

ns1:WithoutVerification a ns1:AuthenticationLevel .

ns1:Yahalom a owl:Class ;
    rdfs:subClassOf ns1:AuthenticationProtocol .

ns1:Yarrow a owl:Class ;
    rdfs:subClassOf ns1:PRNGAlgorithm .

ns1:ZeroKnowledgePassword a owl:Class ;
    rdfs:subClassOf ns1:AuthenticationProtocolType .

ns1:hasCardType a owl:DatatypeProperty .

ns1:hasNetworkBandwidth a owl:DatatypeProperty ;
    rdfs:domain ns1:Network ;
    rdfs:range xsd:positiveInteger .

ns1:isUsedAt a owl:ObjectProperty .

ns1:vCard a owl:Class ;
    rdfs:comment "vCard is a virtual electronic business card format."^^xsd:string ;
    rdfs:subClassOf ns1:StandardFiles .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#AccessControl> a <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CounterMeasure> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#AccessToUntrustedWebSite> a owl:Class ;
    rdfs:comment "Several attacks may be achieved after access to hacked web sites like cross site scripting (XSS) for example." ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInUse> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#BatteryLimitation> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#PhysicalVulnerability> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Bluetooth> a <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerableServiceAutoStart> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#BruteForce> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#ByPassingAuthentication> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#BufferOverFlow> a owl:Class ;
    rdfs:comment "By passing data through an API where it is known that the API is designed to receive X bytes and we are passing X+N bytes, it can be arranged that the N bytes overflow into an area that was used by other storage (if it is a heap overflow) or will cause the return address to be corrupted (if it is a stack overflow). OMTP"^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#MalformedInput> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CodeInjection> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#MalformedInput> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#DefaultPIN> a owl:Class ;
    rdfs:comment "Always set to manufacturer default values"^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#InsecureDefaultSettings> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#DefaultPassword> a owl:Class ;
    rdfs:comment "Always set to manufacturer default values"^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#InsecureDefaultSettings> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#DevicePortability> a owl:Class ;
    rdfs:comment "The easy portability of the device make it vulnerable to rabbers and theft."^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#PhysicalVulnerability> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#DoS> a owl:Class ;
    rdfs:comment "Most common type involves flooding a host until it cannot respond to legitimate traffic."^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Eavesdropping> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#NetworkInfrastructureAttack> ;
    owl:equivalentClass <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Interception> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Emanation> a owl:Class ;
    rdfs:comment "The fact of making internal data available to third parties by radio.. In that case,the issuer is the passive victim of the attack.\\nAlmost all electrical devices emit radiation to the exterior that can be intercepted by other equipment (radio receivers) causing a leak of information. This threat is frequently but inaccurately called, a TEMPEST attack (“Transient Electromagnetic Pulse Standard”)." ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#PhysicalVulnerability> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#EquipmentDos> a owl:Class ;
    rdfs:comment "The attacker causes an overload or a disruption in the system such that network functions  in an abnormal manner. The abnormal behavior could be legitimate subscribers not receiving service, illegitimate subscribers receiving service or the entire network may disabled as a result of the attack."^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#NetworkInfrastructureAttack> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#ExternalBatteryRemovel> a owl:Class ;
    rdfs:comment "Bypassing security barries may be performed through a battery removal. For example in a DRM situation, a song may have been played, but if the rights count is not decremented until the end of the song, then removing the power source could result in the user playing the song indefinitely(OMPT)."^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#HardwareAttack> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#ExternalMemoryCardRemoval> a owl:Class ;
    rdfs:comment "Bypassing security barries may be performed through a battery removal. For example in a DRM situation, a song may have been played, but if the rights count is not decremented until the end of the song, then removing the memory card could result in the user playing the song indefinitely(OMPT)."^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#HardwareAttack> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#FOTAUnAuthorizedReFlash> a owl:Class ;
    rdfs:comment "UnAuthorized reflash via Firmware Over The Air. FOTA consists in replacing one version of the general OS(s) with another over the Air."^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#SoftwareAttack> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Fabrication> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#NetworkInfrastructureAttack> ;
    owl:equivalentClass <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Replay> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#FormatStringAttack> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#MalformedInput> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#InputOutputLimitation> a owl:Class ;
    rdfs:comment "Limited screen display and small keypad ad some aggravation to attacks like phishing for example." ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#PhysicalVulnerability> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Interruption> a owl:Class ;
    rdfs:comment "The attacker caused an Interruption by destroying resources. The attacker may delete a subscriber data in the entity such as an HLR."^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#NetworkInfrastructureAttack> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#MissingErrorHandling> a owl:Class ;
    rdfs:comment "Missing error handling may reveal hidden coding details."^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInDevelopment> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#MissingInputValidation> a owl:Class ;
    rdfs:comment "Leaving inputs to a lightweight validation i's one of the most relevant applicationn vulnerability." ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInDevelopment> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#MultipleServicesIntegration> a owl:Class ;
    rdfs:comment "The integration of several networkign services like access to PAN, LAN and WAN in the same divice makes hard the set up of access control policies. This integration  agravates also the multi-session attacks."^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CommunicationVulnerability> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#NAKAttack> a owl:Class ;
    rdfs:comment "Concurrent processes may cause logical breaks. These breaks could be exploited by malicious code to get access to protected resources."^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#SoftwareAttack> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#NotAuthenticatedSoftInstallation> a owl:Class ;
    rdfs:comment "Several untrusted softwares are available for free download or through the trasnfer from an other device. These softwares may be infected with viruses or have trojans. They may also come up with bad code that leads to denial of service."^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInUse> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#OTASoftwareUpdate> a owl:Class ;
    rdfs:comment "Software Update can be performed Over The Air without user konwledge or confirmation. These softwares may be infected or trojanized."^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInUse> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#PowerAnalysis> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#SideChannelAttack> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#ProcessingPowerLimitation> a owl:Class ;
    rdfs:comment "Limited Processing power is boundary for cryptographic enhanced tasks." ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#PhysicalVulnerability> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#RoamingConfigChallenges> a owl:Class ;
    rdfs:comment "Switching from one network to an other should respect security policies." ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CommunicationVulnerability> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#SmartCardUpdate> a owl:Class ;
    rdfs:comment "The procedure of updating the SIM card is a heavy task for the operator."^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CommunicationVulnerability> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#StatisticalAttack> a owl:Class ;
    rdfs:comment "A cryptanalysis that exploits the predictibility of a particular data segment or a prdicatable relationships among different data segments in a cipher codestream to deduce the plaintext without the knowledge of the decryption key or to substantially reduce the search space such that a brute force attack is feasable."^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CryptographicAttack> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#TestWithEmulatorOnly> a owl:Class ;
    rdfs:comment "After developement, applications should be tested with real and different devices and not only with emulators."^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInDevelopment> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#UnsafeMessageAcceptance> a owl:Class ;
    rdfs:comment "Non authenticated SMS or MMS may deal to denial fo service or virus infection."^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInUse> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#UnsafeStorageDevicePlugging> a owl:Class ;
    rdfs:comment "Exchanging Memory card may lead to virus infection."^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInUse> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#UseofUntrustedAPI> a owl:Class ;
    rdfs:comment "Some API, components may be downloaded and used by developers without any security garantee."^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInDevelopment> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#UseofVulnerableProgLanguage> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInDevelopment> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#WirelessTransmission> a owl:Class ;
    rdfs:comment "Wireless transmission could be exploited by hacker to eavesdrop traffic, analyse authentication tokens and sensitive information in general."^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CommunicationVulnerability> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#hasVulnerability> a owl:ObjectProperty ;
    rdfs:range <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Vulnerability> .

ns1:2.5G a owl:Class ;
    rdfs:subClassOf ns1:WANetwork .

ns1:3G a owl:Class ;
    rdfs:subClassOf ns1:WANetwork .

    rdfs:subClassOf ns1:BlockCipherAlgorithm .

ns1:AES_FIPS197 a ns1:AES .

ns1:AccessControlList a owl:Class ;
    rdfs:comment "List of permissions attached to an object."^^xsd:string ;
    rdfs:subClassOf ns1:AccessControlMethods .

ns1:Checksum a owl:Class ;
    rdfs:subClassOf ns1:Algorithm .

ns1:CodingStandards a owl:Class ;
    rdfs:comment "Deploy development regimes such as coding standards and documentation methodologies to lead to best practises" ;
    rdfs:subClassOf ns1:BestPractises .

    rdfs:subClassOf ns1:BlockCipherAlgorithm .

ns1:DES_FIPS46-1-2 a ns1:DES .

ns1:DataRecords a owl:Class ;
    rdfs:comment "Some applications use records files to store data."^^xsd:string ;
    rdfs:subClassOf ns1:LocalFiles .

ns1:JME a ns1:Platform .

ns1:LANetwork a owl:Class ;
    rdfs:subClassOf ns1:Network .

ns1:LockingScreen a owl:Class ;
    rdfs:comment "In some situations it is useful to lock the screen display until a task is terminated. This is technique is used to avoid the screen modification until a answer is received."^^xsd:string ;
    rdfs:subClassOf ns1:LockingMechanism .

ns1:MobileVPN a owl:Class ;
    rdfs:subClassOf ns1:VPN .

ns1:RC4 a owl:Class ;
    rdfs:comment "A free algorithm provided by  RSA security, implemented since 1970."^^xsd:string ;
    rdfs:subClassOf ns1:StreamCipherAlgorithm .

ns1:SIM a owl:Class ;
    rdfs:comment "Subscriber Identity Module; A smart card for GSM networks access." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:BlockCipherAlgorithm ;
            owl:onProperty ns1:Provide ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Provide ;
            owl:someValuesFrom ns1:CryptographicHashFunction ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:BlockCipherAlgorithm ;
            owl:onProperty ns1:Provide ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Provide ;
            owl:someValuesFrom ns1:DigitalSignatureAlgorithm ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Provide ;
            owl:someValuesFrom ns1:AsymmetricAlgorithm ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Provide ;
            owl:someValuesFrom ns1:DigitalSignatureAlgorithm ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Provide ;
            owl:someValuesFrom ns1:CryptographicHashFunction ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Provide ;
            owl:someValuesFrom ns1:AsymmetricAlgorithm ],
        ns1:SmartCard .

ns1:StreamCipherAlgorithm a owl:Class ;
    rdfs:subClassOf ns1:SymmetricAlgorithm .

ns1:TrustedAPIAttack a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#ApplicationAPIAttack> .

ns1:UnTrustedAPIAttack a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#ApplicationAPIAttack> .

ns1:X509Certificate a owl:Class ;
    rdfs:subClassOf ns1:CertificateFormat .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CryptographicAttack> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Interception> a owl:Class ;
    rdfs:comment "The attacker intercepts information without modifing or deleting them. This is a passive attack. This affects the privacy of the subscriber and the network operator."^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#NetworkInfrastructureAttack> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Replay> a owl:Class ;
    rdfs:comment "In this case the attacker may insert spurious objects into the system. The attacker may insert fake signaling messages, the effects could result in the attacker masquerading as an authority."^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#NetworkInfrastructureAttack> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInConfig> a owl:Class ;
    rdfs:comment "Some default configurations of services may be exploited by hackers."^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#SoftwareVulnerability> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerableServiceAutoStart> a owl:Class ;
    rdfs:comment "Some services like Bluetooth for example starts automatically which may lead to intrusion and access controls attacks." ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#InsecureDefaultSettings> .

ns1:2G a owl:Class ;
    rdfs:subClassOf ns1:WANetwork .

ns1:Add-OnMemory a owl:Class ;
    rdfs:subClassOf ns1:Memory .

ns1:AuthenticationWay a owl:Class ;
    rdfs:subClassOf ns1:ValueTypes .

ns1:Backup a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Availability ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Journaling ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Availability ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Journaling ],
        ns1:Techniques .

ns1:CardType a owl:Class ;
    rdfs:subClassOf ns1:ValueTypes .

ns1:CertificateInstallation a owl:Class ;
    rdfs:subClassOf ns1:DeviceCapabilities .

ns1:ConfigurationData a owl:Class ;
    rdfs:comment "Several configuration data are stored in the device or sent by the mobile operator."^^xsd:string ;
    rdfs:subClassOf ns1:Data .

ns1:DigitalSignature a owl:Class ;
    rdfs:comment "A digital signature is represented in a computer as a string of binary\\ndigits. A digital signature is computed using a set of rules and a set of parameters such that the identity of the signatory and integrity of the data can be verified. An algorithm provides the capability to generate and verify signatures. Signature generation makes use of a private key to generate a digital signature. Signature verification makes use of a public key which corresponds to, but is not the same as, the private key. (http://csrc.nist.gov/publications/fips/fips186-2/fips186-2-change1.pdf)"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Authentication ],
        [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:Use ;
                        owl:someValuesFrom ns1:MACAlgorithm ] [ a owl:Restriction ;
                        owl:onProperty ns1:Use ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:CryptographicHashFunction ns1:DigitalSignatureAlgorithm ) ] ] ) ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:NonRepudiation ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Authentication ],
        [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:Use ;
                        owl:someValuesFrom ns1:MACAlgorithm ] [ a owl:Restriction ;
                        owl:onProperty ns1:Use ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:CryptographicHashFunction ns1:DigitalSignatureAlgorithm ) ] ] ) ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:NonRepudiation ],
        ns1:CoreCounterMeasure .

ns1:HasBandwidth a owl:DatatypeProperty ;
    rdfs:domain ns1:Network ;
    rdfs:range xsd:positiveInteger .

ns1:HasBlockSize a owl:DatatypeProperty .

ns1:HasKeySize a owl:DatatypeProperty ;
    rdfs:domain ns1:Keys ;
    rdfs:range xsd:positiveInteger .

ns1:Help a owl:ObjectProperty ;
    rdfs:subPropertyOf ns1:QualitySatisfaction .

ns1:IPSec a owl:Class ;
    rdfs:subClassOf ns1:SecureNetworkCommunication .

ns1:IndustrialProtocol a owl:Class ;
    rdfs:subClassOf ns1:Standards .

ns1:IntegrityType a owl:Class ;
    rdfs:subClassOf ns1:ValueTypes .

ns1:KeyPad a owl:Class ;
    rdfs:subClassOf ns1:Input .

ns1:KeyStore a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:Store ;
            owl:someValuesFrom ns1:Keys ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Confidentiality ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Integrity ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Store ;
            owl:someValuesFrom ns1:Keys ],
        [ a owl:Restriction ;
