    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:Use ;
            owl:someValuesFrom ns1:RSAAlgorithm ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Use ;
            owl:someValuesFrom ns1:RSAAlgorithm ],
        ns1:DigitalSignatureAlgorithm .

ns1:ReadUserDataFunctionGroup a ns1:FunctionGroups ;
    rdfs:comment "Read User Data: Set of permissions to read user’s data like phone book or calendar entries" .

ns1:Recovery a ns1:MechanismType .

ns1:ReduceCodeSize a owl:Class ;
    rdfs:subClassOf ns1:BestPractises .

