    rdfs:domain ns1:Device ;
    rdfs:range xsd:positiveInteger .

ns1:hasIMSI a owl:DatatypeProperty ;
    rdfs:domain ns1:SmartCard ;
    rdfs:range xsd:positiveInteger .

ns1:hasInitialisationVector a owl:DatatypeProperty ;
