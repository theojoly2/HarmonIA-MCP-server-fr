    dc:format "A certificate which is issued by the device manufacturer like Nokia or Samsung for example."^^xsd:string ;
    rdfs:subClassOf ns1:Certificate .

ns1:Mechanism a owl:Class ;
    rdfs:comment "Security mechanisms used for security services" ;
    rdfs:subClassOf owl:Thing .

ns1:MechanismType a owl:Class ;
    rdfs:subClassOf ns1:ValueTypes .

ns1:Memory a owl:Class ;
    rdfs:subClassOf ns1:Resource .

ns1:Messaging a owl:Class ;
    rdfs:subClassOf ns1:CommChannel .

ns1:NonRepudiation a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:NonRepudiationType ;
            owl:onProperty ns1:hasType ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:NonRepudiationType ;
            owl:onProperty ns1:hasType ],
        <http://www.semanticweb.org/ontologies/2008/11/OntologyServices.owl#Services> .

ns1:NonRepudiationType a owl:Class ;
    rdfs:subClassOf ns1:ValueTypes .

ns1:OperatorCertificate a owl:Class ;
    dc:format "A certificate which is issued by the mobile network operator."^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( ns1:SmartCard [ a owl:Restriction ;
                        owl:onProperty ns1:storedOn ;
                        owl:someValuesFrom ns1:Device ] ) ],
        [ a owl:Class ;
            owl:unionOf ( ns1:SmartCard [ a owl:Restriction ;
                        owl:onProperty ns1:storedOn ;
                        owl:someValuesFrom ns1:Device ] ) ],
        ns1:Certificate .

ns1:PANetwork a owl:Class ;
    rdfs:subClassOf ns1:Network .

ns1:PrivateKey a owl:Class ;
    rdfs:subClassOf ns1:Keys .

ns1:QualitySatisfaction a owl:ObjectProperty .

ns1:RNGEfficiency a owl:Class ;
    rdfs:subClassOf ns1:ValueTypes .

ns1:SecretKey a owl:Class ;
    rdfs:subClassOf ns1:Keys .

ns1:SecureNetworkCommunication a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Confidentiality ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Confidentiality ],
        ns1:SecurityTools .

ns1:SmartCardLock a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:AccessControl ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:AccessControl ],
        ns1:LockingMechanism .

ns1:Software a owl:Class ;
    rdfs:comment "All the applications and data provided with or installed on the device."^^xsd:string ;
    rdfs:subClassOf ns1:Asset .

ns1:SymmetricAlgorithm a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:SecretKey ;
            owl:onProperty ns1:hasKey ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Help ;
            owl:someValuesFrom ns1:Efficiency ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Help ;
            owl:someValuesFrom ns1:Efficiency ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:SecretKey ;
            owl:onProperty ns1:hasKey ],
        ns1:Algorithm .

ns1:Usability a owl:Class ;
    rdfs:comment "A good response time of the application."^^xsd:string ;
    rdfs:subClassOf ns1:Quality .

ns1:hasLevel a owl:ObjectProperty ;
    rdfs:subPropertyOf ns1:Relationship .

ns1:hasMemory a owl:ObjectProperty ;
    rdfs:subPropertyOf ns1:Relationship .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#ByPassingAuthentication> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#SoftwareAttack> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CommunicationVulnerability> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Vulnerability> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#HardwareAttack> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat> .

ns1:ApplicationData a owl:Class ;
    rdfs:subClassOf ns1:Data .

ns1:CoreCounterMeasure a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CounterMeasure> .

ns1:Cost a owl:Class ;
    rdfs:comment "Time, skills, additional equipments are considered as cost constraints"^^xsd:string ;
    rdfs:subClassOf ns1:Constraints .

ns1:Device a owl:Class ;
    rdfs:comment "Mobile terminal equiped with processing capabilities offering  connection to wireless networks." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:LogInSystem ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasNetwork ;
            owl:someValuesFrom ns1:Network ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:LogInSystem ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasMemory ;
            owl:someValuesFrom ns1:Memory ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasProcessing ;
            owl:someValuesFrom ns1:Processing ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasNetwork ;
            owl:someValuesFrom ns1:Network ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:DeviceLock ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:hasIMEI ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasMemory ;
            owl:someValuesFrom ns1:Memory ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasProcessing ;
            owl:someValuesFrom ns1:Processing ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasOutput ;
            owl:someValuesFrom ns1:Output ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:DeviceLock ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:DigitalRightsManagement ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasInput ;
            owl:someValuesFrom ns1:Input ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasOutput ;
            owl:someValuesFrom ns1:Output ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:DigitalRightsManagement ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasInput ;
            owl:someValuesFrom ns1:Input ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:hasIMEI ],
        ns1:Actor .

ns1:FunctionGroups a owl:Class ;
    rdfs:comment "A set of sensitive functions under a named group that can get authorization."^^xsd:string ;
    rdfs:subClassOf ns1:AccessControlMethods .

ns1:KeyManagement a owl:Class ;
    rdfs:comment "The process and procedure for safely storing and distributing accurate cryptographic keys; the overall process of generating and distributing cryptographic key to authorized recipients in a secure manner."^^xsd:string ;
    rdfs:subClassOf ns1:Mechanism .

ns1:LocalFiles a owl:Class ;
    rdfs:subClassOf ns1:ApplicationData .

ns1:MACAlgorithm a owl:Class ;
    rdfs:comment "Message authentication code that include a key for authentication" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:Use ;
            owl:someValuesFrom ns1:CryptographicHashFunction ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Use ;
            owl:someValuesFrom ns1:CryptographicHashFunction ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:SecretKey ;
            owl:onProperty ns1:Use ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:SecretKey ;
            owl:onProperty ns1:Use ],
        ns1:Algorithm .

ns1:MessageDigest a owl:Class ;
    rdfs:comment "A function that takes a string (or message) of any length as input and produces a fixed-length string as output,it is used for authentication and message integrity."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:HasOutputLength ;
            owl:someValuesFrom xsd:positiveInteger ],
        [ a owl:Restriction ;
            owl:onProperty ns1:HasOutputLength ;
            owl:someValuesFrom xsd:positiveInteger ],
        ns1:CoreCounterMeasure .

ns1:Output a owl:Class ;
    rdfs:subClassOf ns1:Resource .

ns1:Platform a owl:Class ;
    rdfs:comment "The software device platform layer"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:LogInSystem ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:AccessControlMethods ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:KeyManagement ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:ResourceMonitoring ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:ResourceMonitoring ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:Algorithm ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:Algorithm ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:MessageDigest ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:AccessControlMethods ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:MessageDigest ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:KeyManagement ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:LogInSystem ],
        ns1:Actor .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#PhysicalVulnerability> a owl:Class ;
    rdfs:comment "Features related to the physical aspect of the device and its properties."^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Vulnerability> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#SoftwareAttack> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInDevelopment> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#SoftwareVulnerability> .

ns1:AccessControlMethods a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Integrity ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Confidentiality ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:AccessControl ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:AccessControl ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Integrity ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Confidentiality ],
        ns1:CoreCounterMeasure .

ns1:Asset a owl:Class ;
    rdfs:comment "The set of assets that should be protected"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#victimOf> ;
            owl:someValuesFrom <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat> ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#victimOf> ;
            owl:someValuesFrom <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat> ],
        owl:Thing .

ns1:AsymmetricAlgorithm a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:PrivateKey ns1:PublicKey ) ] ;
            owl:onProperty ns1:Use ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Hurt ;
            owl:someValuesFrom ns1:Efficiency ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Hurt ;
            owl:someValuesFrom ns1:Efficiency ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:PrivateKey ns1:PublicKey ) ] ;
            owl:onProperty ns1:Use ],
        ns1:Algorithm .

ns1:AuthenticationLevel a owl:Class ;
    rdfs:subClassOf ns1:ValueTypes .

ns1:Availability a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Duration ;
            owl:onProperty ns1:hasDuration ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Duration ;
            owl:onProperty ns1:hasDuration ],
        <http://www.semanticweb.org/ontologies/2008/11/OntologyServices.owl#Services> .

ns1:ChainingMode a owl:Class ;
    rdfs:subClassOf ns1:ValueTypes .

ns1:ConfidentialityLevel a owl:Class ;
    rdfs:subClassOf ns1:ValueTypes .

ns1:PRNGAlgorithm a owl:Class ;
    rdfs:comment "Pseudo Random Number Generation algorithm" ;
    rdfs:subClassOf ns1:Algorithm .

ns1:SmartCard a owl:Class ;
    rdfs:comment "A smart card is any limited-sized card with embedded integrated circuits. The smart card may integrate or not processing capabilities."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:AsymmetricEncryption ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:DigitalSignature ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:SmartCardLock ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:KeyStore ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:SymmetricEncryption ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:SymmetricEncryption ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:AsymmetricEncryption ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:SmartCardMemory ;
            owl:onProperty ns1:hasMemory ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:hasIMSI ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:SmartCardMemory ;
            owl:onProperty ns1:hasMemory ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:MessageDigest ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:SmartCardLock ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:KeyStore ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:hasIMSI ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:DigitalSignature ],
        [ a owl:Restriction ;
            owl:onProperty ns1:ImplementMechanism ;
            owl:someValuesFrom ns1:MessageDigest ],
        ns1:Actor .

ns1:Techniques a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CounterMeasure> .

ns1:hasTrustIn a owl:ObjectProperty,
        owl:ReflexiveProperty .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#NetworkInfrastructureAttack> a owl:Class ;
    rdfs:comment "These attacks belong to the mobile network operator. Most of them require physical air interface equipments like fake base station or modified antenna."^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInUse> a owl:Class ;
    rdfs:comment "Vulnerabilities during the use of the application or service."^^xsd:string ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#SoftwareVulnerability> .

ns1:ApplicationLifeCyclePhase a owl:Class ;
    rdfs:subClassOf ns1:ValueTypes .

ns1:AuthenticationProtocolType a owl:Class ;
    rdfs:subClassOf ns1:ValueTypes .

ns1:AuthenticationToken a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Authentication ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Authentication ],
        ns1:CoreCounterMeasure .

ns1:CertificationAuthority a owl:Class ;
    rdfs:comment "The certification authority provides certificates to bind a set of informations (name, serial number, ...) to a public key."^^xsd:string ;
    rdfs:subClassOf ns1:TrustedThirdParty .

ns1:DigitalRightsManagement a owl:Class ;
    rdfs:comment "A general framework for downloading Rights to Devices and sharing Rights in a domain. DRM is invented by the Open Mobile Alliance whose members are mobile phone manufacturers, mobile system manufacturers, operators , and sofware editors."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:AccessControl ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:AccessControl ],
        ns1:Techniques .

ns1:Duration a owl:Class ;
    rdfs:subClassOf ns1:ValueTypes .

ns1:Input a owl:Class ;
    rdfs:comment "Keypad or any input tool"^^xsd:string ;
    rdfs:subClassOf ns1:Resource .

ns1:KeyExchangeProtocol a owl:Class ;
    rdfs:subClassOf ns1:IndustrialProtocol .

ns1:Keys a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:hasKeyLifeTime ;
            owl:someValuesFrom ns1:Duration ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:HasKeySize ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:HasKeySize ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasKeyLifeTime ;
            owl:someValuesFrom ns1:Duration ],
        ns1:Mechanism .

ns1:SourceCodeVerification a owl:Class ;
    rdfs:subClassOf ns1:SecurityTools .

<http://www.semanticweb.org/ontologies/2008/11/OntologyServices.owl#Services> a owl:Class ;
    rdfs:comment "Security services ontology"@en ;
    rdfs:subClassOf owl:Thing .

ns1:Actor a owl:Class ;
    rdfs:comment "Actors participating in the realisation and implementation of security services" ;
    rdfs:subClassOf owl:Thing .

ns1:CommChannel a owl:Class ;
    rdfs:subClassOf ns1:ValueTypes .

ns1:Resource a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:TrustedThirdParty a owl:Class ;
    rdfs:comment "security authority or its agent, trusted by other entities with respect to security-related activities. In the context of ISO/IEC 9798, a trusted third party is trusted by a claimant and/or a verifier for the purposes of authentication.  ISO/IEC 9798"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:Provide ;
            owl:someValuesFrom ns1:SourceCodeVerification ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Issue ;
            owl:someValuesFrom ns1:Certificate ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Issue ;
            owl:someValuesFrom ns1:Certificate ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Provide ;
            owl:someValuesFrom ns1:SourceCodeVerification ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasTrustIn ;
            owl:someValuesFrom ns1:TrustedThirdParty ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasTrustIn ;
            owl:someValuesFrom ns1:TrustedThirdParty ],
        ns1:Actor .

ns1:Algorithm a owl:Class ;
    rdfs:subClassOf ns1:Mechanism .

ns1:BlockCipherAlgorithm a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:ChainingMode ;
            owl:onProperty ns1:hasChainingMode ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:HasBlockSize ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:hexBinary ;
            owl:onProperty ns1:hasInitialisationVector ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasPadding ;
            owl:someValuesFrom xsd:hexBinary ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasPadding ;
            owl:someValuesFrom xsd:hexBinary ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:hexBinary ;
            owl:onProperty ns1:hasInitialisationVector ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:ChainingMode ;
            owl:onProperty ns1:hasChainingMode ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:HasBlockSize ],
        ns1:SymmetricAlgorithm .

ns1:Network a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:hasNetworkLatency ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:hasNetworkLatency ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:HasBandwidth ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:HasBandwidth ],
        ns1:Resource .

ns1:OrganizationsAndStandards a owl:Class ;
    rdfs:comment "Organizations and associations providing standards in the mobile field arena." ;
    rdfs:subClassOf ns1:ValueTypes .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CounterMeasure> a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:AccessControl a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2008/11/OntologyServices.owl#Services> .

ns1:BestPractises a owl:Class ;
    rdfs:subClassOf ns1:Standards .

ns1:Confidentiality a owl:Class ;
    rdfs:comment "The confidentiality service"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:hasLevel ;
            owl:someValuesFrom ns1:ConfidentialityLevel ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasLevel ;
            owl:someValuesFrom ns1:ConfidentialityLevel ],
        [ a owl:Restriction ;
            owl:onProperty ns1:AppliedTo ;
            owl:someValuesFrom ns1:DomainEntities ],
        [ a owl:Restriction ;
            owl:onProperty ns1:AppliedTo ;
            owl:someValuesFrom ns1:DomainEntities ],
        <http://www.semanticweb.org/ontologies/2008/11/OntologyServices.owl#Services> .

ns1:DigitalSignatureAlgorithm a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:PrivateKey ;
            owl:onProperty ns1:Use ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:PrivateKey ;
            owl:onProperty ns1:Use ],
        ns1:Algorithm .

ns1:Issue a owl:ObjectProperty ;
    rdfs:subPropertyOf ns1:Relationship .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Vulnerability> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#existsOn> ;
            owl:someValuesFrom ns1:Asset ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#isExploitedBy> ;
            owl:someValuesFrom <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat> ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#isExploitedBy> ;
            owl:someValuesFrom <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat> ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#isCorrectedBy> ;
            owl:someValuesFrom <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CounterMeasure> ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#isCorrectedBy> ;
            owl:someValuesFrom <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CounterMeasure> ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#existsOn> ;
            owl:someValuesFrom ns1:Asset ],
        owl:Thing .

owl:Thing a owl:Class ;
    rdfs:comment ""^^xsd:string .

ns1:Certificate a owl:Class ;
    dc:format "A digital certificate is a text document that contains general information about its holder with the associated public key and general informations about the validity of the certificate. The digital certificate is signed by the certification authority that has issued it and can be verified a digital signature.\\nThe digital certificates, together with the identity data and public key, are stored on a USB-compatible token or a conventional smart card for use as part of strong authentication. When users try to log on to the corporate network, they connect their token with the USB slot or their smart card with the card reader.The digital certificate and public key are sent to the authentication authority via internet. To ensure that the public key sent actually belongs to the person attempting to log on to the corporate networks, the independent certification authority confirms that the public key matches the secret key it has stored"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:hasSignatureAlgorithm ;
            owl:someValuesFrom ns1:DigitalSignatureAlgorithm ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:hasSubjectName ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:hasSubjectName ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:hasDigitalSignatureData ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:hasDigitalSignatureData ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasIssuer ;
            owl:someValuesFrom ns1:CertificationAuthority ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasFormat ;
            owl:someValuesFrom ns1:CertificateFormat ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasSignatureAlgorithm ;
            owl:someValuesFrom ns1:DigitalSignatureAlgorithm ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:hasValidity ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasIssuer ;
            owl:someValuesFrom ns1:CertificationAuthority ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasFormat ;
            owl:someValuesFrom ns1:CertificateFormat ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:hasValidity ],
        ns1:AuthenticationToken .

ns1:CryptographicHashFunction a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:HasOutputLength ;
            owl:someValuesFrom xsd:positiveInteger ],
        [ a owl:Restriction ;
            owl:onProperty ns1:HasOutputLength ;
            owl:someValuesFrom xsd:positiveInteger ],
        ns1:Checksum ;
    owl:equivalentClass ns1:MessageDigest .

ns1:Authentication a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:AppliedTo ;
            owl:someValuesFrom ns1:DomainEntities ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:AuthenticationLevel ;
            owl:onProperty ns1:hasLevel ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:AuthenticationLevel ;
            owl:onProperty ns1:hasLevel ],
        [ a owl:Restriction ;
            owl:onProperty ns1:AppliedTo ;
            owl:someValuesFrom ns1:DomainEntities ],
        <http://www.semanticweb.org/ontologies/2008/11/OntologyServices.owl#Services> .

ns1:Integrity a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2008/11/OntologyServices.owl#Services> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:hasThreatType ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threatens> ;
            owl:someValuesFrom ns1:Asset ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threatens> ;
            owl:someValuesFrom ns1:Asset ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#enabledBy> ;
            owl:someValuesFrom <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Vulnerability> ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasThreatType ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#enabledBy> ;
            owl:someValuesFrom <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Vulnerability> ],
        owl:Thing .

ns1:Provide a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:subPropertyOf ns1:Relationship .

ns1:ValueTypes a owl:Class ;
    rdfs:comment "Additional and required types for the ontology" ;
    rdfs:subClassOf owl:Thing .

ns1:Relationship a owl:ObjectProperty .

ns1:ImplementMechanism a owl:ObjectProperty .

ns1:Use a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:subPropertyOf ns1:Relationship .

ns1:Satisfice a owl:ObjectProperty ;
    rdfs:domain ns1:Mechanism ;
    rdfs:range <http://www.semanticweb.org/ontologies/2008/11/OntologyServices.owl#Services> ;
    rdfs:subPropertyOf ns1:Relationship .

[] a owl:Axiom ;
    rdf:object ns1:FunctionGroups ;
    rdf:predicate rdf:type ;
    rdf:subject ns1:NetAccessFunctionGroup ;
    rdfs:comment "" .

[] a owl:AllDifferent ;
    owl:distinctMembers ( ns1:Offline ns1:Parallel ) .

[] a owl:Axiom ;
    rdf:object ns1:CertificateInstallation ;
    rdf:predicate rdf:type ;
    rdf:subject ns1:CertificateInstallationApplication ;
    rdfs:comment "A Symbian and Nokia application that provides capabilities to install symbian certificates on some Nokia devices" .

[] a owl:Axiom ;
    rdf:object ns1:CardMemory ;
    rdf:predicate rdf:type ;
    rdf:subject ns1:SD ;
    rdfs:comment "Secure Digital Memory Card"^^xsd:string .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:Platform ) .

[] a owl:Axiom ;
    rdf:object ns1:CertificateInstallation ;
    rdf:predicate rdf:type ;
    rdf:subject ns1:CertificateInstallationApplication ;
    rdfs:comment "A Symbian and Nokia application that provides capabilities to install symbian certificates on some Nokia devices" .

[] a owl:AllDifferent ;
    owl:distinctMembers ( ns1:Offline ns1:Parallel ) .

[] a owl:Axiom ;
    rdf:object ns1:FunctionGroups ;
    rdf:predicate rdf:type ;
    rdf:subject ns1:NetAccessFunctionGroup ;
    rdfs:comment "" .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:Platform ) .

[] a owl:Axiom ;
    rdf:object ns1:CardMemory ;
    rdf:predicate rdf:type ;
    rdf:subject ns1:SD ;
    rdfs:comment "Secure Digital Memory Card"^^xsd:string .

