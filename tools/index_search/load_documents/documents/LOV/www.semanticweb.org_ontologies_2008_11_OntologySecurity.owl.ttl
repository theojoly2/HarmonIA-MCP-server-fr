    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CounterMeasure> .

ns1:SecurityTools a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CounterMeasure> .

ns1:SmartCardMemory a owl:Class ;
    rdfs:comment "Memory available on smart card like SIM, USIM or others;" ;
    rdfs:subClassOf ns1:Add-OnMemory .

ns1:Standards a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CounterMeasure> .

ns1:Store a owl:ObjectProperty ;
    rdfs:subPropertyOf ns1:Relationship .

ns1:SymmetricEncryption a owl:Class ;
    rdfs:comment "Also known as conventional, secret-key, and single-key algorithms; the encryption and decryption key are either the same or can be calculated from one another. Block ciphers and stream ciphers are both used for symmetric encryption."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:Use ;
            owl:someValuesFrom ns1:SymmetricAlgorithm ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Use ;
            owl:someValuesFrom ns1:SymmetricAlgorithm ],
        ns1:Encryption .

ns1:TLS a owl:Class ;
    rdfs:comment "Transport Layer Security is an IETF standard that is intended to replace the SSL protocol. (IETF Working Group)" ;
    rdfs:subClassOf ns1:SecureNetworkCommunication .

ns1:ThreatType a owl:Class ;
    rdfs:subClassOf ns1:ValueTypes .

ns1:VPN a owl:Class ;
    rdfs:comment "Virtula private network. FIPS 140-2"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:Use ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:IPSec ns1:SSL ns1:TLS ) ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Use ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:IPSec ns1:SSL ns1:TLS ) ] ],
        ns1:SecurityInfrastructure .

ns1:hasAuthenticationProtocolType a owl:ObjectProperty ;
    rdfs:subPropertyOf ns1:Relationship .

ns1:hasChainingMode a owl:ObjectProperty ;
