ns1:hasNetworkLatency a owl:DatatypeProperty ;
    rdfs:domain ns1:Network ;
    rdfs:range xsd:positiveInteger .

ns1:hasOutput a owl:ObjectProperty ;
    rdfs:subPropertyOf ns1:Relationship .

ns1:hasPadding a owl:DatatypeProperty ;
    rdfs:domain ns1:BlockCipherAlgorithm ;
    rdfs:range xsd:hexBinary .

ns1:hasProcessing a owl:ObjectProperty ;
    rdfs:subPropertyOf ns1:Relationship .

ns1:hasRNGDeterminism a owl:DatatypeProperty ;
    rdfs:domain ns1:KeyGeneration ;
    rdfs:range xsd:boolean .

ns1:hasRNGEfficiency a owl:ObjectProperty ;
    rdfs:subPropertyOf ns1:Relationship .

ns1:hasScreenSize a owl:DatatypeProperty ;
    rdfs:domain ns1:DisplayScreen ;
    rdfs:range xsd:float .

ns1:hasSignatureAlgorithm a owl:ObjectProperty ;
    rdfs:domain ns1:Certificate ;
    rdfs:range ns1:DigitalSignatureAlgorithm ;
    rdfs:subPropertyOf ns1:Relationship .

ns1:hasSubjectName a owl:DatatypeProperty ;
    rdfs:domain ns1:Certificate ;
    rdfs:range xsd:string .

ns1:hasThreatType a owl:DatatypeProperty ;
    rdfs:comment "A Threat type may be a passive or an active threat."^^xsd:string ;
    rdfs:domain <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat> ;
    rdfs:range xsd:string .

ns1:hasType a owl:ObjectProperty,
        owl:ReflexiveProperty ;
    rdfs:subPropertyOf ns1:Relationship .

ns1:hasValidity a owl:DatatypeProperty ;
    rdfs:domain ns1:Certificate ;
    rdfs:range xsd:duration .

ns1:storedOn a owl:ObjectProperty ;
    rdfs:subPropertyOf ns1:Relationship .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#ApplicationAPIAttack> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#SoftwareAttack> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#HardwareCloning> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#HardwareAttack> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#SideChannelAttack> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#HardwareAttack> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threatens> a owl:ObjectProperty ;
    rdfs:domain <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat> ;
    owl:inverseOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#victimOf> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#existsOn> a owl:ObjectProperty ;
    rdfs:domain <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Vulnerability> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#isCorrectedBy> a owl:ObjectProperty ;
    rdfs:domain <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Vulnerability> ;
    rdfs:range <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CounterMeasure> .

<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#isExploitedBy> a owl:ObjectProperty ;
    rdfs:domain <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Vulnerability> ;
    rdfs:range <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat> ;
    owl:inverseOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#enabledBy> .

ns1:Constraints a owl:Class ;
    rdfs:comment "Technical, quality constraints and others" ;
    rdfs:subClassOf owl:Thing .

ns1:DeviceCapabilities a owl:Class ;
    rdfs:subClassOf ns1:ValueTypes .

ns1:DisplayScreen a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:hasScreenSize ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:hasScreenSize ],
        ns1:Output .

ns1:Encryption a owl:Class ;
    rdfs:comment "Discipline which embodies principles, means, and methods for the transformation of data in order to hide its information content, prevent its undetected modification and/or prevent its unauthorised use. (CCITT)"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Integrity ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Confidentiality ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Confidentiality ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Authentication ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Use ;
            owl:someValuesFrom ns1:PRNGAlgorithm ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Use ;
            owl:someValuesFrom ns1:PRNGAlgorithm ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Authentication ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Integrity ],
        ns1:CoreCounterMeasure .

ns1:FixedMemory a owl:Class ;
    rdfs:subClassOf ns1:Memory .

ns1:KeyGeneration a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:hasRNGEfficiency ;
            owl:someValuesFrom ns1:RNGEfficiency ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasRNGDeterminism ;
            owl:someValuesFrom xsd:boolean ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasRNGEfficiency ;
            owl:someValuesFrom ns1:RNGEfficiency ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasRNGDeterminism ;
            owl:someValuesFrom xsd:boolean ],
        ns1:KeyManagement .

ns1:PKI a owl:Class ;
    rdfs:comment "Public-key infrastructure (PKI) consists of protocols, services, and standards supporting applications of public-key cryptography. PKI sometimes refers simply to a trust hierarchy based on public-key certificates, and in other contexts embraces encryption and digital signature services provided to end-user applications as well. RSA (http://www.rsa.com/rsalabs/node.asp?id=2268)"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:NonRepudiation ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Integrity ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Use ;
            owl:someValuesFrom ns1:Certificate ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Use ;
            owl:someValuesFrom ns1:AsymmetricEncryption ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Authentication ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:NonRepudiation ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Use ;
            owl:someValuesFrom ns1:AsymmetricEncryption ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Confidentiality ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Integrity ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Use ;
            owl:someValuesFrom ns1:CertificationAuthority ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Use ;
            owl:someValuesFrom ns1:Certificate ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Authentication ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Confidentiality ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Use ;
            owl:someValuesFrom ns1:CertificationAuthority ],
        ns1:SecurityInfrastructure .

ns1:ResourceMonitoring a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:AccessControl ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Availability ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:AccessControl ],
        [ a owl:Restriction ;
            owl:onProperty ns1:Satisfice ;
            owl:someValuesFrom ns1:Availability ],
        ns1:Techniques .

