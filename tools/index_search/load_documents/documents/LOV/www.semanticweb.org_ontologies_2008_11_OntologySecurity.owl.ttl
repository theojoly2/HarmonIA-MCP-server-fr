    rdfs:comment "Best use of the available resources."^^xsd:string ;
    rdfs:subClassOf ns1:Usability .

ns1:HasOutputLength a owl:DatatypeProperty ;
    rdfs:range xsd:positiveInteger .

ns1:Hurt a owl:ObjectProperty ;
    rdfs:subPropertyOf ns1:QualitySatisfaction .

ns1:Internet a owl:Class ;
    rdfs:subClassOf ns1:CommChannel .

ns1:Journaling a owl:Class ;
    rdfs:subClassOf ns1:Techniques .

