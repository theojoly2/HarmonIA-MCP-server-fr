    rdfs:subClassOf ns1:ApplicationData .

ns1:Manual a owl:Class ;
    rdfs:subClassOf ns1:CommChannel .

ns1:NetAccessFunctionGroup rdfs:comment "Contains permissions related to network data connections." .

ns1:O.T.P a owl:Class ;
    rdfs:comment "Password used for once and generated from time, counter and/or key. May be a displayed from a hardware device."^^xsd:string ;
    rdfs:subClassOf ns1:Password .

ns1:Offline a ns1:OperationMode .

ns1:OperationMode a owl:Class ;
    rdfs:subClassOf ns1:ValueTypes .

ns1:Parallel a ns1:OperationMode .

ns1:Password a owl:Class ;
    rdfs:subClassOf ns1:AuthenticationToken .

ns1:Portability a owl:Class ;
    rdfs:comment "ability of Application running on several devices or/and platforms."^^xsd:string ;
    rdfs:subClassOf ns1:Quality .

ns1:Processing a owl:Class ;
    rdfs:subClassOf ns1:Resource .

ns1:PublicKey a owl:Class ;
