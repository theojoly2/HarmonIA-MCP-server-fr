    rdfs:subClassOf ns1:Availability .

ns1:Phishing a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#ByPassingAuthentication> .

ns1:PhysicalLayer a owl:Class ;
    rdfs:subClassOf ns1:SecurityLayer .

ns1:Poor a ns1:RNGEfficiency .

ns1:PreemptDisplay a ns1:LockingScreen .

ns1:Prevention a ns1:MechanismType .

ns1:PrivateKeyPoP a owl:Class ;
    rdfs:subClassOf ns1:AuthenticationProtocolType .

ns1:Public a ns1:ConfidentialityLevel .

ns1:RAM a owl:Class ;
    rdfs:subClassOf ns1:FixedMemory .

ns1:RF a owl:Class ;
    rdfs:subClassOf ns1:PANetwork .

ns1:RIPE-MAC a owl:Class ;
    rdfs:subClassOf ns1:MACAlgorithm .

ns1:RIPE-MD a owl:Class ;
    rdfs:subClassOf ns1:CryptographicHashFunction .

ns1:RMS a ns1:DataRecords ;
    rdfs:comment "Record Management Store are data structure used to store JME data" .

ns1:ROM a owl:Class ;
    rdfs:subClassOf ns1:FixedMemory .

ns1:RSA a owl:Class ;
