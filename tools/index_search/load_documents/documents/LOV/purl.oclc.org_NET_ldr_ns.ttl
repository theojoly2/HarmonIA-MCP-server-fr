@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@prefix ns2: <http://purl.org/vocommons/voaf#> .
@prefix ns3: <http://creativecommons.org/ns#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix onto: <http://purl.oclc.org/NET/ldr/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a owl:Ontology ;
    rdfs:label "Linked Data Rights"@en ;
    ns3:license <http://creativecommons.org/licenses/by/3.0/> ;
    dc:creator <http://delicias.dia.fi.upm.es/~vrodriguez/> ;
    dcterms:contributor "Asuncion Gomez-Perez",
        "Mari Carmen Suarez",
        "Maria Poveda-Villalon",
        "Victor Rodriguez-Doncel" ;
    dcterms:creator "Ontology Engineering Group - Universidad PolitÃƒÂ©cnica de Madrid" ;
    dcterms:description "The Linked Data Rights ontology provides the vocabulary for creating rights expressions for Linked Data resources by extending the ODRL ontology. \\n                   Linked Data assets (RDF triples, graphs, datasets, mappings...) can be object of protection by the intellectual property law, the database law or its access or publication be restricted by other legal reasons (personal data pro- tection, security reasons, etc.). Publishing a rights expression along with the digital asset, allows the rightsholder waiving some or all of the IP and database rights (leaving the work in the public domain), permitting some operations if certain conditions are satisfied (like giving attribution to the author) or simply reminding the audience that some rights are reserved. Specific vocabulary is given for authorising specific uses of Linked Data."@en ;
    dcterms:issued "2013-09-20"^^xsd:date,
        "2014-08-30"^^xsd:date ;
    dcterms:title "Linked Data Rights (LDR)"@en ;
    vann:preferredNamespacePrefix "ldr" ;
    vann:preferredNamespaceUri "http://purl.oclc.org/NET/ldr/ns#" ;
    ns2:classNumber "31"^^xsd:int ;
    ns2:hasEquivalencesWith ns3:null,
        odrl:null,
        foaf:null ;
    ns2:propertyNumber "18"^^xsd:int ;
    ns2:reliesOn ns3:null,
        odrl:,
        odrl:null ;
    ns2:similar <http://data.opendataday.it/LiMo>,
        <http://ns.inria.fr/l4lod/v2/l4lod_v2.rdf>,
        <http://schema.theodi.org/odrs/>,
        odrl:null ;
    ns2:specializes ns3:null,
        odrl:null ;
    ns1:coversRequirements <http://oeg-dev.dia.fi.upm.es/licensius/static/ldr/pattern.html#reqs> ;
    ns1:hasComponent "http://www.w3.org/TR/swbp-n-aryRelations/"@en ;
    ns1:hasIntent <http://oeg-dev.dia.fi.upm.es/licensius/static/ldr/pattern.html#int> ;
    ns1:scenarios "Declaring rights on both Linked Open Data and Linked Closed Data"@en ;
    owl:versionInfo "2.0"@en ;
    prov:wasDerivedFrom <http://oeg-dev.dia.fi.upm.es/licensius/static/lldr/lldr-2013.07.18.owl> .

onto:Agent rdfs:comment "Agent related to a Linked Data resource",
        "Deprecated in favour of the ODRL term"@en ;
    owl:deprecated true ;
    skos:exactMatch odrl:Party,
        foaf:Agent .

onto:HTTPDELETE a onto:LDPAccess,
        owl:NamedIndividual ;
    rdfs:comment "Accessing with the HTTP DELETE Method"@en .

onto:HTTPGET a onto:LDPAccess,
        owl:NamedIndividual ;
    rdfs:comment "Accessing with the HTTP GET Method"@en .

onto:HTTPPATCH a onto:LDPAccess,
        owl:NamedIndividual ;
    rdfs:comment "Accesing with the HTTP PATH Method"@en .

onto:HTTPPOST a onto:LDPAccess,
        owl:NamedIndividual ;
    rdfs:comment "Accessing with the HTTP POST Method"@en .

onto:HTTPPUT a onto:LDPAccess,
        owl:NamedIndividual ;
    rdfs:comment "Accessing with the HTTP PUT Method"@en .

onto:LinkedDataAccess a onto:Access,
        owl:NamedIndividual ;
    rdfs:label "Retrieval of Linked Data resources"@en .

onto:RightsObject rdfs:comment "Deprecated in favour of ODRL"@en,
        "Object over which a right is execised"@en ;
    owl:deprecated true ;
    skos:exactMatch odrl:Asset .

onto:SPARQLASK a onto:SPARQLAccess,
        owl:NamedIndividual ;
    rdfs:comment "Access through the SPARQL ASK query form"@en .

onto:SPARQLCONSTRUCT a onto:SPARQLAccess,
        owl:NamedIndividual ;
    rdfs:comment "Access through the SPARQL CONSTRUCT query form"@en .

onto:SPARQLDESCRIBE a onto:SPARQLAccess,
        owl:NamedIndividual ;
    rdfs:comment "Access through the SPARQL DESCRIBE query form"@en .

onto:SPARQLSELECT a onto:SPARQLAccess,
        owl:NamedIndividual ;
    rdfs:comment "Access through the SPARQL SELECT query form"@en .

onto:access a onto:Access,
        owl:NamedIndividual ;
    rdfs:comment "Access in any manner or form" .

onto:baseSoftwareUpon a onto:Distribution,
        owl:NamedIndividual ;
    rdfs:comment "Distribute a pice of software whose well functioning depends on the related Linked Data resource"@en .

onto:copyDatabase a onto:Extraction,
        owl:NamedIndividual ;
    rdfs:comment "Coyping a dataset, for other purposes than private use"@en .

onto:copyWork a onto:Reproduction,
        owl:NamedIndividual ;
    rdfs:comment "copying the work for purposes other than private"@en .

onto:dataFormat a owl:DatatypeProperty ;
    rdfs:comment "Format of the data (\"text/html\", \"application/rdf+xml\", etc.)"@en ;
    rdfs:subPropertyOf onto:hasclaim,
        odrl:rightOperand .

onto:derivation a onto:Derivation,
        owl:NamedIndividual ;
    rdfs:comment "General transformation of the work"@en .

onto:deriveClasses a onto:Derivation,
        owl:NamedIndividual ;
    rdfs:comment "Subclassing"@en .

onto:deriveProperties a onto:Derivation,
        owl:NamedIndividual ;
    rdfs:comment "Subpropertying"@en .

onto:distribution a onto:Distribution,
        owl:NamedIndividual ;
    rdfs:comment "General act of making available the original work or its copies, in a physical medium"@en .

onto:downloadDatabase a onto:Extraction,
        owl:NamedIndividual ;
    rdfs:comment "Downloading a dataset, for other purposes than private use"@en .

onto:downloadWork a onto:Reproduction,
        owl:NamedIndividual ;
    rdfs:comment "downloading the work for purposes other than private"@en .

onto:extract a onto:Extraction,
        owl:NamedIndividual ;
    rdfs:comment "General right of extraction"@en .

onto:hasAllRightsReserved a onto:ResourceLegalStatus,
        owl:NamedIndividual ;
    rdfs:comment "Declares that the referred resource is protected under copyright or database rights, and none of them is waived"@en .

onto:hasAttributionText a owl:DatatypeProperty ;
    rdfs:comment "Text that has to be included as requested by a condition"@en ;
    rdfs:domain onto:Proposition ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf onto:hasclaim,
        odrl:rightOperand ;
    skos:closeMatch ns3:attributionName,
        ns3:attributionURL .

onto:hasClaim a owl:ObjectProperty ;
    rdfs:comment "Declares a claim asserted in the context of a rights expression"@en ;
    rdfs:range onto:Proposition .

onto:hasCopyrightExpired a onto:ResourceLegalStatus,
        owl:NamedIndividual ;
    rdfs:comment "Declares that the referred resource has its copyright expired"@en .

onto:hasCopyrightNotice a owl:DatatypeProperty ;
    rdfs:comment "Text that has to be attached imposed as a condition"@en ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf onto:hasclaim,
        odrl:rightOperand .

onto:hasDatabaseRightsExpired a onto:ResourceLegalStatus,
        owl:NamedIndividual ;
    rdfs:comment "Declares that the referred resource has the database rights expired"@en .

onto:hasDisclaimerText a owl:DatatypeProperty ;
    rdfs:comment "Text discharging responsibilities on the use of the Linked Data resource"@en ;
    rdfs:domain odrl:Policy ;
    rdfs:subPropertyOf onto:hasclaim,
        odrl:rightOperand .

onto:hasExtendedRule a owl:ObjectProperty ;
    rdfs:comment "Links a Policy to an ExtendedRule it contains"@en ;
    rdfs:domain odrl:Policy ;
    rdfs:range onto:ExtendedRule .

onto:hasIndustrialSecret a onto:ResourceLegalStatus,
        owl:NamedIndividual ;
    rdfs:comment "The referred resource containts an Industrial Secret"@en .

onto:hasLegalStatus a owl:ObjectProperty ;
    rdfs:comment "Declares the legal status of a resource" ;
    rdfs:domain onto:LinkedDataResource ;
    rdfs:range onto:ResourceLegalStatus .

onto:hasNationalSecurityInfo a onto:ResourceLegalStatus,
        owl:NamedIndividual ;
    rdfs:comment "Declares that the referred resource has information whose disclosure might harm the national security"@en .

onto:hasPersonalData a onto:ResourceLegalStatus,
        owl:DatatypeProperty,
        owl:NamedIndividual ;
    rdfs:comment "Declares that the referred resource has personal data"@en ;
    rdfs:subPropertyOf onto:hasclaim,
        odrl:rightOperand .

onto:hasPrivacyLevel a owl:DatatypeProperty ;
    rdfs:comment "Declares the privacy level (e.g. personal data) for a Linked Data resource"@en ;
    rdfs:domain onto:LinkedDataResource ;
    rdfs:subPropertyOf onto:hasclaim,
        odrl:rightOperand .

onto:hasRequirement a owl:ObjectProperty ;
    rdfs:comment "Declares which requirements have to be fulfilled for the Rule to be valid"@en ;
    rdfs:domain odrl:Rule ;
    rdfs:range onto:Proposition .

onto:hasTopSecret a onto:ResourceLegalStatus,
        owl:NamedIndividual ;
    rdfs:comment "Declares that the referred resource contains top secret information of military nature or other"@en .

onto:isInPublicDomain a onto:ResourceLegalStatus,
        owl:NamedIndividual ;
    rdfs:comment "Declares that the declared resource is in the public domain"@en .

onto:issuedOn a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:comment "Date on which the rights expression is issued, with legal consequences on the copyright or database right expiration."@en ;
    rdfs:domain onto:Policy ;
    rdfs:range xsd:dateTime .

onto:judicialProcess a onto:CopyrightException,
        owl:NamedIndividual ;
    rdfs:comment "if the action is carried out for the purposes of an administrative or judicial procedure"@en .

onto:mirror a onto:Distribution,
        owl:NamedIndividual ;
    rdfs:comment "The action of mirroring any piece of Linked Data"@en .

onto:nationalSecurity a onto:CopyrightException,
        owl:NamedIndividual ;
    rdfs:comment "if the action is carried out in the interests of public security"@en .

onto:operation a owl:DatatypeProperty ;
    rdfs:comment "May be set with one of the mathematical values AND, OR and XOR. (OR is the default if not specified.)"@en ;
    rdfs:domain onto:ExtendedRule ;
    rdfs:range xsd:string .

onto:protocol a owl:DatatypeProperty ;
    rdfs:comment "Access protocol (e.g. \"SPARQL\", \"HTTPS\", etc.)"@en ;
    rdfs:subPropertyOf onto:hasclaim,
        odrl:rightOperand .

onto:publicCommunication a onto:PublicCommunication,
        owl:NamedIndividual ;
    rdfs:comment "General right of public communication"@en .

onto:publishDatabase a onto:Reutilization,
        owl:NamedIndividual ;
    rdfs:comment "Make available a database in internet or by other means"@en .

onto:queriesPerDay a owl:DatatypeProperty ;
    rdfs:comment "Number of queries per day"@en ;
    rdfs:subPropertyOf onto:hasclaim,
        odrl:rightOperand .

onto:queriesPerMinute a owl:DatatypeProperty ;
    rdfs:comment "Number of queries per minute"@en ;
    rdfs:subPropertyOf onto:hasclaim,
        odrl:rightOperand .

onto:reasonWith a onto:Access,
        owl:NamedIndividual ;
    rdfs:comment "Accesing Linked Data with the purpose of reasoning, through an specialized protocol (e.g. OWLLink) or not"@en .

onto:rebaseURIs a onto:Derivation,
        owl:NamedIndividual ;
    rdfs:comment "Partially change the URI systematically rebasing the entities"@en .

onto:reificate a onto:Derivation,
        owl:NamedIndividual ;
    rdfs:comment "Reificate an RDF statement or a set thereof"@en .

onto:rent a onto:Distribution,
        owl:NamedIndividual ;
    rdfs:comment "Renting a copy of the work"@en .

onto:reproduction a onto:Reproduction,
        owl:NamedIndividual ;
    rdfs:comment "General right of public reproduction"@en .

onto:research a onto:CopyrightException,
        owl:NamedIndividual ;
    rdfs:comment "illustration for teaching or scientific research, provided the source, including the author's name, is acknowledged"@en .

onto:reutilization a onto:Reutilization,
        owl:NamedIndividual ;
    rdfs:comment "General right of re-utilization"@en .

onto:sell a onto:Distribution,
        owl:NamedIndividual ;
    rdfs:comment "Selling a copy of the work"@en .

onto:sellAccess a onto:Distribution,
        owl:NamedIndividual ;
    rdfs:comment "Offering for meny the access to a copy of the work"@en .

onto:transcodeWork a onto:Derivation,
        owl:NamedIndividual ;
    rdfs:comment "Transcoding the work"@en ;
    skos:example "Having permission to publish a dataset as NTRIPLES, does not entitle the grantee the act of publishing the dataset as Turtle"@en .

onto:translateWork a onto:Derivation,
        owl:NamedIndividual ;
    rdfs:comment "Translating the work"@en ;
    skos:example "Having permission to publish a dataset, does not entitle the grantee the act of publishing a tanslated version of it"@en .

onto:truthValue a owl:DatatypeProperty ;
    rdfs:comment "Truth value"@en ;
    rdfs:domain onto:Proposition ;
    rdfs:range xsd:boolean .

<http://purl.org/NET/rdflicense/cc-zero1.0> a onto:FamousDataLicense,
        owl:NamedIndividual ;
    rdfs:label "CC0"@en ;
    rdfs:comment "Creative Commons public domain waiver"@en .

<http://purl.org/NET/rdflicense/odbc-by1.0> a onto:FamousDataLicense,
        owl:NamedIndividual ;
    rdfs:label "Open Data Commons Attribution"@en ;
    rdfs:comment "Attribution for data/databases"@en .

<http://purl.org/NET/rdflicense/odbc-pddl1.0> a onto:FamousDataLicense,
        owl:NamedIndividual ;
    rdfs:label "ODC Public Domain Dedication and Licence (PDDL)"@en ;
    rdfs:comment "Public Domain for data/databases"@en .

<http://purl.org/NET/rdflicense/odbl1.0> a onto:FamousDataLicense,
        owl:NamedIndividual ;
    rdfs:label "ODC Open Database License"@en ;
    rdfs:comment "Attribution Share-Alike for data/databases"@en .

void:Dataset a owl:Class ;
    rdfs:subClassOf onto:LinkedDataResource .

void:Linkset a owl:Class ;
    rdfs:subClassOf onto:LinkedDataResource .

<http://www.nationalarchives.gov.uk/doc/open-government-licence/version/2/> a onto:FamousDataLicense,
        owl:NamedIndividual ;
    rdfs:label "UK Open Government License"@en,
        "UK Open Government License for public sector information"@en .

rdf:Statement a owl:Class ;
    rdfs:subClassOf onto:LinkedDataResource .

owl:topObjectProperty rdfs:comment "hasIssuer"@en .

skos:closeMatch a owl:AnnotationProperty .

skos:exactMatch a owl:AnnotationProperty .

skos:example a owl:AnnotationProperty .

skos:narrowMatch a owl:AnnotationProperty .

<http://www.w3.org/ns/ldp#Resource> a owl:Class ;
    rdfs:subClassOf onto:LinkedDataResource .

odrl:Constraint a owl:Class ;
    rdfs:subClassOf onto:Proposition .

<urn:mpeg:mpeg21:mco:core:2012#Contract> a owl:Class ;
    rdfs:subClassOf onto:LinkedDataPolicy .

onto:Action a owl:Class .

onto:License a owl:Class ;
    rdfs:comment "Set of rights expressions offered to the public, which grant one or more rights, possibly conditioned to the fulfillment of one or more conditions (propositions)"@en ;
    rdfs:subClassOf onto:LinkedDataPolicy .

onto:PublicCommunication a owl:Class ;
    rdfs:comment "Granting a number of people access to the work without existing distribution"@en ;
    rdfs:subClassOf onto:IPRight .

owl:Ontology a owl:Class ;
    rdfs:subClassOf onto:LinkedDataResource .

onto:DatabaseRight a owl:Class ;
    rdfs:comment "Sui generis right for databases, recognized in European countries and others"@en ;
    rdfs:subClassOf onto:LinkedDataRight .

onto:ExtendedRule a owl:Class ;
    rdfs:comment "Extended Relations may tie Permission, Prohibition, Duty, and Constraint entities together with an AND, OR or XOR relationship. Only entities of the same type can be linked with this model. For example, a Permission and Prohibition cannot be linked together within this model. The Extended rule is composed of two or more rules" ;
    rdfs:subClassOf odrl:Rule .

onto:LinkedDataPolicy a owl:Class ;
    rdfs:comment "A policy applied over a Linked Data resource"@en ;
    rdfs:subClassOf odrl:Policy .

onto:Reutilization a owl:Class ;
    rdfs:comment "Right to make available to the public all or a substantial part of the contents of a database by the distribution of copies, by renting, by on-line or other forms of transmission"@en ;
    rdfs:subClassOf onto:DatabaseRight .

odrl:Asset a owl:Class .

odrl:Rule a owl:Class .

onto:CopyrightException a owl:Class ;
    rdfs:comment "Reason which can be invoked to make an exception to the intellectual property or database law "@en ;
    rdfs:subClassOf onto:Proposition .

onto:Extraction a owl:Class ;
    rdfs:comment "Right to permanent or temporary transfer of all or a substantial part of the contents of a database to another medium by any means or in any form"@en ;
    rdfs:subClassOf onto:DatabaseRight .

onto:LinkedDataRight a owl:Class ;
    rdfs:comment "Action legally granted as allowable to be exercised on a Linked Data resource"@en ;
    rdfs:subClassOf onto:Action .

onto:Reproduction a owl:Class ;
    rdfs:comment "Direct or indirect fixation, allowing its communication and/or making copies of it"@en ;
    rdfs:subClassOf onto:IPRight ;
    skos:exactMatch ns3:Reproduction .

odrl:Policy a owl:Class .

onto:IPRight a owl:Class ;
    rdfs:comment "Intellectual Property right"@en ;
    rdfs:subClassOf onto:LinkedDataRight .

onto:SPARQLAccess a owl:Class ;
    rdfs:subClassOf onto:Access .

onto:Access a owl:Class ;
    rdfs:comment "Right of access, which can be legally granted (e.g. public sector information) or expressely restricted (e.g. secrets compromising national security)"@en ;
    rdfs:subClassOf onto:LinkedDataRight ;
    skos:exactMatch <http://www.w3.org/ns/auth/acl#Access> .

onto:FamousDataLicense a owl:Class ;
    rdfs:comment "License publicly available and known to the public"@en ;
    rdfs:subClassOf onto:License .

onto:LDPAccess a owl:Class ;
    rdfs:subClassOf onto:Access .

onto:Distribution a owl:Class ;
    rdfs:comment "Make available the original work or its copies, in a physical medium"@en ;
    rdfs:subClassOf onto:IPRight ;
    skos:exactMatch ns3:Distribution .

onto:Derivation a owl:Class ;
    rdfs:comment "Transformation of the work, including translation adaptation or any other form modification"@en ;
    rdfs:subClassOf onto:IPRight ;
    skos:closeMatch ns3:DerivativeWorks .

onto:LinkedDataResource a owl:Class ;
    rdfs:comment "A Linked Data resource, object of some rights"@en ;
    rdfs:subClassOf odrl:Asset .

onto:Proposition a owl:Class ;
    rdfs:comment "A veritative statement"@en .

onto:ResourceLegalStatus a owl:Class ;
    rdfs:comment "Attribute of a resource regarding its legal status"@en ;
    rdfs:subClassOf onto:Proposition .

onto:hasclaim a owl:DatatypeProperty .

odrl:rightOperand a owl:DatatypeProperty .

