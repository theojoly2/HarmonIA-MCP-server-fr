      "@id": "schema:NewsMediaOrganization"
    },
    {
      "@id": "schema:Organization"
    }
  ],
  "schema:rangeIncludes": [
    {
      "@id": "schema:Article"
    },
    {
      "@id": "schema:URL"
    }
  ],
  "schema:isPartOf": {
    "@id": "https://pending.schema.org"
  },
  "schema:source": {
