{
  "@context": {
    "cmns-col": "https://www.omg.org/spec/Commons/Collections/",
    "fibo-fnd-arr-doc": "https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Documents/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "https://schema.org/"
  },
  "@id": "schema:partOfInvoice",
  "@type": "rdf:Property",
  "rdfs:label": "partOfInvoice",
  "rdfs:comment": "The order is being paid as part of the referenced Invoice.",
  "rdfs:subPropertyOf": [
    {
      "@id": "cmns-col:isPartOf"
    },
    {
      "@id": "fibo-fnd-arr-doc:isReferencedIn"
    }
  ],
  "schema:domainIncludes": {
    "@id": "schema:Order"
  },
  "schema:rangeIncludes": {
    "@id": "schema:Invoice"
  }
}