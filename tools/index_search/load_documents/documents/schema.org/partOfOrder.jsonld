{
  "@context": {
    "fibo-fnd-arr-doc": "https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Documents/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "https://schema.org/",
    "unece": "http://unece.org/vocab#"
  },
  "@id": "schema:partOfOrder",
  "@type": "rdf:Property",
  "rdfs:label": "partOfOrder",
  "rdfs:comment": "The overall order the items in this delivery were included in.",
  "rdfs:subPropertyOf": {
    "@id": "fibo-fnd-arr-doc:refersTo"
  },
  "schema:domainIncludes": {
    "@id": "schema:ParcelDelivery"
  },
  "schema:rangeIncludes": {
    "@id": "schema:Order"
  },
  "owl:equivalentProperty": {
    "@id": "unece:ReferencedOrder"
  }
}