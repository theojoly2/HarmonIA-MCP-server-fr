{
  "@context": {
    "cmns-q": "https://www.omg.org/spec/Commons/Quantities/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "https://schema.org/",
    "unece": "http://unece.org/vocab#"
  },
  "@id": "schema:orderQuantity",
  "@type": "rdf:Property",
  "rdfs:label": "orderQuantity",
  "rdfs:comment": "The number of the item ordered. If the property is not set, assume the quantity is one.",
  "rdfs:subPropertyOf": {
    "@id": "cmns-q:hasQuantity"
  },
  "schema:domainIncludes": {
    "@id": "schema:OrderItem"
  },
  "schema:rangeIncludes": [
    {
      "@id": "schema:Number"
    },
    {
      "@id": "schema:QuantitativeValue"
    }
  ],
  "owl:equivalentProperty": {
    "@id": "unece:orderQuantity"
  }
}