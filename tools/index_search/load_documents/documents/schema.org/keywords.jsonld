    },
    {
      "@id": "schema:Event"
    },
    {
      "@id": "schema:Organization"
    },
    {
      "@id": "schema:Place"
    },
    {
      "@id": "schema:Product"
    }
  ],
  "schema:rangeIncludes": [
    {
      "@id": "schema:DefinedTerm"
    },
    {
      "@id": "schema:Text"
    },
    {
      "@id": "schema:URL"
    }
  ]
}