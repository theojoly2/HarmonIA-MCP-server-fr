  "@id": "schema:fuelType",
  "@type": "rdf:Property",
  "rdfs:label": "fuelType",
  "rdfs:comment": "The type of fuel suitable for the engine or engines of the vehicle. If the vehicle has only one engine, this property can be attached directly to the vehicle.",
