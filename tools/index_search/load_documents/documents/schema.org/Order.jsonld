{
  "@context": {
    "fibo-fnd-arr-doc": "https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Documents/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "https://schema.org/",
    "unece": "http://unece.org/vocab#"
  },
  "@id": "schema:Order",
  "@type": "rdfs:Class",
  "rdfs:label": "Order",
  "rdfs:comment": "An order is a confirmation of a transaction (a receipt), which can contain multiple line items, each represented by an Offer that has been accepted by the customer.",
  "rdfs:subClassOf": [
    {
      "@id": "fibo-fnd-arr-doc:LegalDocument"
    },
    {
      "@id": "schema:Intangible"
    }
  ],
  "owl:equivalentClass": {
    "@id": "unece:Order"
  }
}