{
  "@context": {
    "cmns-q": "https://www.omg.org/spec/Commons/Quantities/",
    "fibo-fnd-acc-cur": "https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "https://schema.org/"
  },
  "@id": "schema:maxPrice",
  "@type": "rdf:Property",
  "rdfs:label": "maxPrice",
  "rdfs:comment": "The highest price if the price is a range.",
  "rdfs:subPropertyOf": [
    {
      "@id": "cmns-q:hasUpperBound"
    },
    {
      "@id": "fibo-fnd-acc-cur:hasMonetaryAmount"
    }
  ],
  "schema:domainIncludes": {
    "@id": "schema:PriceSpecification"
  },
  "schema:rangeIncludes": {
    "@id": "schema:Number"
  },
  "schema:contributor": {
    "@id": "https://schema.org/docs/collab/GoodRelationsTerms"
  }
}