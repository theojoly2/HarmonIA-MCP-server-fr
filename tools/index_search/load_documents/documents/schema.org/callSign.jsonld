    "@id": "schema:identifier"
  },
  "schema:domainIncludes": [
    {
      "@id": "schema:BroadcastService"
    },
    {
      "@id": "schema:Person"
    },
    {
      "@id": "schema:Vehicle"
    }
  ],
  "schema:rangeIncludes": {
    "@id": "schema:Text"
  },
  "schema:isPartOf": {
    "@id": "https://pending.schema.org"
  },
  "schema:source": {
    "@id": "https://github.com/schemaorg/schemaorg/issues/2109"
  }
}