    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "https://schema.org/"
  },
  "@id": "schema:email",
  "@type": "rdf:Property",
  "rdfs:label": "email",
  "rdfs:comment": "Email address.",
  "schema:domainIncludes": [
    {
      "@id": "schema:ContactPoint"
    },
    {
      "@id": "schema:Organization"
    },
    {
      "@id": "schema:Person"
    }
  ],
  "schema:rangeIncludes": {
    "@id": "schema:Text"
  },
  "owl:equivalentProperty": {
    "@id": "gs1:email"
  }
}