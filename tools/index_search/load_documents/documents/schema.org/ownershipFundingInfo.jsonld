    },
    {
      "@id": "schema:CreativeWork"
    },
    {
      "@id": "schema:Text"
    },
    {
      "@id": "schema:URL"
    }
  ],
  "schema:isPartOf": {
    "@id": "https://pending.schema.org"
  },
