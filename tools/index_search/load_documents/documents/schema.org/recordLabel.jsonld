  "rdfs:label": "recordLabel",
  "rdfs:comment": "The label that issued the release.",
  "schema:domainIncludes": {
    "@id": "schema:MusicRelease"
  },
  "schema:rangeIncludes": {
    "@id": "schema:Organization"
  },
  "schema:contributor": {
