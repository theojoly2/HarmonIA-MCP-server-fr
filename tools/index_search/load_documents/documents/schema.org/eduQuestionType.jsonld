    {
      "@id": "schema:Question"
    },
    {
      "@id": "schema:SolveMathAction"
    }
  ],
  "schema:rangeIncludes": {
    "@id": "schema:Text"
  },
  "schema:isPartOf": {
    "@id": "https://pending.schema.org"
  },
  "schema:source": {
    "@id": "https://github.com/schemaorg/schemaorg/issues/2636"
  }
}