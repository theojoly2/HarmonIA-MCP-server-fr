    "@id": "schema:ProductGroup"
  },
  "schema:rangeIncludes": [
    {
      "@id": "schema:DefinedTerm"
    },
    {
      "@id": "schema:Text"
    }
  ],
  "schema:isPartOf": {
    "@id": "https://pending.schema.org"
  },
  "schema:source": {
    "@id": "https://github.com/schemaorg/schemaorg/issues/1797"
  }
}