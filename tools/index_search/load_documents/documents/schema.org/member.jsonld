{
  "@context": {
    "fibo-fnd-org-org": "https://spec.edmcouncil.org/fibo/ontology/FND/Organizations/Organizations/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "https://schema.org/"
  },
  "@id": "schema:member",
  "@type": "rdf:Property",
  "rdfs:label": "member",
  "rdfs:comment": "A member of an Organization or a ProgramMembership. Organizations can be members of organizations; ProgramMembership is typically for individuals.",
  "schema:domainIncludes": [
    {
      "@id": "schema:Organization"
    },
    {
      "@id": "schema:ProgramMembership"
    }
  ],
  "schema:rangeIncludes": [
    {
      "@id": "schema:Organization"
    },
    {
      "@id": "schema:Person"
    }
  ],
  "schema:inverseOf": {
    "@id": "schema:memberOf"
  },
  "owl:equivalentProperty": {
    "@id": "fibo-fnd-org-org:hasMember"
  }
}