  "schema:domainIncludes": [
    {
      "@id": "schema:Class"
    },
    {
      "@id": "schema:Enumeration"
    },
    {
      "@id": "schema:Property"
    }
  ],
  "schema:rangeIncludes": [
    {
      "@id": "schema:Class"
    },
    {
      "@id": "schema:Enumeration"
    },
    {
      "@id": "schema:Property"
    }
  ],
  "schema:isPartOf": {
    "@id": "https://meta.schema.org"
  }
}