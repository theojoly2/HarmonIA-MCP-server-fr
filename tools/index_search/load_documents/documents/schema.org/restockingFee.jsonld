    {
      "@id": "schema:MerchantReturnPolicy"
    },
    {
      "@id": "schema:MerchantReturnPolicySeasonalOverride"
    }
  ],
  "schema:rangeIncludes": [
    {
      "@id": "schema:MonetaryAmount"
    },
    {
      "@id": "schema:Number"
    }
  ],
  "schema:isPartOf": {
    "@id": "https://pending.schema.org"
  },
  "schema:source": {
