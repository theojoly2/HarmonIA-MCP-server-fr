    },
    {
      "@id": "schema:AnatomicalSystem"
    },
    {
      "@id": "schema:SuperficialAnatomy"
    }
  ],
  "schema:rangeIncludes": {
    "@id": "schema:Text"
  },
  "schema:isPartOf": {
    "@id": "https://health-lifesci.schema.org"
  }
}