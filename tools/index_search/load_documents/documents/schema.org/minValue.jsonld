{
  "@context": {
    "cmns-q": "https://www.omg.org/spec/Commons/Quantities/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "https://schema.org/"
  },
  "@id": "schema:minValue",
  "@type": "rdf:Property",
  "rdfs:label": "minValue",
  "rdfs:comment": "The lower value of some characteristic or property.",
  "rdfs:subPropertyOf": {
    "@id": "cmns-q:hasLowerBound"
  },
  "schema:domainIncludes": [
    {
      "@id": "schema:MonetaryAmount"
    },
    {
      "@id": "schema:PropertyValue"
    },
    {
      "@id": "schema:PropertyValueSpecification"
    },
    {
      "@id": "schema:QuantitativeValue"
    }
  ],
  "schema:rangeIncludes": {
    "@id": "schema:Number"
  },
  "schema:contributor": {
    "@id": "https://schema.org/docs/collab/GoodRelationsTerms"
  }
}