{
  "@context": {
    "fibo-fnd-arr-doc": "https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Documents/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "https://schema.org/",
    "unece": "http://unece.org/vocab#"
  },
  "@id": "schema:DigitalDocument",
  "@type": "rdfs:Class",
  "rdfs:label": "DigitalDocument",
  "rdfs:comment": "An electronic file or document.",
  "rdfs:subClassOf": [
    {
      "@id": "fibo-fnd-arr-doc:Document"
    },
    {
      "@id": "schema:CreativeWork"
    }
  ],
  "owl:equivalentClass": {
    "@id": "unece:ElectronicDocument"
  }
}