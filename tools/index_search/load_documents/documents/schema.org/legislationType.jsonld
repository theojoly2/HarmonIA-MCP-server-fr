    },
    {
      "@id": "https://op.europa.eu/en/web/eu-vocabularies/model/-/resource/dataset/eli"
    }
  ],
  "schema:contributor": {
    "@id": "https://schema.org/docs/collab/ELI"
  },
  "owl:equivalentProperty": {
    "@id": "eli:type_document"
  },
  "skos:exactMatch": {
    "@id": "eli:type_document"
  }
}