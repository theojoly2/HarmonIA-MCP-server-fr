{
  "@context": {
    "cmns-ge": "https://www.omg.org/spec/Commons/GeopoliticalEntities/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "https://schema.org/"
  },
  "@id": "schema:AdministrativeArea",
  "@type": "rdfs:Class",
  "rdfs:label": "AdministrativeArea",
  "rdfs:comment": "A geographical region, typically under the jurisdiction of a particular government.",
  "rdfs:subClassOf": {
    "@id": "schema:Place"
  },
  "owl:equivalentClass": {
    "@id": "cmns-ge:Subdivision"
  }
}