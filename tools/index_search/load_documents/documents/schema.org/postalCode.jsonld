{
  "@context": {
    "fibo-fnd-plc-adr": "https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/",
    "gs1": "https://ref.gs1.org/voc/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "https://schema.org/",
    "unece": "http://unece.org/vocab#"
  },
  "@id": "schema:postalCode",
  "@type": "rdf:Property",
  "rdfs:label": "postalCode",
  "rdfs:comment": "The postal code. For example, 94043.",
  "schema:domainIncludes": [
    {
      "@id": "schema:DefinedRegion"
    },
    {
      "@id": "schema:GeoCoordinates"
    },
    {
      "@id": "schema:GeoShape"
    },
    {
      "@id": "schema:PostalAddress"
    }
  ],
  "schema:rangeIncludes": {
    "@id": "schema:Text"
  },
  "schema:source": {
    "@id": "https://github.com/schemaorg/schemaorg/issues/2506"
  },
  "owl:equivalentProperty": [
    {
      "@id": "fibo-fnd-plc-adr:hasPostalCode"
    },
    {
      "@id": "gs1:postalCode"
    },
    {
      "@id": "unece:postcodeCode"
    }
  ]
}