{
  "@context": {
    "cmns-txt": "https://www.omg.org/spec/Commons/Text/",
    "fibo-fnd-rel-rel": "https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/",
    "gs1": "https://ref.gs1.org/voc/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "https://schema.org/"
  },
  "@id": "schema:legalName",
  "@type": "rdf:Property",
  "rdfs:label": "legalName",
  "rdfs:comment": "The official name of the organization, e.g. the registered company name.",
  "rdfs:subPropertyOf": {
    "@id": "cmns-txt:hasName"
  },
  "schema:domainIncludes": {
    "@id": "schema:Organization"
  },
  "schema:rangeIncludes": {
    "@id": "schema:Text"
  },
  "schema:contributor": {
    "@id": "https://schema.org/docs/collab/GoodRelationsTerms"
  },
  "owl:equivalentProperty": [
    {
      "@id": "fibo-fnd-rel-rel:hasLegalName"
    },
    {
      "@id": "gs1:organizationLegalName"
    }
  ]
}