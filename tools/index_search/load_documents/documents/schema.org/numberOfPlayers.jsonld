  "schema:domainIncludes": [
    {
      "@id": "schema:Game"
    },
    {
      "@id": "schema:VideoGameSeries"
    }
  ],
  "schema:rangeIncludes": {
    "@id": "schema:QuantitativeValue"
  }
}