    {
      "@id": "schema:Accommodation"
    },
    {
      "@id": "schema:ApartmentComplex"
    },
    {
      "@id": "schema:Place"
    }
  ],
  "schema:rangeIncludes": {
    "@id": "schema:URL"
  },
  "schema:isPartOf": {
    "@id": "https://pending.schema.org"
  },
  "schema:source": {
