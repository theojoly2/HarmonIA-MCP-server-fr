{
  "@context": {
    "cmns-loc": "https://www.omg.org/spec/Commons/Locations/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "https://schema.org/",
    "unece": "http://unece.org/vocab#"
  },
  "@id": "schema:GeoCoordinates",
  "@type": "rdfs:Class",
  "rdfs:label": "GeoCoordinates",
  "rdfs:comment": "The geographic coordinates of a place or event.",
  "rdfs:subClassOf": {
    "@id": "schema:StructuredValue"
  },
  "owl:equivalentClass": [
    {
      "@id": "cmns-loc:GeographicCoordinate"
    },
    {
      "@id": "unece:GeographicalCoordinate"
    }
  ]
}