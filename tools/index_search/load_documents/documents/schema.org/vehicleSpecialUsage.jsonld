    "@id": "schema:Vehicle"
  },
  "schema:rangeIncludes": [
    {
      "@id": "schema:CarUsageType"
    },
    {
      "@id": "schema:Text"
    }
  ],
  "schema:isPartOf": {
    "@id": "https://auto.schema.org"
  },
  "schema:contributor": {
    "@id": "https://schema.org/docs/collab/Automotive_Ontology_Working_Group"
  }
}