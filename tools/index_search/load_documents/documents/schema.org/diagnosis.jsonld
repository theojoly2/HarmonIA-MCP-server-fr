      "@id": "schema:DDxElement"
    },
    {
      "@id": "schema:Patient"
    }
  ],
  "schema:rangeIncludes": {
    "@id": "schema:MedicalCondition"
  },
  "schema:isPartOf": {
    "@id": "https://health-lifesci.schema.org"
  }
}