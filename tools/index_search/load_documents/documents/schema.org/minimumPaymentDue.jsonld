    "schema": "https://schema.org/"
  },
  "@id": "schema:minimumPaymentDue",
  "@type": "rdf:Property",
  "rdfs:label": "minimumPaymentDue",
  "rdfs:comment": "The minimum payment required at this time.",
  "rdfs:subPropertyOf": [
    {
      "@id": "cmns-q:hasLowerBound"
    },
    {
      "@id": "fibo-fnd-acc-cur:hasMonetaryAmount"
