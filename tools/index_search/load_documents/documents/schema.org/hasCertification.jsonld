    },
    {
      "@id": "schema:Service"
    }
  ],
  "schema:rangeIncludes": {
    "@id": "schema:Certification"
  },
  "schema:source": {
    "@id": "https://github.com/schemaorg/schemaorg/issues/3230"
  },
  "owl:equivalentProperty": {
