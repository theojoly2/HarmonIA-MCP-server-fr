    {
      "@id": "schema:AudioObject"
    },
    {
      "@id": "schema:ImageObject"
    },
    {
      "@id": "schema:VideoObject"
    }
  ],
  "schema:rangeIncludes": {
    "@id": "schema:Text"
  },
  "schema:isPartOf": {
    "@id": "https://pending.schema.org"
  },
  "schema:source": {
    "@id": "https://github.com/schemaorg/schemaorg/issues/2450"
  }
}