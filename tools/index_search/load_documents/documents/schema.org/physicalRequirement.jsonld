    {
      "@id": "schema:DefinedTerm"
    },
    {
      "@id": "schema:Text"
    },
    {
      "@id": "schema:URL"
    }
  ],
  "schema:isPartOf": {
    "@id": "https://pending.schema.org"
  },
  "schema:source": {
