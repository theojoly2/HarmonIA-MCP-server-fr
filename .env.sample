SERVER_HOST = "qdrant"
SERVER_PORT = "6333"
QDRANT_API_KEY = ""

# Embedding API (ex: Albert /v1/embeddings) - utilisés par tools/index_search/load_documents/config.py
EMBEDDING_API_KEY = ""
URL_EMBEDDING_API = ""
EMBEDDING_MODEL = "BAAI/bge-m3"

# Reranker API (ex: Albert /v1/rerank) - utilisés par tools/index_search/load_documents/config.py
RERANKER_API_KEY = ""
URL_RERANKER_API = ""
RERANKER_MODEL = "BAAI/bge-reranker-v2-m3"

# LLM pour génération de résumés (tools/index_search/load_documents/load.py)
# Activé si summary.enabled=true dans config.yaml
LLM_API_KEY = ""
URL_LLM_API = ""
LLM_MODEL = ""
